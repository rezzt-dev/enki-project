<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===================================================================
       Re-templates completos para controles Fluent que no se pueden llevar
       a "cero radio / rectangular" solo con Setters de propiedad
       (ToggleSwitch, ScrollBar). Ver §7.4 y §7.14 de la guía de diseño.
       Vive en Application.Resources para tener prioridad sobre los
       ControlTheme implícitos de FluentTheme.
       =================================================================== -->

  <!-- ===================== Toggle switch (§7.4) ===================== -->
  <!-- Track/knob del estado "off" resueltos vía la rampa Ink (Fase 1, gap 25: antes hardcodeaban
       #353535/#919191 — grises fijos que no seguían la inversión de polaridad de Colors.axaml al
       cambiar a tema claro, a diferencia de todo lo demás en este re-template). -->
  <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border x:Name="SwitchTrack"
                  Width="36" Height="18"
                  CornerRadius="0"
                  Background="{DynamicResource Ink20}"
                  HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="{DynamicResource MotionInteractionDuration}" Easing="CubicEaseOut" />
              </Transitions>
            </Border.Transitions>
            <Panel x:Name="PART_MovingKnobs">
              <Border x:Name="SwitchKnob"
                      Width="14" Height="14"
                      CornerRadius="0"
                      Background="{DynamicResource Ink40}"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="2,0,0,0" RenderTransform="translateX(0px)">
                <Border.Transitions>
                  <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MotionInteractionDuration}" Easing="CubicEaseOut" />
                    <BrushTransition Property="Background" Duration="{DynamicResource MotionInteractionDuration}" Easing="CubicEaseOut" />
                  </Transitions>
                </Border.Transitions>
              </Border>
            </Panel>
          </Border>

          <ContentPresenter x:Name="PART_OnContentPresenter"
                             Content="{TemplateBinding OnContent}"
                             IsVisible="{TemplateBinding IsChecked}"
                             VerticalAlignment="Center" />
          <ContentPresenter x:Name="PART_OffContentPresenter"
                             Content="{TemplateBinding OffContent}"
                             IsVisible="{Binding !IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                             VerticalAlignment="Center" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Border#SwitchTrack">
      <Setter Property="Background" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Border#SwitchKnob">
      <Setter Property="RenderTransform" Value="translateX(18px)" />
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!-- Controles rectangulares optativos: misma rampa de tinta y estados en ambos temas.
       El contenido del checkbox forma parte del área pulsable y del foco de teclado. -->
  <ControlTheme x:Key="RectangularCheckBox" TargetType="CheckBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="CheckFocus" Background="Transparent" BorderBrush="Transparent"
                BorderThickness="1" CornerRadius="0" Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border x:Name="CheckIndicator" Width="16" Height="16" CornerRadius="0"
                    VerticalAlignment="Center" BorderThickness="1"
                    BorderBrush="{DynamicResource Ink40}" Background="Transparent">
              <Path x:Name="CheckGlyph" Data="M 1,5 L 4,8 L 10,1" Width="10" Height="8"
                    Stroke="{DynamicResource InkOnBrush}" StrokeThickness="1.5" IsVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ContentPresenter Grid.Column="1" x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Border#CheckIndicator">
      <Setter Property="Background" Value="{DynamicResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Path#CheckGlyph">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#CheckIndicator">
      <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#CheckFocus">
      <Setter Property="BorderBrush" Value="{DynamicResource Ink60}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#CheckFocus">
      <Setter Property="Background" Value="{DynamicResource Ink10}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!-- Slider horizontal: pista fina, tramo activo y tirador rectangular. Conserva Track y Thumb
       nativos para arrastre, clic en la pista, teclado y automatización de accesibilidad. -->
  <ControlTheme x:Key="RectangularSlider" TargetType="Slider">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="SliderFocus" BorderBrush="Transparent" BorderThickness="1"
                Background="Transparent" CornerRadius="0" Padding="4,0">
          <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                 Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton>
              <RepeatButton x:Name="PART_DecreaseButton" Focusable="False" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <RepeatButton.Template>
                  <ControlTemplate>
                    <Border Background="Transparent">
                      <Border Height="2" VerticalAlignment="Center" Background="{DynamicResource Ink80}" CornerRadius="0" />
                    </Border>
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseButton>
            <Track.Thumb>
              <Thumb x:Name="PART_Thumb" Width="14" Cursor="SizeWestEast" Focusable="False" Background="{DynamicResource InkBrush}">
                <Thumb.Template>
                  <ControlTemplate>
                    <Border Background="Transparent">
                      <Border x:Name="SliderHandle" Width="12" Height="18" CornerRadius="0"
                              VerticalAlignment="Center" Background="{TemplateBinding Background}"
                              BorderBrush="{DynamicResource InkBrush}" BorderThickness="1" />
                    </Border>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseButton>
              <RepeatButton x:Name="PART_IncreaseButton" Focusable="False" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <RepeatButton.Template>
                  <ControlTemplate>
                    <Border Background="Transparent">
                      <Border Height="2" VerticalAlignment="Center" Background="{DynamicResource Ink20}" CornerRadius="0" />
                    </Border>
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseButton>
          </Track>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#SliderFocus">
      <Setter Property="BorderBrush" Value="{DynamicResource Ink60}" />
    </Style>
    <Style Selector="^ /template/ Thumb:pointerover">
      <Setter Property="Background" Value="{DynamicResource Ink60}" />
    </Style>
    <Style Selector="^ /template/ Thumb:pressed">
      <Setter Property="Background" Value="{DynamicResource InkOnBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
