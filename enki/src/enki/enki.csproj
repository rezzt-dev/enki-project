<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RollForward>LatestMajor</RollForward>
    <!-- Fase 10 (docs/analisis-proyecto/roadmap.md — "añadir un icono de aplicación real"): embebe
         assets/icon/enki.ico en el .exe publicado en Windows (icono en el Explorador/taskbar antes incluso
         de ejecutar la app). El icono de la ventana en tiempo de ejecución (las tres plataformas) se fija
         aparte, en Window.Icon de MainWindow.axaml — ver docs/agent-docs/empaquetado-y-distribucion.md
         para el resto del set (.icns de macOS, PNGs de Linux) y qué queda pendiente de un instalador real. -->
    <ApplicationIcon>assets/icon/enki.ico</ApplicationIcon>
    <!-- Fase 10 (docs/analisis-proyecto/roadmap.md): subido solo aquí, no en Directory.Build.props, a
         propósito — el hallazgo original que motivó esto ("~115 diagnósticos, casi todos CA1305 de
         formateo sensible a cultura, repartidos por buena parte de los ViewModels") es específico del
         código de la app. Subirlo también para enki.Tests/enki.UITests arrastra un lote de reglas propias
         de higiene de tests (CA1816 en el patrón Dispose de xUnit, CA1707 sobre el naming
         Method_Scenario_Expected...) que son un hallazgo distinto, no cubierto por este punto del roadmap. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="assets/**" />
  </ItemGroup>

  <!-- Lets enki.Tests unit-test PolarSyncService's internal DTO<->model mapping (LWW field application,
       tombstone round-trip) directly, without needing a live Supabase connection. -->
  <ItemGroup>
    <InternalsVisibleTo Include="enki.Tests" />
    <!-- Deja que enki.UITests compruebe el pipeline interno de imágenes del live preview
         (Views/Editor/Markdown/MarkdownImageCache y compañía, internal por vivir dentro de la vista):
         es la única capa con una plataforma Avalonia levantada, y por tanto la única donde decodificar
         un bitmap de verdad significa algo. -->
    <InternalsVisibleTo Include="enki.UITests" />
  </ItemGroup>

  <!-- Supabase credentials (SUPABASE_URL/SUPABASE_ANON_KEY) — never committed, see root .gitignore and
       docs/supabase-sync/08-configuracion-y-credenciales.md. Copied next to the executable so
       Services.SupabaseConfig can read it at runtime; absent on a fresh checkout, in which case every
       Polar-linking feature just stays disabled (SupabaseConfig.IsConfigured is false). -->
  <ItemGroup>
    <None Include="../../local.properties" Link="local.properties" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../local.properties')" />
  </ItemGroup>

  <!-- Skills de IA por defecto (docs/ia-skills/especificacion-desarrollo.md §2) — copiadas junto al
       ejecutable para que SkillService.EnsureDefaultSkills las encuentre en runtime vía
       Path.Combine(AppContext.BaseDirectory, "default-skills"). -->
  <ItemGroup>
    <Content Include="../../../docs/ia-skills/default-skills/*.md" CopyToOutputDirectory="PreserveNewest" TargetPath="default-skills/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <!-- Postgres Realtime (postgres_changes over websocket) for PolarRealtimeService — pulls in
         Supabase.Core, Supabase.Postgrest, Websocket.Client and Newtonsoft.Json transitively. -->
    <PackageReference Include="Supabase.Realtime" Version="7.4.0" />
    <PackageReference Include="Svg.Skia" Version="2.0.0.4" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
    <PackageReference Include="YamlDotNet" Version="16.1.3" />
  </ItemGroup>
</Project>
