<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="clr-namespace:enki.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:views="clr-namespace:enki.Views"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             x:Class="enki.Views.SkillsView"
             x:Name="Root"
             x:DataType="vm:SkillsViewModel">

  <!-- Contenedor de la sección IA Skills. No dibuja la sección: elige entre sus dos disposiciones
       —SkillsBrowserView (panel de carpetas + rejilla, al estilo de Archivos) y SkillsTreeView (árbol de
       carpetas y skills + detalle, al estilo de la vista simplificada de Notas)— y aloja lo que es común
       a las dos: los cuatro diálogos modales, que se disparan igual desde la rejilla de una que desde el
       árbol de la otra.

       Se monta una sola disposición, no las dos con IsVisible, por el mismo motivo que en NotesView: cada
       una contiene su propio SkillEditorView, y dos editores vivos sobre el mismo SkillEditorViewModel
       escribirían los dos sobre su propiedad Text. -->

  <Grid>
    <ContentControl x:Name="LayoutHost" />

    <!-- ===================== Modal: confirmar eliminación de una skill ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding PendingDeleteSkill, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
              DataContext="{Binding PendingDeleteSkill}" x:DataType="vm:SkillViewModel">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{loc:Tr Skills_DeleteModal_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Skills_DeleteModal_Message}" FontSize="14" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Name}" Classes="muted" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Margin="0,0,18,0"
                    Command="{Binding #Root.((vm:SkillsViewModel)DataContext).CancelDeleteSkillCommand}">
              <TextBlock Text="{loc:Tr Skills_Cancel_Button, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary-danger"
                    Command="{Binding #Root.((vm:SkillsViewModel)DataContext).ConfirmDeleteSkillCommand}">
              <TextBlock Text="{loc:Tr Skills_Detail_DeleteButton, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>

    <!-- ===================== Modal: confirmar eliminación de una carpeta ===================== -->
    <!-- Modal propio y no el de arriba: eliminar una carpeta arrastra consigo todo lo que contiene y la
         biblioteca de skills no tiene papelera, así que el aviso tiene que decirlo explícitamente. -->
    <controls:ModalOverlayHost IsOpen="{Binding PendingDeleteFolder, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
              DataContext="{Binding PendingDeleteFolder}" x:DataType="vm:SkillFolderViewModel">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{loc:Tr Skills_DeleteFolderModal_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Skills_DeleteFolderModal_Message}" FontSize="14" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Name}" Classes="muted" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Tr Skills_DeleteFolderModal_Warning}" Classes="faint" FontSize="11.5" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Margin="0,0,18,0"
                    Command="{Binding #Root.((vm:SkillsViewModel)DataContext).CancelDeleteFolderCommand}">
              <TextBlock Text="{loc:Tr Skills_Cancel_Button, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary-danger"
                    Command="{Binding #Root.((vm:SkillsViewModel)DataContext).ConfirmDeleteFolderCommand}">
              <TextBlock Text="{loc:Tr Skills_Detail_DeleteButton, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>

    <!-- ===================== Modal: pedir nombre (duplicar / copiar default) ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding NamePrompt, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
              DataContext="{Binding NamePrompt}" x:DataType="vm:SkillNamePromptViewModel">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
          <TextBox Classes="search" Text="{Binding InputText, Mode=TwoWay}" Name="NamePromptTextBox"
                   AutomationProperties.Name="{Binding Title}"
                   KeyDown="NamePromptTextBox_KeyDown" Initialized="NamePromptTextBox_Initialized" />
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="11.5"
                     TextWrapping="Wrap"
                     IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Margin="0,0,18,0"
                    Command="{Binding #Root.((vm:SkillsViewModel)DataContext).CancelNamePromptCommand}">
              <TextBlock Text="{loc:Tr Skills_Cancel_Button, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary"
                    Command="{Binding #Root.((vm:SkillsViewModel)DataContext).ConfirmNamePromptCommand}">
              <TextBlock Text="{Binding ConfirmLabel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>

    <!-- ===================== Modal: colisión de importación ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding HasImportConflicts}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource Ink40}" />
            <TextBlock Text="{loc:Tr Skills_ImportConflict_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{loc:Tr Skills_ImportConflict_Message}"
                     FontSize="13.5" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding ImportConflictFileNames}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Classes="muted" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Right">
            <Button Grid.Column="0" Classes="ghost modal-cancel" Margin="0,0,10,0"
                    Command="{Binding ResolveImportCancelCommand}">
              <TextBlock Text="{loc:Tr Skills_Cancel_Button, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="1" Classes="pill" Margin="0,0,10,0" Command="{Binding ResolveImportRenameCommand}">
              <TextBlock Text="{loc:Tr Skills_ImportConflict_RenameButton, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary" Command="{Binding ResolveImportOverwriteCommand}">
              <TextBlock Text="{loc:Tr Skills_ImportConflict_OverwriteButton, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>
  </Grid>
</UserControl>
