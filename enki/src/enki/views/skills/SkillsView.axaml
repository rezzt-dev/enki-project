<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:views="clr-namespace:enki.Views"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             x:Class="enki.Views.SkillsView"
             x:DataType="vm:SkillsViewModel">

  <UserControl.Styles>
    <Style Selector="Button.export-hover:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Ink20}" />
    </Style>
    <Style Selector="Button.export-hover:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.export-hover:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.export-hover:pointerover mi|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid>

    <!-- ===================== Modo lista ===================== -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" IsVisible="{Binding ActiveEditor, Converter={x:Static conv:ObjectConverters.IsNull}}">

      <!-- Header de sección: eyebrow + título + subtítulo alineados a la izquierda. -->
      <StackPanel Grid.Row="0" Spacing="6" Margin="36,30,36,20">
        <TextBlock Text="{loc:Tr Skills_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
        <TextBlock Text="{loc:Tr Skills_Page_Title, Converter={StaticResource UpperCaseConverter}}" Classes="page-title" />
        <TextBlock Text="{loc:Tr Skills_Page_Subtitle}"
                   Classes="page-subtitle" />
        <TextBlock Text="{loc:Tr Skills_Page_StaticNotice}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>

      <!-- Toolbar: acciones principales a la izquierda, búsqueda + contador a la derecha. -->
      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="36,0,36,12">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <Button Classes="pill" Command="{Binding ImportSkillsCommand}"
                  ToolTip.Tip="{loc:Tr Skills_Import_Tooltip}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="TrayArrowDown" Width="15" Height="15" />
              <TextBlock Text="{loc:Tr Skills_Import_Button, Converter={StaticResource UpperCaseConverter}}" />
            </StackPanel>
          </Button>
          <Button Classes="pill" Command="{Binding ImportSkillsFolderCommand}"
                  ToolTip.Tip="{loc:Tr Skills_ImportFolder_Tooltip}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="FolderOutline" Width="15" Height="15" />
              <TextBlock Text="{loc:Tr Skills_ImportFolder_Button, Converter={StaticResource UpperCaseConverter}}" />
            </StackPanel>
          </Button>
          <Button Classes="pill" Command="{Binding ExportSkillsCommand}"
                  ToolTip.Tip="{loc:Tr Skills_Export_Tooltip}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="TrayArrowUp" Width="15" Height="15" />
              <TextBlock Text="{loc:Tr Skills_Export_Button, Converter={StaticResource UpperCaseConverter}}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <TextBox Grid.Column="2" Classes="search" Height="40" Width="220" Margin="0,0,10,0"
                  VerticalAlignment="Center" PlaceholderText="{loc:Tr Skills_Search_Placeholder}"
                  AutomationProperties.Name="{loc:Tr Skills_Search_Placeholder}"
                  IsVisible="{Binding IsSearchOpen}" Text="{Binding SearchText, Mode=TwoWay}">
          <TextBox.InnerLeftContent>
            <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"
                              Margin="10,0,0,0" />
          </TextBox.InnerLeftContent>
        </TextBox>

        <Button Grid.Column="3" Classes="icon-btn" Classes.active="{Binding IsSearchOpen}" Width="40" Height="40"
                Margin="0,0,10,0" Command="{Binding ToggleSearchCommand}" ToolTip.Tip="{loc:Tr Skills_Search_Tooltip}"
                AutomationProperties.Name="{loc:Tr Skills_Search_Tooltip}">
          <mi:MaterialIcon Kind="Magnify" Width="17" Height="17" />
        </Button>

        <Border Grid.Column="4" Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}"
                BorderThickness="1" Padding="20,11" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="{Binding SkillsCountLabel}" Classes="faint" FontSize="10.5" VerticalAlignment="Center" />
        </Border>
      </Grid>

      <!-- Filtro de etiquetas: misma pieza reutilizable que Notas/Kanban/Polar. Se colapsa sola
           (TagFilterView no pinta nada visible) cuando ninguna skill tiene etiquetas todavía. -->
      <views:TagFilterView Grid.Row="2" DataContext="{Binding TagFilter}" Margin="36,0,36,12" />

      <!-- Banner de comunidad: fila delgada integrada, sin tooltip flotante. -->
      <Button Grid.Row="3" Classes="card" Margin="36,0,36,18" Padding="18,16"
              Command="{Binding OpenCommunitySkillsCommand}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <mi:MaterialIcon Grid.Column="0" Kind="CompassOutline" Width="22" Height="22"
                           Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{loc:Tr Skills_Community_Title}" FontWeight="Bold" FontSize="12.5" LetterSpacing="0.3" />
            <TextBlock Text="{loc:Tr Skills_Community_Description}"
                       Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      Margin="16,0,0,0">
            <TextBlock Text="{Binding CommunitySkillsUrlDisplay}" Classes="faint" FontSize="11" VerticalAlignment="Center" />
            <mi:MaterialIcon Kind="OpenInNew" Width="13" Height="13" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Button>

      <!-- Grid principal: tarjetas + panel de detalle. -->
      <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="36,0,36,24">

        <!-- ===================== Rejilla de tarjetas ===================== -->
        <Border Grid.Column="0" x:Name="SkillsGridBorder" ClipToBounds="True" BorderBrush="{DynamicResource Ink10}" BorderThickness="1"
                Background="{DynamicResource AppBackgroundAltBrush}">
          <Panel>
            <ScrollViewer IsVisible="{Binding Skills.Count, Converter={StaticResource CountToBoolConverter}}" Padding="16">
              <ItemsControl x:Name="SkillsItemsControl" ItemsSource="{Binding Skills}" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="5" VerticalAlignment="Top" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:SkillViewModel">
                    <Button Classes="skill-card" Classes.active="{Binding IsSelected}" Height="210" Margin="8"
                            Command="{Binding $parent[ItemsControl].((vm:SkillsViewModel)DataContext).SelectSkillCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                      <Grid RowDefinitions="Auto,*,Auto">

                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                          <TextBlock Grid.Column="0" Text="{Binding Emoji}" FontSize="22" Margin="0,0,10,0"
                                     VerticalAlignment="Top" IsVisible="{Binding Emoji, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="14" LetterSpacing="0.1"
                                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" VerticalAlignment="Top" />
                          <Button Grid.Column="2" Classes="icon-btn" Width="26" Height="26" Margin="4,-4,-4,0"
                                  IsVisible="{Binding !IsDefault}"
                                  Command="{Binding ToggleExportCommand}" ToolTip.Tip="{loc:Tr Skills_Card_ToggleExport_Tooltip}"
                                  AutomationProperties.Name="{loc:Tr Skills_Card_ToggleExport_Tooltip}">
                            <Panel>
                              <mi:MaterialIcon Kind="CheckboxMarked" Width="16" Height="16" Foreground="{DynamicResource InkBrush}"
                                                IsVisible="{Binding IsCheckedForExport}" />
                              <mi:MaterialIcon Kind="CheckboxBlankOutline" Width="16" Height="16" Foreground="{DynamicResource Ink40}"
                                                IsVisible="{Binding !IsCheckedForExport}" />
                            </Panel>
                          </Button>
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="8">
                          <Border Background="{DynamicResource Ink10}" Padding="6,3" HorizontalAlignment="Left" IsVisible="{Binding IsDefault}">
                            <TextBlock Text="{loc:Tr Skills_Badge_Default, Converter={StaticResource UpperCaseConverter}}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9" FontWeight="Bold"
                                       LetterSpacing="1" Foreground="{DynamicResource TextSecondaryBrush}" />
                          </Border>
                          <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12"
                                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3"
                                     IsVisible="{Binding HasDescription}" />
                          <TextBlock Text="{loc:Tr Skills_NoDescription}" Classes="faint" FontStyle="Italic" FontSize="11.5"
                                     IsVisible="{Binding !HasDescription}" />

                          <ItemsControl ItemsSource="{Binding TagChips}" IsVisible="{Binding HasTags}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}"
                                        BorderThickness="1" Padding="6,2" Margin="0,0,5,5">
                                  <TextBlock Text="{Binding}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
                          <Button Grid.Column="1" Classes="icon-btn" Width="28" Height="28" Margin="0,0,4,0"
                                  Command="{Binding $parent[ItemsControl].((vm:SkillsViewModel)DataContext).EditSkillCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Common_Edit}"
                                  AutomationProperties.Name="{loc:Tr Common_Edit}">
                            <mi:MaterialIcon Kind="PencilOutline" Width="15" Height="15" />
                          </Button>
                          <Button Grid.Column="2" Classes="icon-btn" Width="28" Height="28" Margin="0,0,4,0"
                                  Command="{Binding $parent[ItemsControl].((vm:SkillsViewModel)DataContext).DuplicateSkillCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Skills_Duplicate_Tooltip}"
                                  AutomationProperties.Name="{loc:Tr Skills_Duplicate_Tooltip}">
                            <mi:MaterialIcon Kind="ContentCopy" Width="15" Height="15" />
                          </Button>
                          <Button Grid.Column="3" Classes="icon-btn icon-btn-danger" Width="28" Height="28"
                                  IsVisible="{Binding !IsDefault}"
                                  Command="{Binding $parent[ItemsControl].((vm:SkillsViewModel)DataContext).RequestDeleteSkillCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Common_Delete}"
                                  AutomationProperties.Name="{loc:Tr Common_Delete}">
                            <mi:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" />
                          </Button>
                        </Grid>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
              <Border Width="72" Height="72" Background="{DynamicResource Ink05}" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="Brain" Width="36" Height="36" Foreground="{DynamicResource Ink40}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{loc:Tr Skills_Empty_Title}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:Tr Skills_Empty_Description}"
                         Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
              <Button Classes="pill" Command="{Binding ImportSkillsCommand}" HorizontalAlignment="Center" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="TrayArrowDown" Width="15" Height="15" />
                  <TextBlock Text="{loc:Tr Skills_Empty_ImportButton, Converter={StaticResource UpperCaseConverter}}" />
                </StackPanel>
              </Button>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasNoSearchResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
              <Border Width="72" Height="72" Background="{DynamicResource Ink05}" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="Magnify" Width="36" Height="36" Foreground="{DynamicResource Ink40}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{loc:Tr Skills_NoResults_Title}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding NoSearchResultsMessage}"
                         Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
            </StackPanel>
          </Panel>
        </Border>

        <!-- ===================== Panel de detalle / inspector ===================== -->
        <Border Grid.Column="1" Width="460" Margin="18,0,0,0"
                IsVisible="{Binding SelectedSkill, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
          <Border Classes="card" Background="{DynamicResource AppBackgroundAltBrush}" Padding="24"
                  DataContext="{Binding SelectedSkill}" x:DataType="vm:SkillViewModel">
            <ScrollViewer>
              <StackPanel Spacing="20">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Emoji}" FontSize="26"
                               IsVisible="{Binding Emoji, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="17" TextWrapping="Wrap" />
                      <Border Background="{DynamicResource Ink10}" Padding="6,3" HorizontalAlignment="Left" IsVisible="{Binding IsDefault}">
                        <TextBlock Text="{loc:Tr Skills_Badge_DefaultReadOnly, Converter={StaticResource UpperCaseConverter}}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9"
                                   FontWeight="Bold" LetterSpacing="0.8" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </Border>
                    </StackPanel>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="icon-btn" Width="28" Height="28"
                          Command="{Binding $parent[UserControl].((vm:SkillsViewModel)DataContext).SelectSkillCommand}"
                          ToolTip.Tip="{loc:Tr Skills_Detail_Close_Tooltip}"
                          AutomationProperties.Name="{loc:Tr Skills_Detail_Close_Tooltip}">
                    <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
                  </Button>
                </Grid>

                <StackPanel Spacing="6">
                  <TextBlock Text="{loc:Tr Skills_Detail_Description_Label, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                             IsVisible="{Binding HasDescription}" />
                  <TextBlock Text="{loc:Tr Skills_NoDescription}" Classes="faint" FontStyle="Italic" FontSize="12"
                             IsVisible="{Binding !HasDescription}" />
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding Model.Vibe, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{loc:Tr Skills_Detail_Vibe_Label, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <TextBlock Text="{Binding Model.Vibe}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding Model.Tags.Count, Converter={StaticResource CountToBoolConverter}}">
                  <TextBlock Text="{loc:Tr Skills_Detail_Tags_Label, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <ItemsControl ItemsSource="{Binding Model.Tags}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}" BorderThickness="1"
                                Padding="8,4" Margin="0,0,6,6">
                          <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding Model.Tools.Count, Converter={StaticResource CountToBoolConverter}}">
                  <TextBlock Text="{loc:Tr Skills_Detail_Tools_Label, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <ItemsControl ItemsSource="{Binding Model.Tools}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}" BorderThickness="1"
                                Padding="8,4" Margin="0,0,6,6">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <mi:MaterialIcon Kind="WrenchOutline" Width="10" Height="10" Foreground="{DynamicResource Ink40}" />
                            <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding Model.Permissions.Count, Converter={StaticResource CountToBoolConverter}}">
                  <TextBlock Text="{loc:Tr Skills_Detail_Permissions_Label, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <ItemsControl ItemsSource="{Binding Model.Permissions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}" BorderThickness="1"
                                Padding="8,4" Margin="0,0,6,6">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <mi:MaterialIcon Kind="LockOutline" Width="10" Height="10" Foreground="{DynamicResource Ink40}" />
                            <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Tr Skills_Detail_Content_Label, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="icon-btn" Width="24" Height="24"
                            Command="{Binding $parent[UserControl].((vm:SkillsViewModel)DataContext).CopySkillContentCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Skills_Detail_CopyContent_Tooltip}"
                            AutomationProperties.Name="{loc:Tr Skills_Detail_CopyContent_Tooltip}">
                      <mi:MaterialIcon Kind="ContentCopy" Width="13" Height="13" />
                    </Button>
                  </Grid>
                  <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource Ink10}"
                          BorderThickness="1" Padding="14,12" MaxHeight="280">
                    <ScrollViewer>
                      <TextBlock Text="{Binding Model.Content}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                 TextWrapping="Wrap" LineHeight="18" />
                    </ScrollViewer>
                  </Border>
                </StackPanel>

                <Grid ColumnDefinitions="Auto,*">
                  <mi:MaterialIcon Grid.Column="0" Kind="FileOutline" Width="12" Height="12"
                                    Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" Margin="0,0,7,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Model.FilePath}" Classes="faint" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Model.FilePath}" />
                </Grid>

                <Rectangle Height="1" Fill="{DynamicResource Ink10}" />

                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,*,*">
                    <Button Grid.Column="0" Classes="pill" HorizontalAlignment="Stretch" Margin="0,0,6,0"
                            Command="{Binding $parent[UserControl].((vm:SkillsViewModel)DataContext).EditSkillCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="PencilOutline" Width="13" Height="13" />
                        <TextBlock Text="{loc:Tr Skills_Detail_EditButton, Converter={StaticResource UpperCaseConverter}}" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="pill" HorizontalAlignment="Stretch" Margin="0,0,6,0"
                            Command="{Binding $parent[UserControl].((vm:SkillsViewModel)DataContext).DuplicateSkillCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="ContentCopy" Width="13" Height="13" />
                        <TextBlock Text="{loc:Tr Skills_Detail_DuplicateButton, Converter={StaticResource UpperCaseConverter}}" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="pill export-hover" Classes.pill-primary="{Binding IsDefault}" HorizontalAlignment="Stretch"
                            Command="{Binding $parent[UserControl].((vm:SkillsViewModel)DataContext).ExportSkillsCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="TrayArrowUp" Width="13" Height="13" />
                        <TextBlock Text="{loc:Tr Skills_Export_Button, Converter={StaticResource UpperCaseConverter}}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <Button Classes="pill-primary-danger" HorizontalAlignment="Stretch" IsVisible="{Binding !IsDefault}"
                          Command="{Binding $parent[UserControl].((vm:SkillsViewModel)DataContext).RequestDeleteSkillCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                      <mi:MaterialIcon Kind="TrashCanOutline" Width="13" Height="13" />
                      <TextBlock Text="{loc:Tr Skills_Detail_DeleteButton, Converter={StaticResource UpperCaseConverter}}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Border>
      </Grid>

      <!-- ===================== Modal: confirmar eliminación ===================== -->
      <Border Grid.Row="0" Grid.RowSpan="5" Classes="modal-overlay"
              IsVisible="{Binding PendingDeleteSkill, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
        <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
                DataContext="{Binding PendingDeleteSkill}" x:DataType="vm:SkillViewModel">
          <StackPanel Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
              <TextBlock Text="{loc:Tr Skills_DeleteModal_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Tr Skills_DeleteModal_Message}" FontSize="14" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Name}" Classes="muted" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto,Auto">
              <Button Grid.Column="1" Classes="ghost modal-cancel" Margin="0,0,18,0"
                      Command="{Binding $parent[UserControl].((vm:SkillsViewModel)DataContext).CancelDeleteSkillCommand}">
                <TextBlock Text="{loc:Tr Skills_Cancel_Button, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
              <Button Grid.Column="2" Classes="pill-primary-danger"
                      Command="{Binding $parent[UserControl].((vm:SkillsViewModel)DataContext).ConfirmDeleteSkillCommand}">
                <TextBlock Text="{loc:Tr Skills_Detail_DeleteButton, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>    </Border>

      <!-- ===================== Modal: pedir nombre (duplicar / copiar default) ===================== -->
      <Border Grid.Row="0" Grid.RowSpan="5" Classes="modal-overlay"
              IsVisible="{Binding NamePrompt, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
        <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
                DataContext="{Binding NamePrompt}" x:DataType="vm:SkillNamePromptViewModel">
          <StackPanel Spacing="16">
            <TextBlock Text="{Binding Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
            <TextBox Classes="search" Text="{Binding InputText, Mode=TwoWay}" Name="NamePromptTextBox"
                     AutomationProperties.Name="{Binding Title}"
                     KeyDown="NamePromptTextBox_KeyDown" Initialized="NamePromptTextBox_Initialized" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="11.5"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <Button Grid.Column="1" Classes="ghost modal-cancel" Margin="0,0,18,0"
                      Command="{Binding $parent[UserControl].((vm:SkillsViewModel)DataContext).CancelNamePromptCommand}">
                <TextBlock Text="{loc:Tr Skills_Cancel_Button, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
              <Button Grid.Column="2" Classes="pill-primary"
                      Command="{Binding $parent[UserControl].((vm:SkillsViewModel)DataContext).ConfirmNamePromptCommand}">
                <TextBlock Text="{Binding ConfirmLabel, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>    </Border>

      <!-- ===================== Modal: colisión de importación ===================== -->
      <Border Grid.Row="0" Grid.RowSpan="5" Classes="modal-overlay" IsVisible="{Binding HasImportConflicts}">
        <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource Ink40}" />
              <TextBlock Text="{loc:Tr Skills_ImportConflict_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{loc:Tr Skills_ImportConflict_Message}"
                       FontSize="13.5" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding ImportConflictFileNames}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Classes="muted" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Right">
              <Button Grid.Column="0" Classes="ghost modal-cancel" Margin="0,0,10,0"
                      Command="{Binding ResolveImportCancelCommand}">
                <TextBlock Text="{loc:Tr Skills_Cancel_Button, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
              <Button Grid.Column="1" Classes="pill" Margin="0,0,10,0" Command="{Binding ResolveImportRenameCommand}">
                <TextBlock Text="{loc:Tr Skills_ImportConflict_RenameButton, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
              <Button Grid.Column="2" Classes="pill-primary" Command="{Binding ResolveImportOverwriteCommand}">
                <TextBlock Text="{loc:Tr Skills_ImportConflict_OverwriteButton, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>    </Border>

    </Grid>

    <!-- ===================== Modo editor ===================== -->
    <Grid RowDefinitions="Auto,*" IsVisible="{Binding ActiveEditor, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="36,26,36,18">
        <Button Grid.Column="0" Classes="icon-btn" Command="{Binding CloseEditorCommand}"
                ToolTip.Tip="{loc:Tr Skills_Editor_BackTooltip}" AutomationProperties.Name="{loc:Tr Skills_Editor_BackTooltip}" Margin="0,0,14,0">
          <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding ActiveEditor.Title}" FontSize="20" FontWeight="Bold"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <mi:MaterialIcon Width="13" Height="13" Kind="CheckCircleOutline" Classes="severity-icon success"
                            IsVisible="{Binding !ActiveEditor.IsDirty}" />
          <mi:MaterialIcon Width="13" Height="13" Kind="CircleMedium" Classes="severity-icon warning"
                            IsVisible="{Binding ActiveEditor.IsDirty}" />
          <TextBlock Text="{Binding ActiveEditor.SaveStatus, Converter={StaticResource UpperCaseConverter}}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Classes="card" Margin="36,0,36,26" Padding="4">
        <views:SkillEditorView DataContext="{Binding ActiveEditor}" />
      </Border>
    </Grid>

  </Grid>
</UserControl>
