<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:views="clr-namespace:enki.Views"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="760"
             x:Class="enki.Views.SkillDetailView"
             x:Name="DetailRoot"
             x:DataType="vm:SkillsViewModel">

  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundAltBrush}">
    <Border BorderBrush="{DynamicResource Ink10}" BorderThickness="1,1,1,0" Padding="24">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="8" Margin="0,0,16,0">
          <TextBlock Text="{Binding SelectedSkill.Emoji}" FontSize="22" IsVisible="{Binding SelectedSkill.Emoji, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding SelectedSkill.Name}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedSkill.Description}" Classes="muted" TextWrapping="Wrap" FontSize="14" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding SelectedSkill.RelativeFolderPath}" Classes="muted" IsVisible="{Binding SelectedSkill.HasFolder}" />
            <TextBlock Text="{loc:Tr Skills_Detail_Location_Root}" Classes="muted" IsVisible="{Binding !SelectedSkill.HasFolder}" />
            <TextBlock Text="{loc:Tr Skills_Badge_DefaultReadOnly}" Classes="muted" IsVisible="{Binding SelectedSkill.IsDefault}" />
            <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding SelectedSkill.IsPackage}"
                        ToolTip.Tip="{loc:Tr Skills_Badge_Package_Tooltip}">
              <mi:MaterialIcon Kind="PackageVariantClosed" Width="13" Height="13" Foreground="{DynamicResource Ink40}" />
              <TextBlock Text="{loc:Tr Skills_Badge_Package}" Classes="muted" />
            </StackPanel>
          </StackPanel>
          <!-- Asistentes del sistema que ya tienen una copia de la skill (addon de instalación). -->
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSelectedSkillInstallSummary}">
            <mi:MaterialIcon Kind="CheckCircleOutline" Width="13" Height="13" Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Tr SkillInstall_InstalledIn}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SelectedSkillInstallSummary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <!-- Archivos auxiliares de un paquete: lo que se instala junto a SKILL.md. -->
          <StackPanel IsVisible="{Binding SelectedSkill.IsPackage}">
            <ToggleButton x:Name="PackageFilesToggle" Classes="tag-chip toolbar-chip"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Center" IsChecked="False"
                          AutomationProperties.Name="{loc:Tr Skills_PackageFiles}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{loc:Tr Skills_PackageFiles, Converter={StaticResource UpperCaseConverter}}" VerticalAlignment="Center" />
                <mi:MaterialIcon Grid.Column="1" Width="16" Height="16" Margin="12,0,0,0"
                                 Kind="{Binding #PackageFilesToggle.IsChecked, Converter={StaticResource ExpandChevronConverter}}" />
              </Grid>
            </ToggleButton>
            <Border IsVisible="{Binding #PackageFilesToggle.IsChecked}"
                    BorderBrush="{DynamicResource Ink10}" BorderThickness="1,0,1,1"
                    Background="{DynamicResource AppBackgroundAltBrush}" Padding="16" CornerRadius="0">
              <StackPanel Spacing="8">
                <TextBlock Text="{loc:Tr Skills_PackageFiles_Empty}" Classes="faint" FontSize="11.5" TextWrapping="Wrap"
                           IsVisible="{Binding !HasSelectedPackageFiles}" />
                <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasSelectedPackageFiles}">
                  <ItemsControl ItemsSource="{Binding SelectedPackageFiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                          <mi:MaterialIcon Kind="FileOutline" Width="11" Height="11" Foreground="{DynamicResource Ink40}" />
                          <TextBlock Text="{Binding}" FontSize="11" FontFamily="{DynamicResource InterfaceLabelFontFamily}"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Button Classes="pill" HorizontalAlignment="Left" Command="{Binding OpenSkillLocationCommand}" CommandParameter="{Binding SelectedSkill}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="FolderOpenOutline" Width="13" Height="13" />
                    <TextBlock Text="{loc:Tr Skills_OpenPackageFolder, Converter={StaticResource UpperCaseConverter}}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="MetadataSection" IsVisible="{Binding SelectedSkill.HasMetadata}">
            <ToggleButton x:Name="MetadataToggle" Classes="tag-chip toolbar-chip"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Center" IsChecked="False"
                          AutomationProperties.Name="{loc:Tr Skills_Metadata}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{loc:Tr Skills_Metadata, Converter={StaticResource UpperCaseConverter}}" VerticalAlignment="Center" />
                <mi:MaterialIcon Grid.Column="1" Width="16" Height="16" Margin="12,0,0,0"
                                 Kind="{Binding #MetadataToggle.IsChecked, Converter={StaticResource ExpandChevronConverter}}" />
              </Grid>
            </ToggleButton>
            <Border x:Name="MetadataContent" IsVisible="{Binding #MetadataToggle.IsChecked}"
                    BorderBrush="{DynamicResource Ink10}" BorderThickness="1,0,1,1"
                    Background="{DynamicResource AppBackgroundAltBrush}" Padding="16" CornerRadius="0">
            <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
              <StackPanel DataContext="{Binding SelectedSkill}" x:DataType="vm:SkillViewModel" Spacing="12">
        <StackPanel Spacing="6" IsVisible="{Binding Model.Vibe, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{loc:Tr Skills_Detail_Vibe_Label, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
          <TextBlock Text="{Binding Model.Vibe}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding Model.Tags.Count, Converter={StaticResource CountToBoolConverter}}">
          <TextBlock Text="{loc:Tr Skills_Detail_Tags_Label, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
          <ItemsControl ItemsSource="{Binding Model.Tags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}" BorderThickness="1"
                        Padding="8,4" Margin="0,0,6,6">
                  <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding Model.Tools.Count, Converter={StaticResource CountToBoolConverter}}">
          <TextBlock Text="{loc:Tr Skills_Detail_Tools_Label, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
          <ItemsControl ItemsSource="{Binding Model.Tools}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}" BorderThickness="1"
                        Padding="8,4" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <mi:MaterialIcon Kind="WrenchOutline" Width="10" Height="10" Foreground="{DynamicResource Ink40}" />
                    <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding Model.Permissions.Count, Converter={StaticResource CountToBoolConverter}}">
          <TextBlock Text="{loc:Tr Skills_Detail_Permissions_Label, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
          <ItemsControl ItemsSource="{Binding Model.Permissions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}" BorderThickness="1"
                        Padding="8,4" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <mi:MaterialIcon Kind="LockOutline" Width="10" Height="10" Foreground="{DynamicResource Ink40}" />
                    <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

              </StackPanel>
            </ScrollViewer>
            </Border>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Classes="icon-btn" VerticalAlignment="Top" Command="{Binding SelectSkillCommand}"
                ToolTip.Tip="{loc:Tr Skills_Detail_Close_Tooltip}" AutomationProperties.Name="{loc:Tr Skills_Detail_Close_Tooltip}">
          <mi:MaterialIcon Kind="Close" Width="18" Height="18" />
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="1" BorderBrush="{DynamicResource Ink10}" BorderThickness="1" Padding="0">
      <views:SkillEditorView x:Name="DetailEditor" PreviewText="{Binding #DetailRoot.((vm:SkillsViewModel)DataContext).SelectedSkill.Model.Content}" DataContext="{x:Null}" IsReadOnly="True" />
    </Border>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Ink10}" BorderThickness="1,0,1,1" Padding="24,16">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding SelectedSkill.FilePath}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedSkill.FilePath}" />
        <Grid ColumnDefinitions="*,Auto">
          <WrapPanel Orientation="Horizontal" Margin="0,0,16,0">
            <Button Classes="pill-primary" Command="{Binding EditSkillCommand}" CommandParameter="{Binding SelectedSkill}" Margin="0,0,8,0" VerticalAlignment="Center" Content="{loc:Tr Skills_Detail_EditButton, Converter={StaticResource UpperCaseConverter}}" />
            <Button Classes="pill" Command="{Binding UseWithAssistantCommand}" CommandParameter="{Binding SelectedSkill}" Margin="0,0,8,0" VerticalAlignment="Center"
                    IsVisible="{Binding IsAssistantAvailable}" ToolTip.Tip="{loc:Tr Skills_Detail_UseWithAssistant_Tooltip}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="Creation" Width="13" Height="13" />
                <TextBlock Text="{loc:Tr Skills_Detail_UseWithAssistant, Converter={StaticResource UpperCaseConverter}}" />
              </StackPanel>
            </Button>
            <Button Classes="pill" Command="{Binding OpenInstallDialogCommand}" CommandParameter="{Binding SelectedSkill}" Margin="0,0,8,0" VerticalAlignment="Center"
                    IsVisible="{Binding IsSystemInstallAvailable}" ToolTip.Tip="{loc:Tr SkillInstall_Button_Tooltip}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="DownloadOutline" Width="13" Height="13" />
                <TextBlock Text="{loc:Tr SkillInstall_Button, Converter={StaticResource UpperCaseConverter}}" />
              </StackPanel>
            </Button>
            <Button Classes="pill" Command="{Binding DuplicateSkillCommand}" CommandParameter="{Binding SelectedSkill}" Margin="0,0,8,0" VerticalAlignment="Center" Content="{loc:Tr Skills_Detail_DuplicateButton, Converter={StaticResource UpperCaseConverter}}" />
            <Button Classes="pill" Command="{Binding ConvertToPackageCommand}" CommandParameter="{Binding SelectedSkill}" Margin="0,0,8,0" VerticalAlignment="Center"
                    IsVisible="{Binding SelectedSkill.CanConvertToPackage}" ToolTip.Tip="{loc:Tr Skills_ConvertToPackage_Tooltip}"
                    Content="{loc:Tr Skills_ConvertToPackage, Converter={StaticResource UpperCaseConverter}}" />
            <Button Classes="pill" Command="{Binding ExportSkillsCommand}" Margin="0,0,8,0" VerticalAlignment="Center" Content="{loc:Tr Skills_Export_Button, Converter={StaticResource UpperCaseConverter}}" />
            <Button Classes="icon-btn" Width="40" Height="40" Command="{Binding CopySkillContentCommand}" CommandParameter="{Binding SelectedSkill}" Margin="0,0,8,0" VerticalAlignment="Center"
                    ToolTip.Tip="{loc:Tr Skills_Detail_CopyContent_Tooltip}" AutomationProperties.Name="{loc:Tr Skills_Detail_CopyContent_Tooltip}">
              <mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
            </Button>
            <Button Classes="icon-btn" Width="40" Height="40" Command="{Binding OpenSkillLocationCommand}" CommandParameter="{Binding SelectedSkill}" Margin="0,0,8,0" VerticalAlignment="Center"
                    ToolTip.Tip="{loc:Tr Skills_OpenLocation_Tooltip}" AutomationProperties.Name="{loc:Tr Skills_OpenLocation_Tooltip}">
              <mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
            </Button>
            <Button Classes="icon-btn icon-btn-danger" Width="40" Height="40" VerticalAlignment="Center" Command="{Binding RequestDeleteSkillCommand}" CommandParameter="{Binding SelectedSkill}" IsVisible="{Binding !SelectedSkill.IsDefault}"
                    ToolTip.Tip="{loc:Tr Skills_Detail_DeleteButton}" AutomationProperties.Name="{loc:Tr Skills_Detail_DeleteButton}">
              <mi:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
            </Button>
          </WrapPanel>
          <ToggleButton x:Name="DetailSourceToggle" Grid.Column="1" Classes="tag-chip toolbar-chip" Height="40"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        IsChecked="{Binding IsSourceMode, ElementName=DetailEditor, Mode=TwoWay}"
                        Content="{loc:Tr Skills_Source, Converter={StaticResource UpperCaseConverter}}" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
