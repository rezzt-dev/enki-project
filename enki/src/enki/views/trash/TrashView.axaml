<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="clr-namespace:enki.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="enki.Views.TrashView"
             x:Name="Root"
             x:DataType="vm:TrashViewModel"
             Focusable="True" Loaded="TrashView_Loaded">

  <!-- Atajo propio de la página (Fase 7 de docs/analisis-proyecto/roadmap.md): abre el diálogo de
       confirmación de "vaciar papelera" — nunca purga directamente, mismo flujo que el botón.
       RequestEmptyTrash no hace nada si la papelera está vacía (guarda IsFullyEmpty). Remapeable
       (propuesta 29, docs/propuesta-nuevas-funcionalidades.md) — ver TrashView.axaml.cs (BuildKeyBindings). -->

  <Grid RowDefinitions="Auto,*" Margin="36,30,36,26">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,22">
      <StackPanel Grid.Column="0" Spacing="6">
        <TextBlock Text="{loc:Tr Trash_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
        <TextBlock Text="{loc:Tr Trash_PageTitle, Converter={StaticResource UpperCaseConverter}}" Classes="page-title" />
        <TextBlock Text="{loc:Tr Trash_PageSubtitle}"
                   Classes="page-subtitle" />
      </StackPanel>

      <Button Grid.Column="1" Classes="pill" VerticalAlignment="Center"
              IsEnabled="{Binding !IsFullyEmpty}"
              Command="{Binding RequestEmptyTrashCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <mi:MaterialIcon Kind="DeleteSweepOutline" Width="15" Height="15" />
          <TextBlock Text="{loc:Tr Trash_EmptyAllButton, Converter={StaticResource UpperCaseConverter}}" />
        </StackPanel>
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="32">

        <!-- ===================== Documentos ===================== -->
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{loc:Tr Trash_Documents_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="pill" Padding="10,5" IsEnabled="{Binding !IsEmpty}"
                    Command="{Binding RequestEmptyDocumentsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="DeleteSweepOutline" Width="12" Height="12" />
                <TextBlock Text="{loc:Tr Trash_EmptyButton, Converter={StaticResource UpperCaseConverter}}" FontSize="10" />
              </StackPanel>
            </Button>
          </Grid>

          <ItemsControl ItemsSource="{Binding Notes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:NoteCardViewModel">
                <Border Classes="card" Margin="0,0,16,16" Width="224" Height="150" Padding="16">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Ink40}" />
                      <TextBlock Text="{Binding ModifiedLabel}" Classes="faint" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="5" Margin="0,10,0,0">
                      <TextBlock Text="{Binding Title}"
                                 FontWeight="Bold" FontSize="14" LetterSpacing="0.3"
                                 TextTrimming="CharacterEllipsis" MaxLines="1" />
                      <TextBlock Text="{Binding Preview}" Classes="muted" FontSize="12"
                                 TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                      <Button Classes="icon-btn"
                              Command="{Binding $parent[ItemsControl].((vm:TrashViewModel)DataContext).RestoreCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Trash_RestoreTooltip}"
                              AutomationProperties.Name="{loc:Tr Trash_RestoreTooltip}">
                        <mi:MaterialIcon Kind="Restore" Width="15" Height="15" />
                      </Button>
                      <Button Classes="icon-btn icon-btn-danger"
                              Command="{Binding $parent[ItemsControl].((vm:TrashViewModel)DataContext).RequestDeleteForeverCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Trash_DeleteForeverTooltip}"
                              AutomationProperties.Name="{loc:Tr Trash_DeleteForeverTooltip}">
                        <mi:MaterialIcon Kind="DeleteForeverOutline" Width="15" Height="15" />
                      </Button>
                    </StackPanel>
                  </Grid>
            </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding IsEmpty}" Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="NoteTextOutline" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{loc:Tr Trash_Documents_Empty}" Classes="muted" FontSize="12.5" />
          </StackPanel>
        </StackPanel>

        <!-- ===================== Archivos ===================== -->
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{loc:Tr Trash_Files_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="pill" Padding="10,5" IsEnabled="{Binding !IsFilesEmpty}"
                    Command="{Binding RequestEmptyFilesCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="DeleteSweepOutline" Width="12" Height="12" />
                <TextBlock Text="{loc:Tr Trash_EmptyButton, Converter={StaticResource UpperCaseConverter}}" FontSize="10" />
              </StackPanel>
            </Button>
          </Grid>

          <ItemsControl ItemsSource="{Binding Files}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:FileCardViewModel">
                <Border Classes="card" Margin="0,0,16,16" Width="224" Height="150" Padding="16">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Ink40}" />
                      <TextBlock Text="{Binding ModifiedLabel}" Classes="faint" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0" VerticalAlignment="Center">
                      <mi:MaterialIcon Kind="{Binding IconKind}" Width="24" Height="24" Foreground="{DynamicResource Ink40}" />
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13.5"
                                   TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SizeLabel}" Classes="muted" FontSize="12" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                      <Button Classes="icon-btn"
                              Command="{Binding $parent[ItemsControl].((vm:TrashViewModel)DataContext).RestoreFileCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Trash_RestoreTooltip}"
                              AutomationProperties.Name="{loc:Tr Trash_RestoreTooltip}">
                        <mi:MaterialIcon Kind="Restore" Width="15" Height="15" />
                      </Button>
                      <Button Classes="icon-btn icon-btn-danger"
                              Command="{Binding $parent[ItemsControl].((vm:TrashViewModel)DataContext).RequestDeleteFileForeverCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Trash_DeleteForeverTooltip}"
                              AutomationProperties.Name="{loc:Tr Trash_DeleteForeverTooltip}">
                        <mi:MaterialIcon Kind="DeleteForeverOutline" Width="15" Height="15" />
                      </Button>
                    </StackPanel>
                  </Grid>
            </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding IsFilesEmpty}" Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="FileOutline" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{loc:Tr Trash_Files_Empty}" Classes="muted" FontSize="12.5" />
          </StackPanel>
        </StackPanel>

        <!-- ===================== Tareas ===================== -->
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{loc:Tr Trash_Tasks_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="pill" Padding="10,5" IsEnabled="{Binding !IsTasksEmpty}"
                    Command="{Binding RequestEmptyTasksCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="DeleteSweepOutline" Width="12" Height="12" />
                <TextBlock Text="{loc:Tr Trash_EmptyButton, Converter={StaticResource UpperCaseConverter}}" FontSize="10" />
              </StackPanel>
            </Button>
          </Grid>

          <ItemsControl ItemsSource="{Binding Tasks}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:TrashedTaskCardViewModel">
                <Border Classes="card" Margin="0,0,16,16" Width="224" Height="120" Padding="16">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Ink40}" />
                      <TextBlock Text="{Binding DeletedLabel}" Classes="faint" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="5" Margin="0,10,0,0">
                      <TextBlock Text="{Binding Title}"
                                 FontWeight="Bold" FontSize="14" LetterSpacing="0.3"
                                 TextTrimming="CharacterEllipsis" MaxLines="1" />
                      <TextBlock Text="{Binding WasInColumnLabel}" Classes="muted" FontSize="12"
                                 TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                      <Button Classes="icon-btn"
                              Command="{Binding $parent[ItemsControl].((vm:TrashViewModel)DataContext).RestoreTaskCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Trash_RestoreTooltip}"
                              AutomationProperties.Name="{loc:Tr Trash_RestoreTooltip}">
                        <mi:MaterialIcon Kind="Restore" Width="15" Height="15" />
                      </Button>
                      <Button Classes="icon-btn icon-btn-danger"
                              Command="{Binding $parent[ItemsControl].((vm:TrashViewModel)DataContext).RequestDeleteTaskForeverCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Trash_DeleteForeverTooltip}"
                              AutomationProperties.Name="{loc:Tr Trash_DeleteForeverTooltip}">
                        <mi:MaterialIcon Kind="DeleteForeverOutline" Width="15" Height="15" />
                      </Button>
                    </StackPanel>
                  </Grid>
            </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding IsTasksEmpty}" Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="ViewColumnOutline" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{loc:Tr Trash_Tasks_Empty}" Classes="muted" FontSize="12.5" />
          </StackPanel>
        </StackPanel>

        <!-- ===================== Tareas Polar (análisis alfa-3 §4.3) ===================== -->
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{loc:Tr Trash_PolarTasks_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="pill" Padding="10,5" IsEnabled="{Binding !IsPolarTasksEmpty}"
                    Command="{Binding RequestEmptyPolarTasksCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="DeleteSweepOutline" Width="12" Height="12" />
                <TextBlock Text="{loc:Tr Trash_EmptyButton, Converter={StaticResource UpperCaseConverter}}" FontSize="10" />
              </StackPanel>
            </Button>
          </Grid>

          <ItemsControl ItemsSource="{Binding PolarLists}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:TrashedPolarListCardViewModel">
                <Border Classes="card" Margin="0,0,16,16" Width="224" Height="100" Padding="16">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                      <mi:MaterialIcon Kind="FormatListBulletedSquare" Width="13" Height="13" Foreground="{DynamicResource Ink40}" />
                      <TextBlock Text="{Binding DeletedLabel}" Classes="faint" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Title}"
                               FontWeight="Bold" FontSize="14" LetterSpacing="0.3" Margin="0,10,0,0"
                               TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                      <Button Classes="icon-btn"
                              Command="{Binding $parent[ItemsControl].((vm:TrashViewModel)DataContext).RestorePolarListCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Trash_RestoreTooltip}"
                              AutomationProperties.Name="{loc:Tr Trash_RestoreTooltip}">
                        <mi:MaterialIcon Kind="Restore" Width="15" Height="15" />
                      </Button>
                      <Button Classes="icon-btn icon-btn-danger"
                              Command="{Binding $parent[ItemsControl].((vm:TrashViewModel)DataContext).RequestDeletePolarListForeverCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Trash_DeleteForeverTooltip}"
                              AutomationProperties.Name="{loc:Tr Trash_DeleteForeverTooltip}">
                        <mi:MaterialIcon Kind="DeleteForeverOutline" Width="15" Height="15" />
                      </Button>
                    </StackPanel>
                  </Grid>
            </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding PolarTasks}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:TrashedPolarTaskCardViewModel">
                <Border Classes="card" Margin="0,0,16,16" Width="224" Height="100" Padding="16">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                      <mi:MaterialIcon Kind="CheckboxMarkedOutline" Width="13" Height="13" Foreground="{DynamicResource Ink40}" />
                      <TextBlock Text="{Binding DeletedLabel}" Classes="faint" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Title}"
                               FontWeight="Bold" FontSize="14" LetterSpacing="0.3" Margin="0,10,0,0"
                               TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                      <Button Classes="icon-btn"
                              Command="{Binding $parent[ItemsControl].((vm:TrashViewModel)DataContext).RestorePolarTaskCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Trash_RestoreTooltip}"
                              AutomationProperties.Name="{loc:Tr Trash_RestoreTooltip}">
                        <mi:MaterialIcon Kind="Restore" Width="15" Height="15" />
                      </Button>
                      <Button Classes="icon-btn icon-btn-danger"
                              Command="{Binding $parent[ItemsControl].((vm:TrashViewModel)DataContext).RequestDeletePolarTaskForeverCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Trash_DeleteForeverTooltip}"
                              AutomationProperties.Name="{loc:Tr Trash_DeleteForeverTooltip}">
                        <mi:MaterialIcon Kind="DeleteForeverOutline" Width="15" Height="15" />
                      </Button>
                    </StackPanel>
                  </Grid>
            </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding IsPolarTasksEmpty}" Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="CloudOffOutline" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{loc:Tr Trash_PolarTasks_Empty}" Classes="muted" FontSize="12.5" />
          </StackPanel>

          <StackPanel IsVisible="{Binding !IsPolarTasksEmpty}" Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="InformationOutline" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{loc:Tr Trash_PolarTasks_NoPurgeHint}" Classes="faint" FontSize="11.5"
                       TextWrapping="Wrap" MaxWidth="460" />
          </StackPanel>
        </StackPanel>

        <!-- ===================== Recordatorios ===================== -->
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{loc:Tr Trash_Reminders_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="pill" Padding="10,5" IsEnabled="{Binding !IsRemindersEmpty}"
                    Command="{Binding RequestEmptyRemindersCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="DeleteSweepOutline" Width="12" Height="12" />
                <TextBlock Text="{loc:Tr Trash_EmptyButton, Converter={StaticResource UpperCaseConverter}}" FontSize="10" />
              </StackPanel>
            </Button>
          </Grid>

          <ItemsControl ItemsSource="{Binding Reminders}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:TrashedReminderCardViewModel">
                <Border Classes="card" Margin="0,0,16,16" Width="224" Height="100" Padding="16">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Ink40}" />
                      <TextBlock Text="{Binding DeletedLabel}" Classes="faint" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Title}"
                               FontWeight="Bold" FontSize="14" LetterSpacing="0.3" Margin="0,10,0,0"
                               TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                      <Button Classes="icon-btn"
                              Command="{Binding $parent[ItemsControl].((vm:TrashViewModel)DataContext).RestoreReminderCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Trash_RestoreTooltip}"
                              AutomationProperties.Name="{loc:Tr Trash_RestoreTooltip}">
                        <mi:MaterialIcon Kind="Restore" Width="15" Height="15" />
                      </Button>
                    </StackPanel>
                  </Grid>
            </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding IsRemindersEmpty}" Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="BellRingOutline" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{loc:Tr Trash_Reminders_Empty}" Classes="muted" FontSize="12.5" />
          </StackPanel>

          <!-- análisis alfa-3 §4.3, Baja: sin esta pista, la ausencia del botón "borrar para siempre" que
               sí tienen el resto de categorías se puede leer como un bug en vez de una decisión deliberada
               (ver el comentario en TrashViewModel.RestoreReminder). -->
          <StackPanel IsVisible="{Binding !IsRemindersEmpty}" Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="InformationOutline" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{loc:Tr Trash_Reminders_NoDeleteForeverHint}" Classes="faint" FontSize="11.5"
                       TextWrapping="Wrap" MaxWidth="460" />
          </StackPanel>
        </StackPanel>

        <!-- ===================== Sesiones ===================== -->
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{loc:Tr Trash_Sessions_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="pill" Padding="10,5" IsEnabled="{Binding !IsSessionsEmpty}"
                    Command="{Binding RequestEmptySessionsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="DeleteSweepOutline" Width="12" Height="12" />
                <TextBlock Text="{loc:Tr Trash_EmptyButton, Converter={StaticResource UpperCaseConverter}}" FontSize="10" />
              </StackPanel>
            </Button>
          </Grid>

          <ItemsControl ItemsSource="{Binding Sessions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:TrashedSessionCardViewModel">
                <Border Classes="card" Margin="0,0,16,16" Width="224" Height="100" Padding="16">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Ink40}" />
                      <TextBlock Text="{Binding NoteCountLabel}" Classes="faint" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Name}"
                               FontWeight="Bold" FontSize="14" LetterSpacing="0.3" Margin="0,10,0,0"
                               TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                      <Button Classes="icon-btn"
                              Command="{Binding $parent[ItemsControl].((vm:TrashViewModel)DataContext).RestoreSessionCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Trash_RestoreTooltip}"
                              AutomationProperties.Name="{loc:Tr Trash_RestoreTooltip}">
                        <mi:MaterialIcon Kind="Restore" Width="15" Height="15" />
                      </Button>
                      <Button Classes="icon-btn icon-btn-danger"
                              Command="{Binding $parent[ItemsControl].((vm:TrashViewModel)DataContext).RequestDeleteSessionForeverCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Trash_DeleteForeverTooltip}"
                              AutomationProperties.Name="{loc:Tr Trash_DeleteForeverTooltip}">
                        <mi:MaterialIcon Kind="DeleteForeverOutline" Width="15" Height="15" />
                      </Button>
                    </StackPanel>
                  </Grid>
            </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel IsVisible="{Binding IsSessionsEmpty}" Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="SitemapOutline" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{loc:Tr Trash_Sessions_Empty}" Classes="muted" FontSize="12.5" />
          </StackPanel>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- ===================== Diálogo: vaciar documentos/tareas/papelera ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding PendingEmptyTarget, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{Binding PendingEmptyTitle, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{Binding PendingEmptyMessage}" FontSize="14" TextWrapping="Wrap" MaxWidth="320" />

          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Command="{Binding CancelEmptyCommand}" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary-danger" Command="{Binding ConfirmEmptyCommand}">
              <TextBlock Text="{loc:Tr Trash_EmptyButton, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
    </Border>
  </controls:ModalOverlayHost>

    <!-- ===================== Diálogo: borrado permanente individual (Fase 3, docs/analisis-proyecto/roadmap.md) =====================
         Misma estructura que el de vaciado; el mensaje (con el título del elemento interpolado) viene
         calculado del viewmodel porque el orden de palabras no es fijo entre idiomas. -->
    <controls:ModalOverlayHost IsOpen="{Binding PendingPermanentDelete, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{loc:Tr Trash_DeleteForeverModal_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{Binding PendingPermanentDeleteMessage}" FontSize="14" TextWrapping="Wrap" MaxWidth="320" />

          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Command="{Binding CancelPermanentDeleteCommand}" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary-danger" Command="{Binding ConfirmPermanentDeleteCommand}">
              <TextBlock Text="{loc:Tr Trash_DeleteForeverButton, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
    </Border>
  </controls:ModalOverlayHost>
  </Grid>
</UserControl>
