<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:controls="clr-namespace:enki.Controls"
             xmlns:baseconv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="760"
             x:Class="enki.Views.NotificationsView"
             x:DataType="vm:NotificationsViewModel">

  <Grid>

   <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="36,30,36,26" MaxWidth="1180" HorizontalAlignment="Stretch">

    <Grid Grid.Row="0" Margin="0,0,0,24">
      <StackPanel Grid.Column="0" Spacing="6">
        <TextBlock Text="{loc:Tr Notifications_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
        <TextBlock Text="{loc:Tr Notifications_Title, Converter={StaticResource UpperCaseConverter}}" Classes="page-title" />
        <TextBlock Text="{loc:Tr Notifications_Subtitle}"
                   Classes="page-subtitle" TextWrapping="Wrap" />
      </StackPanel>

    </Grid>

    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
        <Button Classes="pill" Margin="0,0,8,8" Padding="14,10" IsEnabled="{Binding UnreadCount, Converter={StaticResource CountToBoolConverter}}" Command="{Binding MarkAllReadCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="CheckAll" Width="14" Height="14" />
            <TextBlock Text="{loc:Tr Notifications_MarkAllReadButton, Converter={StaticResource UpperCaseConverter}}" />
          </StackPanel>
        </Button>
        <Button Classes="pill" Margin="0,0,8,8" Padding="14,10" IsEnabled="{Binding !IsEmpty}" Command="{Binding RequestClearAllCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="DeleteSweepOutline" Width="14" Height="14" />
            <TextBlock Text="{loc:Tr Notifications_ClearAllButton, Converter={StaticResource UpperCaseConverter}}" />
          </StackPanel>
        </Button>
    </WrapPanel>
    <StackPanel Grid.Row="2" Spacing="14" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" Classes="search" Text="{Binding SearchText}"
                 PlaceholderText="{loc:Tr Activity_Search}" MinHeight="40"
                 AutomationProperties.Name="{loc:Tr Activity_Search}" />
        <TextBlock Grid.Column="1" Text="{Binding ResultsLabel}" Classes="faint"
                   Margin="16,0,0,0" VerticalAlignment="Center" />
      </Grid>
      <WrapPanel Orientation="Horizontal">
        <RadioButton Classes="segment" GroupName="NotificationsFilter" Margin="0,0,8,6"
                     Content="{loc:Tr Activity_All, Converter={StaticResource UpperCaseConverter}}"
                     IsChecked="{Binding Filter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=All, Mode=OneWay}"
                     Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static vm:ActivityFilter.All}" />
        <RadioButton Classes="segment" GroupName="NotificationsFilter" Margin="0,0,8,6"
                     Content="{loc:Tr Activity_Unread, Converter={StaticResource UpperCaseConverter}}"
                     IsChecked="{Binding Filter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Unread, Mode=OneWay}"
                     Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static vm:ActivityFilter.Unread}" />
      </WrapPanel>
    </StackPanel>

    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10">

        <StackPanel IsVisible="{Binding IsEmpty}" Spacing="10" Margin="0,60,0,0" HorizontalAlignment="Center">
          <mi:MaterialIcon Kind="BellRingOutline" Width="40" Height="40" Foreground="{DynamicResource TextMutedBrush}"
                            HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Tr Notifications_EmptyState}" Classes="muted" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel IsVisible="{Binding HasNoResults}" Spacing="12" Margin="24,48" HorizontalAlignment="Center">
          <mi:MaterialIcon Kind="Magnify" Width="32" Height="32" Foreground="{DynamicResource Ink40}" HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Tr Activity_NoResults}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Tr Activity_NoResultsHint}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
          <Button Classes="pill" Command="{Binding ResetFiltersCommand}" HorizontalAlignment="Center">
            <TextBlock Text="{loc:Tr Activity_Reset, Converter={StaticResource UpperCaseConverter}}" />
          </Button>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding VisibleItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="0" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:NotificationItemViewModel">
              <Button Classes="note-card activity-row" Classes.unread="{Binding !IsRead}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Command="{Binding $parent[ItemsControl].((vm:NotificationsViewModel)DataContext).OpenDetailCommand}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding Title}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <mi:MaterialIcon Grid.Column="0" Kind="{Binding SeverityIcon}" Width="18" Height="18"
                                    Margin="0,0,14,0" VerticalAlignment="Center" Classes="severity-icon"
                                    Classes.success="{Binding Severity, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Success}"
                                    Classes.warning="{Binding Severity, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Warning}"
                                    Classes.error="{Binding Severity, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Error}" />

                  <StackPanel Grid.Column="1" Spacing="6" Margin="0,0,20,0">
                    <Grid ColumnDefinitions="Auto,*">
                      <Ellipse Grid.Column="0" Margin="0,0,8,0" Width="6" Height="6" Fill="{DynamicResource Ink90}" IsVisible="{Binding !IsRead}" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" FontSize="14" LetterSpacing="0.2"
                                 TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </Grid>
                    <TextBlock Text="{Binding Message}" Classes="muted" FontSize="12"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                               IsVisible="{Binding HasMessage}" />
                  </StackPanel>

                  <TextBlock Grid.Column="2" Text="{Binding TimeLabel}" ToolTip.Tip="{Binding CreatedAtLabel}" Classes="faint"
                             HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

   </Grid>

    <!-- ===================== Diálogo: detalle de notificación ===================== -->
    <controls:ModalOverlayHost
        IsOpen="{Binding Detail, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="520" MaxWidth="560" MaxHeight="640" DataContext="{Binding Detail}" x:DataType="vm:NotificationItemViewModel">
        <Grid RowDefinitions="*,Auto" RowSpacing="20">
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">

              <StackPanel Orientation="Horizontal" Spacing="10">
                <mi:MaterialIcon Kind="{Binding SeverityIcon}" Width="18" Height="18" Classes="severity-icon"
                                  Classes.success="{Binding Severity, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Success}"
                                  Classes.warning="{Binding Severity, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Warning}"
                                  Classes.error="{Binding Severity, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Error}" />
                <TextBlock Text="{Binding SeverityLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" LetterSpacing="-0.3" TextWrapping="Wrap" />

              <StackPanel Spacing="6" IsVisible="{Binding HasMessage}">
                <TextBlock Text="{loc:Tr Notifications_Detail_DetailLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <TextBlock Text="{Binding Message}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="{loc:Tr Notifications_Detail_ReceivedLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <TextBlock Text="{Binding CreatedAtLabel}" Classes="muted" FontSize="12" />
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <Button Grid.Column="1" Classes="pill"
                    Command="{Binding $parent[UserControl].((vm:NotificationsViewModel)DataContext).CloseDetailCommand}">
              <TextBlock Text="{loc:Tr Common_Close, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </Grid>
      </Border>
    </controls:ModalOverlayHost>

    <!-- ===================== Diálogo: limpiar notificaciones ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding PendingClearAll}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <Grid ColumnDefinitions="Auto,*">
            <mi:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="18" Height="18" Margin="0,1,10,0" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Grid.Column="1" Text="{loc:Tr Notifications_ClearAllModal_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow"
                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" LineHeight="16" />
          </Grid>

          <TextBlock Text="{loc:Tr Notifications_ClearAllModal_Message}" FontSize="14"
                     TextWrapping="Wrap" MaxWidth="320" />

          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Command="{Binding CancelClearAllCommand}" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary-danger" Command="{Binding ConfirmClearAllCommand}">
              <TextBlock Text="{loc:Tr Notifications_ClearAllButton, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>

  </Grid>
</UserControl>
