<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="820"
             x:Class="enki.Views.StatisticsView"
             x:DataType="vm:StatisticsViewModel">

  <ScrollViewer>
    <StackPanel Margin="36,30,36,30" Spacing="26" MaxWidth="1180" HorizontalAlignment="Stretch">

      <!-- Header -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock Text="{loc:Tr Statistics_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
          <TextBlock Text="{loc:Tr Statistics_Title, Converter={StaticResource UpperCaseConverter}}" Classes="page-title" />
          <TextBlock Text="{loc:Tr Statistics_Subtitle}" Classes="page-subtitle" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <RadioButton Classes="segment" GroupName="StatisticsRange" Content="{loc:Tr Statistics_Range_Week, Converter={StaticResource UpperCaseConverter}}"
                       IsChecked="{Binding Range, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Week, Mode=OneWay}"
                       Command="{Binding SelectRangeCommand}" CommandParameter="Week" />
          <RadioButton Classes="segment" GroupName="StatisticsRange" Content="{loc:Tr Statistics_Range_Month, Converter={StaticResource UpperCaseConverter}}"
                       IsChecked="{Binding Range, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Month, Mode=OneWay}"
                       Command="{Binding SelectRangeCommand}" CommandParameter="Month" />
          <RadioButton Classes="segment" GroupName="StatisticsRange" Content="{loc:Tr Statistics_Range_AllTime, Converter={StaticResource UpperCaseConverter}}"
                       IsChecked="{Binding Range, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=AllTime, Mode=OneWay}"
                       Command="{Binding SelectRangeCommand}" CommandParameter="AllTime" />
        </StackPanel>
      </Grid>

      <!-- Estado vacío: vault demasiado nuevo/silencioso para que un gráfico diga algo útil todavía. -->
      <StackPanel IsVisible="{Binding !HasEnoughData}" Spacing="14" Margin="0,60,0,0" HorizontalAlignment="Center">
        <mi:MaterialIcon Kind="ChartBoxOutline" Width="28" Height="28" Foreground="{DynamicResource TextMutedBrush}"
                          HorizontalAlignment="Center" />
        <TextBlock Text="{loc:Tr Statistics_EmptyState}" Classes="muted" FontSize="12.5" HorizontalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center" />
      </StackPanel>

      <StackPanel Spacing="26" IsVisible="{Binding HasEnoughData}">

        <!-- Tiles resumen: última semana de la serie actual. -->
        <Border BorderBrush="{DynamicResource Ink10}" BorderThickness="1">
          <Grid ColumnDefinitions="*,1,*,1,*" Background="{DynamicResource Ink10}">
            <Border Grid.Column="0" Classes="stat-card">
              <StackPanel Spacing="8">
                <TextBlock Text="{loc:Tr Statistics_Tile_Notes, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <TextBlock Text="{Binding NotesThisWeek}" FontSize="26" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="stat-card">
              <StackPanel Spacing="8">
                <TextBlock Text="{loc:Tr Statistics_Tile_TasksCompleted, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <TextBlock Text="{Binding TasksCompletedThisWeek}" FontSize="26" FontWeight="Bold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Classes="stat-card">
              <StackPanel Spacing="8">
                <TextBlock Text="{loc:Tr Statistics_Tile_HabitConsistency, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <TextBlock Text="{loc:Tr Statistics_Tile_NoHabits}" Classes="muted" FontSize="13" IsVisible="{Binding !HasHabitData}" />
                <TextBlock Text="{Binding HabitCompletionPercent, StringFormat={}{0:0}%}" FontSize="26" FontWeight="Bold" IsVisible="{Binding HasHabitData}" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Notas y tareas por semana: barras nativas (Border con Height calculada en el ViewModel), sin
             ninguna librería de gráficos — mismo enfoque que la barra apilada de "TAREAS DEL TABLERO" en
             el Dashboard. -->
        <StackPanel Spacing="16">
          <TextBlock Text="{loc:Tr Statistics_Chart_ActivityTitle, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
          <Border Classes="card" Padding="22">
            <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="18">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Border Width="9" Height="9" Background="{DynamicResource InkBrush}" />
                  <TextBlock Text="{loc:Tr Statistics_Chart_NotesLegend}" Classes="faint" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Border Width="9" Height="9" Background="{DynamicResource Ink30}" />
                  <TextBlock Text="{loc:Tr Statistics_Chart_TasksLegend}" Classes="faint" />
                </StackPanel>
              </StackPanel>

              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Weeks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="14" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:WeekBarViewModel">
                      <StackPanel Spacing="8" Width="34" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom" Height="120">
                          <Border Width="14" Height="{Binding NotesBarHeight}" Background="{DynamicResource InkBrush}" VerticalAlignment="Bottom"
                                  ToolTip.Tip="{Binding NotesTotal}" />
                          <Border Width="14" Height="{Binding TasksBarHeight}" Background="{DynamicResource Ink30}" VerticalAlignment="Bottom"
                                  ToolTip.Tip="{Binding TasksCompleted}" />
                        </StackPanel>
                        <TextBlock Text="{Binding WeekLabel}" Classes="faint" FontSize="9" HorizontalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Constancia de hábitos por semana — mismo lenguaje monocromo, oculto por completo si no hay
             hábitos activos (ninguna semana trae HabitCompletionPercent). -->
        <StackPanel Spacing="16" IsVisible="{Binding HasHabitData}">
          <TextBlock Text="{loc:Tr Statistics_Chart_HabitsTitle, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
          <Border Classes="card" Padding="22">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Weeks}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="14" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:WeekBarViewModel">
                    <StackPanel Spacing="8" Width="34" VerticalAlignment="Bottom">
                      <Border Height="120" Width="20" Background="{DynamicResource Ink05}" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                        <Border Height="{Binding HabitBarHeight}" Background="{DynamicResource InkBrush}" VerticalAlignment="Bottom" />
                      </Border>
                      <TextBlock Text="{Binding WeekLabel}" Classes="faint" FontSize="9" HorizontalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>

        <!-- Aviso Polar: solo se explica por qué las tareas de Polar no cuentan cuando el usuario no ha
             vinculado cuenta — cero fricción para quien no lo usa, mismo principio que el Dashboard. -->
        <TextBlock Text="{loc:Tr Statistics_PolarNotLinkedNotice}" Classes="faint" TextWrapping="Wrap"
                   IsVisible="{Binding !IsPolarLinked}" />

      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
