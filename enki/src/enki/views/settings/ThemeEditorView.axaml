<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="enki.Views.ThemeEditorView"
             x:DataType="vm:ThemeEditorViewModel">

  <Grid RowDefinitions="Auto,*">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="{loc:Tr Settings_Appearance_Theme_EditorTitle, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
        <TextBox Text="{Binding ThemeName}" PlaceholderText="{loc:Tr Settings_Appearance_Theme_EditorNamePlaceholder}" Classes="search" MaxWidth="320" HorizontalAlignment="Left" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="ghost" Command="{Binding ResetToDefaultsCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="Refresh" Width="13" Height="13" />
            <TextBlock Text="{loc:Tr Settings_Appearance_Theme_ResetButton, Converter={StaticResource UpperCaseConverter}}" />
          </StackPanel>
        </Button>
        <Button Classes="ghost" Command="{Binding DuplicateCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="ContentDuplicate" Width="13" Height="13" />
            <TextBlock Text="{loc:Tr Settings_Appearance_Theme_DuplicateButton, Converter={StaticResource UpperCaseConverter}}" />
          </StackPanel>
        </Button>
        <Button Classes="ghost" Command="{Binding ExportCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="FileExportOutline" Width="13" Height="13" />
            <TextBlock Text="{loc:Tr Settings_Appearance_Theme_ExportButton, Converter={StaticResource UpperCaseConverter}}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Color grid -->
    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="22" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:ThemeColorGroupViewModel">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding Category}" Classes="eyebrow" FontSize="11" />
              <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemWidth="180" ItemHeight="86" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ThemeColorSlotViewModel">
                    <Border Classes="card" Padding="12" Margin="0,0,10,10">
                      <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="{Binding DisplayName}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Bottom">
                          <Border Grid.Column="0" Width="34" Height="34"
                                  Background="{Binding Hex, Converter={StaticResource HexColorToBrushConverter}}"
                                  BorderBrush="{DynamicResource Ink20}" BorderThickness="1" Margin="0,0,8,0" />
                          <ColorPicker Grid.Column="1" Color="{Binding Color, Mode=TwoWay}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                          <TextBox Grid.Column="2" Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   VerticalAlignment="Center" Classes="search" />
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </Grid>
</UserControl>
