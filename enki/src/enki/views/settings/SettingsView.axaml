<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="clr-namespace:enki.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:baseconv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="enki.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <!-- Ajustes › Dashboard, fila de sección reordenable: fondo/borde viven aquí (no inline en el
         Border) para que :pointerover/.drag-over/.hidden abajo puedan pisarlos — un valor puesto
         directamente en el elemento siempre gana sobre cualquier trigger de estilo en Avalonia. -->
    <Style Selector="Border.dashboard-section-row">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ink10}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.dashboard-section-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource Ink05}" />
    </Style>
    <Style Selector="Border.dashboard-section-row.drag-over">
      <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    </Style>
    <!-- Sección desactivada: se atenúa en vez de desaparecer de la lista, para que siga siendo
         arrastrable/reordenable mientras está oculta del Dashboard real. -->
    <Style Selector="Border.dashboard-section-row.hidden">
      <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!-- Ajustes › Dashboard › Organización: la tarjeta de plantilla elegida se distingue con el mismo
         borde InkBrush que el resto de la app usa para "seleccionado" (folder-row.active,
         editor-tab.active) — reutiliza Button.card entero (borde/hover/elevación al pasar el ratón) en
         vez de definir una tarjeta nueva desde cero. -->
    <Style Selector="Button.card.active /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    </Style>

    <!-- Bloques del diagrama en miniatura de cada plantilla: los anchos (accesos rápidos, tareas del
         tablero, notas recientes) se pintan un tono más oscuro que los compactos, para que el propio
         diagrama distinga a simple vista qué huecos son "grandes" sin necesitar leyenda. -->
    <Style Selector="Border.layout-block">
      <Setter Property="Background" Value="{DynamicResource Ink10}" />
    </Style>
    <Style Selector="Border.layout-block.wide">
      <Setter Property="Background" Value="{DynamicResource Ink30}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="220,*">

    <!-- ===================== Section nav ===================== -->
    <Border Grid.Column="0" BorderBrush="{DynamicResource Ink10}" BorderThickness="0,0,1,0">
      <StackPanel Spacing="24" Margin="18,30,14,30">
        <StackPanel Spacing="6" Margin="4,0,0,0">
          <TextBlock Text="{loc:Tr Settings_Nav_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
          <TextBlock Text="{loc:Tr Settings_Nav_Title, Converter={StaticResource UpperCaseConverter}}" Classes="page-title" FontSize="26" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Sections}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:SettingsSectionViewModel">
              <Button Classes="nav-item"
                      Classes.active="{Binding IsActive}"
                      Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SelectSectionCommand}"
                      CommandParameter="{Binding Section}">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Label, Converter={StaticResource UpperCaseConverter}}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
  </Border>

    <!-- ===================== Section content ===================== -->
    <!-- Margin en el contenido en vez de Padding en el ScrollViewer (mismo motivo que en
         DashboardView: Avalonia 12 resta el padding del extent scrolleable, dejando los últimos 60px
         de la sección fuera de alcance). -->
    <ScrollViewer Grid.Column="1">
      <!-- Panel en vez de que el StackPanel de abajo envuelva también Ajustes › Dashboard: esa sección
           necesita más ancho que el resto (lista + vista previa lado a lado, § más abajo) y el
           MaxWidth="640" de comodidad de lectura del resto del formulario se lo impediría si compartiera
           el mismo contenedor. Ambos StackPanel son hijos directos de este Panel y se muestran en
           exclusión mutua vía SelectedSection, así que se superponen sin conflicto: el oculto no mide ni
           ocupa espacio (mismo principio que QuickAccessColumns en el Dashboard real). -->
      <Panel Margin="36,30,36,30">
      <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">

        <!-- ===================== General ===================== -->
        <StackPanel Spacing="20" IsVisible="{Binding SelectedSection, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=General}">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Settings_General_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{loc:Tr Settings_General_Description}" Classes="muted" FontSize="12.5" />
          </StackPanel>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="FolderOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_General_VaultFolder_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Text="{loc:Tr Settings_General_VaultFolder_Description}"
                         Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
              <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource Ink10}"
                      BorderThickness="1" Padding="12,10">
                <TextBlock Text="{Binding VaultPath}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
         </Border>
              <Button Classes="pill" Command="{Binding ChangeVaultFolderCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="FolderMoveOutline" Width="14" Height="14" />
                  <TextBlock Text="{loc:Tr Settings_General_VaultFolder_ChangeButton, Converter={StaticResource UpperCaseConverter}}" />
                </StackPanel>
              </Button>
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="TranslateVariant" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_General_Language_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Text="{loc:Tr Settings_General_Language_Description}"
                         Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}" AutomationProperties.Name="{loc:Tr Settings_General_Language_Title}"
                        HorizontalAlignment="Stretch" MaxDropDownHeight="320">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="loc:SupportedLanguageInfo">
                    <TextBlock Text="{Binding NativeName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="HomeVariantOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_General_Startup_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Text="{loc:Tr Settings_General_Startup_Description}"
                         Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
              <WrapPanel>
                <RadioButton Classes="segment" GroupName="StartupPage" Content="{loc:Tr Settings_General_Startup_Dashboard, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,8,8"
                             IsChecked="{Binding StartupPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Dashboard, Mode=OneWay}"
                             Command="{Binding SetStartupPageCommand}" CommandParameter="{x:Static vm:AppPage.Dashboard}" />
                <RadioButton Classes="segment" GroupName="StartupPage" Content="{loc:Tr Settings_General_Startup_Calendar, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,8,8"
                             IsChecked="{Binding StartupPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Calendar, Mode=OneWay}"
                             Command="{Binding SetStartupPageCommand}" CommandParameter="{x:Static vm:AppPage.Calendar}" />
                <RadioButton Classes="segment" GroupName="StartupPage" Content="{loc:Tr Settings_General_Startup_Kanban, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,8,8"
                             IsChecked="{Binding StartupPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Kanban, Mode=OneWay}"
                             Command="{Binding SetStartupPageCommand}" CommandParameter="{x:Static vm:AppPage.Kanban}" />
                <RadioButton Classes="segment" GroupName="StartupPage" Content="{loc:Tr Settings_General_Startup_Notes, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,8,8"
                             IsChecked="{Binding StartupPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Notes, Mode=OneWay}"
                             Command="{Binding SetStartupPageCommand}" CommandParameter="{x:Static vm:AppPage.Notes}" />
                <RadioButton Classes="segment" GroupName="StartupPage" Content="{loc:Tr Settings_General_Startup_Files, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,8,8"
                             IsChecked="{Binding StartupPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Files, Mode=OneWay}"
                             Command="{Binding SetStartupPageCommand}" CommandParameter="{x:Static vm:AppPage.Files}" />
                <RadioButton Classes="segment" GroupName="StartupPage" Content="{loc:Tr Settings_General_Startup_Sessions, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,8,8"
                             IsChecked="{Binding StartupPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Sessions, Mode=OneWay}"
                             Command="{Binding SetStartupPageCommand}" CommandParameter="{x:Static vm:AppPage.Sessions}" />
              </WrapPanel>
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="ViewDashboardOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_General_Dashboard_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_General_Dashboard_ShowScrollbar_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_General_Dashboard_ShowScrollbar_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DashboardShowScrollbar}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_General_Dashboard_ShowScrollbar_Label}" />
              </Grid>
            </StackPanel>
     </Border>

          <!-- ===================== Secciones de la barra lateral ===================== -->
          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="PageLayoutSidebarLeft" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_General_Sidebar_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Text="{loc:Tr Settings_General_Sidebar_Description}"
                         Classes="muted" FontSize="12.5" TextWrapping="Wrap" />

              <!-- Primer grupo -->
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="ViewDashboardOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Nav_Dashboard}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DashboardPanelEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Nav_Dashboard}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="CalendarBlankOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Nav_Calendar}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CalendarPanelEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Nav_Calendar}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="ViewColumnOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Nav_Kanban}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding KanbanPanelEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Nav_Kanban}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="NoteTextOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Nav_Documents}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotesPanelEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Nav_Documents}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="FileImageOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Nav_Files}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding FilesPanelEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Nav_Files}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="SitemapOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Nav_Sessions}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding SessionsPanelEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Nav_Sessions}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="ClipboardCheckOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Nav_Habits}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding HabitsPanelEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Nav_Habits}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Nav_Trash}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding TrashPanelEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Nav_Trash}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="Brain" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Nav_Skills}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding SkillsPanelEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Nav_Skills}" />
              </Grid>

              <!-- Segundo grupo -->
              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,8" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="CalendarClockOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Nav_RemindersLabel}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding RemindersSidebarEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Nav_RemindersLabel}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="BellRingOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Nav_NotificationsLabel}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationsSidebarEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Nav_NotificationsLabel}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="ChartBoxOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Nav_Statistics}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding StatisticsPanelEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Nav_Statistics}" />
              </Grid>
            </StackPanel>
     </Border>

          <!-- ===================== Diagnóstico (Fase 0, docs/analisis-proyecto/analisis-deficiencias-proyecto.md §2) ===================== -->
          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="BugReport" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_General_Diagnostics_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_General_Diagnostics_DebugLogging_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_General_Diagnostics_DebugLogging_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DebugLoggingEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_General_Diagnostics_DebugLogging_Label}" />
              </Grid>

              <Button Classes="pill" Command="{Binding OpenLogsFolderCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" />
                  <TextBlock Text="{loc:Tr Settings_General_Diagnostics_OpenLogsFolderButton, Converter={StaticResource UpperCaseConverter}}" />
                </StackPanel>
              </Button>
            </StackPanel>
     </Border>

          <!-- ===================== Zona de peligro (docs/ajustes-docs/01-continuidad-y-proteccion-de-datos.md) ===================== -->
          <Border Classes="card" Padding="22" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="AlertCircleOutline" Width="15" Height="15" Foreground="{DynamicResource DangerBrush}" />
                <TextBlock Text="{loc:Tr Settings_General_DangerZone_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" Foreground="{DynamicResource DangerBrush}" />
              </StackPanel>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_General_DangerZone_VaultSize_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_General_DangerZone_VaultSize_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding VaultSizeLabel}" Classes="faint" VerticalAlignment="Center" />
              </Grid>

              <Button Classes="pill" Command="{Binding OpenVaultFolderCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" />
                  <TextBlock Text="{loc:Tr Settings_General_DangerZone_OpenVaultFolderButton, Converter={StaticResource UpperCaseConverter}}" />
                </StackPanel>
              </Button>

              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />

              <TextBlock Text="{loc:Tr Settings_General_DangerZone_BackupHint}"
                         Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
              <Button Classes="pill" Command="{Binding CreateBackupCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="ArchiveArrowDownOutline" Width="14" Height="14" />
                  <TextBlock Text="{loc:Tr Settings_General_DangerZone_CreateBackupButton, Converter={StaticResource UpperCaseConverter}}" />
                </StackPanel>
              </Button>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_General_DangerZone_AutoBackup_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_General_DangerZone_AutoBackup_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoBackupEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_General_DangerZone_AutoBackup_Label}" />
              </Grid>

              <!-- Intervalo y retención (Fase 10, docs/analisis-proyecto/roadmap.md): antes fijos en su
                   valor por defecto para todo el mundo, solo el interruptor de arriba tenía control real. -->
              <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding AutoBackupEnabled}" Margin="0,-4,0,0">
                <TextBlock Grid.Column="0" Text="{loc:Tr Settings_General_DangerZone_AutoBackup_IntervalLabel}" FontSize="12.5" Classes="muted" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Value="{Binding AutoBackupIntervalDays}" Minimum="1" Maximum="30" Increment="1"
                               Width="110" ShowButtonSpinner="True" AutomationProperties.Name="{loc:Tr Settings_General_DangerZone_AutoBackup_IntervalLabel}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding AutoBackupEnabled}">
                <TextBlock Grid.Column="0" Text="{loc:Tr Settings_General_DangerZone_AutoBackup_RetentionLabel}" FontSize="12.5" Classes="muted" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Value="{Binding AutoBackupRetentionCount}" Minimum="1" Maximum="30" Increment="1"
                               Width="110" ShowButtonSpinner="True" AutomationProperties.Name="{loc:Tr Settings_General_DangerZone_AutoBackup_RetentionLabel}" />
              </Grid>

              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_General_DangerZone_ConfirmBeforeDelete_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_General_DangerZone_ConfirmBeforeDelete_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConfirmBeforeDelete}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_General_DangerZone_ConfirmBeforeDelete_Label}" />
              </Grid>

              <TextBlock Classes="muted" FontSize="11.5" TextWrapping="Wrap"
                         Text="{loc:Tr Settings_General_DangerZone_TrashRetention_Description}" />

              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />

              <TextBlock Text="{loc:Tr Settings_General_DangerZone_ExportHint}"
                         Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="pill" Command="{Binding ExportSettingsCommand}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="FileExportOutline" Width="14" Height="14" />
                    <TextBlock Text="{loc:Tr Settings_General_DangerZone_ExportSettingsButton, Converter={StaticResource UpperCaseConverter}}" />
                  </StackPanel>
                </Button>
                <Button Classes="pill" Command="{Binding ImportSettingsCommand}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="FileImportOutline" Width="14" Height="14" />
                    <TextBlock Text="{loc:Tr Settings_General_DangerZone_ImportSettingsButton, Converter={StaticResource UpperCaseConverter}}" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />

              <Button Classes="pill-primary-danger" Command="{Binding RequestResetSettingsCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="RestoreAlert" Width="14" Height="14" />
                  <TextBlock Text="{loc:Tr Settings_General_DangerZone_ResetSettingsButton, Converter={StaticResource UpperCaseConverter}}" />
                </StackPanel>
              </Button>
            </StackPanel>
     </Border>

        </StackPanel>

        <!-- ===================== Apariencia ===================== -->
        <StackPanel Spacing="20" IsVisible="{Binding SelectedSection, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Appearance}">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Settings_Appearance_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{loc:Tr Settings_Appearance_Description}" Classes="muted" FontSize="12.5" />
          </StackPanel>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="ThemeLightDark" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Appearance_Theme_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Appearance_Theme_DarkLabel}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Appearance_Theme_Description}" Classes="muted" FontSize="11.5" />
                  <TextBlock Text="{loc:Tr Settings_Appearance_CustomTheme_ActiveHint}" Classes="muted" FontSize="11" FontStyle="Italic"
                             TextWrapping="Wrap" IsVisible="{Binding IsCustomThemeActive}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkTheme}" IsEnabled="{Binding !IsCustomThemeActive}"
                              OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_Appearance_Theme_DarkLabel}" />
              </Grid>
            </StackPanel>
     </Border>

          <!-- ===== Temas personalizados ===== -->
          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="PaletteOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Appearance_CustomTheme_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Text="{loc:Tr Settings_Appearance_CustomTheme_Description}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />

              <Panel IsVisible="{Binding !IsEditingTheme}">
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Classes="ghost" HorizontalAlignment="Stretch" Command="{Binding CreateThemeCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="Plus" Width="13" Height="13" />
                        <TextBlock Text="{loc:Tr Settings_Appearance_Theme_NewThemeButton, Converter={StaticResource UpperCaseConverter}}" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" Command="{Binding ImportCustomThemeCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="FileImportOutline" Width="13" Height="13" />
                        <TextBlock Text="{loc:Tr Settings_Appearance_CustomTheme_ImportButton, Converter={StaticResource UpperCaseConverter}}" />
                      </StackPanel>
                    </Button>
                  </Grid>

                  <TextBlock Text="{loc:Tr Settings_Appearance_CustomTheme_Empty}" Classes="muted" FontSize="12"
                             TextWrapping="Wrap" IsVisible="{Binding !HasCustomThemes}" />

                  <ItemsControl ItemsSource="{Binding CustomThemes}" IsVisible="{Binding HasCustomThemes}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:CustomThemeRowViewModel">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                          <Border Grid.Column="1" Background="{DynamicResource ActivePillBackgroundBrush}" Padding="8,3"
                                  VerticalAlignment="Center" Margin="6,0" IsVisible="{Binding IsActive}">
                            <TextBlock Text="{loc:Tr Settings_Appearance_CustomTheme_ActiveLabel, Converter={StaticResource UpperCaseConverter}}"
                                       FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ActivePillForegroundBrush}" />
                     </Border>
                          <Button Grid.Column="1" Classes="ghost" Padding="8,3" VerticalAlignment="Center" Margin="6,0" IsVisible="{Binding !IsActive}"
                                  Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ActivateCustomThemeCommand}"
                                  CommandParameter="{Binding}">
                            <TextBlock Text="{loc:Tr Settings_Appearance_CustomTheme_ActivateButton, Converter={StaticResource UpperCaseConverter}}" FontSize="10.5" />
                          </Button>

                          <Button Grid.Column="2" Classes="icon-btn" Width="26" Height="26"
                                  Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DuplicateThemeCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="{loc:Tr Settings_Appearance_CustomTheme_DuplicateButton}"
                                  AutomationProperties.Name="{loc:Tr Settings_Appearance_CustomTheme_DuplicateButton}">
                            <mi:MaterialIcon Kind="ContentDuplicate" Width="13" Height="13" />
                          </Button>

                          <Button Grid.Column="3" Classes="icon-btn" Width="26" Height="26"
                                  Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).EditThemeCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="{loc:Tr Settings_Appearance_CustomTheme_EditButton}"
                                  AutomationProperties.Name="{loc:Tr Settings_Appearance_CustomTheme_EditButton}">
                            <mi:MaterialIcon Kind="PencilOutline" Width="13" Height="13" />
                          </Button>

                          <Button Grid.Column="4" Classes="icon-btn" Width="26" Height="26"
                                  Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteCustomThemeCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="{loc:Tr Settings_Appearance_CustomTheme_DeleteButton}"
                                  AutomationProperties.Name="{loc:Tr Settings_Appearance_CustomTheme_DeleteButton}">
                            <mi:MaterialIcon Kind="TrashCanOutline" Width="13" Height="13" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button Classes="ghost" Padding="0,4" HorizontalAlignment="Left" IsVisible="{Binding IsCustomThemeActive}" Command="{Binding UseSystemThemeCommand}">
                    <TextBlock Text="{loc:Tr Settings_Appearance_CustomTheme_UseSystemThemeButton, Converter={StaticResource UpperCaseConverter}}" />
                  </Button>
                </StackPanel>
              </Panel>

              <Panel IsVisible="{Binding IsEditingTheme}">
                <Grid RowDefinitions="Auto,*">
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding ThemeEditor.CancelCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="ArrowLeft" Width="13" Height="13" />
                        <TextBlock Text="{loc:Tr Settings_Appearance_Theme_BackButton, Converter={StaticResource UpperCaseConverter}}" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="ghost" Command="{Binding ThemeEditor.SaveCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="ContentSaveOutline" Width="13" Height="13" />
                        <TextBlock Text="{loc:Tr Settings_Appearance_Theme_SaveButton, Converter={StaticResource UpperCaseConverter}}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <ContentControl Grid.Row="1" Content="{Binding ThemeEditor}" />
                </Grid>
              </Panel>
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="FormatFont" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Appearance_InterfaceFont_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Text="{loc:Tr Settings_Appearance_InterfaceFont_Description}"
                         Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding InterfaceFontFamily}" AutomationProperties.Name="{loc:Tr Settings_Appearance_InterfaceFont_Title}"
                        HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="MagnifyPlusOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Appearance_Zoom_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Text="{loc:Tr Settings_Appearance_Zoom_Description}"
                         Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Appearance_Zoom_LevelLabel}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding UiZoomPercentLabel}"
                           Classes="faint" VerticalAlignment="Center" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Grid.Column="0" Classes="icon-btn" Width="26" Height="26"
                        Command="{Binding ZoomOutCommand}" ToolTip.Tip="{loc:Tr Settings_Appearance_Zoom_OutTooltip}"
                        AutomationProperties.Name="{loc:Tr Settings_Appearance_Zoom_OutTooltip}">
                  <mi:MaterialIcon Kind="MagnifyMinusOutline" Width="15" Height="15" />
                </Button>
                <!-- Barra de solo lectura: visualiza el nivel de zoom actual dentro del rango 50%-200%,
                     ocupando el ancho completo disponible, y un marcador fijo en el 100% (valor por
                     defecto). Sin thumb arrastrable a propósito — el ajuste se hace con los botones -/+,
                     no arrastrando la barra. El relleno usa columnas "Star" (proporción, no píxeles) para
                     que se adapte a cualquier ancho de tarjeta/ventana. -->
                <Grid Grid.Column="1" Height="6" VerticalAlignment="Center">
                  <Border Background="{DynamicResource Ink10}" CornerRadius="0" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{Binding UiZoomBarFillStar}" />
                      <ColumnDefinition Width="{Binding UiZoomBarRemainderStar}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource Ink50}" CornerRadius="0" />
                  </Grid>
                  <!-- Marcador del 100%: rango fijo 50%-200%, así que su posición (a 1/3 desde la
                       izquierda) es una proporción constante, no depende del zoom actual. -->
                  <Grid ColumnDefinitions="1*,2*">
                    <Border Grid.Column="0" Width="2" Height="10" HorizontalAlignment="Right"
                            Background="{DynamicResource Ink70}" ToolTip.Tip="{loc:Tr Settings_Appearance_Zoom_DefaultMarkerTooltip}" />
                  </Grid>
                </Grid>
                <Button Grid.Column="2" Classes="icon-btn" Width="26" Height="26"
                        Command="{Binding ZoomInCommand}" ToolTip.Tip="{loc:Tr Settings_Appearance_Zoom_InTooltip}"
                        AutomationProperties.Name="{loc:Tr Settings_Appearance_Zoom_InTooltip}">
                  <mi:MaterialIcon Kind="MagnifyPlusOutline" Width="15" Height="15" />
                </Button>
              </Grid>
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="DockWindow" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Appearance_TitleBar_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Appearance_TitleBar_UseCustomLabel}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Appearance_TitleBar_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomTitleBar}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_Appearance_TitleBar_UseCustomLabel}" />
              </Grid>
            </StackPanel>
     </Border>

        </StackPanel>

        <!-- ===================== Editor ===================== -->
        <StackPanel Spacing="20" IsVisible="{Binding SelectedSection, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Editor}">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Settings_Editor_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{loc:Tr Settings_Editor_Description}" Classes="muted" FontSize="12.5" />
          </StackPanel>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="FormatFont" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Editor_Font_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Text="{loc:Tr Settings_Editor_Font_Description}"
                         Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding EditorFontFamily}" AutomationProperties.Name="{loc:Tr Settings_Editor_Font_Title}"
                        HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="FormatSize" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Editor_SizeLayout_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Editor_FontSize_Label}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding EditorFontSizeLabel}"
                           Classes="faint" VerticalAlignment="Center" />
              </Grid>
              <Slider Minimum="12" Maximum="20" Value="{Binding EditorFontSize}" TickFrequency="1" AutomationProperties.Name="{loc:Tr Settings_Editor_FontSize_Label}" />

              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Editor_ColumnWidth_Label}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding EditorColumnWidthLabel}"
                           Classes="faint" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{loc:Tr Settings_Editor_ColumnWidth_Description}"
                         Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
              <Slider Minimum="480" Maximum="1400" Value="{Binding EditorColumnWidth}" TickFrequency="20" AutomationProperties.Name="{loc:Tr Settings_Editor_ColumnWidth_Label}" />

              <StackPanel Spacing="8" Margin="0,4,0,0">
                <TextBlock Text="{loc:Tr Settings_Editor_ColumnPosition_Label}" FontSize="13" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <RadioButton Classes="segment" GroupName="ColumnPosition" Content="{loc:Tr Settings_Editor_ColumnPosition_Centered, Converter={StaticResource UpperCaseConverter}}"
                               IsChecked="{Binding !IsColumnLeftAligned}" />
                  <RadioButton Classes="segment" GroupName="ColumnPosition" Content="{loc:Tr Settings_Editor_ColumnPosition_Left, Converter={StaticResource UpperCaseConverter}}"
                               IsChecked="{Binding IsColumnLeftAligned}" />
                </StackPanel>
              </StackPanel>

              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Editor_WordWrap_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Editor_WordWrap_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EditorWordWrap}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_Editor_WordWrap_Label}" />
              </Grid>

              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Editor_ShowScrollbar_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Editor_ShowScrollbar_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EditorShowScrollbar}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_Editor_ShowScrollbar_Label}" />
              </Grid>

              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Editor_LineNumbers_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Editor_LineNumbers_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EditorLineNumbers}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_Editor_LineNumbers_Label}" />
              </Grid>

              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Editor_SidePanel_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Editor_SidePanel_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EditorSidePanelVisible}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_Editor_SidePanel_Label}" />
              </Grid>

              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Editor_TabSize_Label}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding EditorTabSizeLabel}"
                           Classes="faint" VerticalAlignment="Center" />
              </Grid>
              <Slider Minimum="2" Maximum="8" Value="{Binding EditorTabSize}" TickFrequency="1" AutomationProperties.Name="{loc:Tr Settings_Editor_TabSize_Label}" />
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="ContentSaveOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Editor_Autosave_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                         Text="{loc:Tr Settings_Editor_Autosave_Description}" />
            </StackPanel>
     </Border>
        </StackPanel>

        <!-- ===================== Notificaciones ===================== -->
        <StackPanel Spacing="20" IsVisible="{Binding SelectedSection, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Notifications}">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Settings_Notifications_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{loc:Tr Settings_Notifications_Description}" Classes="muted" FontSize="12.5" />
          </StackPanel>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="BellRingOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Notifications_Panels_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Notifications_Bell_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Notifications_Bell_Description}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationsPanelEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_Notifications_Bell_Label}" />
              </Grid>
              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Notifications_RemindersTray_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Notifications_RemindersTray_Description}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding RemindersPanelEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_Notifications_RemindersTray_Label}" />
              </Grid>
              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Notifications_Toast_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Notifications_Toast_Description}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowDesktopToasts}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_Notifications_Toast_Label}" />
              </Grid>
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="BellOffOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Notifications_MuteByCategory_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Text="{loc:Tr Settings_Notifications_MuteByCategory_Description}"
                         Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Notifications_Mute_Info_Label}" FontSize="13" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding MuteInfoNotifications}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_Notifications_Mute_Info_Label}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Notifications_Mute_Success_Label}" FontSize="13" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding MuteSuccessNotifications}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_Notifications_Mute_Success_Label}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Notifications_Mute_Warning_Label}" FontSize="13" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding MuteWarningNotifications}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_Notifications_Mute_Warning_Label}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Notifications_Mute_Error_Label}" FontSize="13" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding MuteErrorNotifications}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_Notifications_Mute_Error_Label}" />
              </Grid>
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="CalendarClockOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Notifications_Reminders_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Notifications_Reminders_SoonWindow_Label}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ReminderSoonWindowDaysLabel}"
                           Classes="faint" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{loc:Tr Settings_Notifications_Reminders_SoonWindow_Description}"
                         Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
              <Slider Minimum="1" Maximum="30" Value="{Binding ReminderSoonWindowDays}" TickFrequency="1" AutomationProperties.Name="{loc:Tr Settings_Notifications_Reminders_SoonWindow_Label}" />
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="MoonWaningCrescent" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Notifications_DndSound_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Notifications_Dnd_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Notifications_Dnd_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DoNotDisturbEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_Notifications_Dnd_Label}" />
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="12" IsEnabled="{Binding DoNotDisturbEnabled}">
                <StackPanel Spacing="6">
                  <TextBlock Text="{loc:Tr Settings_Notifications_Dnd_FromLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <TextBox Classes="search" Text="{Binding DoNotDisturbStart}" Width="90" PlaceholderText="22:00" AutomationProperties.Name="{loc:Tr Settings_Notifications_Dnd_FromLabel}" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Text="{loc:Tr Settings_Notifications_Dnd_ToLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <TextBox Classes="search" Text="{Binding DoNotDisturbEnd}" Width="90" PlaceholderText="08:00" AutomationProperties.Name="{loc:Tr Settings_Notifications_Dnd_ToLabel}" />
                </StackPanel>
              </StackPanel>

              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Notifications_Sound_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Notifications_Sound_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationSoundEnabled}" OnContent="" OffContent="" AutomationProperties.Name="{loc:Tr Settings_Notifications_Sound_Label}" />
              </Grid>

              <StackPanel Spacing="8" IsEnabled="{Binding NotificationSoundEnabled}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Notifications_Sound_Volume_Label}" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding NotificationSoundVolumeLabel}"
                             Classes="faint" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{loc:Tr Settings_Notifications_Sound_Volume_Description}"
                           Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <Slider Grid.Column="0" Minimum="0" Maximum="100" TickFrequency="5"
                          Value="{Binding NotificationSoundVolume}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Tr Settings_Notifications_Sound_Volume_Label}" />
                  <Button Grid.Column="1" Classes="ghost" Margin="10,0,0,0"
                          Content="{loc:Tr Settings_Notifications_Sound_TestButton, Converter={StaticResource UpperCaseConverter}}"
                          Command="{Binding TestNotificationSoundCommand}" />
                </Grid>
              </StackPanel>
            </StackPanel>
     </Border>
        </StackPanel>

        <!-- ===================== Calendario ===================== -->
        <StackPanel Spacing="20" IsVisible="{Binding SelectedSection, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Calendar}">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Settings_Calendar_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{loc:Tr Settings_Calendar_Description}"
                       Classes="muted" FontSize="12.5" />
          </StackPanel>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="ViewGridOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Calendar_DefaultView_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Text="{loc:Tr Settings_Calendar_DefaultView_Description}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <RadioButton Classes="segment" GroupName="CalendarDefaultView" Content="{loc:Tr Settings_Calendar_View_Month, Converter={StaticResource UpperCaseConverter}}"
                             IsChecked="{Binding CalendarDefaultView, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Month, Mode=OneWay}"
                             Command="{Binding SetCalendarDefaultViewCommand}" CommandParameter="{x:Static vm:CalendarViewMode.Month}" />
                <RadioButton Classes="segment" GroupName="CalendarDefaultView" Content="{loc:Tr Settings_Calendar_View_Week, Converter={StaticResource UpperCaseConverter}}"
                             IsChecked="{Binding CalendarDefaultView, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Week, Mode=OneWay}"
                             Command="{Binding SetCalendarDefaultViewCommand}" CommandParameter="{x:Static vm:CalendarViewMode.Week}" />
                <RadioButton Classes="segment" GroupName="CalendarDefaultView" Content="{loc:Tr Settings_Calendar_View_Day, Converter={StaticResource UpperCaseConverter}}"
                             IsChecked="{Binding CalendarDefaultView, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Day, Mode=OneWay}"
                             Command="{Binding SetCalendarDefaultViewCommand}" CommandParameter="{x:Static vm:CalendarViewMode.Day}" />
                <RadioButton Classes="segment" GroupName="CalendarDefaultView" Content="{loc:Tr Settings_Calendar_View_Agenda, Converter={StaticResource UpperCaseConverter}}"
                             IsChecked="{Binding CalendarDefaultView, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Agenda, Mode=OneWay}"
                             Command="{Binding SetCalendarDefaultViewCommand}" CommandParameter="{x:Static vm:CalendarViewMode.Agenda}" />
              </StackPanel>
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="CalendarWeekOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Calendar_Week_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Calendar_WeekStartsMonday_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Calendar_WeekStartsMonday_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CalendarWeekStartsOnMonday}" OnContent="" OffContent="" />
              </Grid>
              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Calendar_ShowWeekends_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Calendar_ShowWeekends_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CalendarShowWeekends}" OnContent="" OffContent="" />
              </Grid>
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="ClockTimeEightOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Calendar_WorkingHours_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Text="{loc:Tr Settings_Calendar_WorkingHours_Description}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Calendar_WorkingHours_StartLabel}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CalendarWorkingHoursStart, StringFormat={}{0:00}:00}"
                           Classes="faint" VerticalAlignment="Center" />
              </Grid>
              <Slider Minimum="0" Maximum="23" Value="{Binding CalendarWorkingHoursStart}" TickFrequency="1" />
              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Calendar_WorkingHours_EndLabel}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CalendarWorkingHoursEnd, StringFormat={}{0:00}:00}"
                           Classes="faint" VerticalAlignment="Center" />
              </Grid>
              <Slider Minimum="1" Maximum="24" Value="{Binding CalendarWorkingHoursEnd}" TickFrequency="1" />
              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Calendar_TimeFormat24h_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Calendar_TimeFormat24h_Description}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CalendarTimeFormat24h}" OnContent="" OffContent="" />
              </Grid>
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="PageLayoutSidebarLeft" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Calendar_PanelSidebar_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Calendar_ShowInNav_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Calendar_ShowInNav_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CalendarPanelEnabled}" OnContent="" OffContent="" />
              </Grid>
              <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4" />
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Calendar_SidebarScrollbar_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Calendar_SidebarScrollbar_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CalendarShowSidebarScrollbar}" OnContent="" OffContent="" />
              </Grid>
            </StackPanel>
     </Border>
        </StackPanel>

        <!-- ===================== Cuenta ===================== -->
        <StackPanel Spacing="20" IsVisible="{Binding SelectedSection, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Account}">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Settings_Account_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{loc:Tr Settings_Account_Description}"
                       Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Sin configuración de Supabase en este equipo (falta local.properties) -->
          <Border Classes="card" Padding="22" IsVisible="{Binding !IsSupabaseConfigured}">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="AlertCircleOutline" Width="15" Height="15" Foreground="{DynamicResource DangerBrush}" />
                <TextBlock Text="{loc:Tr Settings_Account_SupabaseNotConfigured_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" Foreground="{DynamicResource DangerBrush}" />
              </StackPanel>
              <TextBlock Text="{loc:Tr Settings_Account_SupabaseNotConfigured_Description}"
                         Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
            </StackPanel>
     </Border>

          <!-- Vinculado -->
          <Border Classes="card" Padding="22" IsVisible="{Binding IsPolarLinked}">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="ShieldCheckOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Account_LinkPolar_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Account_LinkedAccount_Label}" FontSize="13" />
                  <TextBlock Text="{Binding PolarLinkedEmail}" Classes="muted" FontSize="11.5" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource Ink10}" Padding="8,4" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Tr Settings_Account_LinkedBadge}" Classes="faint" FontSize="10" LetterSpacing="1" />
           </Border>
              </Grid>
              <TextBlock Text="{loc:Tr Settings_Account_LinkedDescription}"
                         Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
              <Button Classes="pill" Command="{Binding UnlinkPolarCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="LinkOff" Width="14" Height="14" />
                  <TextBlock Text="{loc:Tr Settings_Account_UnlinkButton, Converter={StaticResource UpperCaseConverter}}" />
                </StackPanel>
              </Button>
            </StackPanel>
     </Border>

          <!-- No vinculado (formulario) -->
          <Border Classes="card" Padding="22" IsVisible="{Binding !IsPolarLinked}">
            <StackPanel Spacing="14" IsEnabled="{Binding IsSupabaseConfigured}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="LinkVariant" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Account_LinkPolar_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Text="{loc:Tr Settings_Account_LinkForm_Description}"
                         Classes="muted" FontSize="12.5" TextWrapping="Wrap" />

              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Settings_Account_EmailLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <TextBox Classes="search" Text="{Binding PolarEmailInput}" PlaceholderText="{loc:Tr Settings_Account_EmailPlaceholder}" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Settings_Account_PasswordLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <TextBox Classes="search" Text="{Binding PolarPasswordInput}" PasswordChar="●" />
              </StackPanel>

              <TextBlock Text="{Binding PolarLinkError}" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                         TextWrapping="Wrap" IsVisible="{Binding PolarLinkError, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}" />

              <Button Classes="pill-primary" Command="{Binding LinkPolarCommand}" HorizontalAlignment="Left"
                      IsEnabled="{Binding !IsLinkingPolar}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="LinkVariant" Width="14" Height="14" />
                  <TextBlock Text="{Binding LinkButtonLabel, Converter={StaticResource UpperCaseConverter}}" />
                </StackPanel>
              </Button>
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="TagMultipleOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Account_TaskManagement_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Account_ShowTags_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Account_ShowTags_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding PolarShowTaskTags}" OnContent="" OffContent="" />
              </Grid>
            </StackPanel>
     </Border>

          <!-- ===================== Sincronización (docs/ajustes-docs/03-cuenta-y-sincronizacion-polar.md) ===================== -->
          <Border Classes="card" Padding="22" IsVisible="{Binding IsPolarLinked}">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="SyncCircle" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Account_Sync_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Account_LastSynced_Label}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding LastSyncedLabel}" Classes="faint" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{Binding SyncErrorLabel}" Foreground="{DynamicResource DangerBrush}"
                         FontSize="11.5" TextWrapping="Wrap"
                         IsVisible="{Binding SyncErrorLabel, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}" />
              <TextBlock Text="{Binding NextRetryLabel}" Classes="faint" FontSize="11.5"
                         IsVisible="{Binding NextRetryLabel, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}" />
              <TextBlock Text="{loc:Tr Polar_Sync_AlreadyRunningNotice}" Classes="faint" FontSize="11.5"
                         IsVisible="{Binding LastSyncNowWasSkipped}" />
              <Button Classes="pill" Command="{Binding SyncNowCommand}" HorizontalAlignment="Left"
                      IsEnabled="{Binding !IsSyncingNow}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="SyncCircle" Width="14" Height="14" Classes.spin="{Binding IsSyncingNow}" />
                  <TextBlock Text="{Binding SyncNowButtonLabel, Converter={StaticResource UpperCaseConverter}}" />
                </StackPanel>
              </Button>
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22" IsVisible="{Binding IsPolarLinked}">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="InformationCircleOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Account_Management_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                         Text="{loc:Tr Settings_Account_Management_Description}" />
            </StackPanel>
     </Border>
        </StackPanel>

        <!-- ===================== Skills ===================== -->
        <StackPanel Spacing="20" IsVisible="{Binding SelectedSection, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Skills}">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Settings_Skills_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{loc:Tr Settings_Skills_Description}"
                       Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
          </StackPanel>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="Brain" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Skills_Section_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Text="{loc:Tr Settings_Skills_ShowSkills_Label}" FontSize="13" />
                  <TextBlock Text="{loc:Tr Settings_Skills_ShowSkills_Description}"
                             Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding SkillsPanelEnabled}" OnContent="" OffContent="" />
              </Grid>
            </StackPanel>
     </Border>

          <Button Classes="card" Padding="18,16" Command="{Binding OpenCommunitySkillsCommand}"
                  ToolTip.Tip="{loc:Tr Settings_Skills_CommunityLink_Tooltip}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <mi:MaterialIcon Grid.Column="0" Kind="CompassOutline" Width="20" Height="20"
                                Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" Margin="0,0,14,0" />
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr Settings_Skills_CommunityLink_Title, Converter={StaticResource UpperCaseConverter}}" FontWeight="Bold" FontSize="13" />
                <TextBlock Text="{loc:Tr Settings_Skills_CommunityLink_Description}"
                           Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{Binding CommunitySkillsUrlDisplay}" Classes="faint" FontSize="11" VerticalAlignment="Center" />
                <mi:MaterialIcon Kind="OpenInNew" Width="13" Height="13" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Button>
        </StackPanel>

        <!-- ===================== Atajos de teclado remapeables (propuesta 29, docs/propuesta-nuevas-funcionalidades.md) ===================== -->
        <StackPanel Spacing="20" IsVisible="{Binding SelectedSection, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Shortcuts}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="{loc:Tr Settings_Shortcuts_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{loc:Tr Settings_Shortcuts_Description}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" Command="{Binding ResetAllShortcutsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="RestoreAlert" Width="13" Height="13" />
                <TextBlock Text="{loc:Tr Settings_Shortcuts_ResetAllButton, Converter={StaticResource UpperCaseConverter}}" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Un Border.card por categoría (Services.ShortcutCatalog.CategoryKey), cada fila con su
               propio control de captura — clic o Enter empieza a escuchar la próxima combinación. -->
          <ItemsControl ItemsSource="{Binding ShortcutCategories}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="20" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ShortcutCategoryViewModel">
                <Border Classes="card" Padding="22">
                  <StackPanel Spacing="14">
                    <TextBlock Text="{Binding Label, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />

                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ShortcutRowViewModel">
                          <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,180,Auto">
                              <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="muted" FontSize="12.5"
                                         VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />

                              <Border Grid.Column="1" Classes="shortcut-capture" Classes.active="{Binding IsCapturing}"
                                      Classes.customized="{Binding IsCustomized}" Focusable="True"
                                      PointerPressed="ShortcutCapture_PointerPressed"
                                      KeyDown="ShortcutCapture_KeyDown"
                                      LostFocus="ShortcutCapture_LostFocus"
                                      ToolTip.Tip="{loc:Tr Settings_Shortcuts_CaptureHint}">
                                <TextBlock Text="{Binding GestureDisplay}" FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                         </Border>

                              <Button Grid.Column="2" Classes="icon-btn" Width="26" Height="26" Margin="6,0,0,0"
                                      IsVisible="{Binding IsCustomized}"
                                      Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ResetShortcutCommand}"
                                      CommandParameter="{Binding}"
                                      ToolTip.Tip="{loc:Tr Settings_Shortcuts_ResetRowTooltip}"
                                      AutomationProperties.Name="{loc:Tr Settings_Shortcuts_ResetRowTooltip}">
                                <mi:MaterialIcon Kind="Restore" Width="13" Height="13" />
                              </Button>
                            </Grid>

                            <!-- Aviso de conflicto (propuesta 29 §"Detección de conflictos") — solo aparece
                                 mientras hay un gesto capturado pendiente de confirmar, con dos salidas
                                 explícitas en vez de guardar en silencio. -->
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  IsVisible="{Binding ConflictMessage, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
                              <TextBlock Grid.Column="0" Text="{Binding ConflictMessage}" Foreground="{DynamicResource DangerBrush}"
                                         FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                              <Button Grid.Column="1" Classes="ghost" Padding="8,3" Margin="8,0,0,0"
                                      Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).CancelConflictingShortcutCommand}"
                                      CommandParameter="{Binding}">
                                <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" FontSize="10.5" />
                              </Button>
                              <Button Grid.Column="2" Classes="pill" Padding="8,3" Margin="8,0,0,0"
                                      Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ConfirmConflictingShortcutCommand}"
                                      CommandParameter="{Binding}">
                                <TextBlock Text="{loc:Tr Settings_Shortcuts_ApplyAnywayButton, Converter={StaticResource UpperCaseConverter}}" FontSize="10.5" />
                              </Button>
                            </Grid>

                            <!-- Aviso transitorio ("debe incluir Ctrl/Alt/Cmd") — la fila sigue en captura,
                                 sin botones, para que el usuario pruebe otra combinación directamente. -->
                            <TextBlock Text="{Binding CaptureHintMessage}" Foreground="{DynamicResource DangerBrush}"
                                       FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding CaptureHintMessage, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
           </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- ===================== Referencia (no remapeable) ===================== -->
          <StackPanel Spacing="4" Margin="0,6,0,0">
            <TextBlock Text="{loc:Tr Settings_Shortcuts_ReferenceSectionTitle, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{loc:Tr Settings_Shortcuts_ReferenceSectionNote}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="ViewColumnOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_KanbanSection_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="9">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+F" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5" FontWeight="Bold" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Tr Settings_KanbanSection_SearchBoard}" Classes="muted" FontSize="12" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="N" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5" FontWeight="Bold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Tr Settings_KanbanSection_NewCard}" Classes="muted" FontSize="12" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Settings_KanbanSection_DeleteKey}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5" FontWeight="Bold" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Tr Settings_KanbanSection_DeleteCard}" Classes="muted" FontSize="12" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Esc" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5" FontWeight="Bold" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:Tr Settings_KanbanSection_CloseDialog}" Classes="muted" FontSize="12" />
              </Grid>
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="FileImageOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_PdfViewer_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <Grid ColumnDefinitions="140,*" RowDefinitions="Auto" RowSpacing="9">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Settings_PdfViewer_NavKey}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Tr Settings_PdfViewer_PrevNextPage}" Classes="muted" FontSize="12" />
              </Grid>
            </StackPanel>
     </Border>
        </StackPanel>

        <!-- ===================== Acerca de ===================== -->
        <StackPanel Spacing="20" IsVisible="{Binding SelectedSection, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=About}">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Settings_About_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{loc:Tr Settings_About_Description}" Classes="muted" FontSize="12.5" />
          </StackPanel>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="40" Height="40" CornerRadius="0" Background="{DynamicResource InkBrush}">
                  <TextBlock Text="E" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource InkOnBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
           </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="ENKI" FontSize="16" FontWeight="Bold" LetterSpacing="1" />
                  <TextBlock Text="{Binding AppVersionLabel}" Classes="faint" />
                </StackPanel>
              </StackPanel>
              <Rectangle Height="1" Fill="{DynamicResource Ink10}" />
              <TextBlock Text="{loc:Tr Settings_About_Tagline}"
                         Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="BookOpenPageVariantOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_About_WhatIsEnki_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                         Text="{loc:Tr Settings_About_WhatIsEnki_Description}" />
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="ViewGridOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_About_Modules_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>

              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Settings_About_Module_Dashboard_Name}" FontSize="12.5" FontWeight="Bold" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Tr Settings_About_Module_Dashboard_Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Settings_About_Module_Notes_Name}" FontSize="12.5" FontWeight="Bold" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Tr Settings_About_Module_Notes_Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Settings_About_Module_Sessions_Name}" FontSize="12.5" FontWeight="Bold" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Tr Settings_About_Module_Sessions_Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr Settings_About_Module_Kanban_Name}" FontSize="12.5" FontWeight="Bold" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:Tr Settings_About_Module_Kanban_Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr Settings_About_Module_Polar_Name}" FontSize="12.5" FontWeight="Bold" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{loc:Tr Settings_About_Module_Polar_Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Tr Settings_About_Module_Calendar_Name}" FontSize="12.5" FontWeight="Bold" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{loc:Tr Settings_About_Module_Calendar_Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Tr Settings_About_Module_Reminders_Name}" FontSize="12.5" FontWeight="Bold" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{loc:Tr Settings_About_Module_Reminders_Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Tr Settings_About_Module_Trash_Name}" FontSize="12.5" FontWeight="Bold" />
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{loc:Tr Settings_About_Module_Trash_Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />

                <TextBlock Grid.Row="8" Grid.Column="0" Text="{loc:Tr Settings_About_Module_Settings_Name}" FontSize="12.5" FontWeight="Bold" />
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{loc:Tr Settings_About_Module_Settings_Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="CodeTags" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_About_Technology_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                         Text="{loc:Tr Settings_About_Technology_Description}" />
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="ShieldLockOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_About_Privacy_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                         Text="{loc:Tr Settings_About_Privacy_Description}" />
              <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource Ink10}"
                      BorderThickness="1" Padding="12,10">
                <TextBlock Text="{Binding VaultPath}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
         </Border>
            </StackPanel>
     </Border>

          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="TranslateVariant" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_About_Language_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                         Text="{loc:Tr Settings_About_Language_Description}" />
            </StackPanel>
     </Border>
        </StackPanel>

      </StackPanel>

      <!-- ===================== Dashboard: lista + vista previa en vivo, a todo lo ancho ===================== -->
      <StackPanel Spacing="20" MaxWidth="1080" HorizontalAlignment="Left"
                  IsVisible="{Binding SelectedSection, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Dashboard}">
        <StackPanel Spacing="4">
          <TextBlock Text="{loc:Tr Settings_Dashboard_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{loc:Tr Settings_Dashboard_Description}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ===== Organización: qué plantilla de rejilla reparte las secciones visibles ===== -->
        <Border Classes="card" Padding="22">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <mi:MaterialIcon Kind="ViewQuiltOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Settings_Dashboard_Layout_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{loc:Tr Settings_Dashboard_Layout_Subtitle}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding DashboardLayoutOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" ItemWidth="204" ItemHeight="150" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:DashboardLayoutOptionViewModel">
                  <Button Classes="card" Classes.active="{Binding IsSelected}" Padding="14" Margin="0,0,10,10"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SelectDashboardLayoutStyleCommand}"
                          CommandParameter="{Binding Key}"
                          AutomationProperties.Name="{Binding Title}">
                    <StackPanel Spacing="10">

                      <!-- Diagrama en miniatura: la misma geometría (Services.DashboardLayoutEngine)
                           que aplicará esta plantilla, no una ilustración aparte — si cambian los
                           tramos del motor de organización, el diagrama cambia solo con ellos. -->
                      <Border Height="58" Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}" BorderThickness="1" Padding="4">
                        <ItemsControl ItemsSource="{Binding Blocks}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <Grid ColumnDefinitions="*,*,*,*,*,*" RowDefinitions="*,*,*,*,*,*,*" ColumnSpacing="2" RowSpacing="2" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemContainerTheme>
                            <ControlTheme TargetType="ContentPresenter" x:DataType="vm:DashboardLayoutBlockViewModel">
                              <Setter Property="Grid.Row" Value="{Binding GridRow}" />
                              <Setter Property="Grid.Column" Value="{Binding GridColumn}" />
                              <Setter Property="Grid.RowSpan" Value="{Binding GridRowSpan}" />
                              <Setter Property="Grid.ColumnSpan" Value="{Binding GridColumnSpan}" />
                              <Setter Property="HorizontalAlignment" Value="Stretch" />
                              <Setter Property="VerticalAlignment" Value="Stretch" />
                            </ControlTheme>
                          </ItemsControl.ItemContainerTheme>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:DashboardLayoutBlockViewModel">
                              <Border Classes="layout-block" Classes.wide="{Binding IsWide}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                 </Border>

                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock Text="{Binding Description}" Classes="muted" FontSize="10.5" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
   </Border>

        <!-- Riel de control angosto (9*) + lienzo de vista previa dominante (16*) — proporción fluida en
             vez de un ancho fijo en píxeles, para que ambas columnas encojan juntas en vez de desbordar
             en ventanas cerca del MinWidth de MainWindow (980px) — mismo motivo por el que el resto de
             columnas de este archivo usan '*' en vez de números fijos. -->
        <Grid ColumnDefinitions="9*,28,16*">

          <!-- ===== Columna izquierda: lista de secciones ===== -->
          <Border Grid.Column="0" Classes="card" Padding="22" VerticalAlignment="Top">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9">
                  <mi:MaterialIcon Kind="ViewDashboardOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Settings_Dashboard_SectionList_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding DashboardVisibilitySummary}" Classes="faint" VerticalAlignment="Center" Margin="14,0,0,0" />
                <Button Grid.Column="2" Classes="ghost" Command="{Binding ResetDashboardLayoutCommand}">
                  <TextBlock Text="{loc:Tr Settings_Dashboard_Reset, Converter={StaticResource UpperCaseConverter}}" />
                </Button>
              </Grid>

              <TextBlock Text="{loc:Tr Settings_Dashboard_SectionList_Subtitle}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />

              <ItemsControl ItemsSource="{Binding DashboardSections}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:DashboardSectionConfigViewModel">
                    <Border Classes="dashboard-section-row" Classes.drag-over="{Binding IsDropTarget}" Classes.hidden="{Binding !IsVisible}"
                            BorderThickness="1"
                            Padding="12,10"
                            DragDrop.AllowDrop="True"
                            DragDrop.DragEnter="DashboardSectionRow_DragEnter"
                            DragDrop.DragOver="DashboardSectionRow_DragOver"
                            DragDrop.DragLeave="DashboardSectionRow_DragLeave"
                            DragDrop.Drop="DashboardSectionRow_Drop">
                      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                        <Panel Grid.Column="0" Width="18" Margin="0,0,10,0" VerticalAlignment="Center"
                               Cursor="SizeAll"
                               ToolTip.Tip="{loc:Tr Settings_Dashboard_DragHandleTooltip}"
                               PointerPressed="DashboardSectionHandle_PointerPressed"
                               PointerMoved="DashboardSectionHandle_PointerMoved">
                          <mi:MaterialIcon Kind="DragVertical" Width="16" Height="16" Foreground="{DynamicResource Ink40}" />
                        </Panel>

                        <TextBlock Grid.Column="1" Text="{Binding Position, StringFormat={}{0:00}}" Classes="faint"
                                   Width="20" VerticalAlignment="Center" Margin="0,0,10,0" />

                        <mi:MaterialIcon Grid.Column="2" Kind="{Binding Icon}" Width="17" Height="17"
                                          Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" Margin="0,0,12,0" />

                        <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource Ink10}" Padding="6,2" IsVisible="{Binding !IsVisible}">
                              <TextBlock Text="{loc:Tr Settings_Dashboard_Hidden_Label, Converter={StaticResource UpperCaseConverter}}" Classes="faint" FontSize="9" />
                       </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
                          <Button Classes="icon-btn" Width="24" Height="24"
                                  IsEnabled="{Binding !IsFirst}"
                                  Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveDashboardSectionUpCommand}"
                                  CommandParameter="{Binding Key}"
                                  ToolTip.Tip="{loc:Tr Settings_Dashboard_MoveUp_Tooltip}"
                                  AutomationProperties.Name="{loc:Tr Settings_Dashboard_MoveUp_Tooltip}">
                            <mi:MaterialIcon Kind="ChevronUp" Width="14" Height="14" />
                          </Button>
                          <Button Classes="icon-btn" Width="24" Height="24"
                                  IsEnabled="{Binding !IsLast}"
                                  Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MoveDashboardSectionDownCommand}"
                                  CommandParameter="{Binding Key}"
                                  ToolTip.Tip="{loc:Tr Settings_Dashboard_MoveDown_Tooltip}"
                                  AutomationProperties.Name="{loc:Tr Settings_Dashboard_MoveDown_Tooltip}">
                            <mi:MaterialIcon Kind="ChevronDown" Width="14" Height="14" />
                          </Button>
                        </StackPanel>

                        <ToggleSwitch Grid.Column="5"
                                      IsChecked="{Binding IsVisible, Mode=OneWay}"
                                      Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ToggleDashboardSectionVisibilityCommand}"
                                      CommandParameter="{Binding Key}"
                                      OnContent="" OffContent=""
                                      AutomationProperties.Name="{loc:Tr Settings_Dashboard_Visible_Label}" />
                      </Grid>
                </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
     </Border>

          <!-- ===== Columna derecha: vista previa en vivo, como una captura del Dashboard real ===== -->
          <Border Grid.Column="2" Classes="card" Padding="0" VerticalAlignment="Top">
            <StackPanel Spacing="0">
              <StackPanel Spacing="4" Margin="22,22,22,16">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <mi:MaterialIcon Kind="EyeOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Settings_Dashboard_Preview_Title, Converter={StaticResource UpperCaseConverter}}" Classes="section-title" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{loc:Tr Settings_Dashboard_Preview_Subtitle}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
              </StackPanel>

              <!-- Marco de "ventana": una réplica estructural del Dashboard real, a escala reducida —
                   mismos iconos, mismas etiquetas (Dashboard_QuickAccess_*, Dashboard_Vault_*, los
                   estados vacíos Dashboard_Today_EmptyState/Dashboard_Activity_EmptyState, los
                   encabezados de columna de Dashboard_BoardTasks_*), reutilizados tal cual del propio
                   Dashboard en vez de reinventar copys nuevos. Las barras Ink10/15/20 marcan sólo el
                   contenido que sí depende de datos reales del vault (tareas, notas) que esta página no
                   tiene disponibles — todo lo demás es la interfaz real, sólo que en miniatura. -->
              <Border Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}" BorderThickness="1,1,1,0">
                <StackPanel Spacing="0">

                  <!-- Barra de título de la "ventana" -->
                  <Border BorderBrush="{DynamicResource Ink10}" BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Ink20}" />
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Ink20}" />
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Ink20}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{loc:Tr Dashboard_Title, Converter={StaticResource UpperCaseConverter}}"
                                 Classes="faint" FontSize="8.5" LetterSpacing="2" HorizontalAlignment="Center" />
                    </Grid>
              </Border>

                  <!-- Mismo Grid de 6 columnas + ItemContainerTheme que el Dashboard real (DashboardView.axaml)
                       en vez del StackPanel apilado que tenía antes — la vista previa ahora reproduce la
                       organización elegida (Clásica/Pirámide invertida/Lateral/Rejilla modular/Mosaico),
                       no solo el orden y la visibilidad. IsVisible en el propio contenedor (no solo en el
                       contenido) para que una sección oculta no reserve celda: las ocultas no tienen una
                       posición fresca calculada (Compute() sólo recibe las visibles), así que sin esto
                       podrían quedar ancladas a una Grid.Row/Column obsoleta de un cálculo anterior. -->
                  <ItemsControl ItemsSource="{Binding DashboardSections}" Margin="14">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Grid ColumnDefinitions="*,*,*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="8" RowSpacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerTheme>
                      <ControlTheme TargetType="ContentPresenter" x:DataType="vm:DashboardSectionConfigViewModel">
                        <Setter Property="Grid.Row" Value="{Binding GridRow}" />
                        <Setter Property="Grid.Column" Value="{Binding GridColumn}" />
                        <Setter Property="Grid.RowSpan" Value="{Binding GridRowSpan}" />
                        <Setter Property="Grid.ColumnSpan" Value="{Binding GridColumnSpan}" />
                        <Setter Property="IsVisible" Value="{Binding IsVisible}" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                      </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:DashboardSectionConfigViewModel">
                        <StackPanel Spacing="6" IsVisible="{Binding IsVisible}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="{Binding Icon}" Width="10" Height="10" Foreground="{DynamicResource Ink40}" />
                            <TextBlock Text="{Binding Title, Converter={StaticResource UpperCaseConverter}}" Classes="faint" FontSize="8" LetterSpacing="1" VerticalAlignment="Center" />
                          </StackPanel>

                          <!-- Accesos rápidos: la misma rejilla de 4 tarjetas, mismos iconos/rótulos -->
                          <UniformGrid Columns="4" ColumnSpacing="5" IsVisible="{Binding Key, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=QuickAccess}">
                            <Border Classes="card" Padding="6,7">
                              <StackPanel Spacing="4">
                                <mi:MaterialIcon Kind="CalendarBlankOutline" Width="10" Height="10" Foreground="{DynamicResource Ink40}" />
                                <TextBlock Text="{loc:Tr Dashboard_QuickAccess_Calendar_Title, Converter={StaticResource UpperCaseConverter}}" FontSize="7" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                              </StackPanel>
                       </Border>
                            <Border Classes="card" Padding="6,7">
                              <StackPanel Spacing="4">
                                <mi:MaterialIcon Kind="CalendarClockOutline" Width="10" Height="10" Foreground="{DynamicResource Ink40}" />
                                <TextBlock Text="{loc:Tr Dashboard_QuickAccess_Reminders_Title, Converter={StaticResource UpperCaseConverter}}" FontSize="7" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                              </StackPanel>
                       </Border>
                            <Border Classes="card" Padding="6,7">
                              <StackPanel Spacing="4">
                                <mi:MaterialIcon Kind="BellRingOutline" Width="10" Height="10" Foreground="{DynamicResource Ink40}" />
                                <TextBlock Text="{loc:Tr Dashboard_QuickAccess_Notifications_Title, Converter={StaticResource UpperCaseConverter}}" FontSize="7" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                              </StackPanel>
                       </Border>
                            <Border Classes="card" Padding="6,7">
                              <StackPanel Spacing="4">
                                <mi:MaterialIcon Kind="CogOutline" Width="10" Height="10" Foreground="{DynamicResource Ink40}" />
                                <TextBlock Text="{loc:Tr Dashboard_QuickAccess_Settings_Title, Converter={StaticResource UpperCaseConverter}}" FontSize="7" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                              </StackPanel>
                       </Border>
                          </UniformGrid>

                          <!-- Hoy: el mismo estado vacío (icono + copy) que el Dashboard real muestra sin pendientes -->
                          <Border Classes="card" Padding="14" IsVisible="{Binding Key, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Today}">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                              <mi:MaterialIcon Kind="CalendarCheckOutline" Width="15" Height="15" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                              <TextBlock Text="{loc:Tr Dashboard_Today_EmptyState}" Classes="muted" FontSize="8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                     </Border>

                          <!-- Almacén: las mismas tres filas icono+etiqueta+valor -->
                          <Border Classes="card" Padding="10" IsVisible="{Binding Key, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Vault}">
                            <StackPanel Spacing="7">
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <mi:MaterialIcon Grid.Column="0" Kind="NoteTextOutline" Width="9" Height="9" Foreground="{DynamicResource Ink40}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{loc:Tr Dashboard_Vault_NotesLabel}" Classes="faint" FontSize="7" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Height="9" Width="16" Background="{DynamicResource Ink10}" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <mi:MaterialIcon Grid.Column="0" Kind="SitemapOutline" Width="9" Height="9" Foreground="{DynamicResource Ink40}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{loc:Tr Dashboard_Vault_SessionsLabel}" Classes="faint" FontSize="7" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Height="9" Width="16" Background="{DynamicResource Ink10}" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <mi:MaterialIcon Grid.Column="0" Kind="Harddisk" Width="9" Height="9" Foreground="{DynamicResource Ink40}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{loc:Tr Dashboard_Vault_SizeLabel}" Classes="faint" FontSize="7" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Height="9" Width="26" Background="{DynamicResource Ink10}" />
                              </Grid>
                            </StackPanel>
                     </Border>

                          <!-- Actividad: mismo estado vacío que el Dashboard real -->
                          <Border Classes="card" Padding="14" IsVisible="{Binding Key, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Activity}">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                              <mi:MaterialIcon Kind="BellRingOutline" Width="15" Height="15" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                              <TextBlock Text="{loc:Tr Dashboard_Activity_EmptyState}" Classes="muted" FontSize="8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                     </Border>

                          <!-- Sesiones: mismo icono + subtítulo, con el resumen de conteo como marcador -->
                          <Border Classes="card" Padding="10" IsVisible="{Binding Key, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Sessions}">
                            <StackPanel Spacing="6">
                              <mi:MaterialIcon Kind="SitemapOutline" Width="14" Height="14" Foreground="{DynamicResource Ink40}" />
                              <Border Height="9" Width="60" HorizontalAlignment="Left" Background="{DynamicResource Ink10}" />
                              <TextBlock Text="{loc:Tr Dashboard_Sessions_Subtitle}" Classes="muted" FontSize="7.5" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                     </Border>

                          <!-- Tareas del tablero: la misma barra de progreso de tres tramos + las tres
                               columnas reales (mismos iconos/rótulos), con marcadores donde irían las
                               tarjetas de tarea reales -->
                          <StackPanel Spacing="8" IsVisible="{Binding Key, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=BoardTasks}">
                            <StackPanel Orientation="Horizontal" Spacing="0">
                              <Border Width="34" Height="4" Background="{DynamicResource Ink20}" />
                              <Border Width="20" Height="4" Background="{DynamicResource Ink50}" />
                              <Border Width="14" Height="4" Background="{DynamicResource InkBrush}" />
                            </StackPanel>
                            <Border BorderBrush="{DynamicResource Ink10}" BorderThickness="1">
                              <Grid ColumnDefinitions="*,1,*,1,*" Background="{DynamicResource Ink10}">
                                <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" Padding="7">
                                  <StackPanel Spacing="6">
                                    <mi:MaterialIcon Kind="TrayFull" Width="9" Height="9" Foreground="{DynamicResource Ink40}" />
                                    <Border Height="6" Background="{DynamicResource Ink10}" />
                                    <Border Height="6" Width="18" HorizontalAlignment="Left" Background="{DynamicResource Ink10}" />
                                  </StackPanel>
                           </Border>
                                <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" Padding="7">
                                  <StackPanel Spacing="6">
                                    <mi:MaterialIcon Kind="ProgressClock" Width="9" Height="9" Foreground="{DynamicResource Ink40}" />
                                    <Border Height="6" Background="{DynamicResource Ink10}" />
                                  </StackPanel>
                           </Border>
                                <Border Grid.Column="4" Background="{DynamicResource PanelBackgroundBrush}" Padding="7">
                                  <StackPanel Spacing="6">
                                    <mi:MaterialIcon Kind="CheckCircleOutline" Width="9" Height="9" Foreground="{DynamicResource Ink40}" />
                                    <Border Height="6" Background="{DynamicResource Ink10}" />
                                  </StackPanel>
                         </Border>
                              </Grid>
                            </Border>
                          </StackPanel>

                          <!-- Notas recientes: la misma tarjeta destacada + lista compacta, con
                               marcadores donde irían el título/fecha reales de cada nota -->
                          <Grid ColumnDefinitions="7*,8,5*" IsVisible="{Binding Key, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=RecentNotes}">
                            <Border Grid.Column="0" Classes="note-card" Padding="10">
                              <StackPanel Spacing="7">
                                <Border Height="6" Width="24" HorizontalAlignment="Left" Background="{DynamicResource Ink10}" />
                                <Border Height="10" Background="{DynamicResource Ink15}" />
                                <Border Height="6" Width="46" HorizontalAlignment="Left" Background="{DynamicResource Ink10}" />
                              </StackPanel>
                       </Border>
                            <StackPanel Grid.Column="2" Spacing="6">
                              <Border Classes="card" Padding="7">
                                <StackPanel Spacing="4">
                                  <Border Height="6" Background="{DynamicResource Ink10}" />
                                  <Border Height="5" Width="30" HorizontalAlignment="Left" Background="{DynamicResource Ink10}" />
                                </StackPanel>
                         </Border>
                              <Border Classes="card" Padding="7">
                                <StackPanel Spacing="4">
                                  <Border Height="6" Background="{DynamicResource Ink10}" />
                                  <Border Height="5" Width="30" HorizontalAlignment="Left" Background="{DynamicResource Ink10}" />
                                </StackPanel>
                         </Border>
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
         </Border>
            </StackPanel>
     </Border>

        </Grid>
      </StackPanel>
      </Panel>
    </ScrollViewer>

    <!-- ===================== Diálogo: restablecer ajustes por defecto ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding PendingResetSettings}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{loc:Tr Settings_DangerZone_ResetDialog_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{loc:Tr Settings_DangerZone_ResetDialog_Message}"
                     FontSize="14" TextWrapping="Wrap" MaxWidth="320" />

          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Command="{Binding CancelResetSettingsCommand}" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary-danger" Command="{Binding ConfirmResetSettingsCommand}">
              <TextBlock Text="{loc:Tr Settings_General_DangerZone_ResetSettingsButton, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
    </Border>
  </controls:ModalOverlayHost>
  </Grid>
</UserControl>
