<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:views="clr-namespace:enki.Views"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:loc="clr-namespace:enki.Localization"
             xmlns:controls="clr-namespace:enki.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="enki.Views.FullNotesView"
             x:Name="Root"
             x:DataType="vm:NotesViewModel">

  <!-- Vista completa de la página de Notas: portada con la rejilla de tarjetas, panel de carpetas y
       filtro de etiquetas mientras no hay ninguna nota abierta, y la barra de pestañas + el editor a
       pantalla completa en cuanto la hay. Es la disposición por defecto; la alternativa es
       SimpleNotesView (Ajustes › Editor › Vista del editor). NotesView instancia solo la elegida y
       descarta la otra —ver NotesView.axaml.cs— porque tener las dos vivas a la vez significaría dos
       EditorView sobre el mismo EditorViewModel, y cada inserción de un comando "/" o cada salto desde
       el esquema se aplicaría dos veces. -->

  <UserControl.DataTemplates>
    <!-- Plantilla recursiva: un ItemsControl bindado a Children reutiliza esta misma plantilla
         implícita (por DataType) a cualquier profundidad, sin necesidad de TreeView. -->
    <DataTemplate DataType="vm:NoteFolderViewModel">
      <StackPanel>
        <Border Focusable="True" Classes="folder-row" Classes.active="{Binding IsSelected}" Classes.drag-over="{Binding IsDropTarget}"
                Padding="{Binding Depth, Converter={StaticResource DepthIndentConverter}}"
                DragDrop.AllowDrop="True"
                PointerPressed="FolderRow_PointerPressed"
                DragDrop.DragEnter="FolderRow_DragEnter"
                DragDrop.DragOver="FolderRow_DragOver"
                DragDrop.DragLeave="FolderRow_DragLeave"
                DragDrop.Drop="FolderRow_Drop">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{loc:Tr Explorer_Paste}" InputGesture="Ctrl+V" Command="{Binding $parent[UserControl].((vm:NotesViewModel)DataContext).PasteEntryCommand}" CommandParameter="{Binding}" />
              <Separator />
              <MenuItem Header="{loc:Tr Notes_RenameMenuItem}" Command="{Binding BeginRenameCommand}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="PencilOutline" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{loc:Tr Notes_CreateSubfolderMenuItem}"
                        Command="{Binding $parent[UserControl].((vm:NotesViewModel)DataContext).CreateSubfolderCommand}"
                        CommandParameter="{Binding}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="FolderPlusOutline" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{loc:Tr Common_Delete}"
                        Command="{Binding $parent[UserControl].((vm:NotesViewModel)DataContext).DeleteFolderCommand}"
                        CommandParameter="{Binding}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </Border.ContextMenu>
          <!-- Column 0 is a fixed 18px (not Auto) so it reserves the chevron's width even on leaf
               folders, where the button is hidden — otherwise a childless folder's icon shifts left
               to fill that gap and lines up almost flush under its parent's icon instead of reading
               as nested one level in. -->
          <Grid ColumnDefinitions="20,Auto,*,Auto,Auto" Height="34">
            <Button Grid.Column="0" Classes="icon-btn" Width="20" Height="20"
                    IsVisible="{Binding Children.Count, Converter={StaticResource CountToBoolConverter}}"
                    Command="{Binding ToggleExpandCommand}"
                    AutomationProperties.Name="{loc:Tr A11y_Notes_ToggleFolder}">
              <mi:MaterialIcon Kind="{Binding IsExpanded, Converter={StaticResource ExpandChevronConverter}}"
                                Width="16" Height="16" />
            </Button>
            <mi:MaterialIcon Grid.Column="1" Kind="FolderOutline" Width="15" Height="15" Margin="2,0,8,0"
                              Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13.5"
                       TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsRenaming}" />
            <TextBox Grid.Column="2" Text="{Binding EditingName}" IsVisible="{Binding IsRenaming}"
                      VerticalAlignment="Center" FontSize="13.5" Padding="4,2"
                      KeyDown="FolderNameEdit_KeyDown" LostFocus="FolderNameEdit_LostFocus"
                      Initialized="FolderNameEdit_Initialized"
                      PropertyChanged="FolderNameEdit_PropertyChanged" />
            <Button Grid.Column="3" Classes="icon-btn" Width="20" Height="20" Command="{Binding BeginRenameCommand}"
                    ToolTip.Tip="{loc:Tr Notes_RenameFolderTooltip}"
                    AutomationProperties.Name="{loc:Tr Notes_RenameFolderTooltip}">
              <mi:MaterialIcon Kind="FolderEditOutline" Width="14" Height="14" />
            </Button>
            <Button Grid.Column="4" Classes="icon-btn icon-btn-danger" Width="20" Height="20"
                    Command="{Binding $parent[UserControl].((vm:NotesViewModel)DataContext).DeleteFolderCommand}"
                    CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Notes_DeleteFolderTooltip}"
                    AutomationProperties.Name="{loc:Tr Notes_DeleteFolderTooltip}">
              <mi:MaterialIcon Kind="FolderRemoveOutline" Width="14" Height="14" />
            </Button>
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding IsExpanded}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:NoteFolderCardViewModel">
      <Button Classes="note-card" Margin="0,0,16,16" Width="224" Height="150"
              Command="{Binding $parent[ItemsControl].((vm:NotesViewModel)DataContext).OpenFolderCardCommand}"
              CommandParameter="{Binding}">
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{loc:Tr Explorer_Paste}"
                      Command="{Binding $parent[UserControl].((vm:NotesViewModel)DataContext).PasteEntryCommand}"
                      CommandParameter="{Binding}" />
          </ContextMenu>
        </Button.ContextMenu>
        <Grid RowDefinitions="*,Auto">
          <mi:MaterialIcon Grid.Row="0" Kind="FolderOutline" Width="48" Height="48"
                            Foreground="{DynamicResource Ink40}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="Bold" FontSize="14" LetterSpacing="0.3"
                     TextTrimming="CharacterEllipsis" MaxLines="1" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid>
    <!-- ===================== Browsing mode ===================== -->
    <Grid RowDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding ActiveEditor, Converter={x:Static conv:ObjectConverters.IsNull}}">

      <StackPanel Grid.Row="0" Spacing="6" Margin="36,30,36,20">
        <TextBlock Text="{loc:Tr Notes_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
        <TextBlock Text="{loc:Tr Notes_PageTitle, Converter={StaticResource UpperCaseConverter}}" Classes="page-title" />
        <TextBlock Text="{loc:Tr Notes_PageSubtitle}"
                   Classes="page-subtitle" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="36,0,36,18">
        <Button Grid.Column="0" Classes="pill" Height="36" Command="{Binding NewNoteCommand}" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="NotePlusOutline" Width="15" Height="15" />
            <TextBlock Text="{loc:Tr Notes_NewNoteButton, Converter={StaticResource UpperCaseConverter}}" />
          </StackPanel>
        </Button>

        <!-- Junto a "Nueva nota" y no en un menú: es la misma acción —crear una nota— con un punto de
             partida distinto, y esconderla la dejaría sin descubrir. -->
        <Button Grid.Column="1" Classes="pill" Height="36" Command="{Binding ShowTemplatePickerCommand}" Margin="0,0,10,0"
                ToolTip.Tip="{loc:Tr Notes_Templates_Tooltip}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="FileDocumentMultipleOutline" Width="15" Height="15" />
            <TextBlock Text="{loc:Tr Notes_Templates_Button, Converter={StaticResource UpperCaseConverter}}" />
          </StackPanel>
        </Button>

        <!-- Importar y, pegado a él, el web clipper (T3): las dos formas de traer algo de fuera al vault,
             así que comparten sitio igual que la nota diaria y su calendario de constancia más a la
             derecha. El clipper va como botón de icono porque su diálogo vive en el shell y no en esta
             pantalla — abrir el popup es todo lo que hace desde aquí. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="0,0,14,0">
          <Button Classes="pill" Height="36" Command="{Binding ImportCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="TrayArrowDown" Width="15" Height="15" />
              <TextBlock Text="{loc:Tr Notes_ImportButton, Converter={StaticResource UpperCaseConverter}}" />
            </StackPanel>
          </Button>

          <Button Classes="icon-btn" Width="34" Height="34" VerticalAlignment="Center"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).WebClip.ShowCommand}"
                  ToolTip.Tip="{loc:Tr WebClip_Title}"
                  AutomationProperties.Name="{loc:Tr WebClip_Title}">
            <mi:MaterialIcon Kind="WebPlus" Width="16" Height="16" />
          </Button>
        </StackPanel>

        <!-- Nota diaria y, pegado a ella, el calendario de constancia: son la misma idea vista de dos
             maneras (la nota de hoy y el rastro de todas las demás), así que comparten sitio en la
             cabecera en vez de esconder el calendario en un menú. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="0,0,14,0">
          <Button Classes="pill" Height="36" Command="{Binding OpenDailyNoteCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="CalendarToday" Width="15" Height="15" />
              <TextBlock Text="{loc:Tr Notes_DailyNoteButton, Converter={StaticResource UpperCaseConverter}}" />
            </StackPanel>
          </Button>

          <Panel>
            <Button x:Name="ConsistencyTrigger" Classes="icon-btn" Classes.active="{Binding IsConsistencyOpen}"
                    Width="34" Height="34" VerticalAlignment="Center"
                    Command="{Binding ToggleConsistencyCommand}"
                    ToolTip.Tip="{loc:Tr Notes_Consistency_Tooltip}"
                    AutomationProperties.Name="{loc:Tr Notes_Consistency_Tooltip}">
              <mi:MaterialIcon Kind="CalendarCheckOutline" Width="16" Height="16" />
            </Button>
            <!-- Sin OverlayInputPassThroughElement y con IsOpen en TwoWay: el cierre por clic fuera
                 devuelve el estado al viewmodel, y un clic sobre el propio botón mientras el panel está
                 abierto lo cierra (con pass-through volvería a abrirlo en el mismo gesto). -->
            <Popup PlacementTarget="{Binding #ConsistencyTrigger}" Placement="BottomEdgeAlignedLeft" VerticalOffset="4"
                   IsLightDismissEnabled="True"
                   IsOpen="{Binding IsConsistencyOpen, Mode=TwoWay}">
              <Border Classes="dropdown-popover" MaxHeight="560">
                <views:DailyConsistencyView />
              </Border>
            </Popup>
          </Panel>
        </StackPanel>

        <!-- Workspace selector: the vault itself, o una de sus sesiones aisladas (§ sesiones). -->
        <ComboBox Grid.Column="4" Height="36" Margin="0,0,14,0" MinWidth="190"
                  ItemsSource="{Binding SessionOptions}" SelectedItem="{Binding SelectedSessionOption}"
                  AutomationProperties.Name="{loc:Tr A11y_Notes_SessionSelector}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:SessionOptionViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="{Binding IsVault, Converter={StaticResource SessionIconConverter}}"
                                  Width="13" Height="13" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{Binding DisplayName}" FontSize="12" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBox Grid.Column="5" Classes="search" Height="36" PlaceholderText="{loc:Tr Notes_SearchPlaceholder}" Text="{Binding SearchText}"
                  MaxWidth="360" HorizontalAlignment="Left" VerticalAlignment="Center">
          <TextBox.InnerLeftContent>
            <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"
                    Margin="10,0,0,0" />
          </TextBox.InnerLeftContent>
        </TextBox>

        <Border Grid.Column="6" Classes="card" Padding="14,9" VerticalAlignment="Center">
          <TextBlock Text="{Binding NotesCountLabel}" Classes="faint" FontSize="10.5" />
        </Border>
      </Grid>

      <views:TagFilterView Grid.Row="2" DataContext="{Binding TagFilter}" Margin="36,0,36,12" />

      <Grid Grid.Row="3" Margin="24,0,24,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260" MinWidth="180" MaxWidth="480" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Panel de carpetas ===================== -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource Ink10}" BorderThickness="1,1,0,1"
                Background="{DynamicResource AppBackgroundAltBrush}" Padding="10,12">
          <Grid RowDefinitions="Auto,Auto,Auto,*">

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="12,0,0,10">
              <mi:MaterialIcon Kind="FolderOutline" Width="14" Height="14" Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Tr Notes_FoldersEyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Row="1" Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="10,8" Margin="0,0,0,12" Command="{Binding NewFolderCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="FolderPlusOutline" Width="13" Height="13" />
                <TextBlock Text="{loc:Tr Notes_NewFolderButton, Converter={StaticResource UpperCaseConverter}}" FontSize="11" />
              </StackPanel>
            </Button>

            <Border Grid.Row="2" Classes="folder-row" Margin="0,0,0,4"
                    Classes.active="{Binding CurrentFolder, Converter={x:Static conv:ObjectConverters.IsNull}}"
                    Classes.drag-over="{Binding IsRootDropTarget}"
                    DragDrop.AllowDrop="True"
                    PointerPressed="RootFolderRow_PointerPressed"
                    DragDrop.DragEnter="RootFolderRow_DragEnter"
                    DragDrop.DragOver="RootFolderRow_DragOver"
                    DragDrop.DragLeave="RootFolderRow_DragLeave"
                    DragDrop.Drop="RootFolderRow_Drop">
              <StackPanel Orientation="Horizontal" Spacing="8" Height="34" VerticalAlignment="Center" Margin="14,0,0,0">
                <mi:MaterialIcon Kind="ViewGridOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Notes_AllFolderLabel}" FontSize="13.5" VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="3">
              <ItemsControl ItemsSource="{Binding RootFolders}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- Separador arrastrable: cambia el ancho de la ColumnDefinition[0] (con Min/MaxWidth arriba)
             dejando intacto el resto del layout. La costura visible es una Border de 1px propia
             (mismo lenguaje que el resto de bordes Ink10/InkBrush); el GridSplitter en sí queda
             transparente y sólo aporta el área de agarre de 7px, más cómoda que un borde de 1px. -->
        <Border Grid.Column="1" Width="1" HorizontalAlignment="Center"
                Background="{DynamicResource Ink10}" IsHitTestVisible="False" />
        <GridSplitter Grid.Column="1" Classes="folder-panel-splitter" Width="7"
                      Background="Transparent" ResizeDirection="Columns"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      AutomationProperties.Name="{loc:Tr A11y_Notes_FolderPanelSplitter}" />

        <!-- ===================== Rejilla de notas ===================== -->
        <Border Grid.Column="2" ClipToBounds="True"
                BorderBrush="{DynamicResource Ink10}" BorderThickness="1"
                Background="{DynamicResource AppBackgroundAltBrush}">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{loc:Tr Explorer_Paste}" InputGesture="Ctrl+V" Command="{Binding PasteEntryCommand}" />
              <Separator />
              <MenuItem Header="{loc:Tr Notes_NewNoteButton}" Command="{Binding NewNoteCommand}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="NotePlusOutline" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{loc:Tr Notes_Templates_Tooltip}" Command="{Binding ShowTemplatePickerCommand}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="FileDocumentMultipleOutline" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{loc:Tr Notes_NewFolderButton}" Command="{Binding NewFolderCommand}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="FolderPlusOutline" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </Border.ContextMenu>
          <Grid RowDefinitions="Auto,*">

            <TextBlock Grid.Row="0" Text="{Binding CurrentFolderLabel}"
                       Classes="eyebrow" Margin="24,16,24,0" />

            <Grid Grid.Row="1">
              <!-- Margin en el contenido en vez de Padding en el ScrollViewer (mismo motivo que en
                   DashboardView: Avalonia 12 resta el padding del extent scrolleable, así que la última
                   fila de tarjetas quedaba cortada al llegar al final del scroll). -->
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding BrowserItems}" Margin="24">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:NoteCardViewModel">
                      <Button Classes="note-card" Margin="0,0,16,16" Width="224" Height="150"
                              Command="{Binding $parent[ItemsControl].((vm:NotesViewModel)DataContext).OpenCardCommand}"
                              CommandParameter="{Binding}"
                              Initialized="NoteCard_Initialized"
                              AutomationProperties.Name="{Binding Title}">
                        <Button.ContextMenu>
                          <ContextMenu>
              <MenuItem Header="{loc:Tr Explorer_Copy}" InputGesture="Ctrl+C" Command="{Binding #Root.((vm:NotesViewModel)DataContext).CopyEntryCommand}" CommandParameter="{Binding}" />
              <MenuItem Header="{loc:Tr Explorer_Cut}" InputGesture="Ctrl+X" Command="{Binding #Root.((vm:NotesViewModel)DataContext).CutEntryCommand}" CommandParameter="{Binding}" />
              <MenuItem Header="{loc:Tr Explorer_Paste}" InputGesture="Ctrl+V" Command="{Binding #Root.((vm:NotesViewModel)DataContext).PasteEntryCommand}" CommandParameter="{Binding}" />
              <Separator />
                            <MenuItem Header="{loc:Tr Notes_RenameMenuItem}" Command="{Binding BeginRenameCommand}">
                              <MenuItem.Icon>
                                <mi:MaterialIcon Kind="PencilOutline" Width="14" Height="14" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Tr Notes_RevealInSystemMenuItem}" Command="{Binding RevealInSystemCommand}">
                              <MenuItem.Icon>
                                <mi:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Tr Notes_ExportHtmlMenuItem}"
                                      Command="{Binding #Root.((vm:NotesViewModel)DataContext).ExportNoteAsHtmlCommand}"
                                      CommandParameter="{Binding}">
                              <MenuItem.Icon>
                                <mi:MaterialIcon Kind="FileExportOutline" Width="14" Height="14" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <!-- PNG y PDF (T8): la hoja la compone Services.Export.NotePageComposer a
                                 partir del Markdown, no se rasteriza el editor (que virtualiza líneas). -->
                            <MenuItem Header="{loc:Tr Export_ToPng}"
                                      Command="{Binding #Root.((vm:NotesViewModel)DataContext).ExportNoteAsPngCommand}"
                                      CommandParameter="{Binding}">
                              <MenuItem.Icon>
                                <mi:MaterialIcon Kind="ImageOutline" Width="14" Height="14" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Tr Export_ToPdf}"
                                      Command="{Binding #Root.((vm:NotesViewModel)DataContext).ExportNoteAsPdfCommand}"
                                      CommandParameter="{Binding}">
                              <MenuItem.Icon>
                                <mi:MaterialIcon Kind="FilePdfBox" Width="14" Height="14" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Tr Common_Delete}"
                                      Command="{Binding #Root.((vm:NotesViewModel)DataContext).RequestDeleteNoteCommand}"
                                      CommandParameter="{Binding}">
                              <MenuItem.Icon>
                                <mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" />
                              </MenuItem.Icon>
                            </MenuItem>
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Grid RowDefinitions="Auto,*,Auto,Auto">
                          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource InkBrush}" />
                            <TextBlock Text="{Binding ModifiedLabel}" Classes="faint" />
                          </StackPanel>
                          <StackPanel Grid.Row="1" Spacing="5" Margin="0,10,0,0">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="Bold" FontSize="14" LetterSpacing="0.3"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                       IsVisible="{Binding !IsRenaming}" />
                            <TextBox Text="{Binding EditingName}" IsVisible="{Binding IsRenaming}"
                                      FontSize="13" Padding="4,2"
                                      KeyDown="NoteNameEdit_KeyDown" LostFocus="NoteNameEdit_LostFocus"
                                      Initialized="NoteNameEdit_Initialized"
                                      PropertyChanged="NoteNameEdit_PropertyChanged" />
                            <TextBlock Text="{Binding Preview}" Classes="muted" FontSize="12"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3" />
                          </StackPanel>
                          <TextBlock Grid.Row="2" Text="{Binding FileNameLabel}" Classes="faint"
                                     TextTrimming="CharacterEllipsis" MaxLines="1" />
                          <TextBlock Grid.Row="3" Text="{Binding TagsLabel}" Classes="faint"
                                     TextTrimming="CharacterEllipsis" MaxLines="1"
                                     IsVisible="{Binding HasTags}" Margin="0,4,0,0" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <StackPanel IsVisible="{Binding ShowEmptyState}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Spacing="12">
                <mi:MaterialIcon Kind="NoteTextOutline" Width="40" Height="40" Foreground="{DynamicResource TextMutedBrush}"
                        HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr Notes_EmptyState_Message}" Classes="muted" HorizontalAlignment="Center" />
                <Button Classes="pill-primary" Command="{Binding NewNoteCommand}" HorizontalAlignment="Center">
                  <TextBlock Text="{loc:Tr Notes_EmptyState_CreateButton, Converter={StaticResource UpperCaseConverter}}" />
                </Button>
              </StackPanel>

              <!-- Sesión protegida y bloqueada: leer el contenido de sus notas lanzaría SessionLockedException
                   (docs/version-alfa-3/01-analisis-detallado.md §4.1) — hay que desbloquearla desde Sesiones
                   primero, mismo tratamiento que ya tiene Archivos para el mismo caso. -->
              <StackPanel IsVisible="{Binding IsSelectedSessionLocked}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Spacing="12" MaxWidth="280">
                <mi:MaterialIcon Kind="LockOutline" Width="40" Height="40" Foreground="{DynamicResource TextMutedBrush}"
                        HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr Notes_LockedSession_Message}" Classes="muted" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- ===================== Editor mode ===================== -->
    <Grid RowDefinitions="Auto,*"
          IsVisible="{Binding ActiveEditor, Converter={x:Static conv:ObjectConverters.IsNotNull}}">

      <views:EditorTabStripView Grid.Row="0" />

      <views:EditorView Grid.Row="1" DataContext="{Binding ActiveEditor}" />
    </Grid>
  </Grid>
</UserControl>
