<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="clr-namespace:enki.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:models="clr-namespace:enki.Models"
             xmlns:baseconv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:motion="clr-namespace:enki.Views"
        xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="enki.Views.CalendarView"
             x:DataType="vm:CalendarViewModel"
             Focusable="True" Loaded="CalendarView_Loaded" KeyDown="CalendarView_KeyDown">

  <UserControl.Styles>
    <!-- Cabeceras plegables: solo el texto y la flecha reflejan la interacción. -->
    <Style Selector="ToggleButton.calendar-section-toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.calendar-section-toggle /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToggleButton.calendar-section-toggle TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{Binding $parent[ToggleButton].Foreground}" />
    </Style>
    <Style Selector="ToggleButton.calendar-section-toggle mi|MaterialIcon">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{Binding $parent[ToggleButton].Foreground}" />
    </Style>
    <Style Selector="ToggleButton.calendar-section-toggle:checked, ToggleButton.calendar-section-toggle:pointerover, ToggleButton.calendar-section-toggle:focus-visible">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.calendar-section-toggle:pressed">
      <Setter Property="Foreground" Value="{DynamicResource Ink60}" />
    </Style>
    <!-- Plantilla sin rellenos de estado de Fluent para la cabecera mensual. -->
    <Style Selector="ToggleButton.calendar-mini-toggle">
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center"
                            Background="Transparent" BorderThickness="0" />
        </ControlTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>

    <!-- Fila del resumen de hoy (diálogo "Hoy"): barra de color de la capa, casilla de completar (o el
         icono de origen si el item no se puede completar, p. ej. una tarjeta de Kanban), título + origen
         pulsable para abrir su editor, y la hora a la derecha. Sin popover de detalle anidado a propósito:
         dentro de un modal, un segundo emergente encima es una capa de más. -->
    <DataTemplate x:Key="CalendarTodayItemTemplate" x:DataType="vm:CalendarItemViewModel">
      <Border BorderBrush="{DynamicResource Ink10}" BorderThickness="0,0,0,1" Padding="0,8">
        <Grid ColumnDefinitions="3,Auto,*,Auto">
          <Rectangle Grid.Column="0" VerticalAlignment="Stretch"
                     Fill="{Binding EffectiveBorderColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
          <Panel Grid.Column="1" Width="30" Margin="8,0,4,0" VerticalAlignment="Center">
            <Button Classes="icon-btn" Width="26" Height="26" IsVisible="{Binding CanToggleComplete}"
                    Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).ToggleCompleteItemCommand}"
                    CommandParameter="{Binding}" ToolTip.Tip="{Binding CompletedToggleLabel}"
                    AutomationProperties.Name="{Binding CompletedToggleLabel}">
              <mi:MaterialIcon Kind="{Binding CompletedToggleIcon}" Width="16" Height="16" />
            </Button>
            <mi:MaterialIcon Kind="{Binding IconKind}" Width="14" Height="14" IsVisible="{Binding !CanToggleComplete}"
                             Foreground="{Binding EffectiveBorderColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
          </Panel>
          <Button Grid.Column="2" Classes="ghost" Padding="4,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).OpenTodayItemCommand}"
                  CommandParameter="{Binding}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{loc:Tr Common_Edit}">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding Title}" Classes="calendar-detail-title" Classes.completed="{Binding IsCompleted}"
                         FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding SourceLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9" LetterSpacing="2" />
                <TextBlock Text="{Binding ParentContextLabel}" Classes="faint" FontSize="10" IsVisible="{Binding HasParentContext}"
                           TextTrimming="CharacterEllipsis" />
                <mi:MaterialIcon Kind="Repeat" Width="9" Height="9" VerticalAlignment="Center"
                                 IsVisible="{Binding IsGhostOccurrence}" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Calendar_Item_Overdue, Converter={StaticResource UpperCaseConverter}}" Classes="faint overdue" FontSize="9" IsVisible="{Binding IsPastDue}" />
              </StackPanel>
            </StackPanel>
          </Button>
          <Panel Grid.Column="3" Margin="10,0,4,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding TimeLabel}" Classes="faint" FontSize="11" IsVisible="{Binding !IsAllDay}" />
            <TextBlock Text="{loc:Tr Calendar_WeekView_AllDayRowLabel}" Classes="faint" FontSize="10" IsVisible="{Binding IsAllDay}" />
          </Panel>
        </Grid>
      </Border>
    </DataTemplate>
    <!-- Fase 3 (docs/calendar-feature/05-interacciones-y-microinteracciones.md §4–7,
         06-creacion-y-edicion-de-items.md §3/§5): cuerpo del popover de detalle, compartido entre el chip
         de Mes/franja "todo el día"/Agenda (CalendarChipTemplate) y el chip posicionado por hora de
         Semana/Día (CalendarTimedChipTemplate) — ambos lo envuelven en un ContentControl en vez de
         duplicar este árbol dos veces. -->
    <DataTemplate x:Key="CalendarDetailBodyTemplate" x:DataType="vm:CalendarItemViewModel">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding SourceLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="10"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{loc:Tr Calendar_Item_Completed, Converter={StaticResource UpperCaseConverter}}" Classes="faint" FontSize="9.5"
                     IsVisible="{Binding IsCompleted}" />
        </Grid>

        <TextBlock Text="{Binding Title}" Classes="calendar-detail-title" Classes.completed="{Binding IsCompleted}"
                   FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />

        <!-- Ocurrencia fantasma (docs/calendar-feature/03-glosario-y-modelo-de-datos.md §4): la fecha real
             se sustituye por la nota de previsualización, nunca se muestran ambas a la vez. -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsGhostOccurrence}">
          <TextBlock Text="{Binding DueDateLabel}" Classes="faint" FontSize="10.5"
                     Classes.overdue="{Binding IsPastDue}" />
          <TextBlock Text="{loc:Tr Calendar_Item_Overdue, Converter={StaticResource UpperCaseConverter}}" Classes="faint overdue" FontSize="9.5" IsVisible="{Binding IsPastDue}" />
        </StackPanel>
        <TextBlock Text="{Binding GhostOccurrenceNoteLabel}" Classes="faint" FontSize="10.5"
                   IsVisible="{Binding IsGhostOccurrence}" />

        <TextBlock Text="{Binding ParentContextLabel}" Classes="faint" FontSize="10.5"
                   IsVisible="{Binding HasParentContext}" />

        <Rectangle Height="1" Fill="{DynamicResource Ink10}" IsVisible="{Binding HasDescription}" />
        <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding HasDescription}" />

        <!-- Subtareas de solo lectura salvo el checkbox — doc 06 §5. -->
        <StackPanel Spacing="6" IsVisible="{Binding HasSubtasksOrChildren}">
          <Rectangle Height="1" Fill="{DynamicResource Ink10}" />
          <ItemsControl ItemsSource="{Binding Subtasks}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CalendarSubtaskViewModel">
                <Grid ColumnDefinitions="Auto,*">
                  <Button Grid.Column="0" Classes="icon-btn" Width="22" Height="22"
                          Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).ToggleSubtaskCommand}"
                          CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Calendar_Item_MarkCompleted}"
                          AutomationProperties.Name="{loc:Tr Calendar_Item_MarkCompleted}">
                    <mi:MaterialIcon Kind="{Binding CheckIcon}" Width="13" Height="13" />
                  </Button>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11.5" VerticalAlignment="Center"
                             Margin="4,0,0,0" TextWrapping="Wrap" Classes="faint" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Acciones — doc 05 §4–6. Marcar completada y Editar en filas separadas para que no
             se solapen en el ancho estrecho del popover (§la fila única los apretaba). -->
        <Rectangle Height="1" Fill="{DynamicResource Ink10}" />
        <StackPanel Spacing="8">
          <Button Classes="ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  IsVisible="{Binding CanToggleComplete}"
                  Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).ToggleCompleteItemCommand}"
                  CommandParameter="{Binding}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="{Binding CompletedToggleIcon}" Width="14" Height="14" />
              <TextBlock Text="{Binding CompletedToggleLabel, Converter={StaticResource UpperCaseConverter}}" FontSize="10.5" />
            </StackPanel>
          </Button>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CanEdit}">
            <Button Grid.Column="0" Classes="ghost" Padding="0" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).RequestEditItemCommand}"
                    CommandParameter="{Binding}">
              <TextBlock Text="{loc:Tr Common_Edit, Converter={StaticResource UpperCaseConverter}}" FontSize="10.5" />
            </Button>
            <Button Grid.Column="1" Classes="icon-btn icon-btn-danger" Width="28" Height="28" IsVisible="{Binding CanDelete}"
                    Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).RequestDeleteItemCommand}"
                    CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Common_Delete}"
                    AutomationProperties.Name="{loc:Tr Common_Delete}">
              <mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" />
            </Button>
          </Grid>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- Shared by the month cell's chip list, its "+N más" overflow popover, the Semana/Día all-day
         strip and the Agenda list, so a chip (icon + title + time) and its own read-only detail popover
         are only ever defined once — docs/calendar-feature/04-vistas-y-navegacion.md §2/§3/§6/§8. -->
    <DataTemplate x:Key="CalendarChipTemplate" x:DataType="vm:CalendarItemViewModel">
      <Panel Margin="0,1">
        <ToggleButton x:Name="ChipToggle" Classes="calendar-chip" Classes.completed="{Binding IsCompleted}"
                      Classes.ghost="{Binding IsGhostOccurrence}"
                      BorderBrush="{Binding EffectiveBorderColorHex, Converter={StaticResource HexColorToBrushConverter}, ConverterParameter=0.4}"
                      Background="{Binding ChipBackgroundColorHex, Converter={StaticResource HexColorToBrushConverter}, ConverterParameter=0.08}"
                      Initialized="Chip_Initialized">
          <Panel>
            <!-- Icono y texto en la misma línea óptica: la fuente mono asienta sus glifos en la mitad
                 baja de la caja de línea (mucho más hueco por encima que por debajo), así que un icono
                 centrado en la fila quedaba visiblemente por encima del texto. Un empujón de 1px hacia
                 abajo en el icono lo alinea con la masa visible del texto. -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <mi:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="9" Height="9" Margin="0,1,4,0"
                                VerticalAlignment="Center"
                                Foreground="{Binding EffectiveBorderColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="10.5" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <!-- Ocurrencia fantasma — doc 10 §4: glifo de repetición junto al título. -->
              <mi:MaterialIcon Grid.Column="2" Kind="Repeat" Width="9" Height="9" Margin="4,1,0,0"
                                VerticalAlignment="Center" IsVisible="{Binding IsGhostOccurrence}"
                                Foreground="{DynamicResource Ink40}" />
              <TextBlock Grid.Column="3" Text="{Binding TimeLabel}" Classes="faint" FontSize="9"
                         Margin="4,0,0,0" VerticalAlignment="Center" IsVisible="{Binding !IsAllDay}" />
            </Grid>
            <!-- Búsqueda activa (doc 07 §2): "resalta, no navega" — línea de acento inferior en vez de
                 tocar Background/BorderBrush, que ya están enlazados a LayerColor/EffectiveBorderColorHex. -->
            <Border Classes="calendar-chip-search-accent" IsVisible="{Binding IsSearchMatch}" />
          </Panel>

          <!-- Menú contextual — doc 05 §7: mismas acciones que el popover de detalle. -->
          <ToggleButton.ContextMenu>
            <ContextMenu IsVisible="{Binding CanEdit}">
              <MenuItem Header="{loc:Tr Common_Edit, Converter={StaticResource UpperCaseConverter}}" IsVisible="{Binding CanEdit}"
                        Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).RequestEditItemCommand}"
                        CommandParameter="{Binding}" />
              <MenuItem Header="{Binding CompletedToggleLabel, Converter={StaticResource UpperCaseConverter}}" IsVisible="{Binding CanToggleComplete}"
                        Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).ToggleCompleteItemCommand}"
                        CommandParameter="{Binding}" />
              <Separator />
              <MenuItem Header="{loc:Tr Common_Delete, Converter={StaticResource UpperCaseConverter}}" IsVisible="{Binding CanDelete}"
                        Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).RequestDeleteItemCommand}"
                        CommandParameter="{Binding}" />
            </ContextMenu>
          </ToggleButton.ContextMenu>
        </ToggleButton>

        <Popup PlacementTarget="{Binding #ChipToggle}" Placement="Bottom" VerticalOffset="4"
               IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #ChipToggle}"
               IsOpen="{Binding #ChipToggle.IsChecked, Mode=TwoWay}">
          <Border Classes="calendar-popover" Width="280">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CalendarDetailBodyTemplate}" />
     </Border>
        </Popup>
      </Panel>
    </DataTemplate>

    <!-- Vista Agenda: mismo modelo/acciones que CalendarChipTemplate (popover de detalle, menú
         contextual, acento de búsqueda, opacidad de ocurrencia fantasma) pero como tarjeta de fila alta
         en vez de chip compacto — el chip de Mes tiene que caber en una celda diminuta, la Agenda es una
         lista de ancho completo y puede permitirse más aire y jerarquía tipográfica real. -->
    <DataTemplate x:Key="CalendarAgendaItemTemplate" x:DataType="vm:CalendarItemViewModel">
      <Panel Margin="0,3">
        <ToggleButton x:Name="AgendaCardToggle" Classes="calendar-agenda-card" Classes.completed="{Binding IsCompleted}"
                      Classes.ghost="{Binding IsGhostOccurrence}"
                      Initialized="Chip_Initialized">
          <Panel>
            <Grid ColumnDefinitions="3,Auto,*,Auto">
              <Rectangle Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         Fill="{Binding EffectiveBorderColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
              <mi:MaterialIcon Grid.Column="1" Kind="{Binding IconKind}" Width="15" Height="15" Margin="15,14,10,14"
                                VerticalAlignment="Center"
                                Foreground="{Binding EffectiveBorderColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
              <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center" Margin="0,12">
                <TextBlock Text="{Binding Title}" Classes="calendar-detail-title" Classes.completed="{Binding IsCompleted}"
                           FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding SourceLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9" LetterSpacing="2" />
                  <mi:MaterialIcon Kind="Repeat" Width="9" Height="9" VerticalAlignment="Center"
                                    IsVisible="{Binding IsGhostOccurrence}" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Calendar_Item_Overdue, Converter={StaticResource UpperCaseConverter}}" Classes="faint overdue" FontSize="9" IsVisible="{Binding IsPastDue}" />
                </StackPanel>
                <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                           MaxLines="2" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDescription}" />
              </StackPanel>
              <TextBlock Grid.Column="3" Text="{Binding TimeLabel}" Classes="faint" FontSize="11"
                         Margin="10,14,14,14" VerticalAlignment="Center" IsVisible="{Binding !IsAllDay}" />
            </Grid>
            <Border Classes="calendar-chip-search-accent" IsVisible="{Binding IsSearchMatch}" />
          </Panel>

          <ToggleButton.ContextMenu>
            <ContextMenu IsVisible="{Binding CanEdit}">
              <MenuItem Header="{loc:Tr Common_Edit, Converter={StaticResource UpperCaseConverter}}" IsVisible="{Binding CanEdit}"
                        Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).RequestEditItemCommand}"
                        CommandParameter="{Binding}" />
              <MenuItem Header="{Binding CompletedToggleLabel, Converter={StaticResource UpperCaseConverter}}" IsVisible="{Binding CanToggleComplete}"
                        Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).ToggleCompleteItemCommand}"
                        CommandParameter="{Binding}" />
              <Separator />
              <MenuItem Header="{loc:Tr Common_Delete, Converter={StaticResource UpperCaseConverter}}" IsVisible="{Binding CanDelete}"
                        Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).RequestDeleteItemCommand}"
                        CommandParameter="{Binding}" />
            </ContextMenu>
          </ToggleButton.ContextMenu>
        </ToggleButton>

        <Popup PlacementTarget="{Binding #AgendaCardToggle}" Placement="Bottom" VerticalOffset="4"
               IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #AgendaCardToggle}"
               IsOpen="{Binding #AgendaCardToggle.IsChecked, Mode=TwoWay}">
          <Border Classes="calendar-popover" Width="280">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CalendarDetailBodyTemplate}" />
     </Border>
        </Popup>
      </Panel>
    </DataTemplate>

    <!-- Same chip + detail popover as above, but absolutely positioned on the Semana/Día hour grid via
         TopOffset/Height instead of flowing in a stack — see CalendarTimedItemViewModel. Kept as its own
         template (rather than reusing CalendarChipTemplate through an extra wrapper) because its DataType
         is the CalendarTimedItemViewModel positioning wrapper, not the raw CalendarItemViewModel. This
         template only ever handles the vertical axis (Margin/Height, above) — the horizontal slice for
         items with overlapping time ranges is the hosting controls:CalendarTimedItemsPanel's job, reading
         LeftFraction/WidthFraction off the same DataContext (análisis §4.4, Fase 8). -->
    <DataTemplate x:Key="CalendarTimedChipTemplate" x:DataType="vm:CalendarTimedItemViewModel">
      <Panel VerticalAlignment="Top" Height="{Binding Height}"
             Margin="{Binding TopOffset, Converter={StaticResource TopOffsetToMarginConverter}}">
        <ToggleButton x:Name="TimedChipToggle" Classes="calendar-chip calendar-chip-timed" Classes.completed="{Binding Item.IsCompleted}"
                      Classes.ghost="{Binding Item.IsGhostOccurrence}"
                      Margin="2,0,6,0"
                      BorderBrush="{Binding Item.EffectiveBorderColorHex, Converter={StaticResource HexColorToBrushConverter}, ConverterParameter=0.5}"
                      Background="{Binding Item.ChipBackgroundColorHex, Converter={StaticResource HexColorToBrushConverter}, ConverterParameter=0.14}"
                      Initialized="TimedChip_Initialized">
          <Panel>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <!-- Franja horaria (doc 10 §4): aquí arriba solo la hora de INICIO — la de fin va anclada
                   abajo (más abajo en este mismo Panel), para que ambas queden donde realmente ocurren en
                   vez de las dos apretadas en una sola línea. Para un item sin duración esto sigue
                   mostrando exactamente lo mismo que antes (una hora sola). -->
              <TextBlock Grid.Column="0" Text="{Binding Item.MomentLocal, StringFormat={}{0:HH:mm}}"
                         Classes="faint" FontSize="9.5" IsVisible="{Binding !Item.IsAllDay}"
                         Margin="0,0,5,0" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" Text="{Binding Item.Title}" FontSize="11.5" FontWeight="Medium"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
              <mi:MaterialIcon Grid.Column="2" Kind="Repeat" Width="10" Height="10" Margin="4,0,0,0"
                                VerticalAlignment="Top" IsVisible="{Binding Item.IsGhostOccurrence}"
                                Foreground="{DynamicResource Ink40}" />
            </Grid>

            <!-- Hora de FIN, anclada al borde inferior del bloque, justo encima del asa de redimensionado
                 — junto con la hora de inicio de arriba, deja "empieza aquí / termina aquí" visible de un
                 vistazo tanto en Semana como en Día (ambas comparten este mismo template). -->
            <TextBlock Text="{Binding Item.EndTimeLabel}" Classes="faint calendar-chip-end-time" FontSize="9.5"
                       IsVisible="{Binding Item.HasDuration}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />

            <Border Classes="calendar-chip-search-accent" IsVisible="{Binding Item.IsSearchMatch}" />
          </Panel>

          <ToggleButton.ContextMenu>
            <ContextMenu IsVisible="{Binding Item.CanEdit}">
              <MenuItem Header="{loc:Tr Common_Edit, Converter={StaticResource UpperCaseConverter}}" IsVisible="{Binding Item.CanEdit}"
                        Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).RequestEditItemCommand}"
                        CommandParameter="{Binding Item}" />
              <MenuItem Header="{Binding Item.CompletedToggleLabel, Converter={StaticResource UpperCaseConverter}}" IsVisible="{Binding Item.CanToggleComplete}"
                        Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).ToggleCompleteItemCommand}"
                        CommandParameter="{Binding Item}" />
              <Separator />
              <MenuItem Header="{loc:Tr Common_Delete, Converter={StaticResource UpperCaseConverter}}" IsVisible="{Binding Item.CanDelete}"
                        Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).RequestDeleteItemCommand}"
                        CommandParameter="{Binding Item}" />
            </ContextMenu>
          </ToggleButton.ContextMenu>
        </ToggleButton>

        <!-- Franja horaria (doc 05 §2b): asa de redimensionado, solo para un CalendarItemViewModel.CanResize
             (tarjeta Kanban real, con hora, no fantasma) — arrastrar ajusta la duración en pasos de 5
             minutos (CalendarView.axaml.cs, ResizeHandle_*). -->
        <Border Classes="calendar-chip-resize-handle" Margin="2,0,6,0"
                IsVisible="{Binding Item.CanResize}"
                ToolTip.Tip="{loc:Tr Calendar_Item_ResizeTooltip}"
                AutomationProperties.Name="{loc:Tr Calendar_Item_ResizeTooltip}"
                Initialized="ResizeHandle_Initialized">
          <Rectangle />
   </Border>

        <Popup PlacementTarget="{Binding #TimedChipToggle}" Placement="Right" VerticalOffset="0"
               IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #TimedChipToggle}"
               IsOpen="{Binding #TimedChipToggle.IsChecked, Mode=TwoWay}">
          <Border Classes="calendar-popover" Width="280">
            <ContentControl Content="{Binding Item}" ContentTemplate="{StaticResource CalendarDetailBodyTemplate}" />
     </Border>
        </Popup>
      </Panel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="36,30,36,26">

    <!-- Misma presentación flotante que Kanban, por encima del contenido y sin interceptar destinos. -->
    <Canvas x:Name="CalendarDragLayer" ZIndex="100" IsHitTestVisible="False" IsVisible="False" ClipToBounds="True">
      <Border x:Name="CalendarDropIndicator" Background="{DynamicResource InkBrush}" IsVisible="False" />
      <Border x:Name="CalendarDragPreview" Classes="dropdown-popover" Padding="0" BorderThickness="0"
              MaxHeight="Infinity" Background="{DynamicResource AppBackgroundBrush}">
        <Image x:Name="CalendarDragImage" Stretch="Fill" />
      </Border>
    </Canvas>

    <!-- La cabecera ocupa solo la columna lateral; el calendario aprovecha toda la altura. -->
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">

      <StackPanel Grid.Row="0" Grid.Column="0" Width="320" Spacing="6" Margin="0,0,0,22"
                  IsVisible="{Binding !IsSidebarCollapsed}">
        <TextBlock Text="{loc:Tr Calendar_PageEyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
        <TextBlock Text="{loc:Tr Calendar_PageTitle, Converter={StaticResource UpperCaseConverter}}" Classes="page-title" />
        <TextBlock Text="{loc:Tr Calendar_PageSubtitle}"
                   Classes="page-subtitle" />
      </StackPanel>

      <!-- ===================== Sidebar: mini-calendario (§7) ===================== -->
      <Border Grid.Row="1" Grid.Column="0" Classes="calendar-sidebar" Width="320" VerticalAlignment="Stretch"
              IsVisible="{Binding !IsSidebarCollapsed}">
        <ScrollViewer VerticalScrollBarVisibility="{Binding SidebarScrollBarVisibility}" Margin="0,0,-14,0" Padding="0,0,14,0">
        <StackPanel Spacing="22">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="34,*,34">
            <Button Grid.Column="0" Classes="icon-btn calendar-nav" Width="34" Height="34" VerticalAlignment="Center" Command="{Binding MiniCalendarPreviousMonthCommand}"
                    ToolTip.Tip="{loc:Tr Calendar_MiniCalendar_PreviousMonthTooltip}"
                    AutomationProperties.Name="{loc:Tr Calendar_MiniCalendar_PreviousMonthTooltip}">
              <mi:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" />
            </Button>
            <ToggleButton x:Name="MiniCalendarSectionToggle" Grid.Column="1"
                          Classes="calendar-section-toggle calendar-mini-toggle" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" IsChecked="{Binding IsMiniCalendarExpanded, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding MiniCalendarLabel}">
              <Grid ColumnDefinitions="14,*,14" VerticalAlignment="Center">
                <TextBlock Grid.Column="1" Text="{Binding MiniCalendarLabel}" Classes="eyebrow"
                           FontSize="10" LineHeight="14" LetterSpacing="3"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Panel Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="ChevronDown" Width="14" Height="14" IsVisible="{Binding !IsMiniCalendarExpanded}" />
                  <mi:MaterialIcon Kind="ChevronUp" Width="14" Height="14" IsVisible="{Binding IsMiniCalendarExpanded}" />
                </Panel>
              </Grid>
            </ToggleButton>
            <Button Grid.Column="2" Classes="icon-btn calendar-nav" Width="34" Height="34" VerticalAlignment="Center" Command="{Binding MiniCalendarNextMonthCommand}"
                    ToolTip.Tip="{loc:Tr Calendar_MiniCalendar_NextMonthTooltip}"
                    AutomationProperties.Name="{loc:Tr Calendar_MiniCalendar_NextMonthTooltip}">
              <mi:MaterialIcon Kind="ChevronRight" Width="14" Height="14" />
            </Button>
          </Grid>

          <ItemsControl ItemsSource="{Binding MiniWeekdayHeaders}" IsVisible="{Binding IsMiniCalendarExpanded}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="7" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Classes="faint calendar-weekday" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 42 celdas fijas, mismo cálculo que la vista Mes (MonthGridCalculator) — sin chips, solo
               el punto de "tiene contenido" (CalendarMiniDayViewModel.HasItems). -->
          <ItemsControl ItemsSource="{Binding MiniCalendarDays}" IsVisible="{Binding IsMiniCalendarExpanded}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="7" Rows="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CalendarMiniDayViewModel">
                <Button Classes="calendar-day" Classes.outside="{Binding !IsCurrentMonth}"
                        Classes.today="{Binding IsToday}" Classes.selected="{Binding IsSelected}"
                        Command="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).SelectMiniDayCommand}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Date, StringFormat={}{0:D}}">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="{Binding DayLabel}" HorizontalAlignment="Center" />
                    <Border Classes="calendar-mini-dot" IsVisible="{Binding HasItems}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ===================== Capas por origen — docs/calendar-feature/
             07-filtros-busqueda-y-capas.md §1 ===================== -->
        <StackPanel Spacing="8">
          <ToggleButton x:Name="LayersSectionToggle" Classes="calendar-section-toggle" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Padding="8,4"
                        IsChecked="{Binding IsLayersExpanded, Mode=TwoWay}"
                        AutomationProperties.Name="{loc:Tr Calendar_Sidebar_LayersHeader}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{loc:Tr Calendar_Sidebar_LayersHeader, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
              <mi:MaterialIcon Grid.Column="1" Kind="ChevronDown" Width="14" Height="14" IsVisible="{Binding !IsLayersExpanded}" />
              <mi:MaterialIcon Grid.Column="1" Kind="ChevronUp" Width="14" Height="14" IsVisible="{Binding IsLayersExpanded}" />
            </Grid>
          </ToggleButton>
          <StackPanel x:Name="LayersSectionContent" Spacing="8" IsVisible="{Binding IsLayersExpanded}">
            <Border Background="{DynamicResource Ink10}" Padding="1">
              <ItemsControl ItemsSource="{Binding Layers}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CalendarLayerViewModel">
                    <!-- Fila de capa: punto de color (pulsable salvo en la fila madre de Kanban),
                         etiqueta e interruptor. Las sub-filas de columnas de Kanban van indentadas y sin
                         interruptor — ver CalendarViewModel.RebuildLayers. -->
                    <Border Background="{DynamicResource PanelBackgroundBrush}" Padding="7,6">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Ancho fijo para que las etiquetas queden alineadas tenga o no punto la fila
                             (la fila madre KANBAN no lo tiene: es solo el encabezado del grupo). -->
                        <Panel Grid.Column="0" Width="14" VerticalAlignment="Center"
                               Margin="{Binding IndentMargin}">
                          <ToggleButton x:Name="LayerColorToggle" Classes="calendar-layer-color"
                                        IsVisible="{Binding CanEditColor}"
                                        IsChecked="{Binding IsColorPickerOpen, Mode=TwoWay}"
                                        AutomationProperties.Name="{loc:Tr Calendar_Layers_EditColor}"
                                        ToolTip.Tip="{loc:Tr Calendar_Layers_EditColor}">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding ColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
                          </ToggleButton>
                        </Panel>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="10.5" Margin="8,0,6,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Opacity="{Binding LabelOpacity}" />
                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsActive}" OnContent="" OffContent=""
                                      IsVisible="{Binding ShowToggle}"
                                      AutomationProperties.Name="{Binding Label}" />

                        <!-- Selector de color: rejilla de sugerencias + hex libre + "automático".
                             Emergente anclado (no modal) porque es un ajuste de una sola propiedad y el
                             usuario quiere ver el calendario detrás mientras compara colores. -->
                        <Popup PlacementTarget="{Binding #LayerColorToggle}" Placement="RightEdgeAlignedTop"
                               HorizontalOffset="8" IsLightDismissEnabled="True"
                               OverlayInputPassThroughElement="{Binding #LayerColorToggle}"
                               IsOpen="{Binding IsColorPickerOpen, Mode=TwoWay}">
                          <Border Classes="calendar-popover" Width="340" Padding="18">
                            <StackPanel Spacing="10">
                              <StackPanel Spacing="3">
                                <TextBlock Text="{loc:Tr Calendar_Layers_ColorTitle, Converter={StaticResource UpperCaseConverter}}"
                                           Classes="eyebrow" FontSize="9" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold"
                                           TextWrapping="Wrap" />
                              </StackPanel>

                              <ItemsControl ItemsSource="{Binding PaletteSwatches}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Button Classes="calendar-layer-swatch" AutomationProperties.Name="{Binding}"
                                            ToolTip.Tip="{Binding}"
                                            Background="{Binding Converter={StaticResource HexColorToBrushConverter}}"
                                            Command="{Binding $parent[ItemsControl].((vm:CalendarLayerViewModel)DataContext).SelectSwatchCommand}"
                                            CommandParameter="{Binding}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>

                              <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Tr ColorPicker_Hex, Converter={StaticResource UpperCaseConverter}}" Classes="muted" FontSize="11" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                  <controls:LocalizedColorPicker Color="{Binding ColorDraft, Mode=TwoWay}"
                                                                 IsAlphaEnabled="False" CornerRadius="0"
                                                                 AutomationProperties.Name="{loc:Tr ColorPicker_Spectrum}" />
                                  <TextBox Grid.Column="1"
                                           Text="{Binding ColorDraftHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Classes="search" FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                           PlaceholderText="#RRGGBB"
                                           AutomationProperties.Name="{loc:Tr ColorPicker_Hex}">
                                    <TextBox.KeyBindings>
                                      <KeyBinding Gesture="Enter" Command="{Binding ApplyDraftColorCommand}" />
                                    </TextBox.KeyBindings>
                                  </TextBox>
                                </Grid>
                                <Button Classes="ghost" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding ApplyDraftColorCommand}"
                                        Content="{loc:Tr Common_Save, Converter={StaticResource UpperCaseConverter}}" />
                              </StackPanel>

                              <!-- "Automático" solo aparece cuando hay un color elegido a mano que
                                   deshacer; si no, no hay nada que restablecer. -->
                              <Button Classes="ghost" HorizontalAlignment="Left" Padding="0"
                                      IsVisible="{Binding HasCustomColor}"
                                      Command="{Binding UseAutomaticColorCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <mi:MaterialIcon Kind="AutoFix" Width="12" Height="12" />
                                  <TextBlock Text="{loc:Tr Calendar_Layers_ColorAutomatic, Converter={StaticResource UpperCaseConverter}}"
                                             FontSize="9.5" />
                                </StackPanel>
                              </Button>

                              <TextBlock Text="{loc:Tr Calendar_Layers_ColorHint}" Classes="faint" FontSize="9"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </Popup>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- ===================== Búsqueda — doc §2: "underline search" (TextBox.search, mismo
             patrón que NotesView/RemindersView) ===================== -->
        <StackPanel Spacing="8">
          <ToggleButton x:Name="SearchSectionToggle" Classes="calendar-section-toggle" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Padding="8,4"
                        IsChecked="{Binding IsSearchExpanded, Mode=TwoWay}"
                        AutomationProperties.Name="{loc:Tr Calendar_Sidebar_SearchHeader}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{loc:Tr Calendar_Sidebar_SearchHeader, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
              <mi:MaterialIcon Grid.Column="1" Kind="ChevronDown" Width="14" Height="14" IsVisible="{Binding !IsSearchExpanded}" />
              <mi:MaterialIcon Grid.Column="1" Kind="ChevronUp" Width="14" Height="14" IsVisible="{Binding IsSearchExpanded}" />
            </Grid>
          </ToggleButton>
          <StackPanel x:Name="SearchSectionContent" Spacing="8" IsVisible="{Binding IsSearchExpanded}">
            <TextBox Classes="search" Text="{Binding SearchText}" PlaceholderText="{loc:Tr Calendar_Sidebar_SearchPlaceholder}" />
          </StackPanel>
        </StackPanel>

        <!-- ===================== Filtros secundarios — doc §3 ===================== -->
        <StackPanel Spacing="8">
          <ToggleButton x:Name="FiltersSectionToggle" Classes="calendar-section-toggle" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Padding="8,4"
                        IsChecked="{Binding IsFiltersExpanded, Mode=TwoWay}"
                        AutomationProperties.Name="{loc:Tr Calendar_Sidebar_FiltersHeader}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{loc:Tr Calendar_Sidebar_FiltersHeader, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
              <mi:MaterialIcon Grid.Column="1" Kind="ChevronDown" Width="14" Height="14" IsVisible="{Binding !IsFiltersExpanded}" />
              <mi:MaterialIcon Grid.Column="1" Kind="ChevronUp" Width="14" Height="14" IsVisible="{Binding IsFiltersExpanded}" />
            </Grid>
          </ToggleButton>
          <StackPanel x:Name="FiltersSectionContent" Spacing="8" IsVisible="{Binding IsFiltersExpanded}">

            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr Calendar_Sidebar_PriorityHeader, Converter={StaticResource UpperCaseConverter}}" Classes="faint" FontSize="9" />
              <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                <TextBlock Grid.Column="0" Text="{loc:Tr Polar_Priority_High, Converter={StaticResource UpperCaseConverter}}" FontSize="11" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding PriorityFilterHigh}" OnContent="" OffContent=""
                              AutomationProperties.Name="{loc:Tr Polar_Priority_High}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Polar_Priority_Medium, Converter={StaticResource UpperCaseConverter}}" FontSize="11" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding PriorityFilterMedium}" OnContent="" OffContent=""
                              AutomationProperties.Name="{loc:Tr Polar_Priority_Medium}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Polar_Priority_Low, Converter={StaticResource UpperCaseConverter}}" FontSize="11" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding PriorityFilterLow}" OnContent="" OffContent=""
                              AutomationProperties.Name="{loc:Tr Polar_Priority_Low}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Polar_Priority_None, Converter={StaticResource UpperCaseConverter}}" FontSize="11" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding PriorityFilterNone}" OnContent="" OffContent=""
                              AutomationProperties.Name="{loc:Tr Polar_Priority_None}" />
              </Grid>
            </StackPanel>

            <!-- Etiquetas (doc §3/§5): solo si Polar está vinculado y hay al menos una etiqueta en uso. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsPolarLinked}">
              <TextBlock Text="{loc:Tr Calendar_Sidebar_TagsHeader, Converter={StaticResource UpperCaseConverter}}" Classes="faint" FontSize="9" Margin="0,6,0,0"
                         IsVisible="{Binding TagFilters.Count, Converter={StaticResource CountToBoolConverter}}" />
              <ItemsControl ItemsSource="{Binding TagFilters}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CalendarTagFilterViewModel">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Tag}" FontSize="11" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsActive}" OnContent="" OffContent=""
                                    AutomationProperties.Name="{Binding Tag}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4,0,0" />

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{loc:Tr Calendar_Sidebar_HideCompleted, Converter={StaticResource UpperCaseConverter}}" FontSize="11" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding HideCompletedItems}" OnContent="" OffContent=""
                            AutomationProperties.Name="{loc:Tr Calendar_Sidebar_HideCompleted}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{loc:Tr Calendar_Sidebar_HideGhostOccurrences, Converter={StaticResource UpperCaseConverter}}" FontSize="11" VerticalAlignment="Center"
                         TextWrapping="Wrap" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding HideGhostOccurrences}" OnContent="" OffContent=""
                            AutomationProperties.Name="{loc:Tr Calendar_Sidebar_HideGhostOccurrences}" />
            </Grid>
          </StackPanel>
        </StackPanel>

        <!-- ===================== Panel "sin programadas" — docs/calendar-feature/
             04-vistas-y-navegacion.md §8 ===================== -->
        <StackPanel Spacing="8" IsVisible="{Binding HasUnscheduledItems}">
          <ToggleButton x:Name="UnscheduledSectionToggle" Classes="calendar-section-toggle" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Padding="8,4"
                        IsChecked="{Binding IsUnscheduledExpanded, Mode=TwoWay}"
                        AutomationProperties.Name="{loc:Tr Calendar_Sidebar_UnscheduledHeader}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{loc:Tr Calendar_Sidebar_UnscheduledHeader, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
              <mi:MaterialIcon Grid.Column="1" Kind="ChevronDown" Width="14" Height="14" IsVisible="{Binding !IsUnscheduledExpanded}" />
              <mi:MaterialIcon Grid.Column="1" Kind="ChevronUp" Width="14" Height="14" IsVisible="{Binding IsUnscheduledExpanded}" />
            </Grid>
          </ToggleButton>
          <StackPanel x:Name="UnscheduledSectionContent" Spacing="8" IsVisible="{Binding IsUnscheduledExpanded}">
            <Border Background="{DynamicResource Ink10}" Padding="1">
              <ItemsControl ItemsSource="{Binding UnscheduledItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CalendarUnscheduledItemViewModel">
                    <Border Classes="calendar-unscheduled-item" Initialized="UnscheduledItem_Initialized">
                      <Grid ColumnDefinitions="Auto,*">
                        <mi:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="10" Height="10"
                                          Margin="0,2,6,0" VerticalAlignment="Top"
                                          Foreground="{Binding EffectiveCalendarColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding Title}" FontSize="11" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding ParentContextLabel}" Classes="faint" FontSize="9"
                                     IsVisible="{Binding HasParentContext}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <TextBlock Text="{loc:Tr Calendar_Sidebar_UnscheduledHint}" Classes="faint" FontSize="9.5" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>

        </StackPanel>
        </ScrollViewer>
  </Border>

      <!-- ===================== Contenido: barra superior + vista activa ===================== -->
      <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" RowDefinitions="Auto,*" Margin="20,0,0,0">

        <!-- Navegación temporal + selector de vista — docs/calendar-feature/04-vistas-y-navegacion.md
             §9 (◀/▶/Hoy comunes a las cuatro vistas) y §1/10-diseno-visual-y-componentes.md §6
             (segmented control, reutilizando literalmente RadioButton.segment). -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,0,0,18">
          <Button Grid.Column="0" Classes="icon-btn calendar-toolbar-btn" Command="{Binding ToggleSidebarCommand}" Margin="0,0,10,0"
                  ToolTip.Tip="{loc:Tr Calendar_Toolbar_ToggleSidebarTooltip}"
                  AutomationProperties.Name="{loc:Tr Calendar_Toolbar_ToggleSidebarTooltip}">
            <Panel>
              <mi:MaterialIcon Kind="ChevronDoubleLeft" Width="17" Height="17" IsVisible="{Binding !IsSidebarCollapsed}" />
              <mi:MaterialIcon Kind="ChevronDoubleRight" Width="17" Height="17" IsVisible="{Binding IsSidebarCollapsed}" />
            </Panel>
          </Button>
          <Button Grid.Column="1" Classes="icon-btn calendar-toolbar-btn" Command="{Binding PreviousPeriodCommand}"
                  ToolTip.Tip="{loc:Tr Calendar_Toolbar_PreviousPeriodTooltip}"
                  AutomationProperties.Name="{loc:Tr Calendar_Toolbar_PreviousPeriodTooltip}">
            <mi:MaterialIcon Kind="ChevronLeft" Width="18" Height="18" />
          </Button>
          <Button Grid.Column="2" Classes="icon-btn calendar-toolbar-btn" Command="{Binding NextPeriodCommand}"
                  ToolTip.Tip="{loc:Tr Calendar_Toolbar_NextPeriodTooltip}" Margin="2,0,0,0"
                  AutomationProperties.Name="{loc:Tr Calendar_Toolbar_NextPeriodTooltip}">
            <mi:MaterialIcon Kind="ChevronRight" Width="18" Height="18" />
          </Button>
          <TextBlock Grid.Column="3" Text="{Binding PeriodLabel}" Classes="section-title" FontSize="15"
                     VerticalAlignment="Center" Margin="16,0,0,0" />

          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
            <!-- "Hoy": abre el resumen del día como diálogo modal (ver "Diálogo: resumen de hoy" al final). -->
            <Button Classes="pill calendar-toolbar-btn" Command="{Binding OpenTodayPopoverCommand}" Margin="0,0,14,0">
              <TextBlock Text="{loc:Tr Calendar_Toolbar_TodayButton, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <RadioButton Classes="segment calendar-toolbar-btn" GroupName="CalendarViewMode" Content="{loc:Tr Calendar_ViewMode_Month, Converter={StaticResource UpperCaseConverter}}"
                         IsChecked="{Binding ActiveView, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Month, Mode=OneWay}"
                         Command="{Binding SetViewCommand}" CommandParameter="{x:Static vm:CalendarViewMode.Month}" />
            <RadioButton Classes="segment calendar-toolbar-btn" GroupName="CalendarViewMode" Content="{loc:Tr Calendar_ViewMode_Week, Converter={StaticResource UpperCaseConverter}}" Margin="6,0,0,0"
                         IsChecked="{Binding ActiveView, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Week, Mode=OneWay}"
                         Command="{Binding SetViewCommand}" CommandParameter="{x:Static vm:CalendarViewMode.Week}" />
            <RadioButton Classes="segment calendar-toolbar-btn" GroupName="CalendarViewMode" Content="{loc:Tr Calendar_ViewMode_Day, Converter={StaticResource UpperCaseConverter}}" Margin="6,0,0,0"
                         IsChecked="{Binding ActiveView, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Day, Mode=OneWay}"
                         Command="{Binding SetViewCommand}" CommandParameter="{x:Static vm:CalendarViewMode.Day}" />
            <RadioButton Classes="segment calendar-toolbar-btn" GroupName="CalendarViewMode" Content="{loc:Tr Calendar_ViewMode_Agenda, Converter={StaticResource UpperCaseConverter}}" Margin="6,0,0,0"
                         IsChecked="{Binding ActiveView, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Agenda, Mode=OneWay}"
                         Command="{Binding SetViewCommand}" CommandParameter="{x:Static vm:CalendarViewMode.Agenda}" />

            <!-- Exportar la vista actual a PNG/PDF (T8): lo que se exporta es exactamente el rango, las
                 capas y los filtros que hay ahora en pantalla. -->
            <Button Classes="icon-btn calendar-toolbar-btn" Margin="14,0,0,0"
                    ToolTip.Tip="{loc:Tr Export_MenuTooltip}" AutomationProperties.Name="{loc:Tr Export_MenuTooltip}">
              <mi:MaterialIcon Kind="TrayArrowDown" Width="17" Height="17" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="{loc:Tr Export_ToPng, Converter={StaticResource UpperCaseConverter}}" Command="{Binding ExportViewAsPngCommand}">
                    <MenuItem.Icon>
                      <mi:MaterialIcon Kind="ImageOutline" Width="14" Height="14" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="{loc:Tr Export_ToPdf, Converter={StaticResource UpperCaseConverter}}" Command="{Binding ExportViewAsPdfCommand}">
                    <MenuItem.Icon>
                      <mi:MaterialIcon Kind="FilePdfBox" Width="14" Height="14" />
                    </MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <!-- Creación rápida — docs/calendar-feature/06-creacion-y-edicion-de-items.md §1. -->
            <Button Classes="icon-btn calendar-toolbar-btn" Margin="6,0,0,0" Command="{Binding OpenQuickCreateForReferenceDateCommand}"
                    ToolTip.Tip="{loc:Tr Common_Create}" AutomationProperties.Name="{loc:Tr Common_Create}">
              <mi:MaterialIcon Kind="Plus" Width="18" Height="18" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- Región exportable (T8): la cabecera de días de la semana y la vista activa, sin la barra
             de navegación de arriba — un PNG/PDF del calendario no debe llevar botones de interfaz.
             La localiza por nombre Services.ViewExportLocator; ver Services.ViewExportTargets. -->
        <Grid x:Name="CalendarExportRoot" Grid.Row="1" RowDefinitions="Auto,*">
          <!-- Cabecera de días de la semana — solo Mes (Semana/Día dibujan su propia cabecera por
               columna, ver más abajo). Orden/columnas dependen de CalendarWeekStartsOnMonday/
               CalendarShowWeekends (docs/calendar-feature/09-configuracion-y-ajustes.md §1). -->
          <ItemsControl Grid.Row="0" ItemsSource="{Binding WeekdayHeaders}" Margin="5,0,5,4"
                        IsVisible="{Binding IsMonthView}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding MonthGridColumns}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Classes="faint calendar-weekday" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- ===================== Vista Mes ===================== -->
          <!-- Animación de "reveal" al navegar/cambiar de vista — docs/calendar-feature/
               10-diseno-visual-y-componentes.md §8. -->
          <!-- Las seis semanas se reparten el alto disponible sin desplazamiento vertical. -->
          <Grid Grid.Row="1" IsVisible="{Binding IsMonthView}"
                        motion:MotionReveal.AllowTranslation="False"
                motion:MotionReveal.Revision="{Binding RevealRevision}">
            <Border Classes="calendar-month-grid" Margin="5,0,5,5">
              <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="6" Columns="{Binding MonthGridColumns}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CalendarMonthDayViewModel">
                    <Border Classes="calendar-month-cell"
                            Classes.calendar-last-col="{Binding IsLastColumn}"
                            Classes.calendar-last-row="{Binding IsLastRow}">
                      <Grid>
                        <!-- Capa de clic vacío — doc 05 §3: crea un item con la fecha de esta celda. Se
                             sienta por debajo del contenido real en el z-order de este Grid. -->
                        <Button Classes="calendar-cell-click-layer"
                                Command="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).OpenQuickCreateForDayCommand}"
                                CommandParameter="{Binding Date}"
                                AutomationProperties.Name="{Binding Date, StringFormat={}{0:D}}">
                          <Button.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="{loc:Tr Calendar_ContextMenu_CreateKanbanHere, Converter={StaticResource UpperCaseConverter}}"
                                        Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).OpenQuickCreateForDayAsKanbanCommand}"
                                        CommandParameter="{Binding Date}" />
                              <MenuItem Header="{loc:Tr Calendar_ContextMenu_CreatePolarTaskHere, Converter={StaticResource UpperCaseConverter}}"
                                        IsVisible="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).IsPolarLinked}"
                                        Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).OpenQuickCreateForDayAsPolarTaskCommand}"
                                        CommandParameter="{Binding Date}" />
                              <MenuItem Header="{loc:Tr Calendar_ContextMenu_CreateReminderHere, Converter={StaticResource UpperCaseConverter}}"
                                        Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).OpenQuickCreateForDayAsReminderCommand}"
                                        CommandParameter="{Binding Date}" />
                            </ContextMenu>
                          </Button.ContextMenu>
                        </Button>

                        <Grid RowDefinitions="Auto,*" Margin="6">
                          <Border Grid.Row="0" Classes="calendar-day-badge" Classes.today="{Binding IsToday}"
                                  Classes.selected="{Binding IsSelected}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding DayLabel}" Classes="calendar-day-number"
                                       Classes.today="{Binding IsToday}" Classes.outside="{Binding !IsCurrentMonth}" />
                     </Border>

                          <StackPanel Grid.Row="1" Spacing="2" Margin="0,4,0,0">
                            <ItemsControl ItemsSource="{Binding VisibleItems}" ItemTemplate="{StaticResource CalendarChipTemplate}" />

                            <ToggleButton x:Name="OverflowToggle" Classes="calendar-overflow-trigger"
                                          IsVisible="{Binding HasOverflow}">
                              <TextBlock Text="{Binding OverflowLabel}" Classes="faint" FontSize="9.5" />
                            </ToggleButton>

                            <Popup PlacementTarget="{Binding #OverflowToggle}" Placement="Right" VerticalOffset="0"
                                   IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #OverflowToggle}"
                                   IsOpen="{Binding #OverflowToggle.IsChecked, Mode=TwoWay}">
                              <Border Classes="dropdown-popover" Width="260">
                                <StackPanel Spacing="8">
                                  <TextBlock Text="{Binding OverflowPopoverHeaderLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="10" />
                                  <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CalendarChipTemplate}" />
                                </StackPanel>
                         </Border>
                            </Popup>
                          </StackPanel>
                        </Grid>
                      </Grid>
                </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
       </Border>
          </Grid>

          <!-- ===================== Vistas Semana/Día (comparten CalendarWeekColumnViewModel —
               Día es simplemente 1 columna, docs/calendar-feature/04-vistas-y-navegacion.md §4) ============ -->
          <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsHourGridView}"
                motion:MotionReveal.AllowTranslation="False"
                motion:MotionReveal.Revision="{Binding RevealRevision}">

            <!-- Cabeceras de columna -->
            <Grid Grid.Row="0" ColumnDefinitions="56,*">
              <ItemsControl Grid.Column="1" ItemsSource="{Binding WeekColumns}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding WeekColumns.Count}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CalendarWeekColumnViewModel">
                    <Border Classes="calendar-week-header" Classes.today="{Binding IsToday}">
                      <TextBlock Text="{Binding DayLabel}" Classes="eyebrow calendar-week-header-label"
                                 Classes.today="{Binding IsToday}" FontSize="11.5" HorizontalAlignment="Center" />
               </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>

            <!-- Franja "todo el día" — docs/calendar-feature/04-vistas-y-navegacion.md §3: los items sin
                 hora no ocupan franja horaria, se quedan arriba. -->
            <Grid Grid.Row="1" ColumnDefinitions="56,*" Margin="0,6,0,6">
              <TextBlock Grid.Column="0" Text="{loc:Tr Calendar_WeekView_AllDayRowLabel, Converter={StaticResource UpperCaseConverter}}" Classes="faint" FontSize="8.5" HorizontalAlignment="Center"
                         VerticalAlignment="Top" Margin="0,4,0,0" />
              <ItemsControl Grid.Column="1" ItemsSource="{Binding WeekColumns}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding WeekColumns.Count}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CalendarWeekColumnViewModel">
                    <Border Classes="calendar-week-column" Padding="4,0" MinHeight="20"
                            PointerPressed="AllDayColumn_PointerPressed">
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{loc:Tr Calendar_ContextMenu_CreateKanbanHere, Converter={StaticResource UpperCaseConverter}}"
                                    Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).OpenQuickCreateForDayAsKanbanCommand}"
                                    CommandParameter="{Binding Date}" />
                          <MenuItem Header="{loc:Tr Calendar_ContextMenu_CreatePolarTaskHere, Converter={StaticResource UpperCaseConverter}}"
                                    IsVisible="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).IsPolarLinked}"
                                    Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).OpenQuickCreateForDayAsPolarTaskCommand}"
                                    CommandParameter="{Binding Date}" />
                          <MenuItem Header="{loc:Tr Calendar_ContextMenu_CreateReminderHere, Converter={StaticResource UpperCaseConverter}}"
                                    Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).OpenQuickCreateForDayAsReminderCommand}"
                                    CommandParameter="{Binding Date}" />
                        </ContextMenu>
                      </Border.ContextMenu>
                      <ItemsControl ItemsSource="{Binding AllDayItems}" ItemTemplate="{StaticResource CalendarChipTemplate}" />
               </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>

            <!-- Grilla de horas (00:00–23:00) — docs/calendar-feature/10-diseno-visual-y-componentes.md
                 §3: separadores White05, franja de horario laboral resaltada, línea de "ahora" en rojo
                 solo en la columna de hoy. -->
            <ScrollViewer Grid.Row="2">
              <Grid ColumnDefinitions="56,*">
                <ItemsControl Grid.Column="0" ItemsSource="{Binding HourRows}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CalendarHourRowViewModel">
                      <TextBlock Text="{Binding Label}" Classes="faint" FontSize="10" Height="60" Padding="0,2,8,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Column="1" ItemsSource="{Binding WeekColumns}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="{Binding WeekColumns.Count}" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CalendarWeekColumnViewModel">
                      <Border Classes="calendar-week-column calendar-time-column">
                        <Grid>
                          <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).HourRows}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:CalendarHourRowViewModel">
                                <Border Classes="calendar-hour-row" Classes.working="{Binding IsWorkingHour}" Height="60"
                                        PointerPressed="HourCell_PointerPressed" Cursor="Hand" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <ItemsControl ItemsSource="{Binding TimedItems}" ItemTemplate="{StaticResource CalendarTimedChipTemplate}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <controls:CalendarTimedItemsPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                          </ItemsControl>

                          <Border Classes="calendar-now-line" IsVisible="{Binding NowOffsetY, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}"
                                  Margin="{Binding NowOffsetY, Converter={StaticResource TopOffsetToMarginConverter}}">
                            <Ellipse Classes="calendar-now-dot" HorizontalAlignment="Left" Margin="-3,-2.5,0,0" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </ScrollViewer>
          </Grid>

          <!-- ===================== Vista Agenda — docs/calendar-feature/04-vistas-y-navegacion.md §6:
               lista agrupada por día, días sin items no se muestran. ===================== -->
          <Grid Grid.Row="1" IsVisible="{Binding IsAgendaView}"
                motion:MotionReveal.AllowTranslation="False"
                motion:MotionReveal.Revision="{Binding RevealRevision}">
            <ScrollViewer IsVisible="{Binding !IsAgendaEmpty}">
              <ItemsControl ItemsSource="{Binding AgendaGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CalendarAgendaGroupViewModel">
                    <Border Classes="calendar-agenda-day" Background="Transparent" Margin="0,0,0,26">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding HeaderLabel}" Classes="eyebrow" />
                      <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,0,0,4" />
                      <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CalendarAgendaItemTemplate}" />
                    </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <!-- Empty state accionable — reutiliza el mismo comando que el atajo "N" (CalendarView_KeyDown)
                 en vez de duplicar el flujo de creación rápida. -->
            <StackPanel IsVisible="{Binding IsAgendaEmpty}" Spacing="14"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <mi:MaterialIcon Kind="CalendarBlankOutline" Width="24" Height="24"
                                Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:Tr Calendar_Agenda_EmptyMessage}" Classes="muted" HorizontalAlignment="Center" />
              <Button Classes="pill" Command="{Binding OpenQuickCreateForReferenceDateCommand}" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <mi:MaterialIcon Kind="Plus" Width="13" Height="13" />
                  <TextBlock Text="{loc:Tr Calendar_Agenda_CreateItemButton, Converter={StaticResource UpperCaseConverter}}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>

      </Grid>
    </Grid>

    <!-- ===================== Popover: creación rápida (doc 06 §1) ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding QuickCreate, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
              MaxWidth="420" MaxHeight="620" DataContext="{Binding QuickCreate}" x:DataType="vm:CalendarQuickCreateViewModel">
        <Grid RowDefinitions="Auto,*,Auto" MinWidth="380">

          <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,18">
            <TextBlock Text="{loc:Tr Calendar_QuickCreate_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
            <TextBlock Text="{loc:Tr Calendar_QuickCreate_Title}" FontSize="19" FontWeight="Bold" LetterSpacing="-0.3" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
            <StackPanel Spacing="18">

              <!-- Título -->
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Calendar_QuickCreate_TitleFieldLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <TextBox Name="QuickCreateTitleBox" Classes="search" Text="{Binding Title}"
                          KeyDown="QuickCreateTitleBox_KeyDown"
                          PlaceholderText="{loc:Tr Calendar_QuickCreate_TitlePlaceholder}" />
              </StackPanel>

              <!-- Selector de tipo — doc 06 §1, punto 2. -->
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Calendar_QuickCreate_TypeLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <!-- WrapPanel y no un StackPanel horizontal, por el mismo motivo documentado en el
                     selector de recurrencia de KanbanView: un StackPanel horizontal mide a sus hijos con
                     ancho infinito, así que las tres opciones nunca envuelven y la última se sale del
                     modal en cuanto el idioma activo alarga las etiquetas (el popover está acotado a
                     MaxWidth="420"). -->
                <WrapPanel>
                  <RadioButton Classes="segment" GroupName="QuickCreateType" Content="{loc:Tr Calendar_Label_Kanban, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,8,8"
                               IsChecked="{Binding SelectedType, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Kanban, Mode=OneWay}"
                               Command="{Binding SelectTypeCommand}" CommandParameter="Kanban" />
                  <RadioButton Classes="segment" GroupName="QuickCreateType" Content="{loc:Tr Calendar_Source_PolarTask, Converter={StaticResource UpperCaseConverter}}" IsVisible="{Binding IsPolarAvailable}" Margin="0,0,8,8"
                               IsChecked="{Binding SelectedType, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=PolarTask, Mode=OneWay}"
                               Command="{Binding SelectTypeCommand}" CommandParameter="PolarTask" />
                  <RadioButton Classes="segment" GroupName="QuickCreateType" Content="{loc:Tr Calendar_Label_Reminder, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,8,8"
                               IsChecked="{Binding SelectedType, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Reminder, Mode=OneWay}"
                               Command="{Binding SelectTypeCommand}" CommandParameter="Reminder" />
                </WrapPanel>
                <TextBlock Text="{loc:Tr Calendar_QuickCreate_TypeHint}" Classes="body-small" Foreground="{DynamicResource Ink40}" TextWrapping="Wrap" />
              </StackPanel>

              <!-- Destino: columna Kanban o lista Polar, según el tipo elegido — doc 06 §1, puntos 4–5. -->
              <StackPanel Spacing="6" IsVisible="{Binding IsKanbanType}">
                <TextBlock Text="{loc:Tr Calendar_QuickCreate_ColumnLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <ComboBox ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}" IsVisible="{Binding HasMultipleBoards}"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Tr Kanban_Multi_Boards}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="models:KanbanBoard"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:KanbanColumn">
                      <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding IsPolarType}">
                <TextBlock Text="{loc:Tr Calendar_QuickCreate_ListLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <ComboBox ItemsSource="{Binding PolarLists}" SelectedItem="{Binding SelectedPolarList}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:PolarTaskList">
                      <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- Fecha/hora — doc 06 §1, punto 3. -->
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Calendar_QuickCreate_DateLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />

                <Button Name="QuickCreateDateTrigger" Classes="date-picker-trigger"
                        Command="{Binding ToggleCalendarCommand}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <mi:MaterialIcon Grid.Column="0" Kind="CalendarOutline" Width="14" Height="14"
                                      Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding DateDisplayLabel}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <mi:MaterialIcon Grid.Column="2" Kind="MenuDown" Width="15" Height="15"
                                      Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <Popup PlacementTarget="{Binding #QuickCreateDateTrigger}" Placement="BottomEdgeAlignedLeft"
                       VerticalOffset="6" IsLightDismissEnabled="True"
                       OverlayInputPassThroughElement="{Binding #QuickCreateDateTrigger}"
                       IsOpen="{Binding IsCalendarOpen, Mode=TwoWay}">
                  <Border Classes="calendar-popover" Width="290">
                    <StackPanel Spacing="14">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Classes="icon-btn calendar-nav" Command="{Binding PreviousMonthCommand}"
                                ToolTip.Tip="{loc:Tr Calendar_MiniCalendar_PreviousMonthTooltip}"
                                AutomationProperties.Name="{loc:Tr Calendar_MiniCalendar_PreviousMonthTooltip}">
                          <mi:MaterialIcon Kind="ChevronLeft" Width="15" Height="15" />
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding CalendarMonthLabel}" Classes="eyebrow" FontSize="10.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="icon-btn calendar-nav" Command="{Binding NextMonthCommand}"
                                ToolTip.Tip="{loc:Tr Calendar_MiniCalendar_NextMonthTooltip}"
                                AutomationProperties.Name="{loc:Tr Calendar_MiniCalendar_NextMonthTooltip}">
                          <mi:MaterialIcon Kind="ChevronRight" Width="15" Height="15" />
                        </Button>
                      </Grid>

                      <ItemsControl ItemsSource="{Binding WeekdayHeaders}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" Classes="faint calendar-weekday" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Plantilla explícita, y no una DataTemplate implícita como la que KanbanView/
                           RemindersView declaran en su UserControl.DataTemplates: esas dos son locales a
                           su vista y no alcanzan a esta, así que sin esto la rejilla caía en el ToString()
                           por defecto de KanbanCalendarDayViewModel y pintaba 42 veces
                           "enki.ViewModels.KanbanCalendarDayViewModel" en lugar de los días del mes.
                           El comando vive en el propio CalendarQuickCreateViewModel (el DataContext de
                           este ItemsControl), no en la página, a diferencia de los botones del pie. -->
                      <ItemsControl ItemsSource="{Binding CalendarDays}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:KanbanCalendarDayViewModel">
                            <Button Classes="calendar-day" Classes.outside="{Binding !IsCurrentMonth}"
                                    Classes.today="{Binding IsToday}" Classes.selected="{Binding IsSelected}"
                                    Command="{Binding $parent[ItemsControl].((vm:CalendarQuickCreateViewModel)DataContext).SelectCalendarDayCommand}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Date, StringFormat={}{0:D}}">
                              <TextBlock Text="{Binding DayLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <StackPanel Spacing="8">
                        <Rectangle Height="1" Fill="{DynamicResource Ink10}" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{loc:Tr Calendar_QuickCreate_AddTimeLabel, Converter={StaticResource UpperCaseConverter}}" FontSize="12" VerticalAlignment="Center" />
                          <ToggleSwitch Grid.Column="1" IsChecked="{Binding HasTime}" OnContent="" OffContent=""
                                        AutomationProperties.Name="{loc:Tr Calendar_QuickCreate_AddTimeLabel}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasTime}">
                          <NumericUpDown Value="{Binding Hour}" Minimum="0" Maximum="23" Increment="1"
                                         FormatString="00" Width="92" ShowButtonSpinner="True" />
                          <TextBlock Text=":" FontWeight="Bold" VerticalAlignment="Center" />
                          <NumericUpDown Value="{Binding Minute}" Minimum="0" Maximum="59" Increment="5"
                                         FormatString="00" Width="92" ShowButtonSpinner="True" />
                        </StackPanel>
                      </StackPanel>

                      <!-- Duración / franja horaria (opcional, solo Kanban con hora activada) — doc 06 §1,
                           doc 04 §5: convierte el punto de "Agregar hora" en un rango que el calendario
                           dibuja como bloque en Semana/Día, ajustable después arrastrando su borde
                           inferior. Mismos pasos de 5 minutos que el selector de hora de arriba. -->
                      <StackPanel Spacing="8" IsVisible="{Binding CanShowDuration}">
                        <Rectangle Height="1" Fill="{DynamicResource Ink10}" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{loc:Tr Calendar_QuickCreate_DurationLabel, Converter={StaticResource UpperCaseConverter}}" FontSize="12" VerticalAlignment="Center" />
                          <ToggleSwitch Grid.Column="1" IsChecked="{Binding HasDuration}" OnContent="" OffContent=""
                                        AutomationProperties.Name="{loc:Tr Calendar_QuickCreate_DurationLabel}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasDuration}">
                          <NumericUpDown Value="{Binding DurationMinutes}" Minimum="5" Maximum="1435" Increment="5"
                                         Width="110" ShowButtonSpinner="True" />
                          <TextBlock Text="{loc:Tr Calendar_QuickCreate_DurationUnitMinutes}" Classes="faint" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding DurationRangeLabel}" Classes="faint" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                      </StackPanel>

                      <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="1" Classes="ghost" Command="{Binding SetTodayCommand}">
                          <TextBlock Text="{loc:Tr Calendar_Toolbar_TodayButton, Converter={StaticResource UpperCaseConverter}}" />
                        </Button>
                      </Grid>
                    </StackPanel>
             </Border>
                </Popup>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>

          <!-- Acciones — doc 06 §1, punto 6: "Más opciones" nunca es un techo, así que deja de ser un
               Button.ghost (Padding="0", sin caja propia) perdido entre "Cancelar" y "Crear": es el
               secundario real del pie, con el outline de Button.pill, a la izquierda como camino
               alternativo, frente al par "descartar / confirmar" de la derecha. Los tres comparten ahora
               alto y línea base — el ghost sin relleno flotaba a una altura distinta y cualquier estado
               (hover, foco) le dibujaba un recuadro pegado a las letras en vez de al botón. El filete de
               1px separa las acciones del cuerpo desplazable, igual que dentro del propio popover de
               fecha. -->
          <StackPanel Grid.Row="2" Spacing="16" Margin="0,16,0,0">
            <Rectangle Height="1" Fill="{DynamicResource Ink10}" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Button Grid.Column="0" Classes="pill"
                      Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).SaveQuickCreateAndEditMoreCommand}"
                      IsEnabled="{Binding CanSave}">
                <TextBlock Text="{loc:Tr Calendar_QuickCreate_MoreOptionsButton, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
              <Button Grid.Column="2" Classes="ghost modal-cancel"
                      Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).CancelQuickCreateCommand}"
                      Margin="0,0,12,0">
                <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
              <Button Grid.Column="3" Classes="pill-primary"
                      Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).SaveQuickCreateCommand}"
                      IsEnabled="{Binding CanSave}">
                <TextBlock Text="{loc:Tr Common_Create, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </controls:ModalOverlayHost>

    <!-- ===================== Diálogo: resumen de hoy (botón "Hoy" de la barra) =====================
         Modal centrado sobre toda la ventana (ModalOverlayHost bloquea los clics en el resto de la app
         mientras está abierto). Pendientes arriba y completadas abajo, cada grupo en orden alfabético
         (CalendarViewModel.RebuildToday); ignora capas y filtros — es el día entero. Escape lo cierra
         (CalendarView_KeyDown). -->
    <controls:ModalOverlayHost IsOpen="{Binding IsTodayPopoverOpen}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
              MaxWidth="520" Width="520" MaxHeight="640">
        <Grid RowDefinitions="Auto,*,Auto">

          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Text="{loc:Tr Calendar_Toolbar_TodayButton, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
              <TextBlock Text="{Binding TodayPopoverHeaderLabel}" FontSize="19" FontWeight="Bold" LetterSpacing="-0.3" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding TodayPendingCount}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="12" />
                  <TextBlock Text="{loc:Tr Calendar_TodayPopover_Pending, Converter={StaticResource UpperCaseConverter}}" Classes="faint" FontSize="9.5" LetterSpacing="2" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding TodayCompletedCount}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="12" />
                  <TextBlock Text="{loc:Tr Calendar_TodayPopover_Completed, Converter={StaticResource UpperCaseConverter}}" Classes="faint" FontSize="9.5" LetterSpacing="2" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Classes="icon-btn" Width="30" Height="30" VerticalAlignment="Top"
                    Command="{Binding CloseTodayPopoverCommand}"
                    ToolTip.Tip="{loc:Tr Common_Close}" AutomationProperties.Name="{loc:Tr Common_Close}">
              <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
            </Button>
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Margin="0,0,-14,0" Padding="0,0,14,0">
            <StackPanel Spacing="20">
              <StackPanel Spacing="10" IsVisible="{Binding HasNoTodayItems}" Margin="0,24" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="CalendarCheckOutline" Width="28" Height="28" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Calendar_TodayPopover_Empty}" Classes="muted" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding HasTodayPendingItems}">
                <TextBlock Text="{loc:Tr Calendar_TodayPopover_Pending, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding TodayPendingItems}" ItemTemplate="{StaticResource CalendarTodayItemTemplate}" />
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding HasTodayCompletedItems}">
                <TextBlock Text="{loc:Tr Calendar_TodayPopover_Completed, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding TodayCompletedItems}" ItemTemplate="{StaticResource CalendarTodayItemTemplate}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Spacing="16" Margin="0,16,0,0">
            <Rectangle Height="1" Fill="{DynamicResource Ink10}" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button Grid.Column="0" Classes="pill" Command="{Binding ShowTodayInCalendarCommand}">
                <TextBlock Text="{loc:Tr Calendar_TodayPopover_ShowInCalendar, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
              <Button Grid.Column="2" Classes="pill-primary" Command="{Binding CloseTodayPopoverCommand}">
                <TextBlock Text="{loc:Tr Common_Close, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </controls:ModalOverlayHost>

    <!-- ===================== Diálogo: eliminar item (doc 05 §6) ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding ItemPendingDelete, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
              DataContext="{Binding ItemPendingDelete}" x:DataType="vm:CalendarItemViewModel">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{loc:Tr Calendar_DeleteDialog_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Calendar_DeleteDialog_Message}" FontSize="14" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Title}" Classes="muted" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel"
                    Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).CancelDeleteItemCommand}"
                    Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary-danger"
                    Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).ConfirmDeleteItemCommand}">
              <TextBlock Text="{loc:Tr Common_Delete, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>

  </Grid>
</UserControl>
