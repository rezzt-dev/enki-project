<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="clr-namespace:enki.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:baseconv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="760"
             x:Class="enki.Views.RemindersView"
             x:DataType="vm:RemindersViewModel"
             Focusable="True" Loaded="RemindersView_Loaded">

  <!-- Atajo propio de la página (Fase 7 de docs/analisis-proyecto/roadmap.md): Ctrl+N no choca con el
       editor abierto porque RemindersViewModel.OpenCreateEditor no hace nada mientras ya haya un editor
       abierto. Remapeable (propuesta 29, docs/propuesta-nuevas-funcionalidades.md) — ver
       RemindersView.axaml.cs (BuildKeyBindings). -->

  <UserControl.DataTemplates>
    <!-- ===================== Celda del calendario (misma VM que Kanban, ver ReminderEditorViewModel) ===================== -->
    <DataTemplate DataType="vm:KanbanCalendarDayViewModel">
      <Button Classes="calendar-day" Classes.outside="{Binding !IsCurrentMonth}"
              Classes.today="{Binding IsToday}" Classes.selected="{Binding IsSelected}"
              Command="{Binding $parent[ItemsControl].((vm:ReminderEditorViewModel)DataContext).SelectCalendarDayCommand}"
              CommandParameter="{Binding}"
              AutomationProperties.Name="{Binding Date, StringFormat={}{0:D}}">
        <TextBlock Text="{Binding DayLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Button>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid>

   <Grid RowDefinitions="Auto,*" Margin="36,30,36,26" MaxWidth="1180" HorizontalAlignment="Stretch">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,22">
      <StackPanel Grid.Column="0" Spacing="6">
        <TextBlock Text="{loc:Tr Reminders_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
        <TextBlock Text="{loc:Tr Reminders_Title, Converter={StaticResource UpperCaseConverter}}" Classes="page-title" />
        <TextBlock Text="{loc:Tr Reminders_Subtitle}"
                   Classes="page-subtitle" />
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0" IsVisible="{Binding IsPolarLinked}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="ShieldCheckOutline" Width="12" Height="12" Foreground="{DynamicResource Ink40}" />
            <TextBlock Text="{Binding PolarSyncStatusLabel}" Classes="faint" />
          </StackPanel>
          <Button Classes="icon-btn" Width="20" Height="20" Command="{Binding SyncNowCommand}" IsEnabled="{Binding !IsSyncing}" ToolTip.Tip="{loc:Tr Reminders_SyncNowTooltip}"
                  AutomationProperties.Name="{loc:Tr Reminders_SyncNowTooltip}">
            <mi:MaterialIcon Kind="Autorenew" Width="12" Height="12" Classes.spin="{Binding IsSyncing}" />
          </Button>
        </StackPanel>
        <TextBlock Text="{Binding SyncErrorLabel}" Foreground="{DynamicResource DangerBrush}"
                   FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding SyncErrorLabel, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{Binding NextRetryLabel}" Classes="faint" FontSize="11.5"
                   IsVisible="{Binding NextRetryLabel, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{loc:Tr Polar_Sync_AlreadyRunningNotice}" Classes="faint" FontSize="11.5"
                   IsVisible="{Binding LastSyncNowWasSkipped}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button Classes="pill" Padding="18,10" IsEnabled="{Binding !IsEmpty}" Command="{Binding RequestClearAllCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="DeleteSweepOutline" Width="14" Height="14" />
            <TextBlock Text="{loc:Tr Reminders_ClearAllButton, Converter={StaticResource UpperCaseConverter}}" />
          </StackPanel>
        </Button>
        <Button Classes="pill" Padding="18,10" IsEnabled="{Binding UnreadCount, Converter={StaticResource CountToBoolConverter}}" Command="{Binding MarkAllReadCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="CheckAll" Width="14" Height="14" />
            <TextBlock Text="{loc:Tr Reminders_MarkAllReadButton, Converter={StaticResource UpperCaseConverter}}" />
          </StackPanel>
        </Button>
        <Button Classes="pill-primary" Command="{Binding OpenCreateEditorCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Plus" Width="14" Height="14" />
            <TextBlock Text="{loc:Tr Reminders_NewButton, Converter={StaticResource UpperCaseConverter}}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="10">

        <!-- Empty state accionable — mismo comando que el botón "NUEVO RECORDATORIO" de la cabecera,
             repetido aquí para que el estado vacío en sí ofrezca la salida en vez de obligar a subir la
             vista. -->
        <StackPanel IsVisible="{Binding IsEmpty}" Spacing="14" Margin="0,60,0,0" HorizontalAlignment="Center">
          <mi:MaterialIcon Kind="CalendarClockOutline" Width="28" Height="28" Foreground="{DynamicResource TextMutedBrush}"
                            HorizontalAlignment="Center" />
          <TextBlock Text="{loc:Tr Reminders_EmptyState}" Classes="muted" FontSize="12.5" HorizontalAlignment="Center" />
          <Button Classes="pill-primary" Command="{Binding OpenCreateEditorCommand}" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="Plus" Width="13" Height="13" />
              <TextBlock Text="{loc:Tr Reminders_EmptyState_CreateButton, Converter={StaticResource UpperCaseConverter}}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ReminderListItemViewModel">
              <Button Classes="note-card" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Padding="16"
                      Command="{Binding $parent[ItemsControl].((vm:RemindersViewModel)DataContext).OpenDetailCommand}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding Title}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Grid.Column="0" Width="38" Height="38" Background="{DynamicResource Ink05}"
                          VerticalAlignment="Top">
                    <mi:MaterialIcon Kind="{Binding IconKind}" Width="17" Height="17"
                                      Foreground="{DynamicResource Ink70}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
             </Border>

                  <StackPanel Grid.Column="1" Spacing="4" Margin="14,0">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Ink90}" IsVisible="{Binding !IsRead}" />
                      <TextBlock Text="{Binding Title}" Classes="subtask-title" Classes.done="{Binding IsCompleted}"
                                 FontWeight="Bold" FontSize="14" LetterSpacing="0.2"
                                 TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                               IsVisible="{Binding HasDescription}" />
                  </StackPanel>

                  <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="{Binding NotifyAtLabel}" Classes="faint" Classes.overdue="{Binding IsOverdue}" />
                    <TextBlock Text="{Binding StatusLabel}" Classes="faint" Classes.overdue="{Binding IsOverdue}" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" IsVisible="{Binding HasRecurrence}">
                      <mi:MaterialIcon Kind="RepeatVariant" Width="11" Height="11" Foreground="{DynamicResource Ink40}" />
                      <TextBlock Text="{Binding RecurrenceLabel, Converter={StaticResource UpperCaseConverter}}" Classes="faint" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

   </Grid>

    <!-- ===================== Formulario emergente: nuevo recordatorio ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding Editor, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
              MaxWidth="460" MaxHeight="680" DataContext="{Binding Editor}" x:DataType="vm:ReminderEditorViewModel">
        <Grid RowDefinitions="Auto,*,Auto" MinWidth="400">

          <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,18">
            <TextBlock Text="{loc:Tr Reminders_Editor_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
            <TextBlock Text="{loc:Tr Reminders_Editor_Title}" FontSize="19" FontWeight="Bold" LetterSpacing="-0.3" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
            <StackPanel Spacing="18">

              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Reminders_Editor_TitleFieldLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <TextBox Classes="search" Text="{Binding Title}" PlaceholderText="{loc:Tr Reminders_Editor_TitlePlaceholder}"
                         AutomationProperties.Name="{loc:Tr Reminders_Editor_TitleFieldLabel}" />
              </StackPanel>

              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{loc:Tr Reminders_DescriptionLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <TextBlock Grid.Column="1" Text="{Binding DescriptionCounterLabel}" Classes="faint" />
                </Grid>
                <TextBox Classes="search" Text="{Binding Description}" MaxLength="240"
                          AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                          PlaceholderText="{loc:Tr Reminders_Editor_DescriptionPlaceholder}"
                          AutomationProperties.Name="{loc:Tr Reminders_DescriptionLabel}" />
              </StackPanel>

              <!-- Fecha de aviso: mismo selector de calendario que Kanban. La hora vive en su propio
                   campo aparte (ver más abajo) en vez de dentro de este popover — mezclados quedaban
                   demasiado apretados y el spinner de hora se veía cortado. -->
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Reminders_Editor_NotifyDateFieldLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />

                <Button Name="NotifyDateTrigger" Classes="date-picker-trigger" Command="{Binding ToggleCalendarCommand}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <mi:MaterialIcon Grid.Column="0" Kind="CalendarOutline" Width="14" Height="14"
                                      Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding NotifyDateDisplayLabel}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <mi:MaterialIcon Grid.Column="2" Kind="MenuDown" Width="15" Height="15"
                                      Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <Popup PlacementTarget="{Binding #NotifyDateTrigger}" Placement="BottomEdgeAlignedLeft"
                       VerticalOffset="6" IsLightDismissEnabled="True"
                       OverlayInputPassThroughElement="{Binding #NotifyDateTrigger}"
                       IsOpen="{Binding IsCalendarOpen, Mode=TwoWay}">
                  <Border Classes="calendar-popover" Width="290">
                    <StackPanel Spacing="14">

                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Classes="icon-btn calendar-nav" Command="{Binding PreviousMonthCommand}"
                                ToolTip.Tip="{loc:Tr Reminders_Editor_PreviousMonthTooltip}"
                                AutomationProperties.Name="{loc:Tr Reminders_Editor_PreviousMonthTooltip}">
                          <mi:MaterialIcon Kind="ChevronLeft" Width="15" Height="15" />
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding CalendarMonthLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="10.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="icon-btn calendar-nav" Command="{Binding NextMonthCommand}"
                                ToolTip.Tip="{loc:Tr Reminders_Editor_NextMonthTooltip}"
                                AutomationProperties.Name="{loc:Tr Reminders_Editor_NextMonthTooltip}">
                          <mi:MaterialIcon Kind="ChevronRight" Width="15" Height="15" />
                        </Button>
                      </Grid>

                      <!-- Weekday letters come from RemindersViewModel.WeekdayLabels (CultureInfo-derived,
                           docs/agent-docs/internacionalizacion-i18n.md §1.7) instead of 7 hardcoded Spanish
                           TextBlocks — cross-references the page VM the same way the Cancelar/Crear buttons
                           below already do, since this popover's own DataContext is ReminderEditorViewModel. -->
                      <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:RemindersViewModel)DataContext).WeekdayLabels}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <ItemsControl ItemsSource="{Binding CalendarDays}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>

                      <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="1" Classes="ghost" Command="{Binding SetNotifyDateTodayCommand}">
                          <TextBlock Text="{loc:Tr Reminders_Editor_TodayButton, Converter={StaticResource UpperCaseConverter}}" />
                        </Button>
                      </Grid>

                    </StackPanel>
             </Border>
                </Popup>
              </StackPanel>

              <!-- Hora de aviso: campo propio, separado del selector de fecha (ver arriba) para que
                   los controles de hora/minuto tengan espacio suficiente y no se corten. -->
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Reminders_Editor_NotifyTimeFieldLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <NumericUpDown Value="{Binding NotifyHour}" Minimum="0" Maximum="23" Increment="1"
                                 FormatString="00" Width="120" ShowButtonSpinner="True"
                                 AutomationProperties.Name="{loc:Tr A11y_Reminders_NotifyHourField}" />
                  <TextBlock Text=":" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                  <NumericUpDown Value="{Binding NotifyMinute}" Minimum="0" Maximum="59" Increment="5"
                                 FormatString="00" Width="120" ShowButtonSpinner="True"
                                 AutomationProperties.Name="{loc:Tr A11y_Reminders_NotifyMinuteField}" />
                </StackPanel>
              </StackPanel>

              <!-- Icono -->
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Reminders_Editor_IconFieldLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <ItemsControl ItemsSource="{Binding IconOptions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ReminderIconOptionViewModel">
                      <RadioButton Classes="segment" GroupName="ReminderIcon" Margin="0,0,8,8"
                                   IsChecked="{Binding IsSelected, Mode=OneWay}"
                                   Command="{Binding $parent[ItemsControl].((vm:ReminderEditorViewModel)DataContext).SelectIconCommand}"
                                   CommandParameter="{Binding Icon}"
                                   AutomationProperties.Name="{Binding Icon}">
                        <mi:MaterialIcon Kind="{Binding Icon}" Width="16" Height="16" />
                      </RadioButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Recurrencia local (Fase 10, docs/analisis-proyecto/roadmap.md) — mismo selector segmentado
                   que la recurrencia de tareas Polar en Kanban (views/kanban/KanbanView.axaml), reutilizando
                   las mismas claves ya traducidas puesto que es el mismo enum con el mismo significado. -->
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Reminders_Editor_RecurrenceFieldLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <WrapPanel Orientation="Horizontal">
                  <RadioButton Classes="segment" GroupName="ReminderRecurrence" Content="{loc:Tr Kanban_Recurrence_None, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,6,6"
                               IsChecked="{Binding Recurrence, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=None, Mode=OneWay}"
                               Command="{Binding SelectRecurrenceCommand}" CommandParameter="None" />
                  <RadioButton Classes="segment" GroupName="ReminderRecurrence" Content="{loc:Tr Polar_Recurrence_Daily, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,6,6"
                               IsChecked="{Binding Recurrence, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Daily, Mode=OneWay}"
                               Command="{Binding SelectRecurrenceCommand}" CommandParameter="Daily" />
                  <RadioButton Classes="segment" GroupName="ReminderRecurrence" Content="{loc:Tr Polar_Recurrence_Weekly, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,6,6"
                               IsChecked="{Binding Recurrence, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Weekly, Mode=OneWay}"
                               Command="{Binding SelectRecurrenceCommand}" CommandParameter="Weekly" />
                  <RadioButton Classes="segment" GroupName="ReminderRecurrence" Content="{loc:Tr Polar_Recurrence_Monthly, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,6,6"
                               IsChecked="{Binding Recurrence, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Monthly, Mode=OneWay}"
                               Command="{Binding SelectRecurrenceCommand}" CommandParameter="Monthly" />
                  <RadioButton Classes="segment" GroupName="ReminderRecurrence" Content="{loc:Tr Kanban_Recurrence_MonWed, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,6,6"
                               IsChecked="{Binding Recurrence, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=MonWed, Mode=OneWay}"
                               Command="{Binding SelectRecurrenceCommand}" CommandParameter="MonWed" />
                  <RadioButton Classes="segment" GroupName="ReminderRecurrence" Content="{loc:Tr Kanban_Recurrence_FirstDayMonth, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,6,6"
                               IsChecked="{Binding Recurrence, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=FirstDayMonth, Mode=OneWay}"
                               Command="{Binding SelectRecurrenceCommand}" CommandParameter="FirstDayMonth" />
                </WrapPanel>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,18,0,0">
            <Button Grid.Column="1" Classes="ghost modal-cancel"
                    Command="{Binding $parent[UserControl].((vm:RemindersViewModel)DataContext).CancelEditorCommand}"
                    Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary"
                    Command="{Binding $parent[UserControl].((vm:RemindersViewModel)DataContext).SaveEditorCommand}"
                    IsEnabled="{Binding CanSave}">
              <TextBlock Text="{loc:Tr Common_Create, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </Grid>
    </Border>
  </controls:ModalOverlayHost>

    <!-- ===================== Diálogo: detalle de recordatorio ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding Detail, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
              MaxWidth="440" DataContext="{Binding Detail}" x:DataType="vm:ReminderListItemViewModel">
        <StackPanel Spacing="18" MinWidth="380">

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="44" Height="44" Background="{DynamicResource Ink05}">
              <mi:MaterialIcon Kind="{Binding IconKind}" Width="20" Height="20" Foreground="{DynamicResource Ink70}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
       </Border>
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{Binding StatusLabel}" Classes="faint" Classes.overdue="{Binding IsOverdue}" />
              <TextBlock Text="{Binding NotifyAtLabel}" Classes="muted" FontSize="12" />
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasRecurrence}">
                <mi:MaterialIcon Kind="RepeatVariant" Width="11" Height="11" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{Binding RecurrenceLabel, Converter={StaticResource UpperCaseConverter}}" Classes="faint" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding Title}" Classes="subtask-title" Classes.done="{Binding IsCompleted}"
                     FontSize="19" FontWeight="Bold" LetterSpacing="-0.3" TextWrapping="Wrap" />

          <StackPanel Spacing="6" IsVisible="{Binding HasDescription}">
            <TextBlock Text="{loc:Tr Reminders_DescriptionLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
            <TextBlock Text="{Binding Description}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Reminders_Detail_CreatedLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
            <TextBlock Text="{Binding CreatedAtLabel}" Classes="muted" FontSize="12" />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <Button Grid.Column="0" Classes="icon-btn icon-btn-danger"
                    Command="{Binding $parent[UserControl].((vm:RemindersViewModel)DataContext).DeleteFromDetailCommand}"
                    CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Reminders_Detail_DeleteTooltip}"
                    AutomationProperties.Name="{loc:Tr Reminders_Detail_DeleteTooltip}">
              <mi:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15" />
            </Button>
            <Button Grid.Column="1" Classes="icon-btn" Margin="6,0,0,0"
                    Command="{Binding $parent[UserControl].((vm:RemindersViewModel)DataContext).ToggleCompletedCommand}"
                    CommandParameter="{Binding}"
                    ToolTip.Tip="{loc:Tr Reminders_Detail_ToggleCompletedTooltip}"
                    AutomationProperties.Name="{loc:Tr Reminders_Detail_ToggleCompletedTooltip}">
              <mi:MaterialIcon Kind="{Binding CompletedToggleIcon}" Width="15" Height="15" />
            </Button>
            <Button Grid.Column="3" Classes="pill"
                    Command="{Binding $parent[UserControl].((vm:RemindersViewModel)DataContext).CloseDetailCommand}">
              <TextBlock Text="{loc:Tr Common_Close, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
    </Border>
  </controls:ModalOverlayHost>

    <!-- ===================== Diálogo: limpiar recordatorios ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding PendingClearAll}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{loc:Tr Reminders_ClearAllModal_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{loc:Tr Reminders_ClearAllModal_Message}" FontSize="14"
                     TextWrapping="Wrap" MaxWidth="320" />

          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Command="{Binding CancelClearAllCommand}" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary-danger" Command="{Binding ConfirmClearAllCommand}">
              <TextBlock Text="{loc:Tr Reminders_ClearAllButton, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
    </Border>
  </controls:ModalOverlayHost>

  </Grid>
</UserControl>
