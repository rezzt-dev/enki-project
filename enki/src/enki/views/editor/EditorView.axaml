<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:models="clr-namespace:enki.Models"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:loc="clr-namespace:enki.Localization"
             xmlns:controls="clr-namespace:enki.Controls"
             xmlns:services="clr-namespace:enki.Services"
             xmlns:views="clr-namespace:enki.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="enki.Views.EditorView"
             x:DataType="vm:EditorViewModel">
  <UserControl.Styles>
    <Style Selector="Button.linked-card-row">
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.linked-card-row:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Ink05}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Historial de versiones: líneas del comparador (Editor_History_*) — un acento de color a la
         izquierda en vez de un fondo teñido, para que el texto siga leyéndose con el mismo contraste
         que el resto del panel en ambos temas. -->
    <Style Selector="Border.diff-line">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.diff-line.diff-added">
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
      <Setter Property="Background" Value="{DynamicResource Ink05}" />
    </Style>
    <Style Selector="Border.diff-line.diff-removed">
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Background" Value="{DynamicResource Ink05}" />
    </Style>
    <Style Selector="Border.diff-line.diff-added TextBlock.diff-text">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Border.diff-line.diff-removed TextBlock.diff-text">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="TextBlock.diff-marker">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Width" Value="12" />
    </Style>
    <Style Selector="Border.diff-line.diff-added TextBlock.diff-marker">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Border.diff-line.diff-removed TextBlock.diff-marker">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="{Binding RootMargin}">

    <!-- Header: título a la izquierda, metadatos/acciones a la derecha en una sola fila. Oculta por
         completo en modo enfoque/zen (propuesta 7) — junto con la barra de formato y el panel lateral,
         es lo que deja "solo el texto centrado" que pide esa propuesta. -->
    <Grid x:Name="EditorHeader" Grid.Row="0" Margin="{Binding HeaderMargin}" IsVisible="{Binding !IsZenMode}">
      <!-- Columna 0 elástica y columnas 1-3 al tamaño de su contenido: lo que cede espacio al estrechar
           el editor es el título —que se recorta y sigue estando entero en la pestaña— y no las acciones,
           que dejarían de poder pulsarse. -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="80" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                  ClipToBounds="True" Margin="0,0,12,0">
        <Button Classes="icon-btn" Command="{Binding BackCommand}"
                IsVisible="{Binding ShowFullViewChrome}"
                ToolTip.Tip="{loc:Tr Editor_Toolbar_Back_Tooltip}"
                AutomationProperties.Name="{loc:Tr Editor_Toolbar_Back_Tooltip}">
          <mi:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
        </Button>

        <!-- UpdateSourceTrigger=LostFocus (+ OnTitleKeyDown committing on Enter below) is deliberate:
             Title's setter renames the file on disk (VaultService.RenameNote), and the note's FullPath is
             the tab's identity — the default PropertyChanged trigger would rename the file on every
             keystroke while typing a new title, hammering disk I/O and reloading the note grid mid-word.
             "ghost title-edit" layers a rename-specific affordance on top of the chrome-less ghost base
             (§ Styles.axaml) — a hairline underline that only shows on hover/focus. -->
        <TextBox Classes="ghost title-edit" FontSize="{Binding TitleFontSize}" FontWeight="Bold"
                 LetterSpacing="-0.5"
                 Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                 PlaceholderText="{loc:Tr Editor_Title_Placeholder}" VerticalAlignment="Center"
                 AutomationProperties.Name="{loc:Tr Editor_Title_Placeholder}"
                 ToolTip.Tip="{loc:Tr Editor_Title_RenameTooltip}"
                 KeyDown="OnTitleKeyDown" GotFocus="OnTitleGotFocus" />
      </StackPanel>

      <!-- ===================== Nota diaria (propuesta 8) =====================
           Solo aparece cuando la nota abierta es la nota diaria de un día (ver
           EditorViewModel.DailyNote.cs): día anterior, la fecha escrita para leerse, día siguiente y,
           cuando toca, volver a hoy y combinar con la plantilla. En cualquier otra nota la columna se
           colapsa y la cabecera queda exactamente como estaba. -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="8,0" VerticalAlignment="Center"
                  IsVisible="{Binding IsDailyNote}">
        <Button Classes="icon-btn" Width="30" Height="30" Command="{Binding OpenPreviousDayCommand}"
                ToolTip.Tip="{loc:Tr Editor_DailyNote_PreviousDay}"
                AutomationProperties.Name="{loc:Tr Editor_DailyNote_PreviousDay}">
          <mi:MaterialIcon Kind="CalendarArrowLeft" Width="15" Height="15" />
        </Button>

        <Border Classes="card" Padding="9,5" VerticalAlignment="Center"
                ToolTip.Tip="{loc:Tr Editor_DailyNote_DateTooltip}">
          <TextBlock Text="{Binding DailyNoteDateLabel}" FontSize="11" FontWeight="Bold"
                     FontFamily="{DynamicResource InterfaceLabelFontFamily}" VerticalAlignment="Center" />
        </Border>

        <Button Classes="icon-btn" Width="30" Height="30" Command="{Binding OpenNextDayCommand}"
                ToolTip.Tip="{loc:Tr Editor_DailyNote_NextDay}"
                AutomationProperties.Name="{loc:Tr Editor_DailyNote_NextDay}">
          <mi:MaterialIcon Kind="CalendarArrowRight" Width="15" Height="15" />
        </Button>

        <Button Classes="icon-btn" Width="30" Height="30" Command="{Binding OpenTodayNoteCommand}"
                IsVisible="{Binding CanReturnToToday}"
                ToolTip.Tip="{loc:Tr Editor_DailyNote_Today}"
                AutomationProperties.Name="{loc:Tr Editor_DailyNote_Today}">
          <mi:MaterialIcon Kind="CalendarTodayOutline" Width="15" Height="15" />
        </Button>

        <!-- Combinar con la plantilla: solo cuando hay algo que añadir, y con el tooltip enumerando qué
             secciones se van a añadir antes de pulsarlo. -->
        <Button Classes="icon-btn" Width="30" Height="30" Command="{Binding MergeDailyTemplateCommand}"
                IsVisible="{Binding HasPendingDailyTemplateSections}"
                ToolTip.Tip="{Binding PendingDailyTemplateTooltip}"
                AutomationProperties.Name="{Binding PendingDailyTemplateTooltip}">
          <mi:MaterialIcon Kind="FileDocumentPlusOutline" Width="15" Height="15" />
        </Button>
      </StackPanel>

      <!-- Tareas vinculadas en la cabecera; el desplegable no desplaza el editor. -->
      <Panel Grid.Column="2" Margin="8,0" VerticalAlignment="Center" IsVisible="{Binding ShowLinkedCards}">
        <ToggleButton x:Name="LinkedCardsTrigger" Classes="tag-chip toolbar-chip" Padding="9,5" MinHeight="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                      IsChecked="{Binding IsLinkedCardsExpanded, Mode=TwoWay}"
                      AutomationProperties.Name="{loc:Tr Editor_LinkedCards_Label}"
                      ToolTip.Tip="{loc:Tr Editor_LinkedCards_Label}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="LinkVariant" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="{Binding LinkedCards.Count}" FontSize="11" FontFamily="{DynamicResource InterfaceLabelFontFamily}" VerticalAlignment="Center" />
            <mi:MaterialIcon Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding !IsLinkedCardsExpanded}" />
            <mi:MaterialIcon Kind="ChevronUp" Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding IsLinkedCardsExpanded}" />
          </StackPanel>
        </ToggleButton>
        <Popup x:Name="LinkedCardsPopup" PlacementTarget="{Binding #LinkedCardsTrigger}" Placement="BottomEdgeAlignedRight" VerticalOffset="4"
               IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #LinkedCardsTrigger}"
               IsOpen="{Binding IsLinkedCardsExpanded, Mode=TwoWay}">
          <Border Classes="dropdown-popover" MinWidth="200" MaxWidth="320">
            <StackPanel Spacing="10">
              <TextBlock Text="{loc:Tr Editor_LinkedCards_Label, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9" />
              <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding LinkedCards}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="1" Background="{DynamicResource Ink10}" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LinkedCardItemViewModel">
                      <Button Classes="linked-card-row" Padding="10,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).OpenLinkedCardCommand}"
                              CommandParameter="{Binding Id}">
                        <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Popup>
      </Panel>

      <!-- Etiquetas con icono y fondo de tarjeta para agrupar visualmente. Columna propia (ya no dentro
           del grupo de acciones) con un ancho acotado por los dos lados: el MinWidth garantiza que siga
           siendo una caja en la que se puede escribir por estrecho que vaya el editor, y el MaxWidth que
           no se estire a lo largo de media cabecera en una ventana ancha. Fuera de la vista simplificada
           (ver ShowFullViewChrome): allí la cabecera se queda en el nombre de la nota y las acciones. -->
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding ShowFullViewChrome}">
      <Border x:Name="TagsBox" Margin="12,0,4,0"
              IsVisible="{Binding ShowFullViewChrome}"
              Classes="card" Padding="8,5" VerticalAlignment="Center" HorizontalAlignment="Left"
              MinWidth="150" MaxWidth="240">
        <Grid ColumnDefinitions="Auto,*">
          <mi:MaterialIcon Grid.Column="0" Kind="TagOutline" Width="14" Height="14" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Classes="search tag-input"
                   MinWidth="0" VerticalAlignment="Center"
                   Text="{Binding TagsInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                   PlaceholderText="{loc:Tr Editor_Tags_Placeholder}"
                   AutomationProperties.Name="{loc:Tr Editor_Tags_Placeholder}"
                   KeyDown="OnTagsKeyDown" LostFocus="OnTagsLostFocus" />
        </Grid>
      </Border>
        <Panel>
          <Button x:Name="PropertiesTrigger" Classes="icon-btn" Width="32" Height="32"
                  Command="{Binding TogglePropertiesCommand}" ToolTip.Tip="{loc:Tr Editor_Properties_Title}"
                  AutomationProperties.Name="{loc:Tr Editor_Properties_Title}">
            <mi:MaterialIcon Kind="FormatListBulleted" Width="16" Height="16" />
          </Button>
          <Popup PlacementTarget="{Binding #PropertiesTrigger}" Placement="BottomEdgeAlignedRight"
                 VerticalOffset="4" IsLightDismissEnabled="True" IsOpen="{Binding IsPropertiesOpen, Mode=TwoWay}">
            <Border Classes="dropdown-popover" Width="330" Padding="14">
              <StackPanel Spacing="10">
                <TextBlock Text="{loc:Tr Editor_Properties_Title}" Classes="eyebrow" />
                <ItemsControl ItemsSource="{Binding Properties}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotePropertyItemViewModel">
                      <Grid ColumnDefinitions="100,*,Auto,Auto" Margin="0,0,0,5">
                        <TextBlock Grid.Column="0" Text="{Binding Key}" Classes="faint" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Classes="icon-btn" Width="24" Height="24" Content="✎"
                                Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).EditPropertyCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="{loc:Tr Editor_Properties_Edit}" AutomationProperties.Name="{loc:Tr Editor_Properties_Edit}" />
                        <Button Grid.Column="3" Classes="icon-btn" Width="24" Height="24" Content="×"
                                Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).DeletePropertyCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="{loc:Tr Editor_Properties_Delete}" AutomationProperties.Name="{loc:Tr Editor_Properties_Delete}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Text="{Binding PropertyKeyInput}" AutomationProperties.Name="{loc:Tr Editor_Properties_Key}" PlaceholderText="{loc:Tr Editor_Properties_Key}" />
                <TextBox Text="{Binding PropertyValueInput}" AutomationProperties.Name="{loc:Tr Editor_Properties_Value}" PlaceholderText="{loc:Tr Editor_Properties_Value}" />
                <Button Classes="pill" Command="{Binding SavePropertyCommand}" Content="{loc:Tr Editor_Properties_Save, Converter={StaticResource UpperCaseConverter}}" />
                <TextBlock Text="{Binding PropertyError}" IsVisible="{Binding HasPropertyError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Popup>
        </Panel>
      </StackPanel>

      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <!-- Cambio externo sin resolver (.docs/project-info/cambios-externos-en-el-vault.md): mientras
             haya una decisión pendiente el autoguardado de esta nota está en pausa, y eso no puede ser un
             estado invisible. Se muestra también en la vista simplificada, a diferencia del resto de
             adornos de la cabecera: es lo contrario de un adorno. -->
        <Button Classes="pill pill-compact"
                IsVisible="{Binding ShowExternalConflictBadge}"
                Command="{Binding ReopenExternalConflictCommand}"
                ToolTip.Tip="{loc:Tr Editor_External_Badge_Tooltip}"
                AutomationProperties.Name="{loc:Tr Editor_External_Badge_Tooltip}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14"
                             Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Tr Editor_External_Badge, Converter={StaticResource UpperCaseConverter}}"
                       Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Indicador de guardado prominente (Fase 2 §2). En la vista simplificada se queda solo el
             icono: la pestaña ya lleva su propio punto de "sin guardar", y esos ~70px de etiqueta son la
             diferencia entre que la cabecera quepa o no en un panel de editor estrecho. -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding SaveStatus}">
          <mi:MaterialIcon Width="14" Height="14" Kind="CheckCircleOutline" Classes="severity-icon success"
                           IsVisible="{Binding ShowSavedIcon}" />
          <mi:MaterialIcon Width="14" Height="14" Kind="CircleMedium" Classes="severity-icon warning"
                           IsVisible="{Binding !ShowSavedIcon}" />
          <TextBlock Text="{Binding SaveStatus, Converter={StaticResource UpperCaseConverter}}" FontWeight="Bold" FontSize="11"
                     VerticalAlignment="Center" IsVisible="{Binding ShowFullViewChrome}" />
        </StackPanel>

        <!-- Barra de formato y panel lateral no existen en la vista simplificada de Notas (Ajustes ›
             Editor › Vista del editor), así que sus interruptores desaparecen con ellos en vez de
             quedarse como botones que no hacen nada. -->
        <Button Classes="icon-btn" Classes.active="{Binding IsToolbarVisible}"
                IsVisible="{Binding ShowFullViewChrome}"
                Command="{Binding ToggleToolbarCommand}"
                ToolTip.Tip="{loc:Tr Editor_Toolbar_ToggleToolbar_Tooltip}"
                AutomationProperties.Name="{loc:Tr Editor_Toolbar_ToggleToolbar_Tooltip}">
          <mi:MaterialIcon Kind="FormatFont" Width="17" Height="17" />
        </Button>

        <Button Classes="icon-btn" Classes.active="{Binding IsSidePanelVisible}"
                IsVisible="{Binding ShowFullViewChrome}"
                Command="{Binding ToggleSidePanelCommand}"
                ToolTip.Tip="{loc:Tr Editor_Toolbar_ToggleSidePanel_Tooltip}"
                AutomationProperties.Name="{loc:Tr Editor_Toolbar_ToggleSidePanel_Tooltip}">
          <mi:MaterialIcon Kind="{Binding SidePanelToggleIcon}" Width="17" Height="17" />
        </Button>

        <!-- Modo enfoque/zen (propuesta 7, docs/propuesta-nuevas-funcionalidades.md): oculta cabecera,
             barra de formato, tarjetas vinculadas y panel lateral, dejando solo el cuerpo de la nota.
             Ctrl+Shift+Enter (ver NotesView.axaml) lo activa/desactiva desde cualquier punto de la
             pestaña; Escape lo desactiva (ver EditorView.axaml.cs, OnEditorKeyDown). -->
        <Button Classes="icon-btn" Classes.active="{Binding IsZenMode}"
                Command="{Binding ToggleZenModeCommand}"
                ToolTip.Tip="{loc:Tr Editor_Toolbar_ToggleZenMode_Tooltip}"
                AutomationProperties.Name="{loc:Tr Editor_Toolbar_ToggleZenMode_Tooltip}">
          <mi:MaterialIcon Kind="{Binding ZenModeToggleIcon}" Width="17" Height="17" />
        </Button>

        <!-- Exportar (propuesta 6, docs/propuesta-nuevas-funcionalidades.md): HTML directo autónomo. -->
        <Button Classes="icon-btn" Command="{Binding ExportAsHtmlCommand}"
                ToolTip.Tip="{loc:Tr Notes_ExportHtmlMenuItem}"
                AutomationProperties.Name="{loc:Tr Notes_ExportHtmlMenuItem}">
          <mi:MaterialIcon Kind="FileExportOutline" Width="17" Height="17" />
        </Button>

        <Button Classes="icon-btn icon-btn-danger" Command="{Binding RequestDeleteCommand}"
                ToolTip.Tip="{loc:Tr Editor_Toolbar_Delete_Tooltip}"
                AutomationProperties.Name="{loc:Tr Editor_Toolbar_Delete_Tooltip}">
          <mi:MaterialIcon Kind="TrashCanOutline" Width="17" Height="17" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Formatting toolbar — split into five independently collapsible groups (Fase 4 §"Editor de notas",
         gap 17). Each group's own chevron button stays put whether or not the group is expanded, so it's
         always where the user left it; only the ButtonsPanel underneath collapses/expands. -->
    <StackPanel x:Name="FormattingToolbar" Grid.Row="1" Orientation="Horizontal" Spacing="2" Margin="0,0,0,16"
                HorizontalAlignment="Center" IsVisible="{Binding ShowFormattingToolbar}">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="icon-btn toolbar-group-toggle" Classes.active="{Binding !IsToolbarTextStyleExpanded}" Width="16" Height="26"
                Command="{Binding ToggleToolbarGroupCommand}" CommandParameter="TextStyle"
                ToolTip.Tip="{loc:Tr Editor_Toolbar_ToggleGroup_Tooltip}">
          <Panel>
            <mi:MaterialIcon Kind="ChevronLeft" Width="11" Height="11" IsVisible="{Binding IsToolbarTextStyleExpanded}" />
            <mi:MaterialIcon Kind="ChevronRight" Width="11" Height="11" IsVisible="{Binding !IsToolbarTextStyleExpanded}" />
          </Panel>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsToolbarTextStyleExpanded}">
          <Button Classes="icon-btn" Click="OnBoldClick" ToolTip.Tip="{loc:Tr Editor_Toolbar_Bold_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_Bold_Tooltip}">
            <mi:MaterialIcon Kind="FormatBold" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Click="OnItalicClick" ToolTip.Tip="{loc:Tr Editor_Toolbar_Italic_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_Italic_Tooltip}">
            <mi:MaterialIcon Kind="FormatItalic" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Click="OnStrikethroughClick" ToolTip.Tip="{loc:Tr Editor_Toolbar_Strikethrough_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_Strikethrough_Tooltip}">
            <mi:MaterialIcon Kind="FormatStrikethrough" Width="16" Height="16" />
          </Button>
          <!-- Resaltado (==texto==): el live preview ya lo pintaba, pero no había forma de escribirlo sin
               saberse la sintaxis de memoria. -->
          <Button Classes="icon-btn" Click="OnHighlightClick" ToolTip.Tip="{loc:Tr Editor_Toolbar_Highlight_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_Highlight_Tooltip}">
            <mi:MaterialIcon Kind="Marker" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </StackPanel>
      <Rectangle Width="1" Height="18" Fill="{DynamicResource Ink10}" Margin="6,0" />

      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="icon-btn toolbar-group-toggle" Classes.active="{Binding !IsToolbarHeadingsExpanded}" Width="16" Height="26"
                Command="{Binding ToggleToolbarGroupCommand}" CommandParameter="Headings"
                ToolTip.Tip="{loc:Tr Editor_Toolbar_ToggleGroup_Tooltip}">
          <Panel>
            <mi:MaterialIcon Kind="ChevronLeft" Width="11" Height="11" IsVisible="{Binding IsToolbarHeadingsExpanded}" />
            <mi:MaterialIcon Kind="ChevronRight" Width="11" Height="11" IsVisible="{Binding !IsToolbarHeadingsExpanded}" />
          </Panel>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsToolbarHeadingsExpanded}">
          <Button Classes="icon-btn" Click="OnH1Click" ToolTip.Tip="{loc:Tr Editor_Toolbar_H1_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_H1_Tooltip}">
            <mi:MaterialIcon Kind="FormatHeader1" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Click="OnH2Click" ToolTip.Tip="{loc:Tr Editor_Toolbar_H2_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_H2_Tooltip}">
            <mi:MaterialIcon Kind="FormatHeader2" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Click="OnH3Click" ToolTip.Tip="{loc:Tr Editor_Toolbar_H3_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_H3_Tooltip}">
            <mi:MaterialIcon Kind="FormatHeader3" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Click="OnQuoteClick" ToolTip.Tip="{loc:Tr Editor_Toolbar_Quote_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_Quote_Tooltip}">
            <mi:MaterialIcon Kind="FormatQuoteClose" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </StackPanel>
      <Rectangle Width="1" Height="18" Fill="{DynamicResource Ink10}" Margin="6,0" />

      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="icon-btn toolbar-group-toggle" Classes.active="{Binding !IsToolbarListsExpanded}" Width="16" Height="26"
                Command="{Binding ToggleToolbarGroupCommand}" CommandParameter="Lists"
                ToolTip.Tip="{loc:Tr Editor_Toolbar_ToggleGroup_Tooltip}">
          <Panel>
            <mi:MaterialIcon Kind="ChevronLeft" Width="11" Height="11" IsVisible="{Binding IsToolbarListsExpanded}" />
            <mi:MaterialIcon Kind="ChevronRight" Width="11" Height="11" IsVisible="{Binding !IsToolbarListsExpanded}" />
          </Panel>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsToolbarListsExpanded}">
          <Button Classes="icon-btn" Click="OnBulletClick" ToolTip.Tip="{loc:Tr Editor_Toolbar_BulletList_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_BulletList_Tooltip}">
            <mi:MaterialIcon Kind="FormatListBulleted" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Click="OnOrderedClick" ToolTip.Tip="{loc:Tr Editor_Toolbar_OrderedList_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_OrderedList_Tooltip}">
            <mi:MaterialIcon Kind="FormatListNumbered" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Click="OnTaskListClick" ToolTip.Tip="{loc:Tr Editor_Toolbar_TaskList_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_TaskList_Tooltip}">
            <mi:MaterialIcon Kind="FormatListChecks" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </StackPanel>
      <Rectangle Width="1" Height="18" Fill="{DynamicResource Ink10}" Margin="6,0" />

      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="icon-btn toolbar-group-toggle" Classes.active="{Binding !IsToolbarInsertExpanded}" Width="16" Height="26"
                Command="{Binding ToggleToolbarGroupCommand}" CommandParameter="Insert"
                ToolTip.Tip="{loc:Tr Editor_Toolbar_ToggleGroup_Tooltip}">
          <Panel>
            <mi:MaterialIcon Kind="ChevronLeft" Width="11" Height="11" IsVisible="{Binding IsToolbarInsertExpanded}" />
            <mi:MaterialIcon Kind="ChevronRight" Width="11" Height="11" IsVisible="{Binding !IsToolbarInsertExpanded}" />
          </Panel>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsToolbarInsertExpanded}">
          <Button Classes="icon-btn" Click="OnLinkClick" ToolTip.Tip="{loc:Tr Editor_Toolbar_Link_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_Link_Tooltip}">
            <mi:MaterialIcon Kind="LinkVariant" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Click="OnNoteLinkClick" ToolTip.Tip="{loc:Tr Editor_Toolbar_NoteLink_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_NoteLink_Tooltip}">
            <mi:MaterialIcon Kind="FileLinkOutline" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Click="OnAttachmentClick" ToolTip.Tip="{loc:Tr Editor_Attachments_Add}" AutomationProperties.Name="{loc:Tr Editor_Attachments_Add}">
            <mi:MaterialIcon Kind="Paperclip" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Command="{Binding ShowAttachmentsCommand}" ToolTip.Tip="{loc:Tr Editor_Attachments_Title}" AutomationProperties.Name="{loc:Tr Editor_Attachments_Title}">
            <mi:MaterialIcon Kind="FolderImage" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Click="OnImageClick" ToolTip.Tip="{loc:Tr Editor_Toolbar_Image_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_Image_Tooltip}">
            <mi:MaterialIcon Kind="ImageOutline" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Click="OnTableClick" ToolTip.Tip="{loc:Tr Editor_Toolbar_Table_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_Table_Tooltip}">
            <mi:MaterialIcon Kind="Table" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </StackPanel>
      <Rectangle Width="1" Height="18" Fill="{DynamicResource Ink10}" Margin="6,0" />

      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="icon-btn toolbar-group-toggle" Classes.active="{Binding !IsToolbarCodeExpanded}" Width="16" Height="26"
                Command="{Binding ToggleToolbarGroupCommand}" CommandParameter="Code"
                ToolTip.Tip="{loc:Tr Editor_Toolbar_ToggleGroup_Tooltip}">
          <Panel>
            <mi:MaterialIcon Kind="ChevronLeft" Width="11" Height="11" IsVisible="{Binding IsToolbarCodeExpanded}" />
            <mi:MaterialIcon Kind="ChevronRight" Width="11" Height="11" IsVisible="{Binding !IsToolbarCodeExpanded}" />
          </Panel>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsToolbarCodeExpanded}">
          <Button Classes="icon-btn" Click="OnCodeClick" ToolTip.Tip="{loc:Tr Editor_Toolbar_InlineCode_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_InlineCode_Tooltip}">
            <mi:MaterialIcon Kind="CodeTags" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Click="OnCodeBlockClick" ToolTip.Tip="{loc:Tr Editor_Toolbar_CodeBlock_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_CodeBlock_Tooltip}">
            <mi:MaterialIcon Kind="CodeBraces" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Click="OnHorizontalRuleClick" ToolTip.Tip="{loc:Tr Editor_Toolbar_HorizontalRule_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Editor_Toolbar_HorizontalRule_Tooltip}">
            <mi:MaterialIcon Kind="Minus" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <!-- Body -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <Border Grid.Column="0" x:Name="EditorBorder" Classes="card" Padding="4">
        <Grid RowDefinitions="Auto,*">
          <!-- Find & Replace panel -->
          <Border Grid.Row="0" x:Name="FindReplacePanel"
                  Background="{DynamicResource AppBackgroundAltBrush}"
                  BorderBrush="{DynamicResource Ink10}"
                  BorderThickness="0,0,0,1"
                  Padding="12,10"
                  IsVisible="{Binding FindReplace.IsOpen}">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto">
              <TextBox Grid.Row="0" Grid.Column="0" x:Name="FindReplaceSearchTextBox"
                       Classes="search"
                       Text="{Binding FindReplace.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="{loc:Tr Editor_FindReplace_SearchPlaceholder}" />
              <TextBox Grid.Row="1" Grid.Column="0"
                       Classes="search"
                       Text="{Binding FindReplace.ReplaceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="{loc:Tr Editor_FindReplace_ReplacePlaceholder}"
                       IsVisible="{Binding FindReplace.IsReplaceMode}"
                       Margin="0,8,0,0" />

              <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                          Orientation="Horizontal" Spacing="6" Margin="12,0,0,0"
                          VerticalAlignment="Center">
                <ToggleButton Classes="tag-chip"
                              IsChecked="{Binding FindReplace.MatchCase}"
                              Content="Aa" />
                <Button Classes="icon-btn" Command="{Binding FindReplace.FindPreviousCommand}" ToolTip.Tip="{loc:Tr Editor_FindReplace_PreviousTooltip}"
                        AutomationProperties.Name="{loc:Tr Editor_FindReplace_PreviousTooltip}">
                  <mi:MaterialIcon Kind="ChevronUp" Width="16" Height="16" />
                </Button>
                <Button Classes="icon-btn" Command="{Binding FindReplace.FindNextCommand}" ToolTip.Tip="{loc:Tr Editor_FindReplace_NextTooltip}"
                        AutomationProperties.Name="{loc:Tr Editor_FindReplace_NextTooltip}">
                  <mi:MaterialIcon Kind="ChevronDown" Width="16" Height="16" />
                </Button>
                <Button Classes="icon-btn" Command="{Binding FindReplace.ReplaceCommand}" ToolTip.Tip="{loc:Tr Editor_FindReplace_ReplaceTooltip}"
                        AutomationProperties.Name="{loc:Tr Editor_FindReplace_ReplaceTooltip}"
                        IsVisible="{Binding FindReplace.IsReplaceMode}">
                  <mi:MaterialIcon Kind="PencilOutline" Width="16" Height="16" />
                </Button>
                <Button Classes="icon-btn" Command="{Binding FindReplace.ReplaceAllCommand}" ToolTip.Tip="{loc:Tr Editor_FindReplace_ReplaceAllTooltip}"
                        AutomationProperties.Name="{loc:Tr Editor_FindReplace_ReplaceAllTooltip}"
                        IsVisible="{Binding FindReplace.IsReplaceMode}">
                  <mi:MaterialIcon Kind="Autorenew" Width="16" Height="16" />
                </Button>
                <Button Classes="icon-btn" Command="{Binding FindReplace.CloseCommand}" ToolTip.Tip="{loc:Tr Common_Close}"
                        AutomationProperties.Name="{loc:Tr Common_Close}">
                  <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
                </Button>
              </StackPanel>

              <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                         Text="{Binding FindReplace.StatusLabel}"
                         Classes="faint" FontSize="10.5"
                         VerticalAlignment="Bottom" HorizontalAlignment="Right"
                         Margin="12,8,0,0" />
            </Grid>
          </Border>

          <!-- EditorColumnHost is the readable-column container: ApplyColumnLayout() (in code-behind)
               sets its MaxWidth/HorizontalAlignment per the Settings page, and Editor simply stretches
               to fill it. Constraining a plain Border this way is more reliable than constraining the
               ae:TextEditor directly, since TextEditor is a templated control. The 8px margin keeps the
               text off the card's edges even when the column is left-aligned or its width fills the card. -->
          <!-- El editor y, superpuesto en el mismo hueco, el lienzo donde se colocan los botones de copiar
               de los bloques de código (ver CodeBlockCopyOverlay). Va aquí fuera y no en una capa del
               propio AvaloniaEdit porque sus capas no entran en el árbol lógico y un botón dentro de ellas
               no llega a recibir estilo ni plantilla. Sin Background no entra en el hit-test: todo clic que
               no caiga en un botón atraviesa el lienzo y llega al editor. -->
          <Grid x:Name="CodeBlockInputHost" Grid.Row="1">
            <!-- Motor único y oculto que convierte Mermaid a SVG. Mide 1 px porque algunos backends no
                 inicializan un NativeWebView desconectado o sin tamaño; nunca recibe entrada ni navega. -->
            <ContentControl x:Name="MermaidEngineHost" Width="1" Height="1" Opacity="0"
                            IsHitTestVisible="False" ClipToBounds="True" ZIndex="-1"
                            HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Border x:Name="EditorColumnHost" Margin="8">
              <!-- Both horizontal paddings must stay >= MarkdownStyle.CodeBlockHorizontalPadding: a fenced
                   code block's box is painted that far outside the text column on each side, into the left
                   and right padding, so the code text inside it clears the border on every
                   row - see EditorView.axaml.cs's UpdateCodeBlockBleed(). -->
              <ae:TextEditor x:Name="Editor"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="14.5"
                             Padding="20"
                             LineNumbersForeground="{DynamicResource TextMutedBrush}" />
            </Border>
            <Canvas x:Name="CodeBlockOverlay" ClipToBounds="True" Panel.ZIndex="1" />
          </Grid>
        </Grid>
      </Border>

      <!-- El panel reserva su ancho una sola vez: animarlo recompone todo el Markdown por fotograma. -->
      <Grid Grid.Column="1" x:Name="SidePanelHost" ColumnDefinitions="Auto,Auto"
            Width="{Binding SidePanelWidth}" ClipToBounds="True">


        <!-- Separador fino entre editor y panel lateral -->
        <Border Grid.Column="0" Width="1" HorizontalAlignment="Center"
                Background="{DynamicResource Ink10}" IsHitTestVisible="False" Margin="10,0" />

        <!-- Panel lateral derecho: outline, backlinks y estadísticas -->
        <Border Grid.Column="1" x:Name="SidePanel" Classes="card" Padding="0" Width="340"
                Background="{DynamicResource AppBackgroundAltBrush}">
          <Grid RowDefinitions="Auto,*">
            <!-- Barra de tabs con acento inferior. Cada opción ocupa un tercio del ancho para evitar
                 que etiquetas largas choquen con el borde; el estilo .side-panel-tab dibuja solo la
                 línea inferior, eliminando los bordes dobles del segmented control genérico. -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*">
              <RadioButton Grid.Column="0" Classes="side-panel-tab" GroupName="SidePanelTab"
                           IsChecked="{Binding ActiveSidePanelTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Outline}"
                           Command="{Binding SelectSidePanelTabCommand}" CommandParameter="Outline"
                           ToolTip.Tip="{loc:Tr Editor_Outline_Tooltip}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <mi:MaterialIcon Kind="FormatListBulleted" Width="13" Height="13" />
                  <TextBlock Text="{loc:Tr Editor_Outline_TabLabel, Converter={StaticResource UpperCaseConverter}}" />
                </StackPanel>
              </RadioButton>
              <RadioButton Grid.Column="1" Classes="side-panel-tab" GroupName="SidePanelTab"
                           IsChecked="{Binding ActiveSidePanelTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Backlinks}"
                           Command="{Binding SelectSidePanelTabCommand}" CommandParameter="Backlinks"
                           ToolTip.Tip="{loc:Tr Editor_Backlinks_Tooltip}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <mi:MaterialIcon Kind="LinkVariant" Width="13" Height="13" />
                  <TextBlock Text="{loc:Tr Editor_Backlinks_TabLabel, Converter={StaticResource UpperCaseConverter}}" />
                </StackPanel>
              </RadioButton>
              <RadioButton Grid.Column="2" Classes="side-panel-tab" GroupName="SidePanelTab"
                           IsChecked="{Binding ActiveSidePanelTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Stats}"
                           Command="{Binding SelectSidePanelTabCommand}" CommandParameter="Stats"
                           ToolTip.Tip="{loc:Tr Editor_Stats_Tooltip}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <mi:MaterialIcon Kind="ChartBoxOutline" Width="13" Height="13" />
                  <TextBlock Text="{loc:Tr Editor_Stats_TabLabel, Converter={StaticResource UpperCaseConverter}}" />
                </StackPanel>
              </RadioButton>
              <RadioButton Grid.Column="3" Classes="side-panel-tab" GroupName="SidePanelTab"
                           IsChecked="{Binding ActiveSidePanelTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=History}"
                           Command="{Binding SelectSidePanelTabCommand}" CommandParameter="History"
                           ToolTip.Tip="{loc:Tr Editor_History_Tooltip}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <mi:MaterialIcon Kind="RestoreClock" Width="13" Height="13" />
                  <TextBlock Text="{loc:Tr Editor_History_TabLabel, Converter={StaticResource UpperCaseConverter}}" />
                </StackPanel>
              </RadioButton>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1">
              <StackPanel Margin="16,14,16,18" Spacing="16">

                <!-- Outline -->
                <StackPanel IsVisible="{Binding ActiveSidePanelTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Outline}">
                  <ItemsControl ItemsSource="{Binding Outline.Items}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="1" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:EditorOutlineItemViewModel">
                        <Button Classes="nav-item"
                                Classes.active="{Binding IsActive}"
                                Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).Outline.NavigateCommand}"
                                CommandParameter="{Binding .}"
                                Margin="{Binding Level, Converter={StaticResource OutlineIndentConverter}}">
                          <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border IsVisible="{Binding !Outline.HasItems}" Classes="card" Padding="14">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                      <mi:MaterialIcon Kind="FormatListBulleted" Width="22" Height="22" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                      <TextBlock Text="{loc:Tr Editor_Outline_Empty}" Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" FontSize="11" />
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Backlinks -->
                <StackPanel IsVisible="{Binding ActiveSidePanelTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Backlinks}">
                  <ItemsControl ItemsSource="{Binding Backlinks.Items}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="1" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="models:EditorBacklink">
                        <Button Classes="nav-item" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="10,9"
                                Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).Backlinks.OpenCommand}"
                                CommandParameter="{Binding .}">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Context}" Classes="muted" FontSize="10.5" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border IsVisible="{Binding Backlinks.IsEmpty}" Classes="card" Padding="14">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                      <mi:MaterialIcon Kind="LinkVariantOff" Width="22" Height="22" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                      <TextBlock Text="{loc:Tr Editor_Backlinks_Empty}" Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" />
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Stats -->
                <StackPanel IsVisible="{Binding ActiveSidePanelTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Stats}" Spacing="12">
                  <Border Classes="card" Padding="14">
                    <StackPanel Spacing="10">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="BookOpenOutline" Width="14" Height="14" Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Tr Editor_Stats_ReadingSectionLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9" />
                      </StackPanel>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{loc:Tr Editor_Stats_WordsLabel}" Classes="muted" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Stats.WordCount}" FontSize="12" FontWeight="Bold" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{loc:Tr Editor_Stats_CharsLabel}" Classes="muted" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Stats.CharCount}" FontSize="12" FontWeight="Bold" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{loc:Tr Editor_Stats_CharsNoSpacesLabel}" Classes="muted" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Stats.CharCountNoSpaces}" FontSize="12" FontWeight="Bold" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{loc:Tr Editor_Stats_ParagraphsLabel}" Classes="muted" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Stats.ParagraphCount}" FontSize="12" FontWeight="Bold" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{loc:Tr Editor_Stats_LinesLabel}" Classes="muted" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Stats.LineCount}" FontSize="12" FontWeight="Bold" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{loc:Tr Editor_Stats_ReadingTime_RowLabel}" Classes="muted" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Stats.ReadingTimeLabel}" FontSize="12" FontWeight="Bold" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Classes="card" Padding="14">
                    <StackPanel Spacing="10">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="FileClockOutline" Width="14" Height="14" Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Tr Editor_Stats_FileSectionLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{loc:Tr Editor_Stats_CreatedLabel}" Classes="muted" FontSize="11" />
                        <TextBlock Text="{Binding Stats.CreatedLabel}" FontSize="12" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{loc:Tr Editor_Stats_ModifiedLabel}" Classes="muted" FontSize="11" />
                        <TextBlock Text="{Binding Stats.ModifiedLabel}" FontSize="12" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Historial de versiones -->
                <StackPanel IsVisible="{Binding ActiveSidePanelTab, Converter={StaticResource StringEqualsConverter}, ConverterParameter=History}" Spacing="8">
                  <ItemsControl ItemsSource="{Binding History.Items}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:NoteVersionItemViewModel">
                        <Border Classes="card" Padding="10,9">
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                              <TextBlock Text="{Binding CreatedLabel}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding TriggerLabel}" Classes="muted" FontSize="10.5" />
                                <TextBlock Text="•" Classes="muted" FontSize="10.5" />
                                <TextBlock Text="{Binding SizeLabel}" Classes="muted" FontSize="10.5" />
                              </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="icon-btn" Width="26" Height="26"
                                    ToolTip.Tip="{loc:Tr Editor_History_ViewTooltip}"
                                    Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).History.OpenPreviewCommand}"
                                    CommandParameter="{Binding .}">
                              <mi:MaterialIcon Kind="FileCompare" Width="14" Height="14" />
                            </Button>
                            <Button Grid.Column="2" Classes="icon-btn icon-btn-danger" Width="26" Height="26"
                                    ToolTip.Tip="{loc:Tr Editor_History_DeleteVersionTooltip}"
                                    Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).History.DeleteVersionCommand}"
                                    CommandParameter="{Binding .}">
                              <mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border IsVisible="{Binding History.IsEmpty}" Classes="card" Padding="14">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                      <mi:MaterialIcon Kind="RestoreClock" Width="22" Height="22" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                      <TextBlock Text="{loc:Tr Editor_History_Empty}" Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" />
                    </StackPanel>
                  </Border>
                </StackPanel>

              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Slash commands popup -->
    <Popup x:Name="SlashCommandsPopup"
           PlacementTarget="{Binding #EditorBorder}"
           Placement="AnchorAndGravity"
           PlacementAnchor="TopLeft"
           PlacementGravity="BottomRight"
           HorizontalOffset="60" VerticalOffset="60"
           IsLightDismissEnabled="False"
           IsOpen="{Binding SlashCommands.IsOpen, Mode=TwoWay}"
           Width="260" MaxHeight="320">
      <Border Classes="dropdown-popover" Width="260" MaxHeight="320">
        <Grid RowDefinitions="Auto,*">
          <TextBox Grid.Row="0" x:Name="SlashCommandFilter"
                   Classes="search"
                   Text="{Binding SlashCommands.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="{loc:Tr Editor_SlashCommand_FilterPlaceholder}"
                   Margin="12,12,12,0" />
          <ScrollViewer Grid.Row="1" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding SlashCommands.FilteredCommands}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:SlashCommandItemViewModel">
                  <Button Classes="dropdown-item"
                          Classes.active="{Binding IsSelected}"
                          Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).SlashCommands.SelectCommand}"
                          CommandParameter="{Binding .}">
                    <Grid ColumnDefinitions="Auto,*">
                      <mi:MaterialIcon Grid.Column="0" Kind="{Binding Icon}" Width="16" Height="16"
                                        Margin="0,2,10,0" VerticalAlignment="Top" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Label, Converter={StaticResource UpperCaseConverter}}" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="{Binding Key, StringFormat={}/{0}/}" Classes="faint" FontSize="10" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Popup>

    <!-- Note-link picker popup — abierto al escribir "[[", desde el botón "enlazar nota" de la barra de
         herramientas, o desde el comando slash "/nota" (EditorView.axaml.cs, GetNoteLinkPickerContext /
         UpdateNoteLinkPicker). A diferencia del popup de slash commands de arriba (anclado al cursor), este
         se centra en la ventana de la app — PlacementTarget se reapunta al TopLevel y HorizontalOffset/
         VerticalOffset se recalculan en PositionNoteLinkPickerPopup cada vez que se abre o se filtra; los
         valores de aquí son solo el estado inicial antes de la primera reposición. -->
    <Popup x:Name="NoteLinkPickerPopup"
           PlacementTarget="{Binding #EditorBorder}"
           Placement="AnchorAndGravity"
           PlacementAnchor="TopLeft"
           PlacementGravity="BottomRight"
           IsLightDismissEnabled="False"
           IsOpen="{Binding NoteLinkPicker.IsOpen, Mode=TwoWay}"
           Width="360" MaxHeight="340">
      <Border Classes="dropdown-popover" Width="360" MaxHeight="340">
        <Grid RowDefinitions="Auto,*,Auto">
          <!-- Refleja en vivo lo que se ha escrito tras "[[" en el documento (ver GetNoteLinkPickerContext/
               UpdateNoteLinkPicker) — mismo patrón exacto que SlashCommandFilter arriba: el usuario escribe
               en el documento, no aquí dentro, pero antes esto era un TextBlock fijo con el placeholder que
               nunca cambiaba, sin dar ninguna confirmación visual de qué se estaba filtrando. -->
          <TextBox Grid.Row="0" x:Name="NoteLinkFilter"
                   Classes="search"
                   Text="{Binding NoteLinkPicker.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="{loc:Tr Kanban_NotePicker_SearchPlaceholder}"
                   Margin="12,12,12,0" />
          <ScrollViewer Grid.Row="1" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding NoteLinkPicker.FilteredResults}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:NotePickerItemViewModel">
                  <Button Classes="dropdown-item"
                          Classes.active="{Binding IsSelected}"
                          Command="{Binding $parent[UserControl].((vm:EditorViewModel)DataContext).NoteLinkPicker.SelectCommand}"
                          CommandParameter="{Binding .}"
                          ToolTip.Tip="{Binding Title}">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding WorkspaceLabel}" Classes="faint" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="2" Text="{loc:Tr Kanban_NotePicker_NoResults}" Classes="muted" FontSize="11.5"
                     Margin="12,8,12,12" IsVisible="{Binding !NoteLinkPicker.FilteredResults.Count}" />
        </Grid>
      </Border>
    </Popup>

    <!-- ===================== Diálogo: eliminar nota (barra de herramientas del editor, análisis alfa-3 §4.5) ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding IsPendingDelete}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{loc:Tr Notes_DeleteNote_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Notes_DeleteNote_Message}" FontSize="14" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Title}" Classes="muted" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Command="{Binding CancelDeleteCommand}" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary-danger" Command="{Binding ConfirmDeleteCommand}">
              <TextBlock Text="{loc:Tr Common_Delete, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>

    <!-- ===================== Diálogo: historial de versiones — comparar y restaurar (historial local
         de versiones por nota) ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding History.IsPreviewOpen}">
      <Border Classes="modal-card" MaxWidth="720" Width="680" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*,Auto" MaxHeight="560">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="FileCompare" Width="18" Height="18" Foreground="{DynamicResource Ink40}" />
            <TextBlock Text="{loc:Tr Editor_History_CompareTitle, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,14">
            <TextBlock Text="{Binding History.SelectedVersion.CreatedLabel}" FontWeight="Bold" FontSize="13" />
            <TextBlock Text="•" Classes="muted" />
            <TextBlock Text="{Binding History.SelectedVersion.TriggerLabel}" Classes="muted" FontSize="12" />
            <TextBlock Text="•" Classes="muted" />
            <TextBlock Text="{Binding History.SelectedVersion.SizeLabel}" Classes="muted" FontSize="12" />
          </StackPanel>

          <Border Grid.Row="2" Classes="card" Padding="2" MinHeight="220">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding History.DiffLines}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="0" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="services:DiffLine">
                    <Border Classes="diff-line"
                            Classes.diff-added="{Binding Kind, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Added}"
                            Classes.diff-removed="{Binding Kind, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Removed}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="diff-marker" Text="+"
                                   IsVisible="{Binding Kind, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Added}" />
                        <TextBlock Classes="diff-marker" Text="−"
                                   IsVisible="{Binding Kind, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Removed}" />
                        <TextBlock Classes="diff-text" Text="{Binding Text}"
                                   FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <!-- Acciones normales: cerrar o pasar a la confirmación de restaurar -->
          <Grid Grid.Row="3" Margin="0,16,0,0" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding !History.IsPendingRestore}">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Command="{Binding History.ClosePreviewCommand}" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary" Command="{Binding History.RequestRestoreCommand}">
              <TextBlock Text="{loc:Tr Editor_History_RestoreButton, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>

          <!-- Confirmación de restaurar, dentro del mismo diálogo — restaurar siempre crea antes un
               snapshot "PreRestore" del contenido actual (VaultService.RestoreVersion), así que esta
               acción nunca es un callejón sin salida. -->
          <StackPanel Grid.Row="3" Margin="0,16,0,0" Spacing="14" IsVisible="{Binding History.IsPendingRestore}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <mi:MaterialIcon Kind="AlertCircleOutline" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}" />
              <TextBlock Text="{loc:Tr Editor_History_ConfirmRestore_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding History.ConfirmRestoreMessage}" FontSize="13" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <Button Grid.Column="1" Classes="ghost modal-cancel" Command="{Binding History.CancelRestoreCommand}" Margin="0,0,18,0">
                <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
              <Button Grid.Column="2" Classes="pill-primary" Command="{Binding History.ConfirmRestoreCommand}">
                <TextBlock Text="{loc:Tr Editor_History_ConfirmRestore_Confirm, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </controls:ModalOverlayHost>

    <!-- ===================== Diálogo: la nota cambió fuera de Enki
         (.docs/project-info/cambios-externos-en-el-vault.md) =====================
         Ninguna de las dos opciones destruye nada: la versión descartada se guarda antes en el historial
         local con el motivo "conflicto externo". Escape equivale a "decidir luego", que cierra el diálogo
         y deja el autoguardado en pausa hasta que haya decisión. -->
    <controls:ModalOverlayHost IsOpen="{Binding IsExternalConflictOpen}">
      <Border Classes="modal-card" MaxWidth="720" Width="680" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.KeyBindings>
          <KeyBinding Gesture="Escape" Command="{Binding PostponeExternalDecisionCommand}" />
        </Border.KeyBindings>
        <Grid RowDefinitions="Auto,Auto,*,Auto" MaxHeight="560">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="FileSyncOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{loc:Tr Editor_External_Conflict_Title, Converter={StaticResource UpperCaseConverter}}"
                       Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Row="1" Spacing="6" Margin="0,12,0,14">
            <TextBlock Text="{Binding ExternalConflictMessage}" FontSize="14" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Tr Editor_External_Conflict_Reassurance}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
          </StackPanel>

          <Border Grid.Row="2" Classes="card" Padding="2" MinHeight="180" IsVisible="{Binding IsExternalDiffVisible}">
            <ScrollViewer>
              <StackPanel Spacing="0">
                <TextBlock Text="{loc:Tr Editor_External_Conflict_DiffLegend}" Classes="muted" FontSize="11" Margin="10,8" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding ExternalDiffLines}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="0" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="services:DiffLine">
                      <Border Classes="diff-line"
                              Classes.diff-added="{Binding Kind, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Added}"
                              Classes.diff-removed="{Binding Kind, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Removed}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="diff-marker" Text="+"
                                     IsVisible="{Binding Kind, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Added}" />
                          <TextBlock Classes="diff-marker" Text="&#x2212;"
                                     IsVisible="{Binding Kind, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Removed}" />
                          <TextBlock Classes="diff-text" Text="{Binding Text}"
                                     FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Grid Grid.Row="3" Margin="0,16,0,0" ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0" Classes="ghost" Command="{Binding ToggleExternalDiffCommand}">
              <TextBlock Text="{Binding ExternalDiffToggleLabel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="ghost modal-cancel" Command="{Binding LoadFromDiskCommand}" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Editor_External_Conflict_LoadFromDisk, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="3" Classes="pill-primary" Command="{Binding KeepMineCommand}">
              <TextBlock Text="{loc:Tr Editor_External_Conflict_KeepMine, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </Grid>
      </Border>
    </controls:ModalOverlayHost>

    <!-- ===================== Diálogo: la nota se borró fuera de Enki =====================
         El contenido sigue en pantalla y el autoguardado en pausa: escribirlo recrearía en silencio un
         archivo que alguien borró a propósito. -->
    <controls:ModalOverlayHost IsOpen="{Binding IsExternallyDeleted}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="FileRemoveOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{loc:Tr Editor_External_Deleted_Title, Converter={StaticResource UpperCaseConverter}}"
                       Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{Binding ExternalDeletedMessage}" FontSize="14" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Tr Editor_External_Deleted_Hint}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Command="{Binding DiscardAfterExternalDeleteCommand}" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Editor_External_Deleted_Discard, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary" Command="{Binding SaveAfterExternalDeleteCommand}">
              <TextBlock Text="{loc:Tr Editor_External_Deleted_SaveAsNew, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>

    <controls:ModalOverlayHost IsOpen="{Binding IsAttachmentsOpen}" ZIndex="20">
      <Border Classes="modal-card" MaxWidth="1040" Margin="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <views:NoteAttachmentsView />
      </Border>
    </controls:ModalOverlayHost>
  </Grid>
</UserControl>
