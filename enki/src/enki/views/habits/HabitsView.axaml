<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:baseconv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="760"
             x:Class="enki.Views.HabitsView"
             x:DataType="vm:HabitsViewModel">

  <UserControl.Resources>
    <!-- Una celda de la cuadrícula de constancia (propuesta 13): monocroma, sin rachas ni colores de
         intensidad — solo hecho / no hecho / no aplica ese día. -->
    <DataTemplate x:Key="ConsistencyDayTemplate" DataType="vm:ConsistencyDayViewModel">
      <Border Width="9" Height="9" Margin="1.5"
              Classes="consistency-cell"
              Classes.done="{Binding IsDone}"
              Classes.not-applicable="{Binding !IsApplicable}"
              ToolTip.Tip="{Binding Date}" />
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Celda de la cuadrícula de constancia — monocroma, sin colores de intensidad: hecho = relleno
         Ink, no hecho (pero aplicable) = solo borde, no aplica = apagada y sin borde. -->
    <Style Selector="Border.consistency-cell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ink10}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.consistency-cell.done">
      <Setter Property="Background" Value="{DynamicResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="Border.consistency-cell.not-applicable">
      <Setter Property="Background" Value="{DynamicResource Ink05}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Grid RowDefinitions="Auto,*" Margin="36,30,36,26" MaxWidth="1000" HorizontalAlignment="Stretch">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,22">
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock Text="{loc:Tr Habits_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
          <TextBlock Text="{loc:Tr Habits_Title, Converter={StaticResource UpperCaseConverter}}" Classes="page-title" />
          <TextBlock Text="{loc:Tr Habits_Subtitle}" Classes="page-subtitle" />
        </StackPanel>

        <Button Grid.Column="1" Classes="pill-primary" Command="{Binding NewHabitCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Plus" Width="14" Height="14" />
            <TextBlock Text="{loc:Tr Habits_NewButton, Converter={StaticResource UpperCaseConverter}}" />
          </StackPanel>
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="10">

          <StackPanel IsVisible="{Binding IsEmpty}" Spacing="14" Margin="0,60,0,0" HorizontalAlignment="Center">
            <mi:MaterialIcon Kind="CheckboxMarkedCircleOutline" Width="28" Height="28" Foreground="{DynamicResource TextMutedBrush}"
                              HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Tr Habits_EmptyState}" Classes="muted" FontSize="12.5" HorizontalAlignment="Center" />
            <Button Classes="pill-primary" Command="{Binding NewHabitCommand}" HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="Plus" Width="13" Height="13" />
                <TextBlock Text="{loc:Tr Habits_EmptyState_CreateButton, Converter={StaticResource UpperCaseConverter}}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Habits}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:HabitItemViewModel">
                <Border Classes="card" Padding="18">
                  <StackPanel Spacing="14">

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                      <Button Grid.Column="0" Classes="icon-btn" Classes.active="{Binding IsDoneToday}"
                              Command="{Binding $parent[ItemsControl].((vm:HabitsViewModel)DataContext).ToggleTodayCommand}"
                              CommandParameter="{Binding}" Width="30" Height="30" Margin="0,0,14,0"
                              ToolTip.Tip="{loc:Tr Habits_ToggleTodayTooltip}"
                              AutomationProperties.Name="{Binding Name}">
                        <mi:MaterialIcon Kind="{Binding ToggleIconKind}" Width="16" Height="16" />
                      </Button>

                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14.5"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                      </StackPanel>

                      <Border Grid.Column="2" Classes="graph-chip" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FrequencyLabel, Converter={StaticResource UpperCaseConverter}}" Classes="faint" FontSize="10.5" />
                      </Border>

                      <Button Grid.Column="3" Classes="icon-btn" Margin="0,0,4,0"
                              Command="{Binding $parent[ItemsControl].((vm:HabitsViewModel)DataContext).EditHabitCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Common_Edit}"
                              AutomationProperties.Name="{loc:Tr Common_Edit}">
                        <mi:MaterialIcon Kind="PencilOutline" Width="14" Height="14" />
                      </Button>
                      <Button Grid.Column="4" Classes="icon-btn icon-btn-danger"
                              Command="{Binding $parent[ItemsControl].((vm:HabitsViewModel)DataContext).RequestArchiveHabitCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Habits_ArchiveTooltip}"
                              AutomationProperties.Name="{loc:Tr Habits_ArchiveTooltip}">
                        <mi:MaterialIcon Kind="ArchiveOutline" Width="14" Height="14" />
                      </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ConsistencyDays}" ItemTemplate="{StaticResource ConsistencyDayTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <!-- 10 semanas x 7 días: Height fija a 10 filas de celdas de 9px + 3px de margen
                               cada una, para que el WrapPanel vertical parta en columnas de exactamente
                               una semana en vez de calcular el alto a partir del contenido. -->
                          <WrapPanel Orientation="Vertical" Height="122" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>

                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ===================== Formulario emergente: nuevo/editar hábito ===================== -->
    <Border Classes="modal-overlay"
            IsVisible="{Binding Editor, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
              MaxWidth="440" DataContext="{Binding Editor}" x:DataType="vm:HabitEditorViewModel">
        <StackPanel Spacing="18" MinWidth="380">

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Habits_Editor_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
            <TextBlock Text="{loc:Tr Habits_Editor_Title}" FontSize="19" FontWeight="Bold" LetterSpacing="-0.3" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Habits_Editor_NameFieldLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
            <TextBox Classes="search" Text="{Binding Name}" MaxLength="80"
                     PlaceholderText="{loc:Tr Habits_Editor_NamePlaceholder}"
                     AutomationProperties.Name="{loc:Tr Habits_Editor_NameFieldLabel}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Habits_Editor_FrequencyFieldLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
            <WrapPanel Orientation="Horizontal">
              <RadioButton Classes="segment" GroupName="HabitFrequency" Content="{loc:Tr Habits_Frequency_Daily, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,6,6"
                           IsChecked="{Binding Frequency, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Daily, Mode=OneWay}"
                           Command="{Binding SelectFrequencyCommand}" CommandParameter="Daily" />
              <RadioButton Classes="segment" GroupName="HabitFrequency" Content="{loc:Tr Habits_Frequency_Weekly, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,6,6"
                           IsChecked="{Binding Frequency, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Weekly, Mode=OneWay}"
                           Command="{Binding SelectFrequencyCommand}" CommandParameter="Weekly" />
              <RadioButton Classes="segment" GroupName="HabitFrequency" Content="{loc:Tr Habits_Frequency_SpecificDays, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,6,6"
                           IsChecked="{Binding Frequency, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=SpecificDays, Mode=OneWay}"
                           Command="{Binding SelectFrequencyCommand}" CommandParameter="SpecificDays" />
            </WrapPanel>
          </StackPanel>

          <StackPanel Spacing="6" IsVisible="{Binding ShowDayOptions}">
            <TextBlock Text="{loc:Tr Habits_Editor_DaysFieldLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
            <ItemsControl ItemsSource="{Binding DayOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:HabitDayOptionViewModel">
                  <RadioButton Classes="segment" GroupName="{Binding GroupKey}" Margin="0,0,4,0"
                               IsChecked="{Binding IsSelected, Mode=OneWay}"
                               Command="{Binding $parent[ItemsControl].((vm:HabitEditorViewModel)DataContext).ToggleDayCommand}"
                               CommandParameter="{Binding}"
                               AutomationProperties.Name="{Binding Label}">
                    <TextBlock Text="{Binding Label}" FontSize="10" />
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" Classes="ghost modal-cancel"
                    Command="{Binding $parent[UserControl].((vm:HabitsViewModel)DataContext).CancelEditorCommand}"
                    Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary"
                    Command="{Binding $parent[UserControl].((vm:HabitsViewModel)DataContext).SaveEditorCommand}"
                    IsEnabled="{Binding CanSave}">
              <TextBlock Text="{loc:Tr Common_Save, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>

        </StackPanel>
      </Border>    </Border>

    <!-- ===================== Diálogo: archivar hábito ===================== -->
    <Border Classes="modal-overlay"
            IsVisible="{Binding HabitPendingArchive, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{loc:Tr Habits_ArchiveModal_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{loc:Tr Habits_ArchiveModal_Message}" FontSize="14" TextWrapping="Wrap" MaxWidth="320" />

          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Command="{Binding CancelArchiveHabitCommand}" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary-danger" Command="{Binding ConfirmArchiveHabitCommand}">
              <TextBlock Text="{loc:Tr Habits_ArchiveTooltip, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>    </Border>

  </Grid>
</UserControl>
