<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="clr-namespace:enki.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:models="clr-namespace:enki.Models"
             xmlns:views="clr-namespace:enki.Views"
             xmlns:baseconv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             x:Class="enki.Views.KanbanView"
             x:DataType="vm:KanbanViewModel"
             Focusable="True" Loaded="KanbanView_Loaded" KeyDown="KanbanView_KeyDown">

  <UserControl.Styles>
    <Style Selector="Button.board-title-selector">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ink20}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,0,0,4" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.board-title-selector:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="Button.kanban-card TextBlock.faint, Border.kanban-count TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ListBox#BoardList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox#BoardList ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox#BoardList ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#BoardList ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#BoardList ListBoxItem:focus-visible Border.board-choice">
      <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="Border.board-choice">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="Border.board-choice:pointerover">
      <Setter Property="Background" Value="{DynamicResource Ink05}" />
    </Style>
    <Style Selector="Button.board-title-selector.open, Button.board-title-selector:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="Border.board-choice.selected">
      <Setter Property="Background" Value="{DynamicResource Ink10}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>

    <!-- ===================== Tarjeta =====================
         Ancho fijado por la columna que la contiene (Stretch), alto automático según su contenido. El
         orden de lectura va de lo excepcional a lo accesorio: prioridad y acciones arriba, título y
         descripción en el centro, y una sola línea de metadatos abajo — antes esa información iba en
         tres bloques apilados y una fila propia solo para los dos botones de acción, que ahora viven en
         el hueco libre de la primera fila.

         Editar y eliminar solo se dibujan al pasar el ratón o al enfocar la tarjeta (Styles.axaml,
         "Acciones que aparecen al pasar el ratón"). Para quien no use el ratón, el diálogo de detalle
         —al que se llega con un clic o con Enter sobre la tarjeta— ofrece las mismas dos acciones de
         forma permanente, así que ninguna función depende del hover. -->
    <DataTemplate DataType="vm:KanbanCardViewModel">
      <Button Classes="kanban-card" Classes.drag-over="{Binding IsDropTarget}"
              HorizontalAlignment="Stretch" Margin="0,0,0,10"
              IsVisible="{Binding IsVisible}"
              Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).OpenCardDetailCommand}"
              CommandParameter="{Binding}"
              AutomationProperties.Name="{Binding Title}">
        <!-- Menú contextual de la tarjeta: las mismas acciones que los botones que solo aparecen al pasar
             el ratón, más "archivar", que solo existe en la columna "Hecho" (KanbanCardViewModel.CanArchive).
             Archivar saca la tarjeta del tablero sin borrarla; se sigue viendo en el Calendario y se
             recupera desde la ventana de archivadas (docs/agent-docs/kanban-tareas-archivadas.md). -->
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{loc:Tr Kanban_Multi_Move, Converter={StaticResource UpperCaseConverter}}"
                      IsVisible="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).MultipleBoardsEnabled}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).OpenMoveCardCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="{loc:Tr Common_Edit, Converter={StaticResource UpperCaseConverter}}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).OpenEditCardCommand}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{loc:Tr Kanban_Card_ArchiveMenu, Converter={StaticResource UpperCaseConverter}}"
                      IsVisible="{Binding CanArchive}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).ArchiveCardCommand}"
                      CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="{loc:Tr Common_Delete, Converter={StaticResource UpperCaseConverter}}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).RequestDeleteCardCommand}"
                      CommandParameter="{Binding}" />
          </ContextMenu>
        </Button.ContextMenu>

        <StackPanel Spacing="9">

          <!-- Prioridad (clic para rotar Baja → Media → Alta) + acciones de la tarjeta.
               La etiqueta muestra siempre la prioridad actual junto al indicador. -->
          <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="24">
            <Button Grid.Column="0" Classes="ghost" Padding="2,0" VerticalAlignment="Center"
                    Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).CyclePriorityCommand}"
                    CommandParameter="{Binding}"
                    ToolTip.Tip="{Binding PriorityTooltip}" AutomationProperties.Name="{Binding PriorityTooltip}">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Ellipse Classes="priority-dot"
                         Classes.low="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Low}"
                         Classes.medium="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Medium}"
                         Classes.high="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=High}" />
                <TextBlock Text="{Binding PriorityLabel, Converter={StaticResource UpperCaseConverter}}" Classes="faint"
                           LetterSpacing="1" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <StackPanel Grid.Column="2" Classes="card-actions" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <Button Classes="icon-btn" Width="24" Height="24"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).OpenEditCardCommand}"
                      CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Card_EditTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Card_EditTooltip}">
                <mi:MaterialIcon Kind="PencilOutline" Width="12" Height="12" />
              </Button>
              <Button Classes="icon-btn icon-btn-danger" Width="24" Height="24"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).RequestDeleteCardCommand}"
                      CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Card_DeleteTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Card_DeleteTooltip}">
                <mi:MaterialIcon Kind="TrashCanOutline" Width="12" Height="12" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- Título y descripción -->
          <StackPanel Spacing="5">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" LetterSpacing="0.1"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3" />
            <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12.5"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                       IsVisible="{Binding HasDescription}" />
          </StackPanel>

          <!-- Progreso de subtareas: pista a todo el ancho disponible (el padding de la tarjeta ya deja
               el aire a los lados), relleno proporcional vía dos columnas en estrella hecho/restante. -->
          <Border Height="3" Background="{DynamicResource Ink10}" IsVisible="{Binding HasSubtasks}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SubtaskProgressDoneStar}" />
                <ColumnDefinition Width="{Binding SubtaskProgressRemainingStar}" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{DynamicResource InkBrush}" />
            </Grid>
          </Border>

          <!-- Metadatos compactos; las etiquetas usan el ancho completo en su propia fila
               para poder desplegarse sin estrechar la fecha ni el progreso de las subtareas. -->
          <Grid ColumnDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding HasStatusMetadata}">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"
                        VerticalAlignment="Center" IsVisible="{Binding HasSubtasks}">
              <mi:MaterialIcon Kind="FormatListCheckbox" Width="11" Height="11" Margin="0,1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Ink40}" />
              <TextBlock Text="{Binding SubtaskProgressLabel}" Classes="faint" LetterSpacing="1" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"
                        VerticalAlignment="Center" IsVisible="{Binding HasDueDate}">
              <mi:MaterialIcon Kind="CalendarOutline" Width="11" Height="11" Margin="0,1,0,0" VerticalAlignment="Center"
                                Classes.overdue="{Binding IsOverdue}" Foreground="{DynamicResource Ink40}" />
              <TextBlock Text="{Binding DueDateLabel}" Classes="faint" VerticalAlignment="Center" Classes.overdue="{Binding IsOverdue}" />
            </StackPanel>

            <mi:MaterialIcon Grid.Column="2" Kind="{Binding LinkedNoteIcon}" Width="11" Height="11" Margin="0,1,12,0"
                              VerticalAlignment="Center" Foreground="{DynamicResource Ink40}"
                              IsVisible="{Binding HasLinkedNote}"
                              ToolTip.Tip="{Binding LinkedNoteLabel}" AutomationProperties.Name="{Binding LinkedNoteLabel}" />

          </Grid>
          <controls:KanbanTags Tags="{Binding Tags}" IsVisible="{Binding HasTags}" />

        </StackPanel>
      </Button>
    </DataTemplate>

    <!-- ===================== Columna (franja vertical) =====================
         Tres bandas fijas: cabecera, cuerpo desplazable y pie. El pie ("añadir tarjeta") vive fuera del
         scroll, así que sigue a un clic de distancia por larga que sea la columna — antes era la última
         loseta de la pila y con veinte tarjetas encima había que bajar hasta el fondo para encontrarla.
         Cabecera y pie se separan del cuerpo con una línea de 1px, no con aire (§3.2: los bordes son el
         sistema de separación). -->
    <DataTemplate DataType="vm:KanbanColumnViewModel">
      <Border Classes="kanban-column" Classes.drag-over="{Binding IsDropTarget}"
              Width="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).BoardColumnWidth}"
              Margin="8,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid RowDefinitions="Auto,*,Auto">

          <!-- Cabecera: nombre, contador y acciones al pasar el ratón. El candado de las columnas del
               flujo base ya no ocupa sitio de forma permanente en tres de cada cuatro cabeceras: aparece
               con el resto de acciones, justo donde el usuario va a buscar la papelera que no está. -->
          <Border Grid.Row="0" Classes="kanban-column-header">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <!-- El nombre se pinta siempre en mayúsculas, escriba el usuario lo que escriba: la columna
                   es estructura del tablero, no contenido, y en este sistema de diseño la estructura va
                   en mayúsculas con el tracking abierto. Solo cambia cómo se dibuja — el título se guarda
                   tal cual se tecleó, y es eso lo que aparece en el campo de renombrar de al lado. -->
              <TextBlock Grid.Column="0" Text="{Binding Title, Converter={StaticResource UpperCaseConverter}}"
                         FontWeight="Bold" FontSize="12.5" LetterSpacing="1.2" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsRenaming}" />
              <TextBox Grid.Column="0" Text="{Binding EditingTitle}" Classes="title-edit" FontSize="12.5" FontWeight="Bold"
                        IsVisible="{Binding IsRenaming}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        KeyDown="ColumnTitleEdit_KeyDown" LostFocus="ColumnTitleEdit_LostFocus"
                        Initialized="ColumnTitleEdit_Initialized" PropertyChanged="ColumnTitleEdit_PropertyChanged" />

              <!-- "5" cuando no hay filtros, "2/5" cuando sí: una columna que se ve vacía por el filtro
                   no debe parecer vacía de verdad (KanbanColumnViewModel.CountLabel). -->
              <Border Grid.Column="1" Classes="kanban-count" Margin="10,0,0,0" VerticalAlignment="Center"
                      IsVisible="{Binding !IsRenaming}">
                <TextBlock Text="{Binding CountLabel}" Classes="faint" FontSize="10.5" HorizontalAlignment="Center" />
              </Border>

              <StackPanel Grid.Column="2" Classes="column-actions" Orientation="Horizontal" Spacing="2"
                          Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding !IsRenaming}">
                <!-- Archivar de golpe todo lo que hay en "Hecho": solo aparece en esa columna y solo
                     mientras tenga tarjetas (KanbanColumnViewModel.CanArchiveAllCards). Pasa por
                     confirmación, como el resto de acciones que tocan muchas tarjetas a la vez. -->
                <Button Classes="icon-btn" Width="24" Height="24"
                        IsVisible="{Binding CanArchiveAllCards}"
                        Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).RequestArchiveAllDoneCommand}"
                        ToolTip.Tip="{loc:Tr Kanban_Column_ArchiveAllTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Column_ArchiveAllTooltip}">
                  <mi:MaterialIcon Kind="ArchiveArrowDownOutline" Width="13" Height="13" />
                </Button>
                <Button Classes="icon-btn" Width="24" Height="24"
                        Command="{Binding BeginRenameCommand}" ToolTip.Tip="{loc:Tr Kanban_Column_RenameTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Column_RenameTooltip}">
                  <mi:MaterialIcon Kind="PencilOutline" Width="13" Height="13" />
                </Button>
                <!-- Separación deliberada respecto al lápiz de renombrar (Fase 3 de
                     docs/agent-docs/analisis-proyecto/roadmap.md): antes quedaban a 2px y un clic torpe
                     borraba la columna entera — ahora hay confirmación además, pero el gesto equivocado
                     se evita primero por distancia. -->
                <Button Classes="icon-btn icon-btn-danger" Width="24" Height="24" Margin="10,0,0,0"
                        IsVisible="{Binding !IsCore}"
                        Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).RequestDeleteColumnCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Column_DeleteTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Column_DeleteTooltip}">
                  <mi:MaterialIcon Kind="TrashCanOutline" Width="13" Height="13" />
                </Button>
                <!-- Columna del flujo base: no se puede eliminar, solo renombrar. -->
                <mi:MaterialIcon Kind="LockOutline" Width="13" Height="13" Margin="10,0,5,0"
                                  VerticalAlignment="Center" Foreground="{DynamicResource Ink30}"
                                  IsVisible="{Binding IsCore}" ToolTip.Tip="{loc:Tr Kanban_Column_CoreLockedTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Column_CoreLockedTooltip}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Cuerpo: pila vertical de tarjetas con su propia scrollbar, así una columna larga no empuja
               el alto de las demás. -->
          <!-- El aire interior va en el Margin del contenido, no en el Padding del ScrollViewer: el
               Padding desplaza lo que se pinta pero no reduce el ancho con el que se mide, así que una
               tarjeta con etiquetas largas se medía contra la columna entera y se salía 14px por la
               derecha. Con Margin, la medida ya llega recortada y el texto se recorta con elipsis donde
               toca. -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,14,14,4">
              <!-- El hueco entre tarjetas es Margin de la propia tarjeta, no Spacing del panel: una
                   tarjeta escondida por el filtro sale del layout, pero el Spacing que la rodeaba no —
                   y el hueco fantasma resultante desalineaba unas columnas respecto a otras según
                   cuántas tarjetas ocultas tuviera cada una. -->
              <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <!-- Los dos huecos posibles son distintos y se nombran distinto: la columna no tiene nada,
                   o sí tiene pero el filtro activo lo esconde todo. A ojo se veían idénticos. -->
              <TextBlock Classes="column-hint" Margin="0,22,0,12" IsVisible="{Binding IsEmpty}"
                         Text="{loc:Tr Kanban_Column_EmptyLabel, Converter={StaticResource UpperCaseConverter}}" />
              <TextBlock Classes="column-hint" Margin="0,22,0,12" IsVisible="{Binding HasNoMatches}"
                         Text="{loc:Tr Kanban_Column_NoMatchesLabel, Converter={StaticResource UpperCaseConverter}}" />
            </StackPanel>
          </ScrollViewer>

          <!-- Pie fijo: añadir tarjeta a esta columna, abriendo el formulario emergente completo (§7.10) -->
          <Border Grid.Row="2" Classes="kanban-column-footer">
            <Button Classes="kanban-add-card"
                    Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).OpenCreateCardCommand}"
                    CommandParameter="{Binding}"
                    ToolTip.Tip="{loc:Tr Kanban_Column_AddCardTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Column_AddCardTooltip}">
              <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="Plus" Width="13" Height="13" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Tr Kanban_Column_AddCard, Converter={StaticResource UpperCaseConverter}}"
                           FontSize="10.5" FontWeight="Bold" LetterSpacing="1" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- ===================== Celda del calendario de fecha límite (§7.10) ===================== -->
    <DataTemplate DataType="vm:KanbanCalendarDayViewModel">
      <Button Classes="calendar-day" Classes.outside="{Binding !IsCurrentMonth}"
              Classes.today="{Binding IsToday}" Classes.selected="{Binding IsSelected}"
              Command="{Binding $parent[ItemsControl].((vm:KanbanCardEditorViewModel)DataContext).SelectCalendarDayCommand}"
              CommandParameter="{Binding}">
        <TextBlock Text="{Binding DayLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Button>
    </DataTemplate>

    <!-- ===================== Fila de subtarea (dentro del formulario de tarjeta) ===================== -->
    <DataTemplate DataType="vm:KanbanSubtaskItemViewModel">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
        <Button Grid.Column="0" Classes="icon-btn" Width="26" Height="26"
                Command="{Binding ToggleCommand}" ToolTip.Tip="{loc:Tr Kanban_Subtask_ToggleTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Subtask_ToggleTooltip}">
          <mi:MaterialIcon Kind="{Binding CheckIcon}" Width="15" Height="15" />
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                   Classes="subtask-title" Classes.done="{Binding IsDone}"
                   TextWrapping="Wrap" FontSize="12.5" Margin="6,0" />
        <Button Grid.Column="2" Classes="icon-btn icon-btn-danger" Width="22" Height="22"
                Command="{Binding $parent[ItemsControl].((vm:KanbanCardEditorViewModel)DataContext).RemoveSubtaskCommand}"
                CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Subtask_RemoveTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Subtask_RemoveTooltip}">
          <mi:MaterialIcon Kind="Close" Width="12" Height="12" />
        </Button>
      </Grid>
    </DataTemplate>

    <!-- ===================== Lista (sidebar de "Gestión de tareas") ===================== -->
    <DataTemplate DataType="vm:PolarTaskListItemViewModel">
      <Button Classes="nav-item" Classes.active="{Binding IsSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              Command="{Binding $parent[ItemsControl].((vm:PolarTaskManagementViewModel)DataContext).SelectListCommand}"
              CommandParameter="{Binding}">
        <!-- Columnas fijas para check/contador/editar: así solo el nombre (columna *) varía de
             ancho entre filas y el resto queda alineado sea cual sea su contenido (check visible o
             no, contador de 1 o 2 dígitos). -->
        <Grid ColumnDefinitions="Auto,*,20,48,Auto">
          <mi:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="14" Height="14" Margin="0,0,10,0"
                            Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <mi:MaterialIcon Grid.Column="2" Kind="CheckCircleOutline" Width="13" Height="13"
                            Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsVisible="{Binding IsFullyDone}" ToolTip.Tip="{loc:Tr Kanban_TaskList_AllDoneTooltip}" AutomationProperties.Name="{loc:Tr Kanban_TaskList_AllDoneTooltip}" />
          <Border Grid.Column="3" Background="{DynamicResource Ink10}" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding BadgeLabel}" Classes="faint" FontSize="10" />
     </Border>
          <Button Grid.Column="4" Classes="icon-btn" Width="22" Height="22"
                  Command="{Binding $parent[ItemsControl].((vm:PolarTaskManagementViewModel)DataContext).OpenEditListCommand}"
                  CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_TaskList_EditTooltip}" AutomationProperties.Name="{loc:Tr Kanban_TaskList_EditTooltip}">
            <mi:MaterialIcon Kind="PencilOutline" Width="12" Height="12" />
          </Button>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- ===================== Fila de tarea (panel derecho de "Gestión de tareas") =====================
         Button.note-card (no Border) so the whole row is clickable — abre el diálogo de detalle — while
         the nested checkbox/editar/eliminar buttons still handle their own clicks first, same pattern
         already used by Button.kanban-card on the board side. -->
    <DataTemplate DataType="vm:PolarTaskRowViewModel">
      <Button Classes="note-card" Padding="14" Margin="0,0,0,8"
              IsVisible="{Binding IsVisible}"
              Command="{Binding $parent[ItemsControl].((vm:PolarTaskManagementViewModel)DataContext).OpenTaskDetailCommand}"
              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Task_ViewDetailTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Task_ViewDetailTooltip}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Classes="icon-btn" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Top"
                  IsEnabled="{Binding !IsBlocked}"
                  Command="{Binding $parent[ItemsControl].((vm:PolarTaskManagementViewModel)DataContext).ToggleTaskCompletedCommand}"
                  CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Subtask_ToggleTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Subtask_ToggleTooltip}">
            <Panel>
              <mi:MaterialIcon Kind="CheckboxMarkedOutline" Width="16" Height="16" IsVisible="{Binding Completed}" />
              <mi:MaterialIcon Kind="CheckboxBlankOutline" Width="16" Height="16" IsVisible="{Binding !Completed}" />
            </Panel>
          </Button>

          <StackPanel Grid.Column="1" Spacing="6">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Ellipse Grid.Column="0" Classes="priority-dot" Margin="0,0,7,0" VerticalAlignment="Center"
                        IsVisible="{Binding HasPriority}"
                        Classes.low="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=1}"
                        Classes.medium="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=2}"
                        Classes.high="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=3}" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="subtask-title" Classes.done="{Binding Completed}"
                         FontWeight="Bold" FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Border Grid.Column="2" Background="{DynamicResource Ink10}" Padding="6,2" VerticalAlignment="Center"
                      IsVisible="{Binding IsBlocked}" ToolTip.Tip="{loc:Tr Kanban_Task_BlockedTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Task_BlockedTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <mi:MaterialIcon Kind="LockOutline" Width="10" Height="10" />
                  <TextBlock Text="{loc:Tr Kanban_Task_BlockedBadge, Converter={StaticResource UpperCaseConverter}}" Classes="faint" FontSize="9.5" />
                </StackPanel>
         </Border>
            </Grid>

            <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" MaxLines="2" IsVisible="{Binding HasDescription}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasDueDate}">
                <mi:MaterialIcon Kind="CalendarOutline" Width="11" Height="11" Classes.overdue="{Binding IsOverdue}" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{Binding DueDateLabel}" Classes="faint" Classes.overdue="{Binding IsOverdue}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasRecurrence}">
                <mi:MaterialIcon Kind="RepeatVariant" Width="11" Height="11" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{Binding RecurrenceLabel, Converter={StaticResource UpperCaseConverter}}" Classes="faint" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasSubtasks}">
                <mi:MaterialIcon Kind="FormatListCheckbox" Width="11" Height="11" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{Binding SubtaskProgressLabel}" Classes="faint" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasTimeEstimate}">
                <mi:MaterialIcon Kind="ClockOutline" Width="11" Height="11" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{Binding TimeEstimateLabel}" Classes="faint" />
              </StackPanel>
              <TextBlock Text="{Binding TagsLabel}" Classes="faint" IsVisible="{Binding HasTags}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
            <Button Classes="icon-btn" Width="24" Height="24"
                    Command="{Binding $parent[ItemsControl].((vm:PolarTaskManagementViewModel)DataContext).OpenEditTaskCommand}"
                    CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Task_EditTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Task_EditTooltip}">
              <mi:MaterialIcon Kind="PencilOutline" Width="12" Height="12" />
            </Button>
            <Button Classes="icon-btn icon-btn-danger" Width="24" Height="24"
                    Command="{Binding $parent[ItemsControl].((vm:PolarTaskManagementViewModel)DataContext).RequestDeleteTaskCommand}"
                    CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Task_DeleteTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Task_DeleteTooltip}">
              <mi:MaterialIcon Kind="TrashCanOutline" Width="12" Height="12" />
            </Button>
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- ===================== Sección de lista (feed de "Inicio" de Gestión de tareas) =====================
         Barra de acento a la izquierda con el color propio de la lista (mismo patrón que Button.dropdown-
         item.reminder-item en el buzón de notificaciones, aquí con color por dato en vez de por severidad
         fija). Los comandos saltan directo a $parent[UserControl]…TaskManagement en vez de $parent
         [ItemsControl] porque esta fila vive dos ItemsControl por debajo de PolarTaskManagementViewModel
         (Grupos → Tareas), así que el ItemsControl más cercano ya no tiene ese DataContext. -->
    <DataTemplate DataType="vm:PolarHomeGroupViewModel">
      <Border BorderBrush="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
              BorderThickness="3,0,0,0" Padding="16,0,0,0" Margin="0,0,0,28">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="{Binding IconKind}" Width="14" Height="14" Foreground="{DynamicResource Ink40}" />
            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" LetterSpacing="0.3" />
            <Border Background="{DynamicResource Ink10}" Padding="6,2">
              <TextBlock Text="{Binding Tasks.Count}" Classes="faint" FontSize="10" />
       </Border>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Tasks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:PolarTaskRowViewModel">
                <Button Classes="note-card" Padding="14" Margin="0,0,0,8"
                        IsVisible="{Binding IsVisible}"
                        Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).TaskManagement.OpenTaskDetailCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Task_ViewDetailTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Task_ViewDetailTooltip}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" Classes="icon-btn" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Top"
                            IsEnabled="{Binding !IsBlocked}"
                            Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).TaskManagement.ToggleTaskCompletedCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Subtask_ToggleTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Subtask_ToggleTooltip}">
                      <mi:MaterialIcon Kind="CheckboxBlankOutline" Width="16" Height="16" />
                    </Button>

                    <StackPanel Grid.Column="1" Spacing="6">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Ellipse Grid.Column="0" Classes="priority-dot" Margin="0,0,7,0" VerticalAlignment="Center"
                                  IsVisible="{Binding HasPriority}"
                                  Classes.low="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=1}"
                                  Classes.medium="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=2}"
                                  Classes.high="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=3}" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Background="{DynamicResource Ink10}" Padding="6,2" VerticalAlignment="Center"
                                IsVisible="{Binding IsBlocked}" ToolTip.Tip="{loc:Tr Kanban_Task_BlockedTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Task_BlockedTooltip}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <mi:MaterialIcon Kind="LockOutline" Width="10" Height="10" />
                            <TextBlock Text="{loc:Tr Kanban_Task_BlockedBadge, Converter={StaticResource UpperCaseConverter}}" Classes="faint" FontSize="9.5" />
                          </StackPanel>
                   </Border>
                      </Grid>

                      <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                                  TextTrimming="CharacterEllipsis" MaxLines="2" IsVisible="{Binding HasDescription}" />

                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasDueDate}">
                          <mi:MaterialIcon Kind="CalendarOutline" Width="11" Height="11" Classes.overdue="{Binding IsOverdue}" Foreground="{DynamicResource Ink40}" />
                          <TextBlock Text="{Binding DueDateLabel}" Classes="faint" Classes.overdue="{Binding IsOverdue}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasTimeEstimate}">
                          <mi:MaterialIcon Kind="ClockOutline" Width="11" Height="11" Foreground="{DynamicResource Ink40}" />
                          <TextBlock Text="{Binding TimeEstimateLabel}" Classes="faint" />
                        </StackPanel>
                        <TextBlock Text="{Binding TagsLabel}" Classes="faint" IsVisible="{Binding HasTags}" />
                      </StackPanel>

                      <!-- Subtareas ya desplegadas en línea (sin colapsar) para verlas de un vistazo,
                           igual que la lista de la casa en la pantalla de inicio de Polar. -->
                      <ItemsControl ItemsSource="{Binding SubtaskRows}" IsVisible="{Binding HasSubtasks}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:PolarSubtaskRowViewModel">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,2">
                              <Button Grid.Column="0" Classes="icon-btn" Width="22" Height="22"
                                      Command="{Binding ToggleCommand}" ToolTip.Tip="{loc:Tr Kanban_Subtask_ToggleTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Subtask_ToggleTooltip}">
                                <mi:MaterialIcon Kind="{Binding CheckIcon}" Width="13" Height="13" />
                              </Button>
                              <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                          Classes="subtask-title" Classes.done="{Binding IsDone}"
                                          TextWrapping="Wrap" FontSize="12" Margin="6,0" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                      <Button Classes="icon-btn" Width="24" Height="24"
                              Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).TaskManagement.OpenEditTaskCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Task_EditTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Task_EditTooltip}">
                        <mi:MaterialIcon Kind="PencilOutline" Width="12" Height="12" />
                      </Button>
                      <Button Classes="icon-btn icon-btn-danger" Width="24" Height="24"
                              Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).TaskManagement.RequestDeleteTaskCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Task_DeleteTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Task_DeleteTooltip}">
                        <mi:MaterialIcon Kind="TrashCanOutline" Width="12" Height="12" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
  </Border>
    </DataTemplate>

    <!-- ===================== Fila de subtarea (dentro del editor de tarea de Gestión de tareas) ===================== -->
    <DataTemplate DataType="vm:PolarSubtaskRowViewModel">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
        <Button Grid.Column="0" Classes="icon-btn" Width="26" Height="26"
                Command="{Binding ToggleCommand}" ToolTip.Tip="{loc:Tr Kanban_Subtask_ToggleTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Subtask_ToggleTooltip}">
          <mi:MaterialIcon Kind="{Binding CheckIcon}" Width="15" Height="15" />
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                   Classes="subtask-title" Classes.done="{Binding IsDone}"
                   TextWrapping="Wrap" FontSize="12.5" Margin="6,0" />
        <Button Grid.Column="2" Classes="icon-btn icon-btn-danger" Width="22" Height="22"
                Command="{Binding $parent[ItemsControl].((vm:PolarTaskEditorViewModel)DataContext).RemoveSubtaskCommand}"
                CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Subtask_RemoveTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Subtask_RemoveTooltip}">
          <mi:MaterialIcon Kind="Close" Width="12" Height="12" />
        </Button>
      </Grid>
    </DataTemplate>

  </UserControl.DataTemplates>

  <!-- ===================== Variantes "Horizontal" (Ajustes › Apariencia › Tablero Kanban) =====================
       Con clave explícita (no implícitas por DataType como las de arriba) porque conviven con las
       verticales para el mismo tipo — Board (más abajo) elige el juego correcto vía ItemTemplate según
       BoardOrientation, mientras que las plantillas implícitas de arriba siguen sirviendo al resto de
       la app (p.ej. la ventana de confirmación de borrado) sin que esta variante interfiera. Duplican a
       propósito el cuerpo de la tarjeta/columna vertical en vez de parametrizarlo con bindings dinámicos
       de Orientation/RowDefinitions — mismo criterio de "explícito antes que genérico" que ya usa el resto
       del archivo (p.ej. la fila de tarea de Gestión de tareas, repetida en vez de compartida). -->
  <UserControl.Resources>

    <!-- ===================== Fila de tarjeta archivada (ventana de archivadas) =====================
         Misma loseta que la tarjeta del tablero, pero tumbada: en la ventana de archivadas no hay columnas
         que llenar ni arrastre que soportar, así que la fila ocupa todo el ancho y reparte el sitio entre
         el título (que es lo que se busca) y la fecha en que se archivó (que es como se ordena por
         defecto). La prioridad se pinta pero no se rota con un clic: lo archivado se consulta, y para
         cambiarlo está "editar" en el menú contextual. -->
    <DataTemplate x:Key="KanbanArchivedCardTemplate" DataType="vm:KanbanCardViewModel">
      <Button Classes="kanban-card" HorizontalAlignment="Stretch" Margin="0,0,0,8"
              Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).OpenArchivedCardDetailCommand}"
              CommandParameter="{Binding}"
              AutomationProperties.Name="{Binding Title}">

        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{loc:Tr Kanban_Multi_Move, Converter={StaticResource UpperCaseConverter}}"
                      IsVisible="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).MultipleBoardsEnabled}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).OpenMoveCardCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="{loc:Tr Kanban_Archive_UnarchiveMenu, Converter={StaticResource UpperCaseConverter}}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).UnarchiveCardCommand}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{loc:Tr Common_Edit, Converter={StaticResource UpperCaseConverter}}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).EditArchivedCardCommand}"
                      CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="{loc:Tr Common_Delete, Converter={StaticResource UpperCaseConverter}}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).RequestDeleteArchivedCardCommand}"
                      CommandParameter="{Binding}" />
          </ContextMenu>
        </Button.ContextMenu>

        <Grid ColumnDefinitions="Auto,*,Auto" >
          <Ellipse Grid.Column="0" Classes="priority-dot" Margin="0,0,10,0" VerticalAlignment="Center"
                   Classes.low="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Low}"
                   Classes.medium="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Medium}"
                   Classes.high="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=High}"
                   ToolTip.Tip="{Binding PriorityLabel}" />

          <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" LetterSpacing="0.1"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />

            <!-- Mismos metadatos y etiquetas desplegables que en el tablero. -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding HasStatusMetadata}">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"
                          VerticalAlignment="Center" IsVisible="{Binding HasSubtasks}">
                <mi:MaterialIcon Kind="FormatListCheckbox" Width="11" Height="11" Margin="0,1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{Binding SubtaskProgressLabel}" Classes="faint" LetterSpacing="1" VerticalAlignment="Center" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"
                          VerticalAlignment="Center" IsVisible="{Binding HasDueDate}">
                <mi:MaterialIcon Kind="CalendarOutline" Width="11" Height="11" Margin="0,1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{Binding DueDateLabel}" Classes="faint" VerticalAlignment="Center" />
              </StackPanel>

              <mi:MaterialIcon Grid.Column="2" Kind="{Binding LinkedNoteIcon}" Width="11" Height="11" Margin="0,1,12,0"
                                VerticalAlignment="Center" Foreground="{DynamicResource Ink40}"
                                IsVisible="{Binding HasLinkedNote}"
                                ToolTip.Tip="{Binding LinkedNoteLabel}" AutomationProperties.Name="{Binding LinkedNoteLabel}" />

            </Grid>
            <controls:KanbanTags Tags="{Binding Tags}" IsVisible="{Binding HasTags}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" Margin="14,0,0,0" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="ArchiveOutline" Width="11" Height="11" Margin="0,1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Ink40}" />
            <TextBlock Text="{Binding ArchivedAtLabel}" Classes="faint" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- ===================== Tarjeta horizontal =====================
         Parte de una loseta de 216px y puede crecer al desplegar las etiquetas: el cuerpo va
         en una fila en estrella. Título y descripción conservan sus límites de líneas, mientras
         las etiquetas pueden desplegarse completas sin quedar fuera de la tarjeta.

         Duplica a propósito el cuerpo de la tarjeta vertical en vez de parametrizarlo con bindings
         dinámicos: mismo criterio de "explícito antes que genérico" que ya usa el resto del archivo. -->
    <DataTemplate x:Key="KanbanCardTemplateHorizontal" DataType="vm:KanbanCardViewModel">
      <Button Classes="kanban-card" Classes.drag-over="{Binding IsDropTarget}"
              Width="216" MinHeight="216" VerticalAlignment="Top" Margin="0,0,10,0"
              IsVisible="{Binding IsVisible}"
              Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).OpenCardDetailCommand}"
              CommandParameter="{Binding}"
              AutomationProperties.Name="{Binding Title}">
        <!-- Menú contextual de la tarjeta: las mismas acciones que los botones que solo aparecen al pasar
             el ratón, más "archivar", que solo existe en la columna "Hecho" (KanbanCardViewModel.CanArchive).
             Archivar saca la tarjeta del tablero sin borrarla; se sigue viendo en el Calendario y se
             recupera desde la ventana de archivadas (docs/agent-docs/kanban-tareas-archivadas.md). -->
        <Button.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{loc:Tr Kanban_Multi_Move, Converter={StaticResource UpperCaseConverter}}"
                      IsVisible="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).MultipleBoardsEnabled}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).OpenMoveCardCommand}" CommandParameter="{Binding}" />
            <MenuItem Header="{loc:Tr Common_Edit, Converter={StaticResource UpperCaseConverter}}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).OpenEditCardCommand}"
                      CommandParameter="{Binding}" />
            <MenuItem Header="{loc:Tr Kanban_Card_ArchiveMenu, Converter={StaticResource UpperCaseConverter}}"
                      IsVisible="{Binding CanArchive}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).ArchiveCardCommand}"
                      CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="{loc:Tr Common_Delete, Converter={StaticResource UpperCaseConverter}}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).RequestDeleteCardCommand}"
                      CommandParameter="{Binding}" />
          </ContextMenu>
        </Button.ContextMenu>

        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

              <!-- Prioridad (clic para rotar Baja → Media → Alta) + acciones de la tarjeta.
                   La etiqueta muestra siempre la prioridad actual junto al indicador. -->
              <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" MinHeight="24">
                <Button Grid.Column="0" Classes="ghost" Padding="2,0" VerticalAlignment="Center"
                        Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).CyclePriorityCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding PriorityTooltip}" AutomationProperties.Name="{Binding PriorityTooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Ellipse Classes="priority-dot"
                             Classes.low="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Low}"
                             Classes.medium="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Medium}"
                             Classes.high="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=High}" />
                    <TextBlock Text="{Binding PriorityLabel, Converter={StaticResource UpperCaseConverter}}" Classes="faint"
                               LetterSpacing="1" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Classes="card-actions" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <Button Classes="icon-btn" Width="24" Height="24"
                          Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).OpenEditCardCommand}"
                          CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Card_EditTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Card_EditTooltip}">
                    <mi:MaterialIcon Kind="PencilOutline" Width="12" Height="12" />
                  </Button>
                  <Button Classes="icon-btn icon-btn-danger" Width="24" Height="24"
                          Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).RequestDeleteCardCommand}"
                          CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Card_DeleteTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Card_DeleteTooltip}">
                    <mi:MaterialIcon Kind="TrashCanOutline" Width="12" Height="12" />
                  </Button>
                </StackPanel>
              </Grid>

          <!-- Título y descripción -->
          <StackPanel Grid.Row="1" Spacing="5" Margin="0,9,0,9" VerticalAlignment="Top">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" LetterSpacing="0.1"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
            <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12.5"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3"
                       IsVisible="{Binding HasDescription}" />
          </StackPanel>

              <!-- Progreso de subtareas: pista a todo el ancho disponible (el padding de la tarjeta ya deja
                   el aire a los lados), relleno proporcional vía dos columnas en estrella hecho/restante. -->
              <Border Grid.Row="2" Height="3" Margin="0,0,0,9" Background="{DynamicResource Ink10}" IsVisible="{Binding HasSubtasks}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding SubtaskProgressDoneStar}" />
                    <ColumnDefinition Width="{Binding SubtaskProgressRemainingStar}" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="{DynamicResource InkBrush}" />
                </Grid>
              </Border>

              <!-- Metadatos en una sola línea: subtareas, fecha límite, nota vinculada y etiquetas. Antes
                   eran tres bloques apilados, cada uno con su propio margen, para tres datos de una línea.
                   Columnas Auto para lo de ancho previsible y una en estrella para las etiquetas, que son lo
                   único de longitud imprevisible y por tanto lo único que se recorta. El icono de nota
                   vinculada es nuevo en la tarjeta: antes no había forma de saber que una tarjeta tenía nota
                   sin abrirla. Los iconos van 1px más abajo porque la fuente mono asienta sus glifos en la
                   mitad baja de la caja de línea. -->
              <!-- Las etiquetas ocupan una fila independiente y pueden desplegarse completas. -->
              <controls:KanbanTags Grid.Row="3" Tags="{Binding Tags}" IsVisible="{Binding HasTags}" />

              <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*" IsVisible="{Binding HasStatusMetadata}">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"
                            VerticalAlignment="Center" IsVisible="{Binding HasSubtasks}">
                  <mi:MaterialIcon Kind="FormatListCheckbox" Width="11" Height="11" Margin="0,1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{Binding SubtaskProgressLabel}" Classes="faint" LetterSpacing="1" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"
                            VerticalAlignment="Center" IsVisible="{Binding HasDueDate}">
                  <mi:MaterialIcon Kind="CalendarOutline" Width="11" Height="11" Margin="0,1,0,0" VerticalAlignment="Center"
                                    Classes.overdue="{Binding IsOverdue}" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{Binding DueDateLabel}" Classes="faint" VerticalAlignment="Center" Classes.overdue="{Binding IsOverdue}" />
                </StackPanel>

                <mi:MaterialIcon Grid.Column="2" Kind="{Binding LinkedNoteIcon}" Width="11" Height="11" Margin="0,1,0,0"
                                  VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource Ink40}"
                                  IsVisible="{Binding HasLinkedNote}"
                                  ToolTip.Tip="{Binding LinkedNoteLabel}" AutomationProperties.Name="{Binding LinkedNoteLabel}" />
              </Grid>

        </Grid>
      </Button>
    </DataTemplate>

    <!-- ===================== Columna horizontal (franja de ancho completo) =====================
         Apila el encabezado sobre una única franja de tarjetas cuadradas que se desplazan de lado a
         lado. "Añadir tarjeta" cierra la franja como una tira estrecha con el icono "+", no como una
         loseta cuadrada más: aquí no hay pie fijo donde ponerla (la franja es la fila entera) pero
         tampoco tiene por qué ocupar el sitio de una tarjeta real. -->
    <DataTemplate x:Key="KanbanColumnTemplateHorizontal" DataType="vm:KanbanColumnViewModel">
      <Border Classes="kanban-column" Classes.drag-over="{Binding IsDropTarget}">
        <Grid RowDefinitions="Auto,Auto">

          <!-- Encabezado de columna: mismo contenido y mismas reglas de revelado que en la vertical, pero
               con el nombre en una columna Auto y el hueco elástico al final. En la vertical el ancho fijo
               de 300px hace que dé igual, pero aquí la franja ocupa toda la pantalla y un `*` delante
               mandaba el contador y las acciones a mil píxeles del título al que acompañan. -->
          <Border Grid.Row="0" Classes="kanban-column-header">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*">
              <TextBlock Grid.Column="0" Text="{Binding Title, Converter={StaticResource UpperCaseConverter}}" MaxWidth="420"
                         FontWeight="Bold" FontSize="12.5" LetterSpacing="1.2" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsRenaming}" />
              <TextBox Grid.Column="0" Text="{Binding EditingTitle}" Classes="title-edit" FontSize="12.5" FontWeight="Bold"
                        IsVisible="{Binding IsRenaming}" VerticalAlignment="Center" MaxWidth="320" HorizontalAlignment="Left"
                        KeyDown="ColumnTitleEdit_KeyDown" LostFocus="ColumnTitleEdit_LostFocus"
                        Initialized="ColumnTitleEdit_Initialized" PropertyChanged="ColumnTitleEdit_PropertyChanged" />

              <Border Grid.Column="1" Classes="kanban-count" Margin="10,0,0,0" VerticalAlignment="Center"
                      IsVisible="{Binding !IsRenaming}">
                <TextBlock Text="{Binding CountLabel}" Classes="faint" FontSize="10.5" HorizontalAlignment="Center" />
              </Border>

              <StackPanel Grid.Column="2" Classes="column-actions" Orientation="Horizontal" Spacing="2"
                          Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding !IsRenaming}">
                <!-- Archivar de golpe todo lo que hay en "Hecho": solo aparece en esa columna y solo
                     mientras tenga tarjetas (KanbanColumnViewModel.CanArchiveAllCards). Pasa por
                     confirmación, como el resto de acciones que tocan muchas tarjetas a la vez. -->
                <Button Classes="icon-btn" Width="24" Height="24"
                        IsVisible="{Binding CanArchiveAllCards}"
                        Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).RequestArchiveAllDoneCommand}"
                        ToolTip.Tip="{loc:Tr Kanban_Column_ArchiveAllTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Column_ArchiveAllTooltip}">
                  <mi:MaterialIcon Kind="ArchiveArrowDownOutline" Width="13" Height="13" />
                </Button>
                <Button Classes="icon-btn" Width="24" Height="24"
                        Command="{Binding BeginRenameCommand}" ToolTip.Tip="{loc:Tr Kanban_Column_RenameTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Column_RenameTooltip}">
                  <mi:MaterialIcon Kind="PencilOutline" Width="13" Height="13" />
                </Button>
                <Button Classes="icon-btn icon-btn-danger" Width="24" Height="24" Margin="10,0,0,0"
                        IsVisible="{Binding !IsCore}"
                        Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).RequestDeleteColumnCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Kanban_Column_DeleteTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Column_DeleteTooltip}">
                  <mi:MaterialIcon Kind="TrashCanOutline" Width="13" Height="13" />
                </Button>
                <mi:MaterialIcon Kind="LockOutline" Width="13" Height="13" Margin="10,0,5,0"
                                  VerticalAlignment="Center" Foreground="{DynamicResource Ink30}"
                                  IsVisible="{Binding IsCore}" ToolTip.Tip="{loc:Tr Kanban_Column_CoreLockedTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Column_CoreLockedTooltip}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Tarjetas: franja horizontal con su propia scrollbar -->
          <!-- Mismo motivo que en la columna vertical: el aire va en el Margin del contenido. -->
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Margin="14">
              <!-- Mismo motivo que en la vertical: el hueco viaja con la tarjeta para que una tarjeta
                   filtrada no deje un vacío detrás. -->
              <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource KanbanCardTemplateHorizontal}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <TextBlock Classes="column-hint" VerticalAlignment="Center" Margin="6,0,12,0"
                         IsVisible="{Binding IsEmpty}"
                         Text="{loc:Tr Kanban_Column_EmptyLabel, Converter={StaticResource UpperCaseConverter}}" />
              <TextBlock Classes="column-hint" VerticalAlignment="Center" Margin="6,0,12,0"
                         IsVisible="{Binding HasNoMatches}"
                         Text="{loc:Tr Kanban_Column_NoMatchesLabel, Converter={StaticResource UpperCaseConverter}}" />

              <Button Classes="ghost-card" Width="56" Height="216" Padding="0"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).OpenCreateCardCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="{loc:Tr Kanban_Column_AddCardTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Column_AddCardTooltip}">
                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
              </Button>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </DataTemplate>

  </UserControl.Resources>

  <Grid>
    <!-- La instantánea conserva la tarjeta completa (incluidas las etiquetas desplegadas). La capa
         no participa en el hit testing ni en la medida de las columnas y comparte el zoom de la vista. -->
    <Canvas x:Name="CardDragLayer" ZIndex="100" IsHitTestVisible="False" IsVisible="False" ClipToBounds="True">
      <Border x:Name="CardDropIndicator" Background="{DynamicResource InkBrush}" IsVisible="False" />
      <Grid x:Name="CardDragPreview">
        <Image x:Name="CardDragImage" Stretch="Fill" />
        <Border Classes="dropdown-popover" Background="Transparent" BorderBrush="{DynamicResource Ink60}"
                Padding="0" MaxHeight="Infinity" />
      </Grid>
    </Canvas>

    <!-- IsVisible vive en este Border envolvente (no en el Grid interior) por el mismo motivo que en el
         panel de "Gestión de tareas" más abajo: cambiar el DataContext del Grid reapuntaría también
         IsVisible. Border.Padding + Grid.MaxWidth con HorizontalAlignment="Stretch" replica ese mismo
         patrón de centrado, así el tablero queda con el mismo margen a los lados en pantallas anchas
         en vez de estirarse pegado al borde. -->
    <Border Padding="36,30,36,26" HorizontalAlignment="Stretch"
            IsVisible="{Binding DisplayMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Board}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" MaxWidth="1180" HorizontalAlignment="Stretch">

      <!-- ===================== Encabezado =====================
           El subtítulo dejó de ser una frase de manual permanente: ahora es la línea de estado del
           tablero (KanbanViewModel.BoardSummaryLabel), y solo vuelve a ser instrucción cuando el tablero
           está vacío, que es justo cuando hace falta.

           La rejilla de cuatro tarjetas de estadísticas que vivía debajo ya no está. Gastaba ~110px de
           alto —el equivalente a media tarjeta de cada columna— en cuatro cifras que caben en esa misma
           línea de estado, y de las cuatro solo dos pedían alguna acción ("alta prioridad" y "vencidas"):
           esas dos son ahora filtros de un clic en la barra de herramientas, en vez de un número que el
           usuario tenía que traducir a mano a un repaso columna por columna. -->
      <Grid Grid.Row="0" Classes="board-header board-heading" RowDefinitions="Auto,Auto,Auto"
            ColumnDefinitions="*,Auto" ColumnSpacing="24" RowSpacing="8" Margin="0,0,0,24">
        <TextBlock Text="{loc:Tr Kanban_Board_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
        <TextBlock Grid.Row="1" Text="{Binding BoardName, Converter={StaticResource UpperCaseSpacedBulletConverter}}"
                   Classes="page-title" TextTrimming="CharacterEllipsis" IsVisible="{Binding !MultipleBoardsEnabled}" />
        <Button Grid.Row="1" x:Name="BoardSelectorButton" Classes="board-title-selector" Classes.open="{Binding IsBoardSelectorOpen}" MaxWidth="460"
                HorizontalAlignment="Left" IsVisible="{Binding MultipleBoardsEnabled}"
                Command="{Binding ToggleBoardSelectorCommand}" AutomationProperties.Name="{loc:Tr Kanban_Multi_Select}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding BoardName, Converter={StaticResource UpperCaseSpacedBulletConverter}}"
                       Classes="page-title" FontSize="30" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BoardName}" />
            <mi:MaterialIcon Grid.Column="1" Kind="ChevronDown" Width="20" Height="20" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding BoardSummaryLabel}" Classes="page-subtitle" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel Grid.Column="1" Classes="board-modes" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,14,0">
          <RadioButton Classes="segment" GroupName="KanbanDisplayModeBoardHeader" Content="{Binding BoardModeLabel, Converter={StaticResource UpperCaseConverter}}" Height="36"
                       IsChecked="{Binding DisplayMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Board, Mode=OneWay}"
                       Command="{Binding SetDisplayModeCommand}" CommandParameter="Board" />
          <RadioButton Classes="segment" GroupName="KanbanDisplayModeBoardHeader" Content="{loc:Tr Kanban_Board_TabTaskManagement, Converter={StaticResource UpperCaseConverter}}" Height="36"
                       IsChecked="{Binding DisplayMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=TaskManagement, Mode=OneWay}"
                       IsVisible="{Binding IsTaskManagementUnlocked}"
                       Command="{Binding SetDisplayModeCommand}" CommandParameter="TaskManagement"
                       ToolTip.Tip="{Binding TaskManagementLockedHint}" />
        </StackPanel>

        <!-- Exportar el tablero a PNG/PDF (T8). Mismo patrón de botón de icono con MenuFlyout que el de
             "más acciones" del visor de archivos, en vez de dos botones sueltos en la cabecera. -->
        <Button Grid.Column="2" Classes="icon-btn board-tool" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,8,0"
                IsVisible="{Binding DisplayMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Board}"
                ToolTip.Tip="{loc:Tr Export_MenuTooltip}" AutomationProperties.Name="{loc:Tr Export_MenuTooltip}">
          <mi:MaterialIcon Kind="TrayArrowDown" Width="16" Height="16" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{loc:Tr Export_ToPng, Converter={StaticResource UpperCaseConverter}}" Command="{Binding ExportBoardAsPngCommand}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="ImageOutline" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{loc:Tr Export_ToPdf, Converter={StaticResource UpperCaseConverter}}" Command="{Binding ExportBoardAsPdfCommand}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="FilePdfBox" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Button Grid.Column="3" Classes="pill board-tool" Height="36" Padding="16,0" Command="{Binding AddColumnCommand}" VerticalAlignment="Center"
                ToolTip.Tip="{loc:Tr Kanban_Board_AddColumnTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Board_AddColumnTooltip}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Plus" Width="15" Height="15" />
            <TextBlock Text="{loc:Tr Kanban_Board_AddColumnButton, Converter={StaticResource UpperCaseConverter}}" />
          </StackPanel>
        </Button>
        </StackPanel>
      </Grid>

        <Popup Grid.Row="1" IsOpen="{Binding IsBoardSelectorOpen, Mode=TwoWay}" PlacementTarget="{Binding #BoardSelectorButton}"
               Placement="BottomEdgeAlignedLeft" VerticalOffset="8" IsLightDismissEnabled="True">
          <Border Classes="dropdown-popover" Width="380" MaxWidth="{Binding $parent[UserControl].Bounds.Width}"
                  MaxHeight="520" Padding="16" KeyDown="BoardSelector_KeyDown">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{loc:Tr Kanban_Multi_Boards, Converter={StaticResource UpperCaseConverter}}"
                           Classes="eyebrow" LetterSpacing="2" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding BoardOptions.Count}" Classes="faint" />
              </Grid>
              <Grid Grid.Row="1">
                <TextBox Classes="search" MinHeight="40" Padding="34,0,12,0" VerticalContentAlignment="Center"
                         x:Name="BoardSearchBox" Text="{Binding BoardSearchText}" PlaceholderText="{loc:Tr Kanban_Multi_Search}"
                         AutomationProperties.Name="{loc:Tr Kanban_Multi_Search}" />
                <mi:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="12,0,0,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
              </Grid>
              <ListBox Grid.Row="2" x:Name="BoardList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="True" KeyDown="BoardList_KeyDown" SelectedItem="{Binding CurrentBoardOption, Mode=OneWay}" ItemsSource="{Binding BoardOptions}" MaxHeight="300" AutomationProperties.Name="{loc:Tr Kanban_Multi_Boards}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:KanbanBoardOption">
                    <Border Classes="board-choice" Classes.selected="{Binding IsSelected}" BorderThickness="2,0,0,0" Padding="0">
                      <Grid ColumnDefinitions="*,Auto">
                        <Button Classes="dropdown-item" Margin="0" Padding="12" MinHeight="60" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                          Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).SelectBoardCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Label}">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="6" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Board.Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Board.Name}" />
                              <TextBlock Text="{loc:Tr Kanban_Multi_Default, Converter={StaticResource UpperCaseConverter}}"
                                FontSize="10" LetterSpacing="1" FontFamily="{DynamicResource InterfaceLabelFontFamily}"
                                Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding IsDefault}" />
                            </StackPanel>
                            <mi:MaterialIcon Grid.Column="1" Kind="Check" Width="18" Height="18"
                              IsVisible="{Binding IsSelected}" VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                        <Button Grid.Column="1" Classes="icon-btn" Width="36" Height="36" Margin="4,0,6,0" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr Kanban_Multi_Manage}" AutomationProperties.Name="{loc:Tr Kanban_Multi_Manage}">
                          <mi:MaterialIcon Kind="DotsHorizontal" Width="14" Height="14" />
                          <Button.Flyout>
                            <MenuFlyout>
                              <MenuItem Header="{loc:Tr Kanban_Multi_Rename, Converter={StaticResource UpperCaseConverter}}" Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).RenameSelectedBoardCommand}" CommandParameter="{Binding}" />
                              <MenuItem Header="{loc:Tr Kanban_Multi_SetDefault, Converter={StaticResource UpperCaseConverter}}" Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).UseSelectedBoardAsDefaultCommand}" CommandParameter="{Binding}" IsEnabled="{Binding !IsDefault}" />
                              <MenuItem Header="{loc:Tr Kanban_Multi_Delete, Converter={StaticResource UpperCaseConverter}}" Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).DeleteSelectedBoardCommand}" CommandParameter="{Binding}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Grid.Row="2" Spacing="10" Margin="12,20" IsVisible="{Binding !HasBoardSearchResults}">
                <mi:MaterialIcon Kind="Magnify" Width="24" Height="24" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr Search_NoResults}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
              <Border Grid.Row="3" BorderBrush="{DynamicResource Ink10}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <Button Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="40" Command="{Binding CreateBoardCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                    <TextBlock Text="{loc:Tr Kanban_Multi_Create, Converter={StaticResource UpperCaseConverter}}" />
                  </StackPanel>
                </Button>
              </Border>
            </Grid>
          </Border>
        </Popup>
      <Button Grid.Row="1" Classes="ghost" HorizontalAlignment="Left" Margin="0,0,0,8"
              Content="{loc:Tr Kanban_Multi_OpenDestination, Converter={StaticResource UpperCaseConverter}}" Command="{Binding OpenMovedBoardCommand}"
              IsVisible="{Binding LastMovedBoardId, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}" />

      <!-- ===================== Barra de herramientas =====================
           Una sola fila para las tres cosas que se hacen sobre un tablero ya montado: buscar, acotar y
           ordenar. Los dos chips de filtro rápido solo existen si hay algo que filtrar, y "LIMPIAR" solo
           si hay algo que limpiar, así que en un tablero tranquilo la fila se queda en el buscador y el
           orden. Antes esta misma fila llevaba fijos el rótulo "Sin etiquetas" y cuatro segmentos de
           ordenación de los que solo uno importa en cada momento.

           La fila se lee en dos bloques: a la izquierda lo que filtra el tablero (buscador, filtros
           rápidos y limpiar) y a la derecha archivadas y ordenación. La columna flexible reserva
           el espacio de filtros; estos pueden pasar a otra línea en ventanas estrechas, mientras
           las acciones conservan su alineación con el borde derecho del tablero. -->
      <Grid Grid.Row="2" Classes="board-toolbar" Margin="0,0,0,6" ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <WrapPanel x:Name="BoardFilters">

        <!-- Buscador con la lupa y el aspa de limpiar dentro del propio campo: sin aspa había que
             seleccionar el texto y borrarlo a mano para volver a ver el tablero entero. -->
        <Grid Width="260" MaxWidth="{Binding #BoardFilters.Bounds.Width}" Margin="0,0,12,8">
          <TextBox Classes="search" Name="KanbanSearchBox" Height="34" Padding="34,0,32,0"
                   VerticalContentAlignment="Center"
                   Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="{loc:Tr Kanban_Search_Placeholder}"
                   ToolTip.Tip="{loc:Tr Kanban_Search_Tooltip}" AutomationProperties.Name="{loc:Tr Kanban_Search_Tooltip}" />
          <mi:MaterialIcon Classes="search-adornment" Kind="Magnify" />
          <Button Classes="icon-btn" Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,5,0"
                  IsVisible="{Binding SearchText, Converter={x:Static baseconv:StringConverters.IsNotNullOrEmpty}}"
                  Command="{Binding ClearSearchCommand}"
                  ToolTip.Tip="{loc:Tr Kanban_Search_ClearTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Search_ClearTooltip}">
            <mi:MaterialIcon Kind="Close" Width="12" Height="12" />
          </Button>
        </Grid>

        <!-- Filtros rápidos: los dos recuentos que pedían acción, convertidos en un filtro de un clic
             que se apaga volviendo a pulsarlo. Mismo chip que el filtro de etiquetas de abajo, para que
             toda la zona de filtrado se lea como una sola familia. -->
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,12,8" VerticalAlignment="Center">
          <!-- Icono + contador, sin rótulo: el nombre de cada filtro ya viaja en su tooltip y en el
               AutomationProperties.Name, así que el chip se queda en lo que de verdad aporta de un
               vistazo — cuántas hay— en vez de repetir dos palabras que el usuario ya conoce. -->
          <ToggleButton Classes="tag-chip toolbar-chip"
                        IsChecked="{Binding IsHighPriorityFilterActive, Mode=OneWay}"
                        Command="{Binding ToggleQuickFilterCommand}"
                        CommandParameter="{x:Static vm:KanbanQuickFilter.HighPriority}"
                        ToolTip.Tip="{loc:Tr Kanban_Filter_HighPriorityTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Filter_HighPriorityTooltip}">
            <ToggleButton.IsVisible>
              <MultiBinding Converter="{x:Static baseconv:BoolConverters.And}">
                <Binding Path="HasHighPriorityCards" />
                <Binding Path="ShowHighPriorityButton" />
              </MultiBinding>
            </ToggleButton.IsVisible>
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <mi:MaterialIcon Kind="FlagVariantOutline" Width="12" Height="12" VerticalAlignment="Center" />
              <TextBlock Text="{Binding HighPriorityCount}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>

          <ToggleButton Classes="tag-chip toolbar-chip"
                        IsChecked="{Binding IsOverdueFilterActive, Mode=OneWay}"
                        Command="{Binding ToggleQuickFilterCommand}"
                        CommandParameter="{x:Static vm:KanbanQuickFilter.Overdue}"
                        ToolTip.Tip="{loc:Tr Kanban_Filter_OverdueTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Filter_OverdueTooltip}">
            <ToggleButton.IsVisible>
              <MultiBinding Converter="{x:Static baseconv:BoolConverters.And}">
                <Binding Path="HasOverdueCards" />
                <Binding Path="ShowOverdueButton" />
              </MultiBinding>
            </ToggleButton.IsVisible>
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <mi:MaterialIcon Kind="AlertCircleOutline" Width="12" Height="12" VerticalAlignment="Center" />
              <TextBlock Text="{Binding OverdueCount}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
        </StackPanel>

        <!-- Una sola salida para los tres filtros a la vez: buscador, etiquetas y filtro rápido pueden
             estar activos en combinación, y deshacerlos por separado obliga a adivinar cuál seguía puesto. -->
        <Button Classes="ghost" Height="34" Margin="0,0,12,8" VerticalAlignment="Center"
                IsVisible="{Binding HasActiveFilters}" Command="{Binding ClearFiltersCommand}"
                ToolTip.Tip="{loc:Tr Kanban_Filter_ClearTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Filter_ClearTooltip}">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="FilterRemoveOutline" Width="13" Height="13" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Tr Kanban_Filter_ClearButton, Converter={StaticResource UpperCaseConverter}}"
                       FontSize="11" FontWeight="Bold" LetterSpacing="1.5" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        </WrapPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
        <!-- Archivadas: puerta a la ventana del archivo, con el número de tareas guardadas dentro para
             que se note que existen sin tener que abrirla. Solo aparece cuando hay algo archivado —
             un botón permanente que casi siempre lleva a una lista vacía es el mismo ruido que la rejilla
             de estadísticas que esta barra ya se quitó de encima. -->
        <!-- Padding vertical a 0: Button.pill trae 20,11 de serie y, con la altura fija de 34 de la barra,
             los 22px de padding no dejan sitio al contenido y el número acababa recortado. Con el padding
             solo horizontal el contenido se centra entero dentro de los 34px.
             Icono y contador van juntos, como en los chips de filtro rápido: el botón ya no finge ser una
             caja con la etiqueta a un lado y el número al otro, sino el mismo chip compacto que el resto
             de botones de esta barra. El contador va sin recuadro de fondo: pegado al icono ya se lee
             como su recuento. -->
        <Button x:Name="KanbanArchiveTrigger" Classes="pill" Height="34" Padding="12,0" Margin="0,0,12,8"
                VerticalAlignment="Center" Command="{Binding OpenArchiveCommand}"
                ToolTip.Tip="{loc:Tr Kanban_Archive_ButtonTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Archive_ButtonTooltip}">
          <Button.IsVisible>
            <MultiBinding Converter="{x:Static baseconv:BoolConverters.And}">
              <Binding Path="HasArchivedCards" />
              <Binding Path="ShowArchiveButton" />
            </MultiBinding>
          </Button.IsVisible>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="ArchiveOutline" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ArchivedCount}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Ordenación: desplegable que enseña el orden activo en el propio botón, en vez de cuatro
             segmentos permanentes ocupando media barra. Mismo Popup con luz de descarte y misma
             Border.dropdown-popover que el resto de desplegables de la app. -->
        <Panel Margin="0,0,0,8" IsVisible="{Binding ShowSortButton}">
          <Button Name="KanbanSortTrigger" Classes="pill" Height="34" Padding="12,0" Command="{Binding ToggleSortMenuCommand}"
                  ToolTip.Tip="{loc:Tr Kanban_Sort_MenuTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Sort_MenuTooltip}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <mi:MaterialIcon Kind="SortVariant" Width="14" Height="14" VerticalAlignment="Center" />
              <TextBlock Text="{Binding SortModeLabel, Converter={StaticResource UpperCaseConverter}}" VerticalAlignment="Center" />
              <mi:MaterialIcon Kind="MenuDown" Width="14" Height="14" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Popup PlacementTarget="{Binding #KanbanSortTrigger}" Placement="BottomEdgeAlignedRight"
                 VerticalOffset="6" IsLightDismissEnabled="True"
                 OverlayInputPassThroughElement="{Binding #KanbanSortTrigger}"
                 IsOpen="{Binding IsSortMenuOpen, Mode=TwoWay}">
            <Border Classes="dropdown-popover" Width="250">
              <StackPanel Spacing="2">
                <TextBlock Text="{loc:Tr Kanban_Sort_ButtonLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Margin="0,0,0,10" />

                <Button Classes="dropdown-item" Command="{Binding SetSortModeCommand}"
                        CommandParameter="{x:Static vm:KanbanCardSortMode.Manual}"
                        ToolTip.Tip="{loc:Tr Kanban_Sort_ManualTooltip}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Sort_Manual, Converter={StaticResource UpperCaseConverter}}"
                               FontSize="11.5" FontWeight="Bold" LetterSpacing="1.2" VerticalAlignment="Center" />
                    <mi:MaterialIcon Grid.Column="1" Kind="Check" Width="14" Height="14" VerticalAlignment="Center"
                                      IsVisible="{Binding SortMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Manual}" />
                  </Grid>
                </Button>

                <Button Classes="dropdown-item" Command="{Binding SetSortModeCommand}"
                        CommandParameter="{x:Static vm:KanbanCardSortMode.Priority}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Sort_Priority, Converter={StaticResource UpperCaseConverter}}"
                               FontSize="11.5" FontWeight="Bold" LetterSpacing="1.2" VerticalAlignment="Center" />
                    <mi:MaterialIcon Grid.Column="1" Kind="Check" Width="14" Height="14" VerticalAlignment="Center"
                                      IsVisible="{Binding SortMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Priority}" />
                  </Grid>
                </Button>

                <Button Classes="dropdown-item" Command="{Binding SetSortModeCommand}"
                        CommandParameter="{x:Static vm:KanbanCardSortMode.DueDate}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Sort_DueDate, Converter={StaticResource UpperCaseConverter}}"
                               FontSize="11.5" FontWeight="Bold" LetterSpacing="1.2" VerticalAlignment="Center" />
                    <mi:MaterialIcon Grid.Column="1" Kind="Check" Width="14" Height="14" VerticalAlignment="Center"
                                      IsVisible="{Binding SortMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=DueDate}" />
                  </Grid>
                </Button>

                <Button Classes="dropdown-item" Command="{Binding SetSortModeCommand}"
                        CommandParameter="{x:Static vm:KanbanCardSortMode.Created}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Sort_Created, Converter={StaticResource UpperCaseConverter}}"
                               FontSize="11.5" FontWeight="Bold" LetterSpacing="1.2" VerticalAlignment="Center" />
                    <mi:MaterialIcon Grid.Column="1" Kind="Check" Width="14" Height="14" VerticalAlignment="Center"
                                      IsVisible="{Binding SortMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Created}" />
                  </Grid>
                </Button>
              </StackPanel>
            </Border>
          </Popup>
        </Panel>
        </StackPanel>
      </Grid>

      <!-- Chips de etiquetas: fila propia, y solo si el tablero tiene alguna etiqueta. Antes ocupaban
           sitio en la barra de herramientas incluso para anunciar "Sin etiquetas", que es exactamente la
           información que nadie necesita ver. IsVisible se evalúa contra el propio TagFilter porque
           DataContext se reapunta en este mismo elemento (mismo cuidado que en el panel de más abajo),
           y se cruza con el ajuste de Apariencia que permite esconder la fila entera: ocultarla no
           limpia el filtro, solo deja de pintarlo. -->
      <views:TagFilterView Grid.Row="3" DataContext="{Binding TagFilter}" Margin="0,0,0,6">
        <views:TagFilterView.IsVisible>
          <MultiBinding Converter="{x:Static baseconv:BoolConverters.And}">
            <Binding Path="!IsEmpty" />
            <Binding Path="$parent[UserControl].((vm:KanbanViewModel)DataContext).ShowTagFilter" />
          </MultiBinding>
        </views:TagFilterView.IsVisible>
      </views:TagFilterView>

      <!-- ===================== Avisos del tablero ===================== -->
      <StackPanel Grid.Row="4">

        <!-- Primer uso: la frase de ayuda que antes vivía fija bajo el título aparece aquí, solo mientras
             sirve de algo, y con los atajos de teclado al lado — existían desde siempre (N, C, Ctrl+F,
             Supr) pero no se anunciaban en ninguna parte de la interfaz. -->
        <Border Classes="board-hint" IsVisible="{Binding IsBoardEmpty}" Margin="0,0,0,16">
          <StackPanel Spacing="7">
            <TextBlock Text="{loc:Tr Kanban_Multi_Empty}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
            <Button Classes="pill" Content="{loc:Tr Kanban_Multi_FirstTask, Converter={StaticResource UpperCaseConverter}}" Command="{Binding CreateFirstCardCommand}" />
            <TextBlock Text="{loc:Tr Kanban_Board_ShortcutsHint}" Classes="faint" />
          </StackPanel>
        </Border>

        <!-- Filtro sin resultados: el tablero no se queda mudo con todas las columnas en blanco, y la
             salida está en el propio aviso en vez de obligar a recordar qué filtro se dejó puesto. -->
        <Border Classes="board-hint" IsVisible="{Binding HasNoFilterMatches}" Margin="0,0,0,16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Board_NoMatches}" Classes="muted" FontSize="12.5"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" Margin="14,0,0,0" VerticalAlignment="Center"
                    Command="{Binding ClearFiltersCommand}"
                    ToolTip.Tip="{loc:Tr Kanban_Filter_ClearTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Filter_ClearTooltip}">
              <TextBlock Text="{loc:Tr Kanban_Filter_ClearButton, Converter={StaticResource UpperCaseConverter}}"
                         FontSize="11" FontWeight="Bold" LetterSpacing="1.5" />
            </Button>
          </Grid>
        </Border>
      </StackPanel>

      <!-- ===================== Tablero =====================
           Las columnas se reparten a partes iguales todo el ancho del contenido en vez de medir 300px
           fijos y quedarse centradas: con tres columnas en una pantalla normal eso dejaba ~120px muertos
           a cada lado, y el tablero se leía como tres cajas flotando en vez de como un bloque. UniformGrid
           con una sola fila es lo que hace ese reparto — reparte el ancho disponible en tantas celdas
           iguales como columnas haya, así que todas miden lo mismo y la fila llega de borde a borde.

           El hueco de 16px entre columnas es Margin de la propia columna (UniformGrid no tiene Spacing):
           8px a cada lado, y un Margin negativo de -8 se come los dos medios huecos de los extremos, de
           forma que la primera y la última columna quedan alineadas al píxel con la barra de herramientas
           de arriba en vez de meterse 8px hacia dentro.

           Ese -8 va en el ScrollViewer, no en el ItemsControl de dentro: el visor recorta a sus propios
           límites, y con el margen negativo en su contenido el borde derecho de la última columna caía
           justo en la línea de recorte. Con escalado fraccional (125%, 150%…) el redondeo de la maqueta
           lo empujaba un píxel fuera y la columna se quedaba sin borde derecho. Ensanchando el visor, el
           recorte queda 8px más allá del borde, en el hueco transparente.

           Ya no hay una tira fantasma con un "+" al final de la fila: duplicaba el botón "NUEVA COLUMNA"
           del encabezado —que además va rotulado y no se va con el scroll— y dejaba una caja vacía
           flotando a la derecha del tablero.

           El ancho de columna y el scroll horizontal salen los dos del mismo sitio del viewmodel
           (BoardColumnWidth / BoardHorizontalScrollBarVisibility) porque son la misma decisión: un
           ScrollViewer que puede desplazarse en horizontal mide su contenido con ancho infinito, y con
           ancho infinito no hay "ancho disponible" que repartir — el UniformGrid le daba entonces a cada
           columna el ancho que pidiera la tarjeta de título más largo (medido: 695px por columna, hubiera
           sitio o no). Así que o se reparte el ancho con el scroll desactivado, o se usa ancho fijo con
           scroll; nunca a medias. Ver el comentario de MaxColumnsSharingWidth para el umbral.

           Solo una de las dos franjas de abajo está visible según Ajustes › Apariencia › Tablero Kanban
           (BoardOrientation) — mismo patrón de "ambas viven en el mismo Grid.Row, mutuamente excluyentes
           por IsVisible" que Board/TaskManagement más abajo en este mismo archivo. -->
      <ScrollViewer x:Name="BoardVerticalScroll" Grid.Row="5" Margin="-8,0" VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollBarVisibility="{Binding BoardHorizontalScrollBarVisibility}"
                    IsVisible="{Binding BoardOrientation, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Vertical}">
        <!-- x:Name: región exportable a PNG/PDF (T8). Se rasteriza el contenido del ScrollViewer, no el
             ScrollViewer, porque el contenido está dispuesto a su ancho completo y es el visor quien lo
             recorta — así la imagen sale con todas las columnas aunque no quepan en pantalla. Ver
             Services.Export.ViewExportService.FindExportRoot. -->
        <ItemsControl x:Name="KanbanExportRootVertical" ItemsSource="{Binding Columns}" HorizontalAlignment="Stretch">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>

      <!-- Tablero horizontal: franjas de ancho completo (una por columna/estado), apiladas verticalmente,
           cada una con su propia scrollbar horizontal para las tarjetas. -->
      <ScrollViewer x:Name="BoardHorizontalScroll" Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding BoardOrientation, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Horizontal}">
        <ItemsControl x:Name="KanbanExportRootHorizontal" ItemsSource="{Binding Columns}" ItemTemplate="{StaticResource KanbanColumnTemplateHorizontal}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
      </Grid>
  </Border>

    <!-- ===================== "Gestión de tareas" (Polar · Supabase) =====================
         IsVisible lives on this outer wrapper (evaluated against KanbanViewModel) rather than on the
         inner Grid below, because overriding DataContext on an element also repoints every other binding
         on that same element — including IsVisible — to the new DataContext. -->
    <Grid IsVisible="{Binding DisplayMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=TaskManagement}">
    <!-- Border.Padding (en vez de Grid.Margin) + Grid.MaxWidth con HorizontalAlignment="Stretch": mismo
         patrón de centrado que ScrollViewer.Padding + StackPanel.MaxWidth en DashboardView, así el
         contenido queda centrado con el mismo margen a los lados en vez de pegado al borde izquierdo. -->
    <Border Padding="36,30,36,26" HorizontalAlignment="Stretch">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" MaxWidth="1180" HorizontalAlignment="Stretch"
          DataContext="{Binding TaskManagement}" x:DataType="vm:PolarTaskManagementViewModel">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="200" MaxWidth="480" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Encabezado -->
      <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto,Auto,Auto">
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock Text="{loc:Tr Kanban_TaskMgmt_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
          <TextBlock Text="{loc:Tr Kanban_TaskMgmt_Title, Converter={StaticResource UpperCaseConverter}}" Classes="page-title" />
          <TextBlock Text="{loc:Tr Kanban_TaskMgmt_Subtitle}" Classes="page-subtitle" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" Margin="0,0,14,0">
          <RadioButton Classes="segment" GroupName="KanbanDisplayModeTaskManagementHeader" Content="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).BoardModeLabel, Converter={StaticResource UpperCaseConverter}}" Height="36"
                       IsChecked="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).DisplayMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Board, Mode=OneWay}"
                       Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).SetDisplayModeCommand}" CommandParameter="Board" />
          <RadioButton Classes="segment" GroupName="KanbanDisplayModeTaskManagementHeader" Content="{loc:Tr Kanban_Board_TabTaskManagement, Converter={StaticResource UpperCaseConverter}}" Margin="8,0,0,0" Height="36"
                       IsChecked="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).DisplayMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=TaskManagement, Mode=OneWay}"
                       Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).SetDisplayModeCommand}" CommandParameter="TaskManagement" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock Text="{Binding LastSyncedDisplayLabel}" Classes="faint" VerticalAlignment="Center" />
          <Button Classes="icon-btn" Command="{Binding SyncNowCommand}" ToolTip.Tip="{loc:Tr Kanban_TaskMgmt_SyncNowTooltip}" AutomationProperties.Name="{loc:Tr Kanban_TaskMgmt_SyncNowTooltip}" IsEnabled="{Binding !IsSyncing}">
            <mi:MaterialIcon Kind="Autorenew" Width="15" Height="15" Classes.spin="{Binding IsSyncing}" />
          </Button>
        </StackPanel>
        <Button Grid.Column="3" Classes="pill" Height="36" Command="{Binding OpenCreateListCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="Plus" Width="14" Height="14" />
            <TextBlock Text="{loc:Tr Kanban_TaskMgmt_NewListButton, Converter={StaticResource UpperCaseConverter}}" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Inicio / Listas: "Inicio" agrupa las tareas pendientes de todas las listas en un solo feed
           (como la pantalla de inicio de Polar); "Listas" es el flujo original de barra lateral + una
           lista a la vez. -->
      <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="0"
                  Margin="0,18,0,0">
        <RadioButton Classes="segment" GroupName="TaskManagementViewMode" Content="{loc:Tr Kanban_TaskMgmt_TabHome, Converter={StaticResource UpperCaseConverter}}"
                     IsChecked="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Home, Mode=OneWay}"
                     Command="{Binding SetViewModeCommand}" CommandParameter="Home" />
        <RadioButton Classes="segment" GroupName="TaskManagementViewMode" Content="{loc:Tr Kanban_TaskMgmt_TabLists, Converter={StaticResource UpperCaseConverter}}" Margin="8,0,0,0"
                     IsChecked="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Lists, Mode=OneWay}"
                     Command="{Binding SetViewModeCommand}" CommandParameter="Lists" />
      </StackPanel>

      <views:TagFilterView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" DataContext="{Binding TagFilter}" Margin="0,12,0,0"
                           IsVisible="{Binding $parent[Grid].DataContext.ShowTagFilter}" />
      <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Classes="faint" Margin="0,12,0,0" TextWrapping="Wrap"
                 Text="{loc:Tr Kanban_TagFilter_HiddenHint}"
                 IsVisible="{Binding !ShowTagFilter}" />

      <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0" Spacing="2">
        <TextBlock Text="{Binding SyncErrorDisplayLabel}" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                   IsVisible="{Binding SyncError, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{Binding NextRetryLabel}" Classes="faint" FontSize="12"
                   IsVisible="{Binding NextRetryLabel, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{loc:Tr Polar_Sync_AlreadyRunningNotice}" Classes="faint" FontSize="12"
                   IsVisible="{Binding LastSyncNowWasSkipped}" />
      </StackPanel>

      <!-- Estadísticas: misma rejilla con "gap de 1px" que el tablero Kanban (§3.2 / §7.5) -->
      <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="{DynamicResource Ink10}" BorderThickness="1" Margin="0,26,0,0">
        <Grid ColumnDefinitions="*,1,*,1,*,1,*" Background="{DynamicResource GridSeamBrush}">

          <Border Grid.Column="0" Classes="stat-card">
            <Grid>
              <mi:MaterialIcon Kind="FolderOutline" Width="17" Height="17" Foreground="{DynamicResource Ink40}" HorizontalAlignment="Right" VerticalAlignment="Top" />
              <StackPanel Spacing="12" VerticalAlignment="Top">
                <TextBlock Text="{Binding TotalLists}" FontSize="28" FontWeight="Bold" LetterSpacing="-0.5" />
                <TextBlock Text="{loc:Tr Kanban_Stat_Lists, Converter={StaticResource UpperCaseConverter}}" Classes="faint" LetterSpacing="1" />
              </StackPanel>
            </Grid>
      </Border>

          <Border Grid.Column="2" Classes="stat-card">
            <Grid>
              <mi:MaterialIcon Kind="ClipboardListOutline" Width="17" Height="17" Foreground="{DynamicResource Ink40}" HorizontalAlignment="Right" VerticalAlignment="Top" />
              <StackPanel Spacing="12" VerticalAlignment="Top">
                <TextBlock Text="{Binding TotalTasks}" FontSize="28" FontWeight="Bold" LetterSpacing="-0.5" />
                <TextBlock Text="{loc:Tr Kanban_Stat_TotalTasks, Converter={StaticResource UpperCaseConverter}}" Classes="faint" LetterSpacing="1" />
              </StackPanel>
            </Grid>
      </Border>

          <Border Grid.Column="4" Classes="stat-card">
            <Grid>
              <mi:MaterialIcon Kind="ClipboardTextClockOutline" Width="17" Height="17" Foreground="{DynamicResource Ink40}" HorizontalAlignment="Right" VerticalAlignment="Top" />
              <StackPanel Spacing="12" VerticalAlignment="Top">
                <TextBlock Text="{Binding PendingTasks}" FontSize="28" FontWeight="Bold" LetterSpacing="-0.5" />
                <TextBlock Text="{loc:Tr Kanban_Stat_Pending, Converter={StaticResource UpperCaseConverter}}" Classes="faint" LetterSpacing="1" />
              </StackPanel>
            </Grid>
      </Border>

          <Border Grid.Column="6" Classes="stat-card">
            <Grid>
              <mi:MaterialIcon Kind="AlertCircleOutline" Width="17" Height="17" Foreground="{DynamicResource Ink40}" HorizontalAlignment="Right" VerticalAlignment="Top" />
              <StackPanel Spacing="12" VerticalAlignment="Top">
                <TextBlock Text="{Binding OverdueTasks}" FontSize="28" FontWeight="Bold" LetterSpacing="-0.5" />
                <TextBlock Text="{loc:Tr Kanban_Stat_Overdue, Converter={StaticResource UpperCaseConverter}}" Classes="faint" LetterSpacing="1" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- Listas -->
      <Border Grid.Row="5" Grid.Column="0" Margin="0,22,0,0" Padding="0,0,14,0"
              IsVisible="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Lists}">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="2">
              <ItemsControl ItemsSource="{Binding Lists}" />
              <!-- Empty state accionable. -->
              <StackPanel IsVisible="{Binding IsListsEmpty}" Spacing="12" Margin="0,30,0,0" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="FolderOutline" Width="22" Height="22" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr Kanban_Lists_EmptyTitle}" Classes="muted" FontSize="12.5" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Classes="pill" Command="{Binding OpenCreateListCommand}" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="Plus" Width="12" Height="12" />
                    <TextBlock Text="{loc:Tr Kanban_TaskMgmt_NewListButton, Converter={StaticResource UpperCaseConverter}}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
  </Border>

      <!-- Separador arrastrable: cambia el ancho de la ColumnDefinition[0] (con Min/MaxWidth arriba),
           mismo patrón que el panel de carpetas en NotesView. La costura visible es una Border de 1px
           propia; el GridSplitter en sí queda transparente y sólo aporta el área de agarre de 7px. -->
      <Border Grid.Row="5" Grid.Column="1" Width="1" Margin="0,22,0,0" HorizontalAlignment="Center"
              Background="{DynamicResource Ink10}" IsHitTestVisible="False"
              IsVisible="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Lists}" />
      <GridSplitter Grid.Row="5" Grid.Column="1" Classes="folder-panel-splitter" Width="7" Margin="0,22,0,0"
                    Background="Transparent" ResizeDirection="Columns"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    AutomationProperties.Name="{loc:Tr A11y_Kanban_ListPanelSplitter}"
                    IsVisible="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Lists}" />

      <!-- Tareas de la lista seleccionada -->
      <Grid Grid.Row="5" Grid.Column="2" RowDefinitions="Auto,*" Margin="5,22,0,0"
            IsVisible="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Lists}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16" IsVisible="{Binding SelectedList, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedList.Title}" FontWeight="Bold" FontSize="16" LetterSpacing="0.2" />
            <Border Background="{DynamicResource Ink10}" Padding="6,2" IsVisible="{Binding SelectedList.IsDependencyChain}" ToolTip.Tip="{loc:Tr Kanban_List_DependencyChainTooltip}" AutomationProperties.Name="{loc:Tr Kanban_List_DependencyChainTooltip}">
              <TextBlock Text="{loc:Tr Kanban_List_ChainBadge, Converter={StaticResource UpperCaseConverter}}" Classes="faint" FontSize="9.5" />
       </Border>
          </StackPanel>
          <Button Grid.Column="1" Classes="icon-btn icon-btn-danger" Width="26" Height="26" Margin="0,0,8,0"
                  Command="{Binding RequestDeleteListCommand}" CommandParameter="{Binding SelectedList}" ToolTip.Tip="{loc:Tr Kanban_TaskList_DeleteTooltip}" AutomationProperties.Name="{loc:Tr Kanban_TaskList_DeleteTooltip}">
            <mi:MaterialIcon Kind="TrashCanOutline" Width="13" Height="13" />
          </Button>
          <Button Grid.Column="2" Classes="pill" Command="{Binding OpenCreateTaskCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="Plus" Width="13" Height="13" />
              <TextBlock Text="{loc:Tr Kanban_TaskMgmt_NewTaskButton, Converter={StaticResource UpperCaseConverter}}" />
            </StackPanel>
          </Button>
        </Grid>

        <Grid Grid.Row="1">
          <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding SelectedList, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding PendingTaskRows}" />

              <!-- Completadas: sección aparte y colapsada por defecto, para que lo que falta por hacer
                   no se pierda entre tareas ya terminadas — igual que la mayoría de gestores de tareas. -->
              <StackPanel IsVisible="{Binding HasCompletedTasks}" Margin="0,4,0,0">
                <Rectangle Height="1" Fill="{DynamicResource Ink10}" Margin="0,4,0,14"
                           IsVisible="{Binding PendingTaskRows.Count, Converter={StaticResource CountToBoolConverter}}" />
                <!-- Classes="dropdown-item" en vez de "ghost": ghost no neutraliza el CornerRadius ni el
                     fondo de hover/pressed que trae FluentTheme por defecto, así que estirado a todo el
                     ancho se veía como una caja redondeada ajena al resto de la app; dropdown-item ya
                     resuelve exactamente ese caso (fila clicable de ancho completo, esquinas a 0, hover
                     sutil sobre Ink05). -->
                <Button Classes="dropdown-item" Margin="0" Padding="4,8" Command="{Binding ToggleCompletedSectionCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="{Binding IsCompletedExpanded, Converter={StaticResource ExpandChevronConverter}}"
                                      Width="14" Height="14" Foreground="{DynamicResource Ink40}" />
                    <TextBlock Text="{Binding CompletedSectionHeaderLabel}" Classes="eyebrow" FontSize="10" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding CompletedTaskRows}" IsVisible="{Binding IsCompletedExpanded}" Margin="0,10,0,0" />
              </StackPanel>

              <!-- Empty state accionable. -->
              <StackPanel IsVisible="{Binding IsTasksEmpty}" Spacing="12" Margin="0,40,0,0" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="ClipboardListOutline" Width="24" Height="24" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr Kanban_Tasks_EmptyTitle}" Classes="muted" FontSize="12.5" HorizontalAlignment="Center" />
                <Button Classes="pill" Command="{Binding OpenCreateTaskCommand}" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="Plus" Width="12" Height="12" />
                    <TextBlock Text="{loc:Tr Kanban_TaskMgmt_NewTaskButton, Converter={StaticResource UpperCaseConverter}}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <StackPanel IsVisible="{Binding SelectedList, Converter={x:Static baseconv:ObjectConverters.IsNull}}"
                      Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
            <mi:MaterialIcon Kind="FolderOutline" Width="26" Height="26" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Tr Kanban_Lists_SelectPrompt}" Classes="muted" FontSize="12.5" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- ===================== Inicio: feed con las tareas pendientes de todas las listas =====================
           Cada sección lleva la barra de acento del color de su lista (misma idea que Button.dropdown-item.
           reminder-item en el buzón de notificaciones) y muestra las subtareas ya desplegadas en línea, sin
           necesidad de abrir el detalle — así se ve todo de un vistazo, como la pantalla de inicio de Polar. -->
      <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,22,0,0"
            IsVisible="{Binding ViewMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Home}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding HomeGroups}" />

            <StackPanel IsVisible="{Binding IsHomeEmpty}" Spacing="10" Margin="0,40,0,0" HorizontalAlignment="Center">
              <mi:MaterialIcon Kind="CheckCircleOutline" Width="26" Height="26" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:Tr Kanban_Home_EmptyTitle}" Classes="muted" FontSize="12.5" HorizontalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ===================== Formulario emergente: crear / editar lista ===================== -->
      <controls:ModalOverlayHost IsOpen="{Binding ListEditor, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
        <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="420" DataContext="{Binding ListEditor}" x:DataType="vm:PolarListEditorViewModel">
          <StackPanel Spacing="18" MinWidth="380">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding HeadingEyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
              <TextBlock Text="{Binding HeadingTitle}" FontSize="19" FontWeight="Bold" LetterSpacing="-0.3" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Tr Kanban_Field_TitleLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
              <TextBox Classes="search" Text="{Binding Title}" PlaceholderText="{loc:Tr Kanban_ListEditor_NamePlaceholder}" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Tr Kanban_ListEditor_IconLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
              <ItemsControl ItemsSource="{Binding IconOptions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:PolarIconOptionViewModel">
                    <RadioButton Classes="segment" GroupName="PolarListIcon" Margin="0,0,8,8"
                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                 Command="{Binding $parent[ItemsControl].((vm:PolarListEditorViewModel)DataContext).SelectIconCommand}"
                                 CommandParameter="{Binding Key}">
                      <mi:MaterialIcon Kind="{Binding IconKind}" Width="16" Height="16" />
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="{loc:Tr Kanban_ListEditor_ChainToggleLabel, Converter={StaticResource UpperCaseConverter}}" FontSize="13" />
                <TextBlock Text="{loc:Tr Kanban_ListEditor_ChainToggleDescription}"
                           Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDependencyChain}" OnContent="" OffContent=""
                            AutomationProperties.Name="{loc:Tr Kanban_ListEditor_ChainToggleLabel}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto">
              <Button Grid.Column="1" Classes="ghost modal-cancel"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).TaskManagement.CancelListEditorCommand}"
                      Margin="0,0,18,0">
                <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
              <Button Grid.Column="2" Classes="pill-primary" IsEnabled="{Binding CanSave}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).TaskManagement.SaveListEditorCommand}">
                <TextBlock Text="{Binding ConfirmLabel, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
            </Grid>
          </StackPanel>
    </Border>
  </controls:ModalOverlayHost>

      <!-- ===================== Diálogo: eliminar lista ===================== -->
      <controls:ModalOverlayHost IsOpen="{Binding ListPendingDelete, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
        <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
                DataContext="{Binding ListPendingDelete}" x:DataType="vm:PolarTaskListItemViewModel">
          <StackPanel Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
              <TextBlock Text="{loc:Tr Kanban_DeleteList_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Tr Kanban_DeleteList_Message}" FontSize="14" TextWrapping="Wrap" MaxWidth="320" />
              <TextBlock Text="{Binding Title}" Classes="muted" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto,Auto">
              <Button Grid.Column="1" Classes="ghost modal-cancel"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).TaskManagement.CancelDeleteListCommand}"
                      Margin="0,0,18,0">
                <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
              <Button Grid.Column="2" Classes="pill-primary-danger"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).TaskManagement.ConfirmDeleteListCommand}">
                <TextBlock Text="{loc:Tr Common_Delete, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
            </Grid>
          </StackPanel>
    </Border>
  </controls:ModalOverlayHost>

      <!-- ===================== Formulario emergente: crear / editar tarea ===================== -->
      <controls:ModalOverlayHost IsOpen="{Binding TaskEditor, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
        <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="580" MaxHeight="720" DataContext="{Binding TaskEditor}" x:DataType="vm:PolarTaskEditorViewModel">
          <Grid RowDefinitions="Auto,*,Auto" MinWidth="480">

            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,18">
              <TextBlock Text="{Binding HeadingEyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
              <TextBlock Text="{Binding HeadingTitle}" FontSize="19" FontWeight="Bold" LetterSpacing="-0.3" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
              <StackPanel Spacing="18">

                <StackPanel Spacing="6">
                  <TextBlock Text="{loc:Tr Kanban_Field_TitleLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <TextBox Classes="search" Text="{Binding Title}" PlaceholderText="{loc:Tr Kanban_TaskEditor_TitlePlaceholder}" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Field_DescriptionLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                    <TextBlock Grid.Column="1" Text="{Binding DescriptionCounterLabel}" Classes="faint" />
                  </Grid>
                  <TextBox Classes="search" Text="{Binding Description}" MaxLength="240"
                            AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                            PlaceholderText="{loc:Tr Kanban_TaskEditor_DescriptionPlaceholder}" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="{loc:Tr Kanban_Field_PriorityLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton Classes="segment" GroupName="PolarTaskPriority" Content="{loc:Tr Polar_Priority_None, Converter={StaticResource UpperCaseConverter}}"
                                 IsChecked="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=0, Mode=OneWay}"
                                 Command="{Binding SelectPriorityCommand}" CommandParameter="0" />
                    <RadioButton Classes="segment" GroupName="PolarTaskPriority" Content="{loc:Tr Polar_Priority_Low, Converter={StaticResource UpperCaseConverter}}"
                                 IsChecked="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=1, Mode=OneWay}"
                                 Command="{Binding SelectPriorityCommand}" CommandParameter="1" />
                    <RadioButton Classes="segment" GroupName="PolarTaskPriority" Content="{loc:Tr Polar_Priority_Medium, Converter={StaticResource UpperCaseConverter}}"
                                 IsChecked="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=2, Mode=OneWay}"
                                 Command="{Binding SelectPriorityCommand}" CommandParameter="2" />
                    <RadioButton Classes="segment" GroupName="PolarTaskPriority" Content="{loc:Tr Polar_Priority_High, Converter={StaticResource UpperCaseConverter}}"
                                 IsChecked="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=3, Mode=OneWay}"
                                 Command="{Binding SelectPriorityCommand}" CommandParameter="3" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="{loc:Tr Kanban_Field_DueDateLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <Button Name="PolarDueDateTrigger" Classes="date-picker-trigger" Command="{Binding ToggleCalendarCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <mi:MaterialIcon Grid.Column="0" Kind="CalendarOutline" Width="14" Height="14" Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding DueDateDisplayLabel}" Classes.placeholder="{Binding !HasDueDate}" Margin="10,0,0,0" VerticalAlignment="Center" />
                      <mi:MaterialIcon Grid.Column="2" Kind="MenuDown" Width="15" Height="15" Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>

                  <Popup PlacementTarget="{Binding #PolarDueDateTrigger}" Placement="BottomEdgeAlignedLeft"
                         VerticalOffset="6" IsLightDismissEnabled="True"
                         OverlayInputPassThroughElement="{Binding #PolarDueDateTrigger}"
                         IsOpen="{Binding IsCalendarOpen, Mode=TwoWay}">
                    <Border Classes="calendar-popover" Width="290">
                      <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Button Grid.Column="0" Classes="icon-btn calendar-nav" Command="{Binding PreviousMonthCommand}" ToolTip.Tip="{loc:Tr Kanban_Calendar_PrevMonthTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Calendar_PrevMonthTooltip}">
                            <mi:MaterialIcon Kind="ChevronLeft" Width="15" Height="15" />
                          </Button>
                          <TextBlock Grid.Column="1" Text="{Binding CalendarMonthLabel}" Classes="eyebrow" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Button Grid.Column="2" Classes="icon-btn calendar-nav" Command="{Binding NextMonthCommand}" ToolTip.Tip="{loc:Tr Kanban_Calendar_NextMonthTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Calendar_NextMonthTooltip}">
                            <mi:MaterialIcon Kind="ChevronRight" Width="15" Height="15" />
                          </Button>
                        </Grid>
                        <UniformGrid Columns="7">
                          <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdayMon, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                          <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdayTue, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                          <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdayWed, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                          <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdayThu, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                          <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdayFri, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                          <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdaySat, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                          <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdaySun, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                        </UniformGrid>
                        <ItemsControl ItemsSource="{Binding CalendarDays}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel Spacing="8" IsVisible="{Binding HasDueDate}">
                          <Rectangle Height="1" Fill="{DynamicResource Ink10}" />
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Calendar_AddTimeLabel, Converter={StaticResource UpperCaseConverter}}" FontSize="12" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding HasDueTime}" OnContent="" OffContent=""
                                          AutomationProperties.Name="{loc:Tr Kanban_Calendar_AddTimeLabel}" />
                          </Grid>
                          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasDueTime}">
                            <Border Classes="time-stepper">
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Grid.Column="0" Classes="icon-btn time-stepper-btn"
                                        Command="{Binding DecrementDueHourCommand}" ToolTip.Tip="{loc:Tr Kanban_TimeStepper_SubtractHourTooltip}" AutomationProperties.Name="{loc:Tr Kanban_TimeStepper_SubtractHourTooltip}">
                                  <mi:MaterialIcon Kind="Minus" Width="12" Height="12" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding DueHour, StringFormat={}{0:00}}"
                                           Classes="time-stepper-value" />
                                <Button Grid.Column="2" Classes="icon-btn time-stepper-btn"
                                        Command="{Binding IncrementDueHourCommand}" ToolTip.Tip="{loc:Tr Kanban_TimeStepper_AddHourTooltip}" AutomationProperties.Name="{loc:Tr Kanban_TimeStepper_AddHourTooltip}">
                                  <mi:MaterialIcon Kind="Plus" Width="12" Height="12" />
                                </Button>
                              </Grid>
                            </Border>
                            <TextBlock Text=":" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Classes="time-stepper">
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Grid.Column="0" Classes="icon-btn time-stepper-btn"
                                        Command="{Binding DecrementDueMinuteCommand}" ToolTip.Tip="{loc:Tr Kanban_TimeStepper_SubtractMinuteTooltip}" AutomationProperties.Name="{loc:Tr Kanban_TimeStepper_SubtractMinuteTooltip}">
                                  <mi:MaterialIcon Kind="Minus" Width="12" Height="12" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding DueMinute, StringFormat={}{0:00}}"
                                           Classes="time-stepper-value" />
                                <Button Grid.Column="2" Classes="icon-btn time-stepper-btn"
                                        Command="{Binding IncrementDueMinuteCommand}" ToolTip.Tip="{loc:Tr Kanban_TimeStepper_AddMinuteTooltip}" AutomationProperties.Name="{loc:Tr Kanban_TimeStepper_AddMinuteTooltip}">
                                  <mi:MaterialIcon Kind="Plus" Width="12" Height="12" />
                                </Button>
                              </Grid>
                            </Border>
                          </StackPanel>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <Button Grid.Column="1" Classes="ghost" Command="{Binding ClearDueDateCommand}" Margin="0,0,18,0" IsVisible="{Binding HasDueDate}">
                            <TextBlock Text="{loc:Tr Kanban_DueDate_ClearButton, Converter={StaticResource UpperCaseConverter}}" />
                          </Button>
                          <Button Grid.Column="2" Classes="ghost" Command="{Binding SetDueDateTodayCommand}">
                            <TextBlock Text="{loc:Tr Kanban_DueDate_TodayButton, Converter={StaticResource UpperCaseConverter}}" />
                          </Button>
                        </Grid>
                      </StackPanel>
               </Border>
                  </Popup>
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="{loc:Tr Kanban_Field_RecurrenceLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <!-- WrapPanel directo bajo el StackPanel vertical (sin envolverlo en uno horizontal):
                       un StackPanel horizontal mide a sus hijos con ancho infinito, así que el WrapPanel
                       nunca llegaba a envolver y la última opción quedaba cortada fuera del modal. -->
                  <WrapPanel>
                    <RadioButton Classes="segment" GroupName="PolarTaskRecurrence" Content="{loc:Tr Kanban_Recurrence_None, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,6,6"
                                 IsChecked="{Binding Recurrence, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=None, Mode=OneWay}"
                                 Command="{Binding SelectRecurrenceCommand}" CommandParameter="None" />
                    <RadioButton Classes="segment" GroupName="PolarTaskRecurrence" Content="{loc:Tr Polar_Recurrence_Daily, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,6,6"
                                 IsChecked="{Binding Recurrence, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Daily, Mode=OneWay}"
                                 Command="{Binding SelectRecurrenceCommand}" CommandParameter="Daily" />
                    <RadioButton Classes="segment" GroupName="PolarTaskRecurrence" Content="{loc:Tr Polar_Recurrence_Weekly, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,6,6"
                                 IsChecked="{Binding Recurrence, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Weekly, Mode=OneWay}"
                                 Command="{Binding SelectRecurrenceCommand}" CommandParameter="Weekly" />
                    <RadioButton Classes="segment" GroupName="PolarTaskRecurrence" Content="{loc:Tr Polar_Recurrence_Monthly, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,6,6"
                                 IsChecked="{Binding Recurrence, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Monthly, Mode=OneWay}"
                                 Command="{Binding SelectRecurrenceCommand}" CommandParameter="Monthly" />
                    <RadioButton Classes="segment" GroupName="PolarTaskRecurrence" Content="{loc:Tr Kanban_Recurrence_MonWed, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,6,6"
                                 IsChecked="{Binding Recurrence, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=MonWed, Mode=OneWay}"
                                 Command="{Binding SelectRecurrenceCommand}" CommandParameter="MonWed" />
                    <RadioButton Classes="segment" GroupName="PolarTaskRecurrence" Content="{loc:Tr Kanban_Recurrence_FirstDayMonth, Converter={StaticResource UpperCaseConverter}}" Margin="0,0,6,6"
                                 IsChecked="{Binding Recurrence, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=FirstDayMonth, Mode=OneWay}"
                                 Command="{Binding SelectRecurrenceCommand}" CommandParameter="FirstDayMonth" />
                  </WrapPanel>
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="{loc:Tr Kanban_Field_TagsLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <TextBox Classes="search" Text="{Binding TagsInput}" PlaceholderText="{loc:Tr Kanban_Tags_PlaceholderExample}" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="{loc:Tr Kanban_TaskEditor_TimeEstimateLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <NumericUpDown Value="{Binding TimeEstimate}" Minimum="0" Maximum="1440" Increment="5" ShowButtonSpinner="True" HorizontalAlignment="Left" Width="140" />
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding !IsCreateMode}">
                  <TextBlock Text="{loc:Tr Kanban_Field_SubtasksLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <ItemsControl ItemsSource="{Binding Subtasks}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Classes="search" Text="{Binding NewSubtaskTitle}"
                              Name="PolarNewSubtaskBox" PlaceholderText="{loc:Tr Kanban_Subtask_AddPlaceholder}" KeyDown="PolarNewSubtaskBox_KeyDown" />
                    <Button Grid.Column="1" Classes="icon-btn" Width="34" Height="34" Margin="8,0,0,0"
                            Command="{Binding AddSubtaskCommand}" ToolTip.Tip="{loc:Tr Kanban_Subtask_AddTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Subtask_AddTooltip}">
                      <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                    </Button>
                  </Grid>
                </StackPanel>
                <TextBlock Text="{loc:Tr Kanban_TaskEditor_SaveToAddSubtasksHint}" Classes="muted" FontSize="12.5"
                           IsVisible="{Binding IsCreateMode}" />

              </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,18,0,0">
              <Button Grid.Column="1" Classes="ghost modal-cancel"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).TaskManagement.CancelTaskEditorCommand}"
                      Margin="0,0,18,0">
                <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
              <Button Grid.Column="2" Classes="pill-primary" IsEnabled="{Binding CanSave}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).TaskManagement.SaveTaskEditorCommand}">
                <TextBlock Text="{Binding ConfirmLabel, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
            </Grid>
          </Grid>
    </Border>
  </controls:ModalOverlayHost>

      <!-- ===================== Diálogo: eliminar tarea ===================== -->
      <controls:ModalOverlayHost IsOpen="{Binding TaskPendingDelete, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
        <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
                DataContext="{Binding TaskPendingDelete}" x:DataType="vm:PolarTaskRowViewModel">
          <StackPanel Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
              <TextBlock Text="{loc:Tr Kanban_DeleteTask_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Tr Kanban_DeleteTask_Message}" FontSize="14" TextWrapping="Wrap" MaxWidth="320" />
              <TextBlock Text="{Binding Title}" Classes="muted" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto,Auto">
              <Button Grid.Column="1" Classes="ghost modal-cancel"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).TaskManagement.CancelDeleteTaskCommand}"
                      Margin="0,0,18,0">
                <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
              <Button Grid.Column="2" Classes="pill-primary-danger"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).TaskManagement.ConfirmDeleteTaskCommand}">
                <TextBlock Text="{loc:Tr Common_Delete, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
            </Grid>
          </StackPanel>
    </Border>
  </controls:ModalOverlayHost>

      <!-- ===================== Diálogo: detalle de tarea =====================
           Se abre al hacer clic en cualquier tarea de la lista (§ fila de tarea arriba). Muestra toda
           la información — prioridad, fecha límite, recurrencia, estimación, etiquetas, lista de origen,
           bloqueo por cadena y subtareas — organizada en el mismo lenguaje visual que el resto de la app,
           con accesos directos para completar, editar o eliminar sin tener que volver a la lista. -->
      <controls:ModalOverlayHost IsOpen="{Binding TaskDetail, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
        <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="500" MaxHeight="680" DataContext="{Binding TaskDetail}" x:DataType="vm:PolarTaskDetailViewModel">
          <Grid RowDefinitions="Auto,*,Auto" MinWidth="420">

            <!-- Encabezado: lista de origen + bloqueo, botón de completar + título -->
            <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,18">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="{Binding ListIconKind}" Width="12" Height="12" Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{Binding ListTitle}" Classes="eyebrow" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource Ink10}" Padding="6,3" VerticalAlignment="Center"
                        IsVisible="{Binding IsBlocked}" ToolTip.Tip="{loc:Tr Kanban_Task_BlockedTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Task_BlockedTooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <mi:MaterialIcon Kind="LockOutline" Width="10" Height="10" />
                    <TextBlock Text="{loc:Tr Kanban_Task_BlockedBadge, Converter={StaticResource UpperCaseConverter}}" Classes="faint" FontSize="9.5" />
                  </StackPanel>
           </Border>
              </Grid>

              <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0" Classes="icon-btn" Width="30" Height="30" Margin="0,1,12,0" VerticalAlignment="Top"
                        IsEnabled="{Binding !IsBlocked}"
                        Command="{Binding ToggleCompletedCommand}" ToolTip.Tip="{Binding CompletedLabel}"
                        AutomationProperties.Name="{Binding CompletedLabel}">
                  <mi:MaterialIcon Kind="{Binding CompletedIcon}" Width="19" Height="19" />
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="subtask-title" Classes.done="{Binding Completed}"
                           FontSize="19" FontWeight="Bold" LetterSpacing="-0.3" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
              <StackPanel Spacing="20">

                <StackPanel Spacing="6" IsVisible="{Binding HasDescription}">
                  <TextBlock Text="{loc:Tr Kanban_Field_DescriptionLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <TextBlock Text="{Binding Description}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Metadatos: mismo par icono + etiqueta "faint" que ya usa la fila de tarea, agrupados
                     aquí en una sola cuadrícula para que se lean de un vistazo. -->
                <StackPanel Spacing="10" IsVisible="{Binding HasAnyMeta}">
                  <TextBlock Text="{loc:Tr Kanban_TaskDetail_DetailsLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <WrapPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,22,10" IsVisible="{Binding HasPriority}">
                      <Ellipse Classes="priority-dot"
                               Classes.low="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=1}"
                               Classes.medium="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=2}"
                               Classes.high="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=3}" />
                      <TextBlock Text="{Binding PriorityLabel, Converter={StaticResource UpperCaseConverter}}" Classes="faint" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,22,10" IsVisible="{Binding HasDueDate}">
                      <mi:MaterialIcon Kind="CalendarOutline" Width="13" Height="13" Classes.overdue="{Binding IsOverdue}" Foreground="{DynamicResource Ink40}" />
                      <TextBlock Text="{Binding DueDateLabel}" Classes="faint" Classes.overdue="{Binding IsOverdue}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,22,10" IsVisible="{Binding HasRecurrence}">
                      <mi:MaterialIcon Kind="RepeatVariant" Width="13" Height="13" Foreground="{DynamicResource Ink40}" />
                      <TextBlock Text="{Binding RecurrenceLabel, Converter={StaticResource UpperCaseConverter}}" Classes="faint" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,22,10" IsVisible="{Binding HasTimeEstimate}">
                      <mi:MaterialIcon Kind="ClockOutline" Width="13" Height="13" Foreground="{DynamicResource Ink40}" />
                      <TextBlock Text="{Binding TimeEstimateLabel}" Classes="faint" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,22,10" IsVisible="{Binding HasTags}">
                      <mi:MaterialIcon Kind="TagMultipleOutline" Width="13" Height="13" Foreground="{DynamicResource Ink40}" />
                      <TextBlock Text="{Binding TagsLabel}" Classes="faint" VerticalAlignment="Center" />
                    </StackPanel>
                  </WrapPanel>
                </StackPanel>

                <!-- Subtareas: la única parte interactiva además del check de completado — solo se
                     pueden marcar/desmarcar, igual que en el detalle de tarjeta del tablero Kanban. -->
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Field_SubtasksLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                    <TextBlock Grid.Column="1" Text="{Binding SubtaskProgressLabel}" Classes="faint" IsVisible="{Binding HasSubtasks}" />
                  </Grid>

                  <ItemsControl ItemsSource="{Binding Subtasks}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:PolarSubtaskRowViewModel">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                          <Button Grid.Column="0" Classes="icon-btn" Width="26" Height="26"
                                  Command="{Binding ToggleCommand}" ToolTip.Tip="{loc:Tr Kanban_Subtask_ToggleTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Subtask_ToggleTooltip}">
                            <mi:MaterialIcon Kind="{Binding CheckIcon}" Width="15" Height="15" />
                          </Button>
                          <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                     Classes="subtask-title" Classes.done="{Binding IsDone}"
                                     TextWrapping="Wrap" FontSize="12.5" Margin="6,0" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="{loc:Tr Kanban_Subtasks_EmptyLabel}" Classes="muted" FontSize="12.5" IsVisible="{Binding !HasSubtasks}" />
                </StackPanel>

              </StackPanel>
            </ScrollViewer>

            <!-- Acciones -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,18,0,0">
              <Button Grid.Column="0" Classes="icon-btn icon-btn-danger" Width="30" Height="30"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).TaskManagement.DeleteTaskFromDetailCommand}"
                      ToolTip.Tip="{loc:Tr Kanban_Task_DeleteTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Task_DeleteTooltip}">
                <mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" />
              </Button>
              <Button Grid.Column="2" Classes="ghost modal-cancel" Margin="0,0,18,0"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).TaskManagement.EditTaskFromDetailCommand}">
                <TextBlock Text="{loc:Tr Common_Edit, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
              <Button Grid.Column="3" Classes="pill"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).TaskManagement.CloseTaskDetailCommand}">
                <TextBlock Text="{loc:Tr Common_Close, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
            </Grid>
          </Grid>
    </Border>
  </controls:ModalOverlayHost> 
     </Grid>
  </Border>
    </Grid>

    <!-- ===================== Formulario emergente: crear / editar tarjeta (§7.10) ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding CardEditor, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
              MaxWidth="480" MaxHeight="680" DataContext="{Binding CardEditor}" x:DataType="vm:KanbanCardEditorViewModel">
        <Grid RowDefinitions="Auto,*,Auto" MinWidth="420">

          <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,18">
            <TextBlock Text="{Binding HeadingEyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
            <TextBlock Text="{Binding HeadingTitle}" FontSize="19" FontWeight="Bold" LetterSpacing="-0.3" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
            <StackPanel Spacing="18">

              <!-- Título -->
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Kanban_Field_TitleLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <TextBox Name="TitleBox" Classes="search" Text="{Binding Title}"
                          PlaceholderText="{loc:Tr Kanban_CardEditor_TitlePlaceholder}" />
              </StackPanel>

              <!-- Columna: selector explícito además de arrastrar la tarjeta entre columnas — vía de
                   accesibilidad de teclado/lector de pantalla y alternativa cuando el arrastre falla
                   (docs/analisis-proyecto/roadmap.md, Fase 7). No mueve nada hasta Guardar, igual que el
                   resto del formulario. -->
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Kanban_Field_ColumnLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <ComboBox ItemsSource="{Binding AvailableColumns}" SelectedItem="{Binding SelectedColumn}"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Tr Kanban_Field_ColumnLabel}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:KanbanColumnViewModel">
                      <TextBlock Text="{Binding Title, Converter={StaticResource UpperCaseConverter}}" LetterSpacing="1.2" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <!-- Descripción corta -->
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Field_DescriptionLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <TextBlock Grid.Column="1" Text="{Binding DescriptionCounterLabel}" Classes="faint" />
                </Grid>
                <TextBox Classes="search" Text="{Binding Description}" MaxLength="240"
                          AcceptsReturn="True" TextWrapping="Wrap" Height="76"
                          PlaceholderText="{loc:Tr Kanban_CardEditor_DescriptionPlaceholder}" />
              </StackPanel>

              <!-- Prioridad -->
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Kanban_Field_PriorityLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <RadioButton Classes="segment" GroupName="CardPriority" Content="{loc:Tr Polar_Priority_Low, Converter={StaticResource UpperCaseConverter}}"
                               IsChecked="{Binding SelectedPriority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Low, Mode=OneWay}"
                               Command="{Binding SelectPriorityCommand}" CommandParameter="Low" />
                  <RadioButton Classes="segment" GroupName="CardPriority" Content="{loc:Tr Polar_Priority_Medium, Converter={StaticResource UpperCaseConverter}}"
                               IsChecked="{Binding SelectedPriority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Medium, Mode=OneWay}"
                               Command="{Binding SelectPriorityCommand}" CommandParameter="Medium" />
                  <RadioButton Classes="segment" GroupName="CardPriority" Content="{loc:Tr Polar_Priority_High, Converter={StaticResource UpperCaseConverter}}"
                               IsChecked="{Binding SelectedPriority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=High, Mode=OneWay}"
                               Command="{Binding SelectPriorityCommand}" CommandParameter="High" />
                </StackPanel>
              </StackPanel>

              <!-- Etiquetas -->
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Kanban_Field_TagsLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <TextBox Classes="search" Text="{Binding TagsInput}" PlaceholderText="{loc:Tr Kanban_Tags_PlaceholderExample}" />
              </StackPanel>

              <!-- Fecha límite: selector por calendario emergente, mismo lenguaje visual que el resto
                   del formulario (§7.10) — nada de tecleo manual de fecha. -->
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Kanban_Field_StartDateLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />

                <Button Name="StartDateTrigger" Classes="date-picker-trigger"
                        Command="{Binding ToggleStartCalendarCommand}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <mi:MaterialIcon Grid.Column="0" Kind="CalendarOutline" Width="14" Height="14"
                                      Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StartDateDisplayLabel}"
                               Classes.placeholder="{Binding !HasStartDate}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <mi:MaterialIcon Grid.Column="2" Kind="MenuDown" Width="15" Height="15"
                                      Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <Popup PlacementTarget="{Binding #StartDateTrigger}" Placement="BottomEdgeAlignedLeft"
                       VerticalOffset="6" IsLightDismissEnabled="True"
                       OverlayInputPassThroughElement="{Binding #StartDateTrigger}"
                       IsOpen="{Binding IsStartCalendarOpen, Mode=TwoWay}">
                  <Border Classes="calendar-popover" Width="290">
                    <StackPanel Spacing="14">

                      <!-- Mes + navegación -->
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Classes="icon-btn calendar-nav" Command="{Binding PreviousMonthCommand}"
                                ToolTip.Tip="{loc:Tr Kanban_Calendar_PrevMonthTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Calendar_PrevMonthTooltip}">
                          <mi:MaterialIcon Kind="ChevronLeft" Width="15" Height="15" />
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding CalendarMonthLabel}" Classes="eyebrow" FontSize="10.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="icon-btn calendar-nav" Command="{Binding NextMonthCommand}"
                                ToolTip.Tip="{loc:Tr Kanban_Calendar_NextMonthTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Calendar_NextMonthTooltip}">
                          <mi:MaterialIcon Kind="ChevronRight" Width="15" Height="15" />
                        </Button>
                      </Grid>

                      <!-- Cabecera de días de la semana (empieza en lunes) -->
                      <UniformGrid Columns="7">
                        <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdayMon, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                        <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdayTue, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                        <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdayWed, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                        <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdayThu, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                        <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdayFri, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                        <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdaySat, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                        <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdaySun, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                      </UniformGrid>

                      <!-- Rejilla de días (6 semanas fijas, ver KanbanCardEditorViewModel.RebuildCalendarDays) -->
                      <ItemsControl ItemsSource="{Binding CalendarDays}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                      <StackPanel Orientation="Horizontal" Spacing="18">
                        <Button Classes="ghost" Command="{Binding ClearStartDateCommand}" Content="{loc:Tr Kanban_DueDate_ClearButton, Converter={StaticResource UpperCaseConverter}}" />
                        <Button Classes="ghost" Command="{Binding SetStartDateTodayCommand}" Content="{loc:Tr Kanban_DueDate_TodayButton, Converter={StaticResource UpperCaseConverter}}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Popup>
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Kanban_Field_EndDateLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />

                <Button Name="DueDateTrigger" Classes="date-picker-trigger"
                        Command="{Binding ToggleCalendarCommand}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <mi:MaterialIcon Grid.Column="0" Kind="CalendarOutline" Width="14" Height="14"
                                      Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding DueDateDisplayLabel}"
                               Classes.placeholder="{Binding !HasDueDate}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <mi:MaterialIcon Grid.Column="2" Kind="MenuDown" Width="15" Height="15"
                                      Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <Popup PlacementTarget="{Binding #DueDateTrigger}" Placement="BottomEdgeAlignedLeft"
                       VerticalOffset="6" IsLightDismissEnabled="True"
                       OverlayInputPassThroughElement="{Binding #DueDateTrigger}"
                       IsOpen="{Binding IsCalendarOpen, Mode=TwoWay}">
                  <Border Classes="calendar-popover" Width="290">
                    <StackPanel Spacing="14">

                      <!-- Mes + navegación -->
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Classes="icon-btn calendar-nav" Command="{Binding PreviousMonthCommand}"
                                ToolTip.Tip="{loc:Tr Kanban_Calendar_PrevMonthTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Calendar_PrevMonthTooltip}">
                          <mi:MaterialIcon Kind="ChevronLeft" Width="15" Height="15" />
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding CalendarMonthLabel}" Classes="eyebrow" FontSize="10.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="icon-btn calendar-nav" Command="{Binding NextMonthCommand}"
                                ToolTip.Tip="{loc:Tr Kanban_Calendar_NextMonthTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Calendar_NextMonthTooltip}">
                          <mi:MaterialIcon Kind="ChevronRight" Width="15" Height="15" />
                        </Button>
                      </Grid>

                      <!-- Cabecera de días de la semana (empieza en lunes) -->
                      <UniformGrid Columns="7">
                        <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdayMon, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                        <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdayTue, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                        <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdayWed, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                        <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdayThu, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                        <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdayFri, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                        <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdaySat, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                        <TextBlock Text="{loc:Tr Kanban_Calendar_WeekdaySun, Converter={StaticResource UpperCaseConverter}}" Classes="faint calendar-weekday" />
                      </UniformGrid>

                      <!-- Rejilla de días (6 semanas fijas, ver KanbanCardEditorViewModel.RebuildCalendarDays) -->
                      <ItemsControl ItemsSource="{Binding CalendarDays}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>

                      <!-- Hora (opcional): la fecha por sí sola queda a medianoche local — activar esto
                           agrega hora/minuto encima sin reemplazar el día elegido (ver
                           KanbanCardEditorViewModel.CombinedDueDate). -->
                      <StackPanel Spacing="8" IsVisible="{Binding HasDueDate}">
                        <Rectangle Height="1" Fill="{DynamicResource Ink10}" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Calendar_AddTimeLabel, Converter={StaticResource UpperCaseConverter}}" FontSize="12" VerticalAlignment="Center" />
                          <ToggleSwitch Grid.Column="1" IsChecked="{Binding HasDueTime}" OnContent="" OffContent=""
                                        AutomationProperties.Name="{loc:Tr Kanban_Calendar_AddTimeLabel}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasDueTime}">
                          <Border Classes="time-stepper">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <Button Grid.Column="0" Classes="icon-btn time-stepper-btn"
                                      Command="{Binding DecrementDueHourCommand}" ToolTip.Tip="{loc:Tr Kanban_TimeStepper_SubtractHourTooltip}" AutomationProperties.Name="{loc:Tr Kanban_TimeStepper_SubtractHourTooltip}">
                                <mi:MaterialIcon Kind="Minus" Width="12" Height="12" />
                              </Button>
                              <TextBlock Grid.Column="1" Text="{Binding DueHour, StringFormat={}{0:00}}"
                                         Classes="time-stepper-value" />
                              <Button Grid.Column="2" Classes="icon-btn time-stepper-btn"
                                      Command="{Binding IncrementDueHourCommand}" ToolTip.Tip="{loc:Tr Kanban_TimeStepper_AddHourTooltip}" AutomationProperties.Name="{loc:Tr Kanban_TimeStepper_AddHourTooltip}">
                                <mi:MaterialIcon Kind="Plus" Width="12" Height="12" />
                              </Button>
                            </Grid>
                      </Border>
                          <TextBlock Text=":" FontWeight="Bold" VerticalAlignment="Center" />
                          <Border Classes="time-stepper">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <Button Grid.Column="0" Classes="icon-btn time-stepper-btn"
                                      Command="{Binding DecrementDueMinuteCommand}" ToolTip.Tip="{loc:Tr Kanban_TimeStepper_SubtractMinuteTooltip}" AutomationProperties.Name="{loc:Tr Kanban_TimeStepper_SubtractMinuteTooltip}">
                                <mi:MaterialIcon Kind="Minus" Width="12" Height="12" />
                              </Button>
                              <TextBlock Grid.Column="1" Text="{Binding DueMinute, StringFormat={}{0:00}}"
                                         Classes="time-stepper-value" />
                              <Button Grid.Column="2" Classes="icon-btn time-stepper-btn"
                                      Command="{Binding IncrementDueMinuteCommand}" ToolTip.Tip="{loc:Tr Kanban_TimeStepper_AddMinuteTooltip}" AutomationProperties.Name="{loc:Tr Kanban_TimeStepper_AddMinuteTooltip}">
                                <mi:MaterialIcon Kind="Plus" Width="12" Height="12" />
                              </Button>
                            </Grid>
                      </Border>
                        </StackPanel>
                      </StackPanel>

                      <!-- Duración / franja horaria (opcional, solo con hora activada): convierte el
                           punto "21:30" en un rango "21:30 – 22:15" que el calendario dibuja como bloque
                           en Semana/Día y que también se puede ajustar arrastrando el borde inferior de
                           ese bloque (ver CalendarView.axaml.cs, ResizeHandle_*). Mismos pasos de 5
                           minutos que el stepper de arriba y que la estimación de tiempo de Polar. -->
                      <StackPanel Spacing="8" IsVisible="{Binding HasDueTime}">
                        <Rectangle Height="1" Fill="{DynamicResource Ink10}" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_CardEditor_DurationToggleLabel, Converter={StaticResource UpperCaseConverter}}" FontSize="12" VerticalAlignment="Center" />
                          <ToggleSwitch Grid.Column="1" IsChecked="{Binding HasDuration}" OnContent="" OffContent="" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasDuration}">
                          <Border Classes="time-stepper">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <Button Grid.Column="0" Classes="icon-btn time-stepper-btn"
                                      Command="{Binding DecrementDurationCommand}" ToolTip.Tip="{loc:Tr Kanban_TimeStepper_Subtract5Tooltip}" AutomationProperties.Name="{loc:Tr Kanban_TimeStepper_Subtract5Tooltip}">
                                <mi:MaterialIcon Kind="Minus" Width="12" Height="12" />
                              </Button>
                              <TextBlock Grid.Column="1" Text="{Binding DurationMinutes}"
                                         Classes="time-stepper-value" />
                              <Button Grid.Column="2" Classes="icon-btn time-stepper-btn"
                                      Command="{Binding IncrementDurationCommand}" ToolTip.Tip="{loc:Tr Kanban_TimeStepper_Add5Tooltip}" AutomationProperties.Name="{loc:Tr Kanban_TimeStepper_Add5Tooltip}">
                                <mi:MaterialIcon Kind="Plus" Width="12" Height="12" />
                              </Button>
                            </Grid>
                      </Border>
                          <TextBlock Text="{loc:Tr Kanban_CardEditor_MinutesAbbr}" Classes="faint" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding DurationRangeLabel}" Classes="faint" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>

                      <!-- Accesos rápidos -->
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="1" Classes="ghost" Command="{Binding ClearDueDateCommand}"
                                Margin="0,0,18,0" IsVisible="{Binding HasDueDate}">
                          <TextBlock Text="{loc:Tr Kanban_DueDate_ClearButton, Converter={StaticResource UpperCaseConverter}}" />
                        </Button>
                        <Button Grid.Column="2" Classes="ghost" Command="{Binding SetDueDateTodayCommand}">
                          <TextBlock Text="{loc:Tr Kanban_DueDate_TodayButton, Converter={StaticResource UpperCaseConverter}}" />
                        </Button>
                      </Grid>

                    </StackPanel>
             </Border>
                </Popup>
              </StackPanel>

              <TextBlock Text="{loc:Tr Kanban_DateRange_Invalid}" IsVisible="{Binding HasInvalidDateRange}"
                         Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />

              <!-- Subtareas -->
              <StackPanel Spacing="8">
                <TextBlock Text="{loc:Tr Kanban_Field_SubtasksLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />

                <ItemsControl ItemsSource="{Binding Subtasks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Classes="search" Text="{Binding NewSubtaskTitle}"
                            Name="NewSubtaskBox" PlaceholderText="{loc:Tr Kanban_Subtask_AddPlaceholder}"
                            KeyDown="NewSubtaskBox_KeyDown" />
                  <Button Grid.Column="1" Classes="icon-btn" Width="34" Height="34" Margin="8,0,0,0"
                          Command="{Binding AddSubtaskCommand}" ToolTip.Tip="{loc:Tr Kanban_Subtask_AddTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Subtask_AddTooltip}">
                    <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                  </Button>
                </Grid>
              </StackPanel>

              <!-- Nota vinculada (enlace nota↔tarea, "Capa 1") -->
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Kanban_Field_LinkedNoteLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />

                <Grid ColumnDefinitions="*,Auto,Auto">
                  <Button Grid.Column="0" Name="LinkedNoteTrigger" Classes="date-picker-trigger"
                          Command="{Binding ToggleNotePickerCommand}">
                    <Grid ColumnDefinitions="Auto,*">
                      <mi:MaterialIcon Grid.Column="0" Kind="NoteTextOutline" Width="14" Height="14"
                                        Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding LinkedNoteDisplayLabel}"
                                 Classes.placeholder="{Binding !HasLinkedNote}"
                                 Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Button>
                  <Button Grid.Column="1" Classes="icon-btn" Width="34" Height="34" Margin="6,0,0,0"
                          Command="{Binding OpenLinkedNoteCommand}" IsVisible="{Binding HasLinkedNote}"
                          ToolTip.Tip="{loc:Tr Kanban_LinkedNote_ViewTooltip}" AutomationProperties.Name="{loc:Tr Kanban_LinkedNote_ViewTooltip}">
                    <mi:MaterialIcon Kind="OpenInNew" Width="15" Height="15" />
                  </Button>
                  <Button Grid.Column="2" Classes="icon-btn icon-btn-danger" Width="34" Height="34" Margin="6,0,0,0"
                          Command="{Binding ClearLinkedNoteCommand}" IsVisible="{Binding HasLinkedNote}"
                          ToolTip.Tip="{loc:Tr Kanban_LinkedNote_RemoveTooltip}" AutomationProperties.Name="{loc:Tr Kanban_LinkedNote_RemoveTooltip}">
                    <mi:MaterialIcon Kind="LinkVariantOff" Width="15" Height="15" />
                  </Button>
                </Grid>

                <Popup PlacementTarget="{Binding #LinkedNoteTrigger}" Placement="BottomEdgeAlignedLeft"
                       VerticalOffset="6" IsLightDismissEnabled="True"
                       OverlayInputPassThroughElement="{Binding #LinkedNoteTrigger}"
                       IsOpen="{Binding IsNotePickerOpen, Mode=TwoWay}">
                  <Border Classes="dropdown-popover" Width="320">
                    <StackPanel Spacing="10">
                      <TextBox Classes="search" Text="{Binding NotePickerSearchText}"
                                PlaceholderText="{loc:Tr Kanban_NotePicker_SearchPlaceholder}" />
                      <ScrollViewer MaxHeight="260">
                        <ItemsControl ItemsSource="{Binding NotePickerResults}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:NotePickerItemViewModel">
                              <Button Classes="dropdown-item"
                                      Command="{Binding $parent[ItemsControl].((vm:KanbanCardEditorViewModel)DataContext).SelectLinkedNoteCommand}"
                                      CommandParameter="{Binding}">
                                <StackPanel Spacing="1">
                                  <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding WorkspaceLabel}" Classes="faint" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <TextBlock Text="{loc:Tr Kanban_NotePicker_NoResults}" Classes="muted" FontSize="12.5"
                                 IsVisible="{Binding !NotePickerResults.Count}" />
                    </StackPanel>
             </Border>
                </Popup>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>

          <!-- Acciones -->
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,18,0,0">
            <Button Grid.Column="1" Classes="ghost modal-cancel"
                    Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).CancelCardEditorCommand}"
                    Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary"
                    Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).SaveCardEditorCommand}"
                    IsEnabled="{Binding CanSave}">
              <TextBlock Text="{Binding ConfirmLabel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </Grid>
    </Border>
  </controls:ModalOverlayHost>

    <!-- ===================== Diálogo: detalle de tarjeta (solo lectura, salvo subtareas) ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding CardDetail, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
              MaxWidth="480" MaxHeight="640" DataContext="{Binding CardDetail}" x:DataType="vm:KanbanCardDetailViewModel">
        <Grid RowDefinitions="Auto,*,Auto" MinWidth="420">

          <!-- Encabezado: prioridad + fecha límite, título, descripción -->
          <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,18">
            <Button Classes="ghost" Content="{loc:Tr Kanban_Multi_Move, Converter={StaticResource UpperCaseConverter}}"
                    IsVisible="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).MultipleBoardsEnabled}"
                    Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).MoveCardFromDetailCommand}" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Classes="priority-dot"
                         Classes.low="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Low}"
                         Classes.medium="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Medium}"
                         Classes.high="{Binding Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=High}" />
                <TextBlock Text="{Binding PriorityLabel, Converter={StaticResource UpperCaseConverter}}" Classes="faint" LetterSpacing="1" />
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                          IsVisible="{Binding HasDueDate}">
                <mi:MaterialIcon Kind="CalendarOutline" Width="11" Height="11" Classes.overdue="{Binding IsOverdue}"
                                  Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{Binding DueDateLabel}" Classes="faint" Classes.overdue="{Binding IsOverdue}" />
              </StackPanel>
            </Grid>

            <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" LetterSpacing="-0.3" TextWrapping="Wrap" />

            <!-- El diálogo se abre también desde el buzón de recordatorios y desde el calendario, donde no
                 hay ninguna columna alrededor que diga en qué estado está la tarjeta. -->
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasColumnTitle}">
              <mi:MaterialIcon Kind="ViewColumnOutline" Width="11" Height="11" Margin="0,1,0,0"
                                VerticalAlignment="Center" Foreground="{DynamicResource Ink40}" />
              <TextBlock Text="{Binding ColumnTitle, Converter={StaticResource UpperCaseConverter}}" Classes="faint"
                         LetterSpacing="1" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Archivada: el detalle se abre también desde la ventana de archivadas, desde el calendario y
                 desde la búsqueda global, donde nada alrededor dice que la tarjeta ya no está en el
                 tablero. La fecha de archivado va al lado porque es el dato que sitúa el "cuándo". -->
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsArchived}">
              <mi:MaterialIcon Kind="ArchiveOutline" Width="11" Height="11" Margin="0,1,0,0"
                                VerticalAlignment="Center" Foreground="{DynamicResource Ink40}" />
              <TextBlock Text="{loc:Tr Kanban_Archive_Badge, Converter={StaticResource UpperCaseConverter}}" Classes="faint"
                         LetterSpacing="1" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ArchivedAtLabel}" Classes="faint" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
            <StackPanel Spacing="18">

              <StackPanel Spacing="6" IsVisible="{Binding HasDescription}">
                <TextBlock Text="{loc:Tr Kanban_Field_DescriptionLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <TextBlock Text="{Binding Description}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding HasTags}">
                <TextBlock Text="{loc:Tr Kanban_Field_TagsReadonlyLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <TextBlock Text="{Binding TagsLabel}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding HasLinkedNote}">
                <TextBlock Text="{loc:Tr Kanban_Field_LinkedNoteLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <Button Classes="ghost" HorizontalAlignment="Left" Padding="0" Command="{Binding OpenLinkedNoteCommand}"
                        ToolTip.Tip="{Binding LinkedNoteTooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="{Binding LinkedNoteIcon}" Width="13" Height="13" Foreground="{DynamicResource Ink40}" />
                    <TextBlock Text="{Binding LinkedNoteLabel}" Classes="muted" FontSize="13" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <!-- Subtareas: la única parte interactiva del diálogo — solo se pueden marcar/desmarcar. -->
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Field_SubtasksLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                  <TextBlock Grid.Column="1" Text="{Binding SubtaskProgressLabel}" Classes="faint"
                             IsVisible="{Binding HasSubtasks}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Subtasks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:KanbanSubtaskItemViewModel">
                      <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                        <Button Grid.Column="0" Classes="icon-btn" Width="26" Height="26"
                                Command="{Binding ToggleCommand}" ToolTip.Tip="{loc:Tr Kanban_Subtask_ToggleTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Subtask_ToggleTooltip}">
                          <mi:MaterialIcon Kind="{Binding CheckIcon}" Width="15" Height="15" />
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                   Classes="subtask-title" Classes.done="{Binding IsDone}"
                                   TextWrapping="Wrap" FontSize="12.5" Margin="6,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{loc:Tr Kanban_Subtasks_EmptyLabel}" Classes="muted" FontSize="12.5"
                           IsVisible="{Binding !HasSubtasks}" />
              </StackPanel>

            </StackPanel>
          </ScrollViewer>

          <!-- Acciones. Editar y eliminar viven aquí de forma permanente porque en el tablero solo
               aparecen al pasar el ratón por la tarjeta: este diálogo, al que se llega con un clic o con
               Enter desde el teclado, es la vía que no depende del hover. Eliminar va a la izquierda y
               separado del par cerrar/editar, para que no se pulse por inercia. -->
          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,18,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
              <Button Classes="ghost" Padding="0" VerticalAlignment="Center"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).DeleteCardFromDetailCommand}"
                      ToolTip.Tip="{loc:Tr Kanban_Detail_DeleteTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Detail_DeleteTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <mi:MaterialIcon Kind="TrashCanOutline" Width="13" Height="13" VerticalAlignment="Center"
                                    Foreground="{DynamicResource DangerBrush}" />
                  <TextBlock Text="{loc:Tr Common_Delete, Converter={StaticResource UpperCaseConverter}}"
                             Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <!-- Archivar/desarchivar viven aquí por el mismo motivo que editar y eliminar: en el tablero
                   solo se llega a ellas con el clic derecho, y este diálogo es la vía que no depende de
                   ningún gesto oculto. Solo una de las dos puede verse a la vez. -->
              <Button Classes="ghost" Padding="0" VerticalAlignment="Center" IsVisible="{Binding CanArchive}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).ArchiveCardFromDetailCommand}"
                      ToolTip.Tip="{loc:Tr Kanban_Detail_ArchiveTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Detail_ArchiveTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <mi:MaterialIcon Kind="ArchiveArrowDownOutline" Width="13" Height="13" VerticalAlignment="Center"
                                    Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Kanban_Card_ArchiveMenu, Converter={StaticResource UpperCaseConverter}}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="ghost" Padding="0" VerticalAlignment="Center" IsVisible="{Binding IsArchived}"
                      Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).UnarchiveCardFromDetailCommand}"
                      ToolTip.Tip="{loc:Tr Kanban_Detail_UnarchiveTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Detail_UnarchiveTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <mi:MaterialIcon Kind="ArchiveArrowUpOutline" Width="13" Height="13" VerticalAlignment="Center"
                                    Foreground="{DynamicResource Ink40}" />
                  <TextBlock Text="{loc:Tr Kanban_Archive_UnarchiveMenu, Converter={StaticResource UpperCaseConverter}}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>

            <Button Grid.Column="2" Classes="ghost modal-cancel" Margin="0,0,18,0"
                    Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).CloseCardDetailCommand}">
              <TextBlock Text="{loc:Tr Common_Close, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="3" Classes="pill-primary"
                    Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).EditCardFromDetailCommand}"
                    ToolTip.Tip="{loc:Tr Kanban_Detail_EditTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Detail_EditTooltip}">
              <TextBlock Text="{loc:Tr Common_Edit, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </Grid>
    </Border>
  </controls:ModalOverlayHost>

    <!-- ===================== Ventana: tareas archivadas =====================
         docs/agent-docs/kanban-tareas-archivadas.md. Es un modal sobre el propio tablero y no una sección
         aparte: el archivo es el reverso del tablero, se entra a mirarlo y se vuelve, no es un sitio donde
         se trabaja. Por eso hereda su lenguaje —el mismo buscador con lupa y aspa, los mismos chips de
         filtro, el mismo desplegable de orden— en vez de inventarse una barra de herramientas propia.

         Los diálogos del tablero son excluyentes entre sí, así que abrir el detalle, el editor o la
         confirmación de borrado desde aquí cierra esta ventana y la vuelve a abrir al cerrarlos
         (KanbanViewModel._returnToArchive). -->
    <controls:ModalOverlayHost IsOpen="{Binding IsArchiveOpen}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
              MaxWidth="820" MaxHeight="760">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" MinWidth="680">

          <!-- Encabezado: el cierre queda junto al título para que la salida del archivo sea evidente,
               sin obligar a recorrer la lista hasta el pie. -->
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Text="{loc:Tr Kanban_Board_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
              <TextBlock Text="{loc:Tr Kanban_Archive_Title, Converter={StaticResource UpperCaseSpacedBulletConverter}}" Classes="page-title" />
              <TextBlock Text="{Binding ArchiveCountLabel}" Classes="page-subtitle" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="icon-btn" Width="34" Height="34" Margin="18,0,0,0"
                    VerticalAlignment="Top" Command="{Binding CloseArchiveCommand}"
                    ToolTip.Tip="{loc:Tr Common_Close}" AutomationProperties.Name="{loc:Tr Common_Close}">
              <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
            </Button>
          </Grid>

          <!-- Primera fila: la búsqueda es la acción principal; la ordenación, secundaria. Separarlas
               de los filtros evita que el buscador se comprima o quede tapado cuando caben tres chips. -->
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <Grid Grid.Column="0" MinWidth="260" Margin="0,0,10,0">
              <TextBox Classes="search" Name="ArchiveSearchBox" Height="34" Padding="34,0,32,0"
                       VerticalContentAlignment="Center"
                       Text="{Binding ArchiveSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="{loc:Tr Kanban_Archive_SearchPlaceholder}"
                       ToolTip.Tip="{loc:Tr Kanban_Archive_SearchTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Archive_SearchTooltip}" />
              <mi:MaterialIcon Classes="search-adornment" Kind="Magnify" />
              <Button Classes="icon-btn" Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,5,0"
                      IsVisible="{Binding ArchiveSearchText, Converter={x:Static baseconv:StringConverters.IsNotNullOrEmpty}}"
                      Command="{Binding ClearArchiveSearchCommand}"
                      ToolTip.Tip="{loc:Tr Kanban_Search_ClearTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Search_ClearTooltip}">
                <mi:MaterialIcon Kind="Close" Width="12" Height="12" />
              </Button>
            </Grid>

            <Panel Grid.Column="1">
              <Button Name="ArchiveSortTrigger" Classes="pill" Height="34" Command="{Binding ToggleArchiveSortMenuCommand}"
                      ToolTip.Tip="{loc:Tr Kanban_Sort_MenuTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Sort_MenuTooltip}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="SortVariant" Width="14" Height="14" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ArchiveSortModeLabel, Converter={StaticResource UpperCaseConverter}}" VerticalAlignment="Center" />
                  <mi:MaterialIcon Kind="MenuDown" Width="14" Height="14" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Popup PlacementTarget="{Binding #ArchiveSortTrigger}" Placement="BottomEdgeAlignedRight"
                     VerticalOffset="6" IsLightDismissEnabled="True"
                     OverlayInputPassThroughElement="{Binding #ArchiveSortTrigger}"
                     IsOpen="{Binding IsArchiveSortMenuOpen, Mode=TwoWay}">
                <Border Classes="dropdown-popover" Width="250">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{loc:Tr Kanban_Sort_ButtonLabel, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Margin="0,0,0,10" />

                    <Button Classes="dropdown-item" Command="{Binding SetArchiveSortModeCommand}"
                            CommandParameter="{x:Static vm:KanbanArchiveSortMode.ArchivedDate}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Archive_Sort_Archived, Converter={StaticResource UpperCaseConverter}}"
                                   FontSize="11.5" FontWeight="Bold" LetterSpacing="1.2" VerticalAlignment="Center" />
                        <mi:MaterialIcon Grid.Column="1" Kind="Check" Width="14" Height="14" VerticalAlignment="Center"
                                          IsVisible="{Binding ArchiveSortMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=ArchivedDate}" />
                      </Grid>
                    </Button>

                    <Button Classes="dropdown-item" Command="{Binding SetArchiveSortModeCommand}"
                            CommandParameter="{x:Static vm:KanbanArchiveSortMode.DueDate}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Sort_DueDate, Converter={StaticResource UpperCaseConverter}}"
                                   FontSize="11.5" FontWeight="Bold" LetterSpacing="1.2" VerticalAlignment="Center" />
                        <mi:MaterialIcon Grid.Column="1" Kind="Check" Width="14" Height="14" VerticalAlignment="Center"
                                          IsVisible="{Binding ArchiveSortMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=DueDate}" />
                      </Grid>
                    </Button>

                    <Button Classes="dropdown-item" Command="{Binding SetArchiveSortModeCommand}"
                            CommandParameter="{x:Static vm:KanbanArchiveSortMode.Priority}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Sort_Priority, Converter={StaticResource UpperCaseConverter}}"
                                   FontSize="11.5" FontWeight="Bold" LetterSpacing="1.2" VerticalAlignment="Center" />
                        <mi:MaterialIcon Grid.Column="1" Kind="Check" Width="14" Height="14" VerticalAlignment="Center"
                                          IsVisible="{Binding ArchiveSortMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Priority}" />
                      </Grid>
                    </Button>

                    <Button Classes="dropdown-item" Command="{Binding SetArchiveSortModeCommand}"
                            CommandParameter="{x:Static vm:KanbanArchiveSortMode.Title}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Archive_Sort_Title, Converter={StaticResource UpperCaseConverter}}"
                                   FontSize="11.5" FontWeight="Bold" LetterSpacing="1.2" VerticalAlignment="Center" />
                        <mi:MaterialIcon Grid.Column="1" Kind="Check" Width="14" Height="14" VerticalAlignment="Center"
                                          IsVisible="{Binding ArchiveSortMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Title}" />
                      </Grid>
                    </Button>
                  </StackPanel>
                </Border>
              </Popup>
            </Panel>
          </Grid>

          <!-- Segunda fila: los filtros forman un grupo propio, con rótulo para que no parezcan tres
               botones de acción. Mantiene el ancho de la ventana estable incluso con los tres visibles. -->
          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,14,0">
              <mi:MaterialIcon Kind="FlagVariantOutline" Width="13" Height="13" Foreground="{DynamicResource Ink40}" />
              <TextBlock Text="{loc:Tr Kanban_Field_PriorityLabel, Converter={StaticResource UpperCaseConverter}}"
                         Classes="eyebrow" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Prioridad: tres chips que se apagan volviendo a pulsar el que ya estaba puesto, igual
                 que los filtros rápidos del tablero. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <ToggleButton Classes="tag-chip toolbar-chip"
                            IsChecked="{Binding ArchivePriorityFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=High, Mode=OneWay}"
                            Command="{Binding ToggleArchivePriorityFilterCommand}"
                            CommandParameter="{x:Static models:KanbanPriority.High}">
                <TextBlock Text="{loc:Tr Kanban_Priority_High, Converter={StaticResource UpperCaseConverter}}" VerticalAlignment="Center" />
              </ToggleButton>
              <ToggleButton Classes="tag-chip toolbar-chip"
                            IsChecked="{Binding ArchivePriorityFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Medium, Mode=OneWay}"
                            Command="{Binding ToggleArchivePriorityFilterCommand}"
                            CommandParameter="{x:Static models:KanbanPriority.Medium}">
                <TextBlock Text="{loc:Tr Kanban_Priority_Medium, Converter={StaticResource UpperCaseConverter}}" VerticalAlignment="Center" />
              </ToggleButton>
              <ToggleButton Classes="tag-chip toolbar-chip"
                            IsChecked="{Binding ArchivePriorityFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Low, Mode=OneWay}"
                            Command="{Binding ToggleArchivePriorityFilterCommand}"
                            CommandParameter="{x:Static models:KanbanPriority.Low}">
                <TextBlock Text="{loc:Tr Kanban_Priority_Low, Converter={StaticResource UpperCaseConverter}}" VerticalAlignment="Center" />
              </ToggleButton>
            </StackPanel>

            <Button Grid.Column="2" Classes="ghost" Height="34" Margin="12,0,0,0" VerticalAlignment="Center"
                    IsVisible="{Binding HasActiveArchiveFilters}" Command="{Binding ClearArchiveFiltersCommand}"
                    ToolTip.Tip="{loc:Tr Kanban_Filter_ClearTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Filter_ClearTooltip}">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <mi:MaterialIcon Kind="FilterRemoveOutline" Width="13" Height="13" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Tr Kanban_Filter_ClearButton, Converter={StaticResource UpperCaseConverter}}"
                           FontSize="11" FontWeight="Bold" LetterSpacing="1.5" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Etiquetas: una franja propia deja claro que estos chips se suman a la prioridad, no son
               otra variante de ella. Solo se muestran las que existen entre lo archivado. -->
          <Border Grid.Row="3" BorderBrush="{DynamicResource Ink10}" BorderThickness="0,1,0,0"
                  Padding="0,12,0,2" IsVisible="{Binding ArchiveTagFilter.IsEmpty, Converter={x:Static baseconv:BoolConverters.Not}}">
            <Grid ColumnDefinitions="Auto,*">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Top" Margin="0,7,14,0">
                <mi:MaterialIcon Kind="TagOutline" Width="13" Height="13" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Kanban_Field_TagsReadonlyLabel, Converter={StaticResource UpperCaseConverter}}"
                           Classes="eyebrow" VerticalAlignment="Center" />
              </StackPanel>
              <views:TagFilterView Grid.Column="1" DataContext="{Binding ArchiveTagFilter}" />
            </Grid>
          </Border>

          <!-- Lista -->
          <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding FilteredArchivedCards}" ItemTemplate="{StaticResource KanbanArchivedCardTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <!-- Los dos huecos posibles se nombran distinto, igual que en las columnas del tablero: no
                   hay nada archivado, o sí lo hay pero el filtro lo esconde todo. -->
              <Border Classes="board-hint" IsVisible="{Binding IsArchiveEmpty}">
                <TextBlock Text="{loc:Tr Kanban_Archive_EmptyHint}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
              </Border>

              <Border Classes="board-hint" IsVisible="{Binding HasNoArchiveMatches}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Archive_NoMatches}" Classes="muted" FontSize="12.5"
                             TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost" Margin="14,0,0,0" VerticalAlignment="Center"
                          Command="{Binding ClearArchiveFiltersCommand}"
                          ToolTip.Tip="{loc:Tr Kanban_Filter_ClearTooltip}" AutomationProperties.Name="{loc:Tr Kanban_Filter_ClearTooltip}">
                    <TextBlock Text="{loc:Tr Kanban_Filter_ClearButton, Converter={StaticResource UpperCaseConverter}}"
                               FontSize="11" FontWeight="Bold" LetterSpacing="1.5" />
                  </Button>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Pie: la ayuda dice cómo se opera sobre una fila, porque el menú contextual es la única vía
               que no se ve hasta que se prueba. -->
          <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
            <TextBlock Grid.Column="0" Text="{loc:Tr Kanban_Archive_ActionsHint}" Classes="faint"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0" />
            <Button Grid.Column="1" Classes="pill-primary" Command="{Binding CloseArchiveCommand}">
              <TextBlock Text="{loc:Tr Common_Close, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </Grid>
    </Border>
  </controls:ModalOverlayHost>

    <!-- ===================== Diálogo: archivar todas las completadas ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding IsArchiveAllPending}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="ArchiveArrowDownOutline" Width="18" Height="18" Foreground="{DynamicResource Ink40}" />
            <TextBlock Text="{loc:Tr Kanban_ArchiveAll_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{Binding ArchiveAllMessage}" FontSize="14" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Tr Kanban_ArchiveAll_Hint}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel"
                    Command="{Binding CancelArchiveAllDoneCommand}" Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary" Command="{Binding ConfirmArchiveAllDoneCommand}">
              <TextBlock Text="{loc:Tr Kanban_Card_ArchiveMenu, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
    </Border>
  </controls:ModalOverlayHost>

    <!-- ===================== Diálogo: eliminar tarjeta (§7.10) ===================== -->
    <controls:ModalOverlayHost IsOpen="{Binding CardPendingDelete, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
              DataContext="{Binding CardPendingDelete}" x:DataType="vm:KanbanCardViewModel">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{loc:Tr Kanban_DeleteCard_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Kanban_DeleteCard_Message}" FontSize="14"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Title}" Classes="muted" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel"
                    Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).CancelDeleteCardCommand}"
                    Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary-danger"
                    Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).ConfirmDeleteCardCommand}">
              <TextBlock Text="{loc:Tr Common_Delete, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
    </Border>
  </controls:ModalOverlayHost>

    <!-- ===================== Diálogo: eliminar columna (Fase 3, docs/analisis-proyecto/roadmap.md) =====================
         Misma estructura que el de tarjeta; el mensaje (con el recuento de tarjetas pluralizado) viene
         calculado del viewmodel porque el orden de palabras no es fijo entre idiomas. -->
    <controls:ModalOverlayHost IsOpen="{Binding ColumnPendingDelete, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center"
              DataContext="{Binding ColumnPendingDelete}" x:DataType="vm:KanbanColumnViewModel">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{loc:Tr Kanban_DeleteColumn_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).PendingDeleteColumnMessage}" FontSize="14"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Title, Converter={StaticResource UpperCaseConverter}}" Classes="muted"
                       FontWeight="Bold" FontSize="13" LetterSpacing="1.2" TextWrapping="Wrap" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel"
                    Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).CancelDeleteColumnCommand}"
                    Margin="0,0,18,0">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary-danger"
                    Command="{Binding $parent[UserControl].((vm:KanbanViewModel)DataContext).ConfirmDeleteColumnCommand}">
              <TextBlock Text="{loc:Tr Common_Delete, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
    </Border>
  </controls:ModalOverlayHost>

    <controls:ModalOverlayHost IsOpen="{Binding IsBoardNameEditorOpen}">
      <Border Classes="modal-card" Width="440" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{loc:Tr Kanban_Multi_Name}" TextWrapping="Wrap" />
          <TextBox x:Name="BoardNameBox" Text="{Binding BoardNameDraft}" MaxLength="80" AutomationProperties.Name="{loc:Tr Kanban_Multi_Name}" />
          <TextBlock Text="{Binding BoardError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
          <WrapPanel HorizontalAlignment="Right">
            <Button Classes="ghost modal-cancel" Margin="8,0,0,0" Content="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" Command="{Binding CancelBoardNameEditorCommand}" />
            <Button Classes="pill-primary" Margin="8,0,0,0" Content="{loc:Tr Common_Save, Converter={StaticResource UpperCaseConverter}}" Command="{Binding SaveBoardNameCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>
    <controls:ModalOverlayHost IsOpen="{Binding IsBoardDeletePending}">
      <Border Classes="modal-card" Width="440" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{loc:Tr Kanban_Multi_DeleteConfirm}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding BoardName}" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Text="{loc:Tr Kanban_Multi_CannotDelete}" TextWrapping="Wrap" IsVisible="{Binding !CanDeleteCurrentBoard}" />
          <TextBlock Text="{Binding BoardError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
          <WrapPanel HorizontalAlignment="Right">
            <Button Classes="ghost modal-cancel" Margin="8,0,0,0" Content="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" Command="{Binding CancelDeleteBoardCommand}" />
            <Button Classes="pill-primary-danger" Margin="8,0,0,0" Content="{loc:Tr Common_Delete, Converter={StaticResource UpperCaseConverter}}" Command="{Binding DeleteBoardCommand}" IsEnabled="{Binding CanDeleteCurrentBoard}"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>
    <controls:ModalOverlayHost IsOpen="{Binding IsMoveCardOpen}">
      <Border Classes="modal-card" Width="440" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{loc:Tr Kanban_Multi_Move}" TextWrapping="Wrap" />
          <ComboBox ItemsSource="{Binding MoveBoards}" SelectedItem="{Binding MoveTargetBoard}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Tr Kanban_Multi_Boards}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="models:KanbanBoard">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox ItemsSource="{Binding MoveColumns}" SelectedItem="{Binding MoveTargetColumn}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Tr Kanban_Multi_Column}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="models:KanbanColumn">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{loc:Tr Kanban_Multi_Unarchive}" IsVisible="{Binding MoveWillUnarchive}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding BoardError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
          <WrapPanel HorizontalAlignment="Right">
            <Button Classes="ghost modal-cancel" Margin="8,0,0,0" Content="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" Command="{Binding CancelMoveCardCommand}" />
            <Button Classes="pill-primary" Margin="8,0,0,0" Content="{loc:Tr Kanban_Multi_Move, Converter={StaticResource UpperCaseConverter}}" Command="{Binding ConfirmMoveCardCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>
    <controls:ModalOverlayHost IsOpen="{Binding IsBoardSwitchPending}">
      <Border Classes="modal-card" Width="440" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{loc:Tr Kanban_Multi_Unsaved}" TextWrapping="Wrap" />
          <WrapPanel HorizontalAlignment="Right">
            <Button Classes="ghost modal-cancel" Margin="8,0,0,0" Content="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" Command="{Binding CancelBoardSwitchCommand}" />
            <Button Classes="pill-primary" Margin="8,0,0,0" Content="{loc:Tr Kanban_Multi_Discard, Converter={StaticResource UpperCaseConverter}}" Command="{Binding DiscardAndSwitchBoardCommand}" />
            <Button Classes="pill-primary" Margin="8,0,0,0" Content="{loc:Tr Common_Save, Converter={StaticResource UpperCaseConverter}}" Command="{Binding SaveAndSwitchBoardCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>
  </Grid>
</UserControl>
