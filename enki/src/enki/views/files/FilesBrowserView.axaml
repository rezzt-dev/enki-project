<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:views="clr-namespace:enki.Views"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="enki.Views.FilesBrowserView"
             x:Name="Root"
             x:DataType="vm:FilesViewModel">

  <!-- Modo "explorador" de la sección Archivos, la disposición de siempre: encabezado, barra de
       herramientas (importar, sesión, filtro por tipo, búsqueda, contador y conmutador de navegación),
       panel de carpetas a la izquierda y rejilla de tarjetas a la derecha. Abrir un archivo sustituye la
       pantalla entera por la previsualización compartida (FilePreviewView).

       El DataContext es el mismo FilesViewModel que usa el modo árbol: cambiar de modo no reinicia nada. -->

  <UserControl.DataTemplates>
    <!-- Misma plantilla recursiva que NotesView.axaml, apuntando a FileFolderViewModel. -->
    <DataTemplate DataType="vm:FileFolderViewModel">
      <StackPanel>
        <Border Classes="folder-row" Classes.active="{Binding IsSelected}" Classes.drag-over="{Binding IsDropTarget}"
                Padding="{Binding Depth, Converter={StaticResource DepthIndentConverter}}"
                DragDrop.AllowDrop="True"
                PointerPressed="FolderRow_PointerPressed"
                DragDrop.DragEnter="FolderRow_DragEnter"
                DragDrop.DragOver="FolderRow_DragOver"
                DragDrop.DragLeave="FolderRow_DragLeave"
                DragDrop.Drop="FolderRow_Drop">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{loc:Tr Files_RenameAction}" Command="{Binding BeginRenameCommand}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="PencilOutline" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{loc:Tr Files_CreateSubfolderMenuItem}"
                        Command="{Binding $parent[UserControl].((vm:FilesViewModel)DataContext).CreateSubfolderCommand}"
                        CommandParameter="{Binding}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="FolderPlusOutline" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{loc:Tr Common_Delete}"
                        Command="{Binding $parent[UserControl].((vm:FilesViewModel)DataContext).DeleteFolderCommand}"
                        CommandParameter="{Binding}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </Border.ContextMenu>
          <Grid ColumnDefinitions="20,Auto,*,Auto,Auto" Height="34">
            <Button Grid.Column="0" Classes="icon-btn" Width="20" Height="20"
                    IsVisible="{Binding Children.Count, Converter={StaticResource CountToBoolConverter}}"
                    Command="{Binding ToggleExpandCommand}"
                    AutomationProperties.Name="{loc:Tr A11y_Files_ToggleFolder}">
              <mi:MaterialIcon Kind="{Binding IsExpanded, Converter={StaticResource ExpandChevronConverter}}"
                                Width="16" Height="16" />
            </Button>
            <mi:MaterialIcon Grid.Column="1" Kind="FolderOutline" Width="15" Height="15" Margin="2,0,8,0"
                              Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13.5"
                       TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsRenaming}" />
            <TextBox Grid.Column="2" Text="{Binding EditingName}" IsVisible="{Binding IsRenaming}"
                      AutomationProperties.Name="{loc:Tr A11y_Files_FolderNameField}"
                      VerticalAlignment="Center" FontSize="13.5" Padding="4,2"
                      KeyDown="FolderNameEdit_KeyDown" LostFocus="FolderNameEdit_LostFocus"
                      Initialized="FolderNameEdit_Initialized"
                      PropertyChanged="FolderNameEdit_PropertyChanged" />
            <Button Grid.Column="3" Classes="icon-btn" Width="20" Height="20" Command="{Binding BeginRenameCommand}"
                    ToolTip.Tip="{loc:Tr Files_RenameAction}" AutomationProperties.Name="{loc:Tr Files_RenameAction}">
              <mi:MaterialIcon Kind="FolderEditOutline" Width="14" Height="14" />
            </Button>
            <Button Grid.Column="4" Classes="icon-btn icon-btn-danger" Width="20" Height="20"
                    Command="{Binding $parent[UserControl].((vm:FilesViewModel)DataContext).DeleteFolderCommand}"
                    CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Files_DeleteFolderTooltip}" AutomationProperties.Name="{loc:Tr Files_DeleteFolderTooltip}">
              <mi:MaterialIcon Kind="FolderRemoveOutline" Width="14" Height="14" />
            </Button>
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding IsExpanded}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:FileFolderCardViewModel">
      <Button Classes="file-card" Margin="0,0,16,16" Width="180" Height="180"
              Command="{Binding $parent[ItemsControl].((vm:FilesViewModel)DataContext).OpenFolderCardCommand}"
              CommandParameter="{Binding}">
        <Grid RowDefinitions="*,Auto">
          <mi:MaterialIcon Grid.Row="0" Kind="FolderOutline" Width="48" Height="48"
                            Foreground="{DynamicResource Ink40}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="Bold" FontSize="13" LetterSpacing="0.2"
                     TextTrimming="CharacterEllipsis" MaxLines="1" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid>

    <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding ActivePreview, Converter={x:Static conv:ObjectConverters.IsNull}}">

      <StackPanel Grid.Row="0" Spacing="6" Margin="36,30,36,20">
        <TextBlock Text="{loc:Tr Files_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
        <TextBlock Text="{loc:Tr Files_PageTitle, Converter={StaticResource UpperCaseConverter}}" Classes="page-title" />
        <TextBlock Text="{loc:Tr Files_PageSubtitle}"
                   Classes="page-subtitle" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="36,0,36,18">
        <Button Grid.Column="0" Classes="pill" Height="36" Command="{Binding ImportCommand}" Margin="0,0,14,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="TrayArrowDown" Width="15" Height="15" />
            <TextBlock Text="{loc:Tr Files_ImportButton, Converter={StaticResource UpperCaseConverter}}" />
          </StackPanel>
        </Button>

        <!-- Workspace selector: mismas sesiones que ya ve Notas — un archivo soltado en la sesión "X" es
             visible desde Notas y Archivos sin ningún concepto nuevo (docs/seccion-archivos.md §5). -->
        <ComboBox Grid.Column="1" Height="36" Margin="0,0,14,0" MinWidth="190"
                  ItemsSource="{Binding SessionOptions}" SelectedItem="{Binding SelectedSessionOption}"
                  AutomationProperties.Name="{loc:Tr A11y_Files_SessionSelector}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:SessionOptionViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="{Binding IsVault, Converter={StaticResource SessionIconConverter}}"
                                  Width="13" Height="13" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{Binding DisplayName}" FontSize="12" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Filtro por tipo de archivo: extensión — mismo tratamiento visual que el selector de sesión. -->
        <ComboBox Grid.Column="2" Height="36" Margin="0,0,14,0" MinWidth="150"
                  ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilterOption}"
                  AutomationProperties.Name="{loc:Tr A11y_Files_FilterSelector}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:FileKindFilterOption">
              <TextBlock Text="{Binding Label}" FontSize="12" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBox Grid.Column="3" Classes="search" Height="36" PlaceholderText="{loc:Tr Files_SearchPlaceholder}" AutomationProperties.Name="{loc:Tr Files_SearchPlaceholder}" Text="{Binding SearchText}"
                  MaxWidth="360" HorizontalAlignment="Left" VerticalAlignment="Center">
          <TextBox.InnerLeftContent>
            <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"
                    Margin="10,0,0,0" />
          </TextBox.InnerLeftContent>
        </TextBox>

        <Border Grid.Column="4" Classes="card" Padding="14,9" VerticalAlignment="Center">
          <TextBlock Text="{Binding FilesCountLabel}" Classes="faint" FontSize="10.5" />
        </Border>

        <!-- Conmutador de navegación: explorador (esta vista) o árbol. Vive aquí, en la sección, y no en
             Ajustes, porque es una decisión de *cómo navegar* que se toma mientras se navega y cuyo efecto
             se ve al instante — mismo criterio que el de IA Skills. -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    Margin="14,0,0,0" ToolTip.Tip="{loc:Tr Files_Nav_Tooltip}">
          <Button Classes="icon-btn active" Width="34" Height="34"
                  Command="{Binding ShowBrowserViewCommand}"
                  ToolTip.Tip="{loc:Tr Files_Nav_Browser}"
                  AutomationProperties.Name="{loc:Tr Files_Nav_Browser}">
            <mi:MaterialIcon Kind="ViewGridOutline" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Width="34" Height="34"
                  Command="{Binding ShowTreeViewCommand}"
                  ToolTip.Tip="{loc:Tr Files_Nav_Tree}"
                  AutomationProperties.Name="{loc:Tr Files_Nav_Tree}">
            <mi:MaterialIcon Kind="FileTreeOutline" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" Margin="24,0,24,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260" MinWidth="180" MaxWidth="480" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Panel de carpetas ===================== -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource Ink10}" BorderThickness="1,1,0,1"
                Background="{DynamicResource AppBackgroundAltBrush}" Padding="10,12">
          <Grid RowDefinitions="Auto,Auto,*">

            <Button Grid.Row="0" Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="10,8" Margin="0,0,0,12" Command="{Binding NewFolderCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="FolderPlusOutline" Width="13" Height="13" />
                <TextBlock Text="{loc:Tr Files_NewFolderButton, Converter={StaticResource UpperCaseConverter}}" FontSize="11" />
              </StackPanel>
            </Button>

            <Border Grid.Row="1" Classes="folder-row" Margin="0,0,0,4"
                    Classes.active="{Binding CurrentFolder, Converter={x:Static conv:ObjectConverters.IsNull}}"
                    Classes.drag-over="{Binding IsRootDropTarget}"
                    DragDrop.AllowDrop="True"
                    PointerPressed="RootFolderRow_PointerPressed"
                    DragDrop.DragEnter="RootFolderRow_DragEnter"
                    DragDrop.DragOver="RootFolderRow_DragOver"
                    DragDrop.DragLeave="RootFolderRow_DragLeave"
                    DragDrop.Drop="RootFolderRow_Drop">
              <StackPanel Orientation="Horizontal" Spacing="8" Height="34" VerticalAlignment="Center" Margin="14,0,0,0">
                <mi:MaterialIcon Kind="ViewGridOutline" Width="15" Height="15" Foreground="{DynamicResource Ink40}" />
                <TextBlock Text="{loc:Tr Files_AllFolder}" FontSize="13.5" VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2">
              <ItemsControl ItemsSource="{Binding RootFolders}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Column="1" Width="1" HorizontalAlignment="Center"
                Background="{DynamicResource Ink10}" IsHitTestVisible="False" />
        <GridSplitter Grid.Column="1" Classes="folder-panel-splitter" Width="7"
                      Background="Transparent" ResizeDirection="Columns"
                      AutomationProperties.Name="{loc:Tr A11y_Files_FolderPanelSplitter}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- ===================== Rejilla de archivos ===================== -->
        <!-- Objetivo del arrastre-y-soltar desde el explorador del SO (docs/seccion-archivos.md §5/§7):
             DragDrop.AllowDrop + los cuatro handlers, resueltos vía e.DataTransfer.TryGetFiles(). -->
        <Border Grid.Column="2" ClipToBounds="True" Classes="files-grid-panel"
                Classes.drag-over="{Binding IsGridDropTarget}"
                BorderBrush="{DynamicResource Ink10}" BorderThickness="1"
                Background="{DynamicResource AppBackgroundAltBrush}"
                DragDrop.AllowDrop="True"
                DragDrop.DragEnter="FilesGrid_DragEnter"
                DragDrop.DragOver="FilesGrid_DragOver"
                DragDrop.DragLeave="FilesGrid_DragLeave"
                DragDrop.Drop="FilesGrid_Drop">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{loc:Tr Files_ImportButton}" Command="{Binding ImportCommand}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="TrayArrowDown" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{loc:Tr Files_NewFolderButton}" Command="{Binding NewFolderCommand}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="FolderPlusOutline" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </Border.ContextMenu>
          <Grid RowDefinitions="Auto,*">

            <TextBlock Grid.Row="0" Text="{Binding CurrentFolderLabel}"
                       Classes="eyebrow" Margin="24,16,24,0" />

            <Grid Grid.Row="1">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding BrowserItems}" Margin="24">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:FileCardViewModel">
                      <Button Classes="file-card" Margin="0,0,16,16" Width="180" Height="180"
                              Command="{Binding $parent[ItemsControl].((vm:FilesViewModel)DataContext).OpenCardCommand}"
                              CommandParameter="{Binding}" AutomationProperties.Name="{Binding FileName}"
                              Initialized="FileCard_Initialized">
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="{loc:Tr Files_RenameAction}" Command="{Binding BeginRenameCommand}">
                              <MenuItem.Icon>
                                <mi:MaterialIcon Kind="PencilOutline" Width="14" Height="14" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Tr Files_RevealInSystemMenuItem}" Command="{Binding RevealInSystemCommand}">
                              <MenuItem.Icon>
                                <mi:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Tr Files_OpenWithSystemMenuItem}"
                                      Command="{Binding #Root.((vm:FilesViewModel)DataContext).OpenWithSystemCommand}"
                                      CommandParameter="{Binding}">
                              <MenuItem.Icon>
                                <mi:MaterialIcon Kind="OpenInNew" Width="14" Height="14" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Tr Common_Delete}"
                                      Command="{Binding #Root.((vm:FilesViewModel)DataContext).RequestDeleteFileCommand}"
                                      CommandParameter="{Binding}">
                              <MenuItem.Icon>
                                <mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" />
                              </MenuItem.Icon>
                            </MenuItem>
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Grid RowDefinitions="*,Auto,Auto">
                          <!-- Thumbnail decodificado (imágenes) o icono fijo por tipo (PDF/otros) —
                               ver FileCardViewModel.EnsureThumbnailLoaded. -->
                          <Panel Grid.Row="0" Margin="0,0,0,10">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                   IsVisible="{Binding Thumbnail, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                            <mi:MaterialIcon Kind="{Binding IconKind}" Width="40" Height="40"
                                              Foreground="{DynamicResource Ink40}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsVisible="{Binding Thumbnail, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                          </Panel>
                          <TextBlock Grid.Row="1" Text="{Binding FileName}"
                                     FontWeight="Bold" FontSize="13" LetterSpacing="0.2"
                                     TextTrimming="CharacterEllipsis" MaxLines="1"
                                     IsVisible="{Binding !IsRenaming}" />
                          <TextBox Grid.Row="1" Text="{Binding EditingName}" IsVisible="{Binding IsRenaming}"
                                    AutomationProperties.Name="{loc:Tr A11y_Files_FileNameField}"
                                    FontSize="12.5" Padding="4,2"
                                    KeyDown="FileNameEdit_KeyDown" LostFocus="FileNameEdit_LostFocus"
                                    Initialized="FileNameEdit_Initialized"
                                    PropertyChanged="FileNameEdit_PropertyChanged" />
                          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <TextBlock Text="{Binding SizeLabel}" Classes="faint" />
                            <TextBlock Text="·" Classes="faint" />
                            <TextBlock Text="{Binding ModifiedLabel}" Classes="faint" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <StackPanel IsVisible="{Binding ShowEmptyState}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Spacing="12">
                <mi:MaterialIcon Kind="FileOutline" Width="40" Height="40" Foreground="{DynamicResource TextMutedBrush}"
                        HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr Files_EmptyTitle}" Classes="muted" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr Files_EmptyHint}" Classes="faint"
                           HorizontalAlignment="Center" />
              </StackPanel>

              <!-- Sesión protegida y bloqueada: ni siquiera los nombres de los adjuntos se listan (§6,
                   "Sesiones protegidas con contraseña") — hay que desbloquearla desde Sesiones primero. -->
              <StackPanel IsVisible="{Binding IsSelectedSessionLocked}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Spacing="12" MaxWidth="280">
                <mi:MaterialIcon Kind="LockOutline" Width="40" Height="40" Foreground="{DynamicResource TextMutedBrush}"
                        HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr Files_LockedSession_Message}" Classes="muted" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Previsualización a pantalla completa: sustituye a la rejilla en vez de acompañarla, porque en esta
         disposición no hay un panel derecho donde alojarla. -->
    <views:FilePreviewView IsVisible="{Binding ActivePreview, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
  </Grid>
</UserControl>
