<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:loc="clr-namespace:enki.Localization"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="enki.Views.FilePreviewView"
             x:Name="PreviewRoot"
             x:DataType="vm:FilesViewModel"
             Focusable="True"
             FocusAdorner="{x:Null}">

  <!-- Previsualización del archivo abierto (ActivePreview), compartida por las dos disposiciones de la
       sección: en el modo explorador ocupa la pantalla entera en lugar de la rejilla, y en el modo árbol
       ocupa el panel derecho con el árbol intacto al lado. Su DataContext es el FilesViewModel de la
       sección, no la tarjeta: los comandos de la barra (cerrar, anterior/siguiente, abrir con el sistema,
       borrar) son de la sección, y colgar del viewmodel de sección es lo que permite montarla tal cual desde
       las dos disposiciones sin reencaminar bindings.

       Deliberadamente sin tira de pestañas (docs/agent-docs/seccion-archivos.md §4): abrir un archivo
       sustituye esta previsualización única en vez de acumular varias — los archivos se visualizan, no se
       editan, así que no hay "trabajo en curso" que perder al cambiar de uno a otro. Para repasar una carpeta
       están anterior/siguiente.

       Extraída a un control propio justo porque se monta una sola vez: instala TextMate sobre un
       AvaloniaEdit y rasteriza PDFs con PDFium, y tener dos vivas a la vez duplicaría ambas cosas. -->

  <!-- Atajos. Los del PDF no tienen efecto con otro tipo de archivo, porque PdfDocument es null y Avalonia trata
       un Command nulo como deshabilitado. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding ClosePreviewCommand}" />
    <KeyBinding Gesture="Alt+Left" Command="{Binding PreviewPreviousCommand}" />
    <KeyBinding Gesture="Alt+Right" Command="{Binding PreviewNextCommand}" />
    <KeyBinding Gesture="Left" Command="{Binding ActivePreview.PdfDocument.PreviousPageCommand}" />
    <KeyBinding Gesture="Right" Command="{Binding ActivePreview.PdfDocument.NextPageCommand}" />
    <KeyBinding Gesture="PageUp" Command="{Binding ActivePreview.PdfDocument.PreviousPageCommand}" />
    <KeyBinding Gesture="PageDown" Command="{Binding ActivePreview.PdfDocument.NextPageCommand}" />
    <KeyBinding Gesture="Home" Command="{Binding ActivePreview.PdfDocument.FirstPageCommand}" />
    <KeyBinding Gesture="End" Command="{Binding ActivePreview.PdfDocument.LastPageCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ActivePreview.PdfDocument.ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ActivePreview.PdfDocument.ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ActivePreview.PdfDocument.ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ActivePreview.PdfDocument.ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ActivePreview.PdfDocument.FitWidthCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding ActivePreview.PdfDocument.FitWidthCommand}" />
  </UserControl.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource AppBackgroundBrush}">

    <!-- ===================== Barra ===================== -->
    <!-- Alto fijo de 58: en el modo árbol casa al píxel con la barra superior del panel lateral. -->
    <Border Grid.Row="0" Height="58" BorderBrush="{DynamicResource Ink10}" BorderThickness="0,0,0,1"
            Background="{DynamicResource AppBackgroundBrush}" Padding="10,0,14,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
        <Button Grid.Column="0" Classes="icon-btn" Width="32" Height="32" Command="{Binding ClosePreviewCommand}"
                ToolTip.Tip="{loc:Tr Files_ClosePreviewTooltip}" AutomationProperties.Name="{loc:Tr Files_ClosePreviewTooltip}">
          <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
        </Button>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="4,0,12,0" VerticalAlignment="Center">
          <Button Classes="icon-btn" Width="28" Height="28" Command="{Binding PreviewPreviousCommand}"
                  ToolTip.Tip="{loc:Tr Files_PreviousFileTooltip}" AutomationProperties.Name="{loc:Tr Files_PreviousFileTooltip}">
            <mi:MaterialIcon Kind="ArrowLeft" Width="15" Height="15" />
          </Button>
          <Button Classes="icon-btn" Width="28" Height="28" Command="{Binding PreviewNextCommand}"
                  ToolTip.Tip="{loc:Tr Files_NextFileTooltip}" AutomationProperties.Name="{loc:Tr Files_NextFileTooltip}">
            <mi:MaterialIcon Kind="ArrowRight" Width="15" Height="15" />
          </Button>
        </StackPanel>

        <!-- Nombre y, debajo, lo que se sabe del archivo: tipo, tamaño, fecha, y según el tipo las dimensiones
             de la imagen o las líneas del texto; al final, en qué punto de la carpeta se está. -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" Margin="0,0,16,0" ClipToBounds="True">
          <TextBlock Text="{Binding ActivePreview.FileName}" FontSize="13.5" FontWeight="Bold"
                     TextTrimming="CharacterEllipsis" MaxLines="1" ToolTip.Tip="{Binding ActivePreview.FileName}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding ActivePreview.KindLabel}" Classes="faint" FontSize="10.5" />
            <TextBlock Text="·" Classes="faint" FontSize="10.5" />
            <TextBlock Text="{Binding ActivePreview.MetaLabel}" Classes="faint" FontSize="10.5" />
            <TextBlock Text="·" Classes="faint" FontSize="10.5" IsVisible="{Binding ActivePreview.HasImageDimensions}" />
            <TextBlock Text="{Binding ActivePreview.ImageDimensionsLabel}" Classes="faint" FontSize="10.5"
                       IsVisible="{Binding ActivePreview.HasImageDimensions}" />
            <TextBlock Text="·" Classes="faint" FontSize="10.5" IsVisible="{Binding ActivePreview.IsCodeViewer}" />
            <TextBlock Text="{Binding ActivePreview.CodeLinesLabel}" Classes="faint" FontSize="10.5"
                       IsVisible="{Binding ActivePreview.IsCodeViewer}" />
            <TextBlock Text="·" Classes="faint" FontSize="10.5"
                       IsVisible="{Binding PreviewPositionLabel, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding PreviewPositionLabel}" Classes="faint" FontSize="10.5"
                       IsVisible="{Binding PreviewPositionLabel, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </StackPanel>

        <!-- Herramientas del PDF: páginas y zoom. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0"
                    IsVisible="{Binding ActivePreview.IsPdf}">
          <Button Classes="icon-btn" Width="28" Height="28"
                  Command="{Binding ActivePreview.PdfDocument.PreviousPageCommand}"
                  ToolTip.Tip="{loc:Tr Files_PrevPageTooltip}" AutomationProperties.Name="{loc:Tr Files_PrevPageTooltip}">
            <mi:MaterialIcon Kind="ChevronLeft" Width="16" Height="16" />
          </Button>
          <TextBlock Text="{Binding ActivePreview.PdfDocument.PageIndicator}" Classes="faint" FontSize="11"
                     FontFamily="{DynamicResource MonoFontFamily}"
                     VerticalAlignment="Center" MinWidth="64" TextAlignment="Center" />
          <Button Classes="icon-btn" Width="28" Height="28"
                  Command="{Binding ActivePreview.PdfDocument.NextPageCommand}"
                  ToolTip.Tip="{loc:Tr Files_NextPageTooltip}" AutomationProperties.Name="{loc:Tr Files_NextPageTooltip}">
            <mi:MaterialIcon Kind="ChevronRight" Width="16" Height="16" />
          </Button>
          <Border Width="1" Height="18" Background="{DynamicResource Ink10}" Margin="8,0" />
          <Button Classes="icon-btn" Width="28" Height="28"
                  Command="{Binding ActivePreview.PdfDocument.ZoomOutCommand}"
                  ToolTip.Tip="{loc:Tr Files_ZoomOutTooltip}" AutomationProperties.Name="{loc:Tr Files_ZoomOutTooltip}">
            <mi:MaterialIcon Kind="MagnifyMinusOutline" Width="15" Height="15" />
          </Button>
          <Button Classes="icon-btn" Width="52" Height="28"
                  Command="{Binding ActivePreview.PdfDocument.ActualSizeCommand}"
                  ToolTip.Tip="{loc:Tr Files_ActualSizeTooltip}" AutomationProperties.Name="{loc:Tr Files_ActualSizeTooltip}">
            <TextBlock Text="{Binding ActivePreview.PdfDocument.ZoomLabel}" FontSize="11"
                       FontFamily="{DynamicResource MonoFontFamily}" />
          </Button>
          <Button Classes="icon-btn" Width="28" Height="28"
                  Command="{Binding ActivePreview.PdfDocument.ZoomInCommand}"
                  ToolTip.Tip="{loc:Tr Files_ZoomInTooltip}" AutomationProperties.Name="{loc:Tr Files_ZoomInTooltip}">
            <mi:MaterialIcon Kind="MagnifyPlusOutline" Width="15" Height="15" />
          </Button>
          <Button Classes="icon-btn" Width="28" Height="28"
                  Classes.active="{Binding ActivePreview.PdfDocument.IsFitWidth}"
                  Command="{Binding ActivePreview.PdfDocument.FitWidthCommand}"
                  ToolTip.Tip="{loc:Tr Files_FitWidthTooltip}" AutomationProperties.Name="{loc:Tr Files_FitWidthTooltip}">
            <mi:MaterialIcon Kind="ArrowExpandHorizontal" Width="15" Height="15" />
          </Button>
        </StackPanel>

        <!-- Herramientas de la imagen: ajustada a la ventana o a tamaño real. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0"
                    IsVisible="{Binding ActivePreview.IsImageViewer}">
          <Button Classes="icon-btn" Width="28" Height="28"
                  Classes.active="{Binding ActivePreview.IsImageActualSize}"
                  Command="{Binding ActivePreview.ToggleImageActualSizeCommand}"
                  ToolTip.Tip="{loc:Tr Files_ImageActualSizeTooltip}" AutomationProperties.Name="{loc:Tr Files_ImageActualSizeTooltip}">
            <mi:MaterialIcon Kind="ImageSizeSelectActual" Width="15" Height="15" />
          </Button>
        </StackPanel>

        <!-- Herramientas del visor de código: lenguaje, ajuste de líneas y copiar. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0"
                    IsVisible="{Binding ActivePreview.IsCodeViewer}">
          <Border Classes="file-ext-badge" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Text="{Binding ActivePreview.CodeLanguageLabel}" />
          </Border>
          <Button Classes="icon-btn" Width="28" Height="28"
                  Classes.active="{Binding ActivePreview.IsCodeWordWrap}"
                  Command="{Binding ActivePreview.ToggleCodeWordWrapCommand}"
                  ToolTip.Tip="{loc:Tr Files_WordWrapTooltip}" AutomationProperties.Name="{loc:Tr Files_WordWrapTooltip}">
            <mi:MaterialIcon Kind="Wrap" Width="15" Height="15" />
          </Button>
          <Button Classes="icon-btn" Width="28" Height="28"
                  Command="{Binding CopyPreviewContentCommand}"
                  ToolTip.Tip="{loc:Tr Files_CopyContentTooltip}" AutomationProperties.Name="{loc:Tr Files_CopyContentTooltip}">
            <Panel>
              <mi:MaterialIcon Kind="ContentCopy" Width="14" Height="14" IsVisible="{Binding !IsPreviewContentCopied}" />
              <mi:MaterialIcon Kind="Check" Width="15" Height="15" IsVisible="{Binding IsPreviewContentCopied}" />
            </Panel>
          </Button>
        </StackPanel>

        <Button Grid.Column="4" Classes="pill" Padding="10,6" Margin="0,0,4,0"
                Command="{Binding OpenWithSystemCommand}" CommandParameter="{Binding ActivePreview}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="OpenInNew" Width="13" Height="13" />
            <TextBlock Text="{loc:Tr Files_OpenWithSystemButton, Converter={StaticResource UpperCaseConverter}}" FontSize="11" />
          </StackPanel>
        </Button>

        <Button Grid.Column="5" Classes="icon-btn" Width="32" Height="32"
                ToolTip.Tip="{loc:Tr Files_MoreActionsTooltip}" AutomationProperties.Name="{loc:Tr Files_MoreActionsTooltip}">
          <mi:MaterialIcon Kind="DotsVertical" Width="16" Height="16" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{loc:Tr Files_RevealInSystemMenuItem}" Command="{Binding ActivePreview.RevealInSystemCommand}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{loc:Tr Files_CopyPathMenuItem}" Command="{Binding CopyPathCommand}"
                        CommandParameter="{Binding ActivePreview.File.FullPath}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="{loc:Tr Common_Delete}" Command="{Binding RequestDeleteFileCommand}"
                        CommandParameter="{Binding ActivePreview}">
                <MenuItem.Icon>
                  <mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" />
                </MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <!-- Conmutador de navegación. Está también aquí porque en el modo árbol la cabecera del panel derecho
             se oculta con un archivo abierto, y el modo no puede quedarse sin salida. -->
        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center"
                    ToolTip.Tip="{loc:Tr Files_Nav_Tooltip}">
          <Border Width="1" Height="20" Background="{DynamicResource Ink10}" Margin="0,0,8,0" />
          <Button Classes="icon-btn" Classes.active="{Binding !IsTreeView}" Width="32" Height="32"
                  Command="{Binding ShowBrowserViewCommand}"
                  ToolTip.Tip="{loc:Tr Files_Nav_Browser}" AutomationProperties.Name="{loc:Tr Files_Nav_Browser}">
            <mi:MaterialIcon Kind="ViewGridOutline" Width="16" Height="16" />
          </Button>
          <Button Classes="icon-btn" Classes.active="{Binding IsTreeView}" Width="32" Height="32"
                  Command="{Binding ShowTreeViewCommand}"
                  ToolTip.Tip="{loc:Tr Files_Nav_Tree}" AutomationProperties.Name="{loc:Tr Files_Nav_Tree}">
            <mi:MaterialIcon Kind="FileTreeOutline" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Aviso de texto truncado: dicho una vez arriba, y no como una línea falsa añadida al final del propio
         archivo, que es lo que hacía antes (y que se copiaba junto al contenido). -->
    <Border Grid.Row="1" Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}"
            BorderThickness="0,0,0,1" Padding="16,8"
            IsVisible="{Binding ActivePreview.IsCodeTruncated}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="InformationOutline" Width="14" Height="14" Foreground="{DynamicResource Ink40}" />
        <TextBlock Text="{loc:Tr Files_CodeTruncatedNotice}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Background="{DynamicResource AppBackgroundAltBrush}">

      <!-- ===================== Imagen ===================== -->
      <!-- Ajustada a la ventana sin ampliar nunca por encima de su tamaño (un icono de 64 px no se pixela a
           pantalla completa), o a tamaño real con desplazamiento. Mientras llega la imagen completa se enseña
           la miniatura de la tarjeta. -->
      <Panel IsVisible="{Binding ActivePreview.IsImageViewer}">
        <Image Source="{Binding ActivePreview.DisplayImage}" Stretch="Uniform" StretchDirection="DownOnly" Margin="32"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               IsVisible="{Binding !ActivePreview.IsImageActualSize}" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding ActivePreview.IsImageActualSize}">
          <Image Source="{Binding ActivePreview.DisplayImage}" Stretch="None" Margin="32"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ScrollViewer>
        <mi:MaterialIcon Classes="spin" Kind="Loading" Width="30" Height="30"
                         Foreground="{DynamicResource TextMutedBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding ActivePreview.IsImageLoading}" />
      </Panel>

      <!-- ===================== PDF ===================== -->
      <!-- Visor completo vía PDFtoImage/PDFium (ver PdfRenderHelper): raíl de páginas a la izquierda y la página
           actual a la derecha, ajustada al ancho por defecto y con zoom real (re-renderizado, no un escalado
           borroso del mismo bitmap). El DataContext de este subárbol es el PdfDocumentViewModel del archivo
           activo. Panel envolvente separado a propósito: si IsVisible y DataContext se declaran en el mismo
           elemento, Avalonia resuelve IsVisible contra el DataContext nuevo en vez del heredado. -->
      <Panel IsVisible="{Binding ActivePreview.IsPdf}">
      <Grid ColumnDefinitions="150,*" DataContext="{Binding ActivePreview.PdfDocument}">

        <Border Grid.Column="0" BorderBrush="{DynamicResource Ink10}" BorderThickness="0,0,1,0"
                Background="{DynamicResource AppBackgroundBrush}" IsVisible="{Binding IsReady}">
          <ScrollViewer>
            <ItemsControl x:Name="PdfRail" ItemsSource="{Binding Pages}" Margin="10">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <!-- Virtualizado a propósito: un PDF de cientos de páginas solo renderiza las miniaturas
                       realmente cerca del viewport (ver PdfPageThumb_Initialized). -->
                  <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:PdfPageThumbnailViewModel">
                  <Button Classes="pdf-page-thumb" Classes.active="{Binding IsCurrent}" Margin="0,0,0,10"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:PdfDocumentViewModel)DataContext).GoToPageCommand}"
                          CommandParameter="{Binding}"
                          Initialized="PdfPageThumb_Initialized">
                    <StackPanel Spacing="4">
                      <Border Background="White" BorderBrush="{DynamicResource Ink10}" BorderThickness="1" Padding="0"
                              MinHeight="60">
                        <Image Source="{Binding Thumbnail}" Width="110" Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                      </Border>
                      <TextBlock Text="{Binding PageNumber}" Classes="faint" FontSize="10"
                                 HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" x:Name="PdfPageHost">
          <ScrollViewer x:Name="PdfPageScroller" IsVisible="{Binding IsReady}"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <!-- Fondo blanco fijo: es papel, y en un tema oscuro un PDF con fondo transparente quedaría
                 ilegible. -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="32,24"
                    Width="{Binding CurrentPageDisplayWidth}" Height="{Binding CurrentPageDisplayHeight}"
                    Background="White" BorderBrush="{DynamicResource Ink10}" BorderThickness="1">
              <Image Source="{Binding CurrentPageImage}" Stretch="Fill"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Border>
          </ScrollViewer>

          <StackPanel IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Spacing="12">
            <mi:MaterialIcon Classes="spin" Kind="Loading" Width="30" Height="30"
                              Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Tr Files_PdfRenderingLabel}" Classes="muted" HorizontalAlignment="Center" />
          </StackPanel>

          <StackPanel IsVisible="{Binding IsFaulted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Spacing="14" MaxWidth="340" Margin="24">
            <Border Width="72" Height="72" Background="{DynamicResource Ink05}" HorizontalAlignment="Center">
              <mi:MaterialIcon Kind="FileAlertOutline" Width="36" Height="36"
                               Foreground="{DynamicResource Ink40}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{loc:Tr Files_PdfRenderErrorMessage}"
                       Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
            <Button Classes="pill-primary" HorizontalAlignment="Center"
                    Command="{Binding #PreviewRoot.((vm:FilesViewModel)DataContext).OpenWithSystemCommand}"
                    CommandParameter="{Binding #PreviewRoot.((vm:FilesViewModel)DataContext).ActivePreview}">
              <TextBlock Text="{loc:Tr Files_OpenWithSystemFallbackButton, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </StackPanel>
        </Grid>

      </Grid>
      </Panel>

      <!-- ===================== Código y texto ===================== -->
      <!-- Editor de solo lectura con resaltado de sintaxis vía AvaloniaEdit + TextMate. Sin ScrollViewer
           alrededor: el editor trae el suyo y virtualiza las líneas; envuelto en otro, se medía con alto
           infinito y pintaba el archivo entero de golpe. -->
      <Panel IsVisible="{Binding ActivePreview.IsCodeViewer}">
      <Grid DataContext="{Binding ActivePreview}" Background="{DynamicResource AppBackgroundBrush}">
        <ae:TextEditor x:Name="CodeEditor"
                       IsReadOnly="True"
                       ShowLineNumbers="True"
                       WordWrap="{Binding IsCodeWordWrap}"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       FontFamily="{DynamicResource CodeFontFamily}"
                       FontSize="13"
                       Margin="10,8,0,0"
                       Document="{Binding CodeDocument}" />
      </Grid>
      </Panel>

      <!-- ===================== Panel de información ===================== -->
      <!-- Lo que no tiene visor dentro de la app —audio, vídeo, tipos desconocidos, un texto que resulta ser
           binario o una imagen que no se puede decodificar—: una ficha del archivo con el motivo y las dos
           salidas útiles, abrirlo con su aplicación o mostrarlo en su carpeta. Nunca un error sin salida. -->
      <Panel IsVisible="{Binding ActivePreview.ShowsInfoPanel}">
      <StackPanel DataContext="{Binding ActivePreview}" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="16" MaxWidth="440" Margin="32">
        <Border Width="104" Height="104" Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}"
                BorderThickness="1" HorizontalAlignment="Center">
          <Panel>
            <mi:MaterialIcon Kind="{Binding IconKind}" Width="48" Height="48" Foreground="{DynamicResource Ink40}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Classes="file-ext-badge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                    IsVisible="{Binding HasExtension}">
              <TextBlock Text="{Binding ExtensionLabel}" />
            </Border>
          </Panel>
        </Border>

        <StackPanel Spacing="4">
          <TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="Bold"
                     TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding KindMetaLabel}" Classes="faint" FontSize="11.5"
                     TextAlignment="Center" HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="{Binding PreviewHint}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,4,0,0">
          <Button Classes="pill-primary"
                  Command="{Binding #PreviewRoot.((vm:FilesViewModel)DataContext).OpenWithSystemCommand}"
                  CommandParameter="{Binding}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="PlayCircleOutline" Width="16" Height="16" IsVisible="{Binding IsPlayable}" />
              <mi:MaterialIcon Kind="OpenInNew" Width="14" Height="14" IsVisible="{Binding !IsPlayable}" />
              <TextBlock Text="{loc:Tr Files_PlayWithSystemButton, Converter={StaticResource UpperCaseConverter}}"
                         IsVisible="{Binding IsPlayable}" />
              <TextBlock Text="{loc:Tr Files_OpenWithSystemFallbackButton, Converter={StaticResource UpperCaseConverter}}"
                         IsVisible="{Binding !IsPlayable}" />
            </StackPanel>
          </Button>
          <Button Classes="pill" Command="{Binding RevealInSystemCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" />
              <TextBlock Text="{loc:Tr Files_RevealShortButton, Converter={StaticResource UpperCaseConverter}}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
      </Panel>
    </Grid>
  </Grid>
</UserControl>
