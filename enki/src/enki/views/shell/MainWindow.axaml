<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:models="clr-namespace:enki.Models"
        xmlns:vm="clr-namespace:enki.ViewModels"
        xmlns:views="clr-namespace:enki.Views"
        xmlns:conv="clr-namespace:enki.Converters"
        xmlns:baseconv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
        xmlns:motion="clr-namespace:enki.Views"
        xmlns:loc="clr-namespace:enki.Localization"
        mc:Ignorable="d" d:DesignWidth="1320" d:DesignHeight="820"
        x:Class="enki.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="{loc:Tr Shell_WindowTitle}">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
      <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CalendarViewModel}">
      <views:CalendarView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NotesViewModel}">
      <views:NotesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:FilesViewModel}">
      <views:FilesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SkillsViewModel}">
      <views:SkillsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SessionsViewModel}">
      <views:SessionsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:KanbanViewModel}">
      <views:KanbanView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TrashViewModel}">
      <views:TrashView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TagManagerViewModel}">
      <views:TagManagerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ThemeEditorViewModel}">
      <views:ThemeEditorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RemindersViewModel}">
      <views:RemindersView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NotificationsViewModel}">
      <views:NotificationsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HabitsViewModel}">
      <views:HabitsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
      <views:StatisticsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:VaultSetupViewModel}">
      <views:VaultSetupView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LanguageSetupViewModel}">
      <views:LanguageSetupView />
    </DataTemplate>
  </Window.DataTemplates>

  <!-- Atajos globales del shell (búsqueda, quick switcher, paleta de comandos, navegación Ctrl+1..8,
       Ajustes, zoom de vista): remapeables por el usuario (propuesta 29,
       docs/propuesta-nuevas-funcionalidades.md), así que ya no son literales aquí — se construyen en
       MainWindow.axaml.cs (BuildKeyBindings) a partir de Services.ShortcutRegistry y se reconstruyen cada
       vez que Ajustes › Atajos cambia un gesto. Ctrl+rueda del ratón para el zoom sigue aparte, sin
       cambios (necesita interceptar antes que el scroll normal de listas/tablero, algo que un KeyBinding
       no puede hacer). -->

  <!-- Zoom de interfaz (docs/funcionalidad-zoom-interfaz.md §1): LayoutTransformControl en vez de un
       RenderTransform suelto porque mide a su hijo y reporta el tamaño YA escalado como su propio
       DesiredSize — así el layout entero (sidebar + contenido + botones flotantes de la barra de
       título) reflowea correctamente al hacer zoom en vez de recortarse o dejar hueco muerto. -->
  <LayoutTransformControl>
    <LayoutTransformControl.LayoutTransform>
      <ScaleTransform ScaleX="{Binding UiZoomScale}" ScaleY="{Binding UiZoomScale}" />
    </LayoutTransformControl.LayoutTransform>

  <Grid>

  <!-- La shell no se declara aquí: se construye cuando la pantalla de arranque ya está delante, para que
       el primer fotograma de la ventana no tenga que esperar a inflar sus ~300 líneas de XAML (ver
       MainWindow.BuildShell y views/shell/ShellView.axaml). Ocupa el primer puesto del árbol porque lo que
       venga después —la cortina, las pantallas de configuración, los botones de la barra de título— se
       dibuja por encima. -->
  <ContentControl x:Name="ShellHost" />


  <!-- Pantalla de arranque: mientras se construyen y cargan las secciones (ver
       MainWindowViewModel.StartSectionWarmUp) la ventana no es interactiva y esto la tapa entera, incluida
       la barra lateral, para que nadie navegue a medio cargar. La vista lleva su propia entrada/salida
       animada y su propio logo (SetLogo, desde UpdateBrandIcon de este mismo code-behind), así que aquí
       solo se le pasa el estado. -->
  <views:StartupScreen x:Name="StartupOverlay" IsWarmUpActive="{Binding IsSectionWarmUpActive}" />

  <views:LanguageSetupView DataContext="{Binding LanguageSetup}"
                           IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LanguageSetup, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}" />

  <views:VaultSetupView DataContext="{Binding VaultSetup}"
                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).VaultSetup, Converter={x:Static baseconv:ObjectConverters.IsNotNull}}" />

    <!-- ===================== Resize grips (§ ajuste "Usar barra de título propia") =====================
         WindowDecorations.None (see MainWindow.axaml.cs) drops the OS/Avalonia-drawn resize border
         along with its title bar, so these thin hit-test strips stand in for it — otherwise a
         maximized-only window would be the only way to resize once the setting is on. Declared before
         the window-control buttons below so those buttons win the corner pixels they share. -->
    <Border Background="Transparent" Height="4" VerticalAlignment="Top" Cursor="SizeNorthSouth"
            IsVisible="{Binding UseCustomTitleBar}" Tag="North" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Background="Transparent" Height="4" VerticalAlignment="Bottom" Cursor="SizeNorthSouth"
            IsVisible="{Binding UseCustomTitleBar}" Tag="South" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Background="Transparent" Width="4" HorizontalAlignment="Left" Cursor="SizeWestEast"
            IsVisible="{Binding UseCustomTitleBar}" Tag="West" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Background="Transparent" Width="4" HorizontalAlignment="Right" Cursor="SizeWestEast"
            IsVisible="{Binding UseCustomTitleBar}" Tag="East" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Background="Transparent" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top"
            Cursor="TopLeftCorner" IsVisible="{Binding UseCustomTitleBar}" Tag="NorthWest" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Background="Transparent" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
            Cursor="TopRightCorner" IsVisible="{Binding UseCustomTitleBar}" Tag="NorthEast" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Background="Transparent" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
            Cursor="BottomLeftCorner" IsVisible="{Binding UseCustomTitleBar}" Tag="SouthWest" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Background="Transparent" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Cursor="BottomRightCorner" IsVisible="{Binding UseCustomTitleBar}" Tag="SouthEast" PointerPressed="ResizeGrip_PointerPressed" />

    <!-- ===================== Botones de contenido de la barra de título =====================
         Orden fijo, de izquierda a derecha: buscar · notificaciones · recordatorios · bandeja de entrada.
         Deliberately NOT gated by UseCustomTitleBar like the window controls below, since they carry app
         content (not window chrome) and stay meaningful whether Enki or the OS is drawing the title bar.
         Each is independently hideable from Ajustes › Notificaciones (MainWindowViewModel
         .NotificationsPanelEnabled/RemindersPanelEnabled/InboxPanelEnabled) instead. They are NOT the
         same feature: the bell is a push-driven system event log (NotificationCenterViewModel — vault
         switched, sync errors…); recordatorios is a pull-driven view over kanban due dates AND the user's
         own standalone reminders from the Recordatorios page (ReminderInboxViewModel — "what's due
         soon"); la bandeja de entrada no lee nada, escribe: es la captura rápida (QuickCaptureViewModel)
         para apuntar una idea en Inbox/ o como tarjeta. A fired reminder still also lands in the bell as
         a one-off toast/log entry ("this just happened"), but the reminders panel is what stays labeled
         "Recordatorios" and lists it until it's completed/dismissed.
         See docs/agent-docs/notificaciones-y-recordatorios.md for the fuller design. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">

      <!-- Global search: abre un popup con consulta en paralelo a notas, tarjetas, tareas y recordatorios. -->
      <Grid>
        <Button Name="GlobalSearchTrigger" Classes="titlebar-btn titlebar-btn-plain"
                Command="{Binding OpenGlobalSearchCommand}" ToolTip.Tip="{loc:Tr Shell_SearchTooltip}"
                AutomationProperties.Name="{loc:Tr Shell_SearchTooltip}">
          <mi:MaterialIcon Kind="Magnify" Width="19" Height="19"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>

        <Popup Name="GlobalSearchPopup" PlacementTarget="{Binding #GlobalSearchTrigger}"
               Placement="BottomEdgeAlignedRight" VerticalOffset="6"
               IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #GlobalSearchTrigger}"
               IsOpen="{Binding GlobalSearch.IsOpen, Mode=TwoWay}" Width="600" MaxHeight="520"
               Opened="GlobalSearchPopup_Opened">
          <Border Classes="dropdown-popover" Width="600" MaxHeight="520">
            <StackPanel Spacing="12">
              <TextBox Name="GlobalSearchTextBox" Classes="search"
                       Text="{Binding GlobalSearch.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="{loc:Tr Shell_SearchPlaceholder}"
                       AutomationProperties.Name="{loc:Tr Shell_SearchPlaceholder}" />

              <TextBlock Text="{loc:Tr Search_Prompt}"
                         Classes="faint" TextWrapping="Wrap"
                         IsVisible="{Binding GlobalSearch.ShowSearchPrompt}" />

              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding GlobalSearch.IsSearching}">
                <mi:MaterialIcon Classes="spin" Kind="Loading" Width="14" Height="14" />
                <TextBlock Text="{loc:Tr Search_InProgress}" Classes="faint" />
              </StackPanel>

              <TextBlock Text="{loc:Tr Search_NoResults}"
                         Classes="faint" TextWrapping="Wrap"
                         IsVisible="{Binding GlobalSearch.ShowNoResults}" />

              <ScrollViewer IsVisible="{Binding GlobalSearch.HasResults}" MaxHeight="380">
                <ItemsControl ItemsSource="{Binding GlobalSearch.Results}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GlobalSearchResultViewModel">
                      <Button Classes="dropdown-item"
                              Command="{Binding $parent[ItemsControl].DataContext.GlobalSearchResultSelectedCommand}"
                              CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Title}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <mi:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="16" Height="16"
                                            Margin="0,2,10,0" VerticalAlignment="Top" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Subtitle}" Classes="faint" FontSize="11"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>

      <!-- Quick Switcher: Ctrl+P para saltar a una nota. -->
      <Grid>
        <Popup Name="QuickSwitcherPopup" PlacementTarget="{Binding #GlobalSearchTrigger}"
               Placement="BottomEdgeAlignedRight" VerticalOffset="6"
               IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #GlobalSearchTrigger}"
               IsOpen="{Binding QuickSwitcher.IsOpen, Mode=TwoWay}" Width="500" MaxHeight="420"
               Opened="QuickSwitcherPopup_Opened">
          <Border Classes="dropdown-popover" Width="500" MaxHeight="420">
            <StackPanel Spacing="10">
              <TextBox Name="QuickSwitcherTextBox" Classes="search"
                       Text="{Binding QuickSwitcher.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="{loc:Tr QuickSwitcher_SearchPlaceholder}"
                       AutomationProperties.Name="{loc:Tr QuickSwitcher_SearchPlaceholder}"
                       KeyDown="QuickSwitcherTextBox_KeyDown" />

              <TextBlock Text="{loc:Tr QuickSwitcher_Prompt}"
                         Classes="faint" TextWrapping="Wrap"
                         IsVisible="{Binding QuickSwitcher.ShowPrompt}" />

              <ScrollViewer IsVisible="{Binding QuickSwitcher.HasResults}" MaxHeight="320">
                <ItemsControl ItemsSource="{Binding QuickSwitcher.Results}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuickSwitcherItemViewModel">
                      <Button Classes="dropdown-item"
                              Classes.active="{Binding IsSelected}"
                              Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).QuickSwitcher.OpenNoteCommand}"
                              CommandParameter="{Binding .}"
                              AutomationProperties.Name="{Binding Title}">
                        <Grid ColumnDefinitions="Auto,*">
                          <mi:MaterialIcon Grid.Column="0" Kind="NoteTextOutline" Width="16" Height="16"
                                            Margin="0,2,10,0" VerticalAlignment="Top" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Preview}" Classes="faint" FontSize="11"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="1" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>

      <!-- Paleta de comandos unificada: Ctrl+Shift+K ejecuta cualquier acción registrada por el shell
           (propuesta 25, docs/propuesta-nuevas-funcionalidades.md). Mismo patrón de popup que el Quick
           Switcher justo encima, con MoveSelectionUp/Down + ExecuteItem en vez de OpenNote. -->
      <Grid>
        <Popup Name="CommandPalettePopup" PlacementTarget="{Binding #GlobalSearchTrigger}"
               Placement="BottomEdgeAlignedRight" VerticalOffset="6"
               IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #GlobalSearchTrigger}"
               IsOpen="{Binding CommandPalette.IsOpen, Mode=TwoWay}" Width="500" MaxHeight="420"
               Opened="CommandPalettePopup_Opened">
          <Border Classes="dropdown-popover" Width="500" MaxHeight="420">
            <StackPanel Spacing="10">
              <TextBox Name="CommandPaletteTextBox" Classes="search"
                       Text="{Binding CommandPalette.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="{loc:Tr CommandPalette_SearchPlaceholder}"
                       AutomationProperties.Name="{loc:Tr CommandPalette_SearchPlaceholder}"
                       KeyDown="CommandPaletteTextBox_KeyDown" />

              <TextBlock Text="{loc:Tr CommandPalette_NoResults}"
                         Classes="faint" TextWrapping="Wrap"
                         IsVisible="{Binding CommandPalette.ShowNoResults}" />

              <ScrollViewer IsVisible="{Binding CommandPalette.HasResults}" MaxHeight="340">
                <ItemsControl ItemsSource="{Binding CommandPalette.Results}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CommandPaletteItemViewModel">
                      <Button Classes="dropdown-item"
                              Classes.active="{Binding IsSelected}"
                              Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CommandPalette.ExecuteItemCommand}"
                              CommandParameter="{Binding .}"
                              AutomationProperties.Name="{Binding Title}">
                        <Grid ColumnDefinitions="Auto,*">
                          <mi:MaterialIcon Grid.Column="0" Kind="{Binding Icon}" Width="16" Height="16"
                                            Margin="0,2,10,0" VerticalAlignment="Top" />
                          <TextBlock Grid.Column="1" Text="{Binding Title, Converter={StaticResource UpperCaseConverter}}" FontWeight="Bold" TextWrapping="Wrap" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>

      <!-- Web clipper (T3, .docs/project-info/web-clipper.md): pegar una URL y que salga una nota en
           Inbox/. Mismo patrón de popup anclado a la barra de título que la paleta de comandos de arriba,
           porque guardar una página no pertenece a ninguna pantalla: se pide desde la paleta, desde la
           cabecera de Documentos y desde la captura rápida. -->
      <Grid>
        <Popup Name="WebClipPopup" PlacementTarget="{Binding #GlobalSearchTrigger}"
               Placement="BottomEdgeAlignedRight" VerticalOffset="6"
               IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #GlobalSearchTrigger}"
               IsOpen="{Binding WebClip.IsOpen, Mode=TwoWay}" Width="420"
               Opened="WebClipPopup_Opened">
          <Border Classes="dropdown-popover" Width="420">
            <StackPanel Spacing="12">
              <TextBlock Text="{loc:Tr WebClip_Title, Converter={StaticResource UpperCaseConverter}}"
                         Classes="eyebrow" FontSize="10.5" />

              <TextBox Name="WebClipTextBox" Classes="search"
                       Text="{Binding WebClip.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="{loc:Tr WebClip_UrlPlaceholder}"
                       AutomationProperties.Name="{loc:Tr WebClip_UrlPlaceholder}"
                       IsEnabled="{Binding WebClip.IsIdle}"
                       KeyDown="WebClipTextBox_KeyDown" />

              <!-- El motivo del rechazo se lee junto al campo que hay que corregir, no solo en el panel de
                   avisos: una URL mal escrita se arregla aquí mismo. -->
              <TextBlock Text="{Binding WebClip.ErrorMessage}" Classes="faint" TextWrapping="Wrap"
                         IsVisible="{Binding WebClip.ErrorMessage, Converter={x:Static baseconv:StringConverters.IsNotNullOrEmpty}}" />

              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding WebClip.IsBusy}">
                <mi:MaterialIcon Kind="Loading" Classes="spin" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Tr WebClip_Working}" Classes="faint" VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock Text="{loc:Tr WebClip_Hint}" Classes="faint" TextWrapping="Wrap" />

              <Grid ColumnDefinitions="*,Auto,Auto">
                <Button Grid.Column="1" Classes="ghost modal-cancel" Margin="0,0,8,0"
                        Command="{Binding WebClip.CancelCommand}">
                  <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
                </Button>
                <Button Grid.Column="2" Classes="pill-primary" Command="{Binding WebClip.SaveCommand}">
                  <TextBlock Text="{loc:Tr WebClip_SaveButton, Converter={StaticResource UpperCaseConverter}}" />
                </Button>
              </Grid>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>

      <!-- Bell: system notifications -->
      <Grid DataContext="{Binding NotificationCenter}"
            IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NotificationsPanelEnabled}">
        <Button Name="NotificationsTrigger" Classes="titlebar-btn titlebar-btn-plain" Command="{Binding ToggleCommand}"
                ToolTip.Tip="{loc:Tr Notification_BellTooltip}"
                AutomationProperties.Name="{loc:Tr Notification_BellTooltip}">
          <Panel Width="20" Height="20">
            <mi:MaterialIcon Kind="BellRingOutline" Width="19" Height="19"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Classes="titlebar-badge" IsVisible="{Binding UnreadCount, Converter={StaticResource CountToBoolConverter}}">
              <TextBlock Classes="titlebar-badge-text" Text="{Binding UnreadCount}" />
            </Border>
          </Panel>
        </Button>

        <Popup PlacementTarget="{Binding #NotificationsTrigger}" Placement="BottomEdgeAlignedRight"
               VerticalOffset="6" IsLightDismissEnabled="True"
               OverlayInputPassThroughElement="{Binding #NotificationsTrigger}"
               IsOpen="{Binding IsOpen, Mode=TwoWay}">
          <Border Classes="dropdown-popover" Width="320">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Notification_PanelTitle, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="10.5"
                           VerticalAlignment="Center" MinWidth="0" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Classes="ghost" Command="{Binding MarkAllReadCommand}"
                        Margin="8,0,0,0"
                        IsVisible="{Binding UnreadCount, Converter={StaticResource CountToBoolConverter}}">
                  <TextBlock Text="{loc:Tr Notification_MarkAllRead, Converter={StaticResource UpperCaseConverter}}" />
                </Button>
              </Grid>

              <TextBlock Text="{loc:Tr Notification_Empty}" Classes="faint" IsVisible="{Binding !HasItems}" />

              <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NotificationItemViewModel">
                    <!-- Fila + menú "Aplazar" (T5), solo en los avisos nacidos de un vencimiento. Misma
                         estructura que la fila de la bandeja de recordatorios: el menú va fuera del Button
                         para no meter botones dentro de un botón. -->
                    <StackPanel>
                      <Button Classes="dropdown-item"
                              Command="{Binding $parent[ItemsControl].DataContext.SelectItemCommand}"
                              CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Title}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                          <mi:MaterialIcon Grid.Column="0" Kind="{Binding SeverityIcon}" Width="15" Height="15"
                                            Margin="0,2,10,0" VerticalAlignment="Top" Classes="severity-icon"
                                            Classes.success="{Binding Severity, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Success}"
                                            Classes.warning="{Binding Severity, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Warning}"
                                            Classes.error="{Binding Severity, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Error}" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"
                                       Classes.faint="{Binding IsRead}" />
                            <TextBlock Text="{Binding Message}" Classes="faint" FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding HasMessage}" />
                            <!-- Acción del aviso (T9: "Descargar"). El enlace pasa otra vez por
                                 ExternalLinkPolicy al abrirse, ver NotificationCenterViewModel.OpenLink. -->
                            <Button Classes="ghost" Padding="0,2" HorizontalAlignment="Left"
                                    IsVisible="{Binding HasLink}"
                                    Command="{Binding $parent[ItemsControl].DataContext.OpenLinkCommand}"
                                    CommandParameter="{Binding}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="OpenInNew" Width="11" Height="11" />
                                <TextBlock Text="{loc:Tr Notification_OpenLink, Converter={StaticResource UpperCaseConverter}}"
                                           FontSize="10.5" FontWeight="Bold" />
                              </StackPanel>
                            </Button>
                          </StackPanel>
                          <Button Grid.Column="2" Classes="icon-btn" Width="20" Height="20" Margin="8,0,0,0"
                                  VerticalAlignment="Top" IsVisible="{Binding CanSnooze}"
                                  Command="{Binding $parent[ItemsControl].DataContext.ToggleSnoozeMenuCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Reminder_Snooze_Tooltip}"
                                  AutomationProperties.Name="{loc:Tr Reminder_Snooze_Tooltip}">
                            <mi:MaterialIcon Kind="AlarmSnooze" Width="12" Height="12" />
                          </Button>
                          <TextBlock Grid.Column="3" Text="{Binding TimeLabel}" Classes="faint" FontSize="9.5"
                                     Margin="8,2,0,0" VerticalAlignment="Top" />
                        </Grid>
                      </Button>

                      <Border Classes="snooze-menu" IsVisible="{Binding IsSnoozeMenuOpen}">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{loc:Tr Reminder_Snooze_MenuTitle, Converter={StaticResource UpperCaseConverter}}"
                                     Classes="eyebrow" FontSize="9.5" Margin="8,0,0,4" />
                          <Button Classes="snooze-option" Content="{Binding $parent[ItemsControl].DataContext.SnoozePrimaryLabel, Converter={StaticResource UpperCaseConverter}}"
                                  Command="{Binding $parent[ItemsControl].DataContext.SnoozePrimaryCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="snooze-option" Content="{Binding $parent[ItemsControl].DataContext.SnoozeSecondaryLabel, Converter={StaticResource UpperCaseConverter}}"
                                  Command="{Binding $parent[ItemsControl].DataContext.SnoozeSecondaryCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="snooze-option" Content="{loc:Tr Reminder_Snooze_Evening, Converter={StaticResource UpperCaseConverter}}"
                                  Command="{Binding $parent[ItemsControl].DataContext.SnoozeEveningCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="snooze-option" Content="{loc:Tr Reminder_Snooze_Tomorrow, Converter={StaticResource UpperCaseConverter}}"
                                  Command="{Binding $parent[ItemsControl].DataContext.SnoozeTomorrowCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>

      <!-- Recordatorios: vencimientos de tarjetas Kanban con fecha límite más los recordatorios propios
           de la página "Recordatorios". El icono es CalendarClockOutline, el mismo que la entrada
           "Recordatorios" del sidebar (SidebarSectionCatalog), para que el botón y la página a la que
           lleva se reconozcan como la misma cosa. InboxOutline, que llevaba antes, pasó al botón de
           bandeja de entrada de aquí al lado. Ver docs/notificaciones-y-recordatorios.md. -->
      <Grid DataContext="{Binding ReminderInbox}"
            IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemindersPanelEnabled}">
        <Button Name="RemindersTrigger" Classes="titlebar-btn titlebar-btn-plain" Command="{Binding ToggleCommand}"
                ToolTip.Tip="{loc:Tr Reminder_InboxTooltip}"
                AutomationProperties.Name="{loc:Tr Reminder_InboxTooltip}">
          <Panel Width="20" Height="20">
            <mi:MaterialIcon Kind="CalendarClockOutline" Width="19" Height="19"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Classes="titlebar-badge" IsVisible="{Binding OverdueCount, Converter={StaticResource CountToBoolConverter}}">
              <TextBlock Classes="titlebar-badge-text" Text="{Binding OverdueCount}" />
            </Border>
          </Panel>
        </Button>

        <Popup PlacementTarget="{Binding #RemindersTrigger}" Placement="BottomEdgeAlignedRight"
               VerticalOffset="6" IsLightDismissEnabled="True"
               OverlayInputPassThroughElement="{Binding #RemindersTrigger}"
               IsOpen="{Binding IsOpen, Mode=TwoWay}">
          <Border Classes="dropdown-popover" Width="320">
            <StackPanel Spacing="12">
              <TextBlock Text="{loc:Tr Reminder_InboxTitle, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="10.5" />

              <!-- Aviso "Deshacer" tras un Dismiss (Fase 10, docs/analisis-proyecto/roadmap.md) — mismo
                   patrón visual de texto+botón fantasma inline que Polar_Sync_AlreadyRunningNotice
                   (views/reminders/RemindersView.axaml), sin componente de toast nuevo. -->
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasLastDismissed}">
                <TextBlock Grid.Column="0" Text="{loc:Tr Reminder_DismissedUndoMessage}" Classes="faint" FontSize="11.5"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Classes="ghost" Padding="6,2" Command="{Binding UndoDismissCommand}">
                  <TextBlock Text="{loc:Tr Reminder_UndoDismiss, Converter={StaticResource UpperCaseConverter}}" FontSize="11" FontWeight="Bold" />
                </Button>
              </Grid>

              <TextBlock Text="{loc:Tr Reminder_InboxEmpty}" Classes="faint" IsVisible="{Binding !HasItems}" />

              <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReminderItemViewModel">
                    <!-- Fila + su menú "Aplazar" desplegable (T5). El menú va FUERA del Button de la fila
                         y no dentro: anidado, cada opción quedaría dentro del área clicable que abre la
                         tarjeta, y un lector de pantalla anunciaría botones dentro de un botón. -->
                    <StackPanel>
                      <!-- Three-row hierarchy — metadata (bucket/due date), title, column tag — instead of
                           a flat text stack, plus a left accent bar (see Button.dropdown-item.reminder-item)
                           so urgency reads at a glance across the whole list. -->
                      <Button Classes="dropdown-item reminder-item"
                              Classes.overdue="{Binding Bucket, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Overdue}"
                              Classes.today="{Binding Bucket, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Today}"
                              Classes.snoozed="{Binding IsSnoozed}"
                              Command="{Binding $parent[ItemsControl].DataContext.OpenCardCommand}"
                              CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Title}">
                        <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding BucketLabel}" Classes="faint" FontSize="9.5"
                                       FontWeight="Bold" LetterSpacing="1"
                                       Classes.overdue="{Binding Bucket, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Overdue}"
                                       Classes.today="{Binding Bucket, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Today}" />
                            <TextBlock Grid.Column="1" Text="{Binding DueDateLabel}" Classes="faint" FontSize="9.5" />
                          </Grid>
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold" FontSize="13"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="icon-btn" Width="20" Height="20" Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding $parent[ItemsControl].DataContext.ToggleSnoozeMenuCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Reminder_Snooze_Tooltip}"
                                    AutomationProperties.Name="{loc:Tr Reminder_Snooze_Tooltip}">
                              <mi:MaterialIcon Kind="AlarmSnooze" Width="12" Height="12" />
                            </Button>
                            <Button Grid.Column="2" Classes="icon-btn" Width="20" Height="20" Margin="4,0,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding $parent[ItemsControl].DataContext.DismissCommand}"
                                    CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr Reminder_DismissTooltip}"
                                    AutomationProperties.Name="{loc:Tr Reminder_DismissTooltip}">
                              <mi:MaterialIcon Kind="Close" Width="11" Height="11" />
                            </Button>
                          </Grid>
                          <!-- "Aplazado hasta 15:40" + contador de aplazamientos: solo con un aplazamiento
                               vigente, y por encima del origen para que se lea junto a la fecha. -->
                          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsSnoozed}">
                            <TextBlock Grid.Column="0" Text="{Binding SnoozedUntilLabel}" Classes="faint"
                                       FontSize="10.5" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding SnoozeCountLabel}" Classes="faint"
                                       FontSize="9.5" Margin="8,0,0,0" IsVisible="{Binding HasSnoozeCount}" />
                          </Grid>
                          <!-- Mismo criterio que en el propio tablero: el nombre de una columna se dibuja
                               siempre en mayúsculas, escriba el usuario lo que escriba. -->
                          <TextBlock Text="{Binding ColumnTitle, Converter={StaticResource UpperCaseConverter}}"
                                     Classes="faint" FontSize="10.5" LetterSpacing="1" />
                        </StackPanel>
                      </Button>

                      <Border Classes="snooze-menu" IsVisible="{Binding IsSnoozeMenuOpen}">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{loc:Tr Reminder_Snooze_MenuTitle, Converter={StaticResource UpperCaseConverter}}"
                                     Classes="eyebrow" FontSize="9.5" Margin="8,0,0,4" />
                          <Button Classes="snooze-option" Content="{Binding $parent[ItemsControl].DataContext.SnoozePrimaryLabel, Converter={StaticResource UpperCaseConverter}}"
                                  Command="{Binding $parent[ItemsControl].DataContext.SnoozePrimaryCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="snooze-option" Content="{Binding $parent[ItemsControl].DataContext.SnoozeSecondaryLabel, Converter={StaticResource UpperCaseConverter}}"
                                  Command="{Binding $parent[ItemsControl].DataContext.SnoozeSecondaryCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="snooze-option" Content="{loc:Tr Reminder_Snooze_Evening, Converter={StaticResource UpperCaseConverter}}"
                                  Command="{Binding $parent[ItemsControl].DataContext.SnoozeEveningCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="snooze-option" Content="{loc:Tr Reminder_Snooze_Tomorrow, Converter={StaticResource UpperCaseConverter}}"
                                  Command="{Binding $parent[ItemsControl].DataContext.SnoozeTomorrowCommand}"
                                  CommandParameter="{Binding}" />

                          <!-- Personalizado: minutos (el rango es el de Services.SnoozeSchedule,
                               1 minuto – 7 días) y confirmación explícita. -->
                          <Grid ColumnDefinitions="*,Auto" Margin="8,6,0,0" ColumnSpacing="6">
                            <NumericUpDown Grid.Column="0" Minimum="1" Maximum="10080" Increment="5"
                                           FormatString="0" FontSize="12"
                                           Value="{Binding $parent[ItemsControl].DataContext.CustomSnoozeMinutes, Mode=TwoWay}"
                                           AutomationProperties.Name="{loc:Tr Reminder_Snooze_CustomMinutes_AccessibleName}" />
                            <Button Grid.Column="1" Classes="ghost" Padding="6,2" VerticalAlignment="Center"
                                    Command="{Binding $parent[ItemsControl].DataContext.SnoozeCustomCommand}"
                                    CommandParameter="{Binding}">
                              <TextBlock Text="{loc:Tr Reminder_Snooze_CustomApply, Converter={StaticResource UpperCaseConverter}}"
                                         FontSize="11" FontWeight="Bold" />
                            </Button>
                          </Grid>

                          <Button Classes="snooze-option" Content="{loc:Tr Reminder_Snooze_Cancel, Converter={StaticResource UpperCaseConverter}}"
                                  IsVisible="{Binding IsSnoozed}"
                                  Command="{Binding $parent[ItemsControl].DataContext.CancelSnoozeCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>

      <!-- ===================== Bandeja de entrada (captura rápida) =====================
           Cuarto botón de contenido de la barra de título: apuntar una idea suelta sin salir de donde
           estés. No estrena ningún almacén — comparte QuickCaptureViewModel con la mini-ventana global
           (Ctrl+Alt+Space) y con la paleta de comandos, así que el borrador y el destino elegido son los
           mismos se abra por donde se abra, y la idea acaba en Inbox/ del vault o como tarjeta Kanban
           igual que allí. Aquí es un popup y no una ventana porque el gesto nace de la propia ventana
           de Enki, ya visible. -->
      <Grid DataContext="{Binding QuickCapture}"
            IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).InboxPanelEnabled}">
        <Button Name="InboxTrigger" Classes="titlebar-btn titlebar-btn-plain" Command="{Binding ToggleCommand}"
                ToolTip.Tip="{loc:Tr Shell_InboxTooltip}"
                AutomationProperties.Name="{loc:Tr Shell_InboxTooltip}">
          <mi:MaterialIcon Kind="InboxOutline" Width="19" Height="19"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>

        <Popup PlacementTarget="{Binding #InboxTrigger}" Placement="BottomEdgeAlignedRight"
               VerticalOffset="6" IsLightDismissEnabled="True"
               OverlayInputPassThroughElement="{Binding #InboxTrigger}"
               IsOpen="{Binding IsOpen, Mode=TwoWay}" Opened="InboxPopup_Opened">
          <Border Classes="dropdown-popover" Width="320">
            <StackPanel Spacing="12">
              <StackPanel Spacing="2">
                <TextBlock Text="{loc:Tr QuickCapture_Title, Converter={StaticResource UpperCaseConverter}}"
                           Classes="eyebrow" FontSize="10.5" />
                <TextBlock Text="{loc:Tr QuickCapture_Subtitle}" Classes="faint" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>

              <TextBox Name="InboxTextBox" Text="{Binding Draft}" Height="110"
                       AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                       PlaceholderText="{loc:Tr QuickCapture_Placeholder}"
                       AutomationProperties.Name="{loc:Tr QuickCapture_Input_AccessibleName}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SubmitCommand}" />
                </TextBox.KeyBindings>
              </TextBox>

              <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Destinations}"
                        SelectedItem="{Binding SelectedDestination}"
                        AutomationProperties.Name="{loc:Tr QuickCapture_Destination_Label}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:QuickCaptureDestinationOption">
                    <TextBlock Text="{Binding Label, Converter={StaticResource UpperCaseConverter}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <ComboBox HorizontalAlignment="Stretch" MinWidth="140" MaxWidth="300" ItemsSource="{Binding KanbanBoards}" SelectedItem="{Binding SelectedKanbanBoard}"
                        IsVisible="{Binding ShowKanbanBoards}" AutomationProperties.Name="{loc:Tr Kanban_Multi_Boards}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="models:KanbanBoard"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding KanbanColumns}"
                        SelectedItem="{Binding SelectedKanbanColumn}"
                        IsVisible="{Binding IsKanbanDestination}"
                        AutomationProperties.Name="{loc:Tr QuickCapture_KanbanColumn_Label}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:QuickCaptureColumnOption">
                    <TextBlock Text="{Binding Title}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                         TextWrapping="Wrap" FontSize="11.5"
                         IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <Button Classes="pill-primary" HorizontalAlignment="Stretch" Command="{Binding SubmitCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                  <TextBlock Text="{loc:Tr QuickCapture_Submit, Converter={StaticResource UpperCaseConverter}}" />
                  <TextBlock Text="{loc:Tr QuickCapture_SubmitHint}" Opacity="0.7" FontSize="10"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>

      <!-- Controles de ventana: al ocultarlos también desaparece el margen del botón de minimizar.
           El StackPanel conserva su alineación derecha y su margen exterior para los iconos restantes.
           Con la barra nativa, el sistema operativo gestiona sus propios controles. -->
      <Button Classes="titlebar-btn" Click="Minimize_Click" ToolTip.Tip="{loc:Tr Shell_MinimizeTooltip}"
              Margin="85,5,5,5"
              IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AreWindowControlsVisible}">
        <mi:MaterialIcon Kind="WindowMinimize" Width="13" Height="13" />
      </Button>
      <Button Classes="titlebar-btn" Click="MaximizeRestore_Click" ToolTip.Tip="{loc:Tr Shell_MaximizeRestoreTooltip}"
              IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AreWindowControlsVisible}">
        <!-- Plain drawn square instead of a MaterialIcon glyph. MaximizeGlyph is the resting
             "maximize" square; RestoreGlyph (two overlapping squares, classic restore mark) swaps
             in once the window is maximized — toggled in MainWindow.axaml.cs. -->
        <Grid Width="12" Height="12">
          <Border x:Name="MaximizeGlyph" Classes="titlebar-glyph" Width="10" Height="10"
                  BorderThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Panel x:Name="RestoreGlyph" IsVisible="False">
            <Border Classes="titlebar-glyph" Width="8" Height="8" BorderThickness="1.2"
                    HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Border Classes="titlebar-glyph" Width="8" Height="8" BorderThickness="1.2"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" />
          </Panel>
        </Grid>
      </Button>
      <Button Classes="titlebar-btn titlebar-btn-close" Click="Close_Click" ToolTip.Tip="{loc:Tr Common_Close}"
              IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AreWindowControlsVisible}">
        <mi:MaterialIcon Kind="WindowClose" Width="14" Height="14" />
      </Button>
    </StackPanel>

  </Grid>
  </LayoutTransformControl>
</Window>
