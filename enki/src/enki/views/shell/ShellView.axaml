<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:models="clr-namespace:enki.Models"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:views="clr-namespace:enki.Views"
             xmlns:conv="clr-namespace:enki.Converters"
             xmlns:baseconv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:motion="clr-namespace:enki.Views"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="1320" d:DesignHeight="820"
             x:Class="enki.Views.ShellView"
             x:DataType="vm:MainWindowViewModel"
             IsVisible="{Binding IsVaultReady}">

  <!-- La shell entera —sidebar, barra de título, host de secciones— vive aquí y no dentro de
       MainWindow.axaml para que su XAML no exista durante el primer fotograma de la aplicación.

       Este archivo son ~300 líneas de XAML que cuestan unos 700 ms de inflado (compiled bindings de cada
       control incluidas) y que solo tienen sentido cuando ya hay un vault que enseñar. Si estuvieran
       declaradas en la ventana, se pagarían antes de poder pintar nada: la ventana no puede dibujar su
       primer fotograma hasta que su árbol entero está construido. Construyéndola después —cuando la
       pantalla de arranque ya está opaca— el primer fotograma de la aplicación es la cortina, y todo esto
       se paga detrás de ella. Ver MainWindow.BuildShell y docs/project-info/pantalla-de-arranque.md. -->

  <Grid ColumnDefinitions="Auto,*">

    <!-- ===================== Sidebar =====================
         Oculto por completo en modo enfoque/zen (propuesta 7, docs/propuesta-nuevas-funcionalidades.md) —
         IsZenMode mirrors whichever note is currently focused (ver MainWindowViewModel.OnNotesPropertyChanged),
         y solo se activa desde dentro de una nota, así que fuera del editor de Notas siempre queda en
         false y el sidebar se comporta exactamente igual que hoy.

         Sin margen: el sidebar va pegado a los bordes de la ventana. El "flotante" de 10px que llevaba
         (Margin="10,10,0,10") nunca se llegó a rematar como panel flotante real —ni sombra, ni radio, ni
         borde en los lados libres, solo un hueco— así que con un tema de alto contraste (p. ej. dark-dev,
         app-background #000 contra sidebar #050505) ese hueco se leía como una costura de píxeles a la
         izquierda en vez de como un panel despegado. -->
    <Border Grid.Column="0" IsVisible="{Binding !IsZenMode}">
      <Border Width="{Binding SidebarWidth}" CornerRadius="0"
              Background="{DynamicResource SidebarBackgroundBrush}">
        <Border BorderBrush="{DynamicResource Ink10}" BorderThickness="0,0,1,0">

          <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="14,18,14,16">

            <!-- Brand header — logo, text, and (only while expanded) the toggle button all share this
                 one row so they line up on the same vertical center. Collapsed: the toggle moves to its
                 own row below (see the second Button further down) instead of squeezing into this row,
                 because the collapsed rail (76px) never has to fit the logo and a 34px button side by
                 side — the middle "*" column's contribution drops to 0 once the title StackPanel hides,
                 so centering the Grid makes the logo sit with equal margins on both sides instead of
                 flush left. El Border es también el recorte del logo: con una imagen personalizada circular
                 (Ajustes › Apariencia › Logo) BrandLogoCornerRadius pasa a half-side y ClipToBounds la
                 redondea. Es la única forma circular del sistema de diseño; con el icono por defecto, o con
                 una imagen cuadrada, el radio vuelve a 0 como todo lo demás.

                 El logo se redujo de 32x32 a 24x24 para que el icono personalizado del panel lateral no
                 dominara visualmente la fila del header junto al texto ENKI / NOTAS MARKDOWN y al toggle de
                 pliegue, mientras que los 24px siguen una proporción coherente con los 20px de los íconos
                 del raíl y con la vista previa de Ajustes › Apariencia (44px). -->
            <Grid Grid.Row="0" Classes="brand-header" Classes.collapsed="{Binding !IsSidebarExpanded}"
                  ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,14"
                  Background="Transparent" PointerPressed="TitleBar_PointerPressed">
              <Border Grid.Column="0" Width="24" Height="24"
                      CornerRadius="{Binding BrandLogoCornerRadius}" ClipToBounds="True">
                <Image Name="BrandIcon" Width="24" Height="24" Stretch="{Binding BrandLogoStretch}"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
              </Border>

              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                          IsVisible="{Binding IsSidebarExpanded}">
                <TextBlock Text="ENKI" FontSize="15" FontWeight="Bold" LetterSpacing="1" />
                <TextBlock Text="{loc:Tr Shell_BrandTagline}" Classes="faint" FontSize="9.5" LetterSpacing="1.5" />
              </StackPanel>

              <!-- Expanded-only toggle: same row as the logo/title, vertically centered alongside them.
                   The collapsed-rail toggle below is a separate Button (own row) rather than this one
                   just moving, since collapsing this row's "*" column to 0 would otherwise pull the
                   toggle flush against the logo instead of leaving it centered in a 76px rail. -->
              <Button Grid.Column="2" Classes="icon-btn sidebar-toggle" VerticalAlignment="Center"
                      Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="{loc:Tr Shell_ToggleSidebarTooltip}"
                      AutomationProperties.Name="{loc:Tr Shell_ToggleSidebarTooltip}"
                      IsVisible="{Binding IsSidebarExpanded}">
                <Border Classes="sidebar-toggle-box" Width="32" Height="32" CornerRadius="0"
                        Background="Transparent">
                  <mi:MaterialIcon Kind="{Binding SidebarToggleIcon}" Width="20" Height="20"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Button>
            </Grid>

            <!-- Collapsed-rail toggle: own row, centered like every other rail square. Hidden while
                 expanded (see the Button above, inside the header row, for that state) instead of both
                 being visible and just repositioned via alignment, since IsVisible="False" collapses
                 this row to 0 height and removes it from layout entirely. -->
            <Button Grid.Row="1" Classes="icon-btn sidebar-toggle collapsed"
                    Command="{Binding ToggleSidebarCommand}"
                    Margin="4,0,4,14" ToolTip.Tip="{loc:Tr Shell_ToggleSidebarTooltip}"
                    AutomationProperties.Name="{loc:Tr Shell_ToggleSidebarTooltip}"
                    IsVisible="{Binding !IsSidebarExpanded}">
              <!-- Hover fill lives on this Border instead of the Button's own ContentPresenter so it's
                   pixel-exact 32x32 with sharp corners — same box as the logo Border above — instead of
                   trusting FluentTheme's default Button padding/border-thickness to net out to the same
                   size. -->
              <Border Classes="sidebar-toggle-box" Width="32" Height="32" CornerRadius="0"
                      Background="Transparent">
                <mi:MaterialIcon Kind="{Binding SidebarToggleIcon}" Width="20" Height="20"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Button>

            <!-- Selector de vault (T4, .docs/project-info/multi-vault-en-caliente.md): el rótulo
                 dice qué carpeta está abierta —la pregunta que se hace quien separa trabajo y vida
                 personal en dos vaults— y al pulsarlo se despliega la lista de recientes. Fila propia
                 entre el brand header y la navegación en vez de dentro del header: el header ya carga con
                 el logo, el nombre de la app y el botón de plegar, y ahí el nombre del vault se leería
                 como parte de la marca. Plegado queda solo el icono, con el nombre en el tooltip, igual
                 que cualquier otra fila del raíl. -->
            <Grid Grid.Row="2" Name="VaultSwitcherRow">
              <Button Name="VaultSwitcherTrigger" Classes="nav-item" Margin="0,4,0,0"
                      Classes.collapsed="{Binding !IsSidebarExpanded}"
                      Classes.active="{Binding VaultSwitcher.IsOpen}"
                      IsVisible="{Binding VaultSwitcherEnabled}"
                      Command="{Binding VaultSwitcher.ToggleCommand}"
                      ToolTip.Tip="{Binding VaultSwitcher.ActiveVaultName}"
                      ToolTip.ServiceEnabled="{Binding !IsSidebarExpanded}"
                      AutomationProperties.Name="{loc:Tr VaultSwitcher_Tooltip}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <mi:MaterialIcon Grid.Column="0" Kind="SafeSquareOutline" Width="20" Height="20"
                                   VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="0"
                              IsVisible="{Binding IsSidebarExpanded}">
                    <TextBlock Text="{loc:Tr VaultSwitcher_Eyebrow, Converter={StaticResource UpperCaseConverter}}"
                               Classes="faint" FontSize="9" LetterSpacing="1.5" />
                    <TextBlock Text="{Binding VaultSwitcher.ActiveVaultName}" FontSize="12"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                  </StackPanel>
                  <mi:MaterialIcon Grid.Column="2" Kind="ChevronDown" Width="16" Height="16"
                                   VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}" />
                </Grid>
              </Button>

              <!-- Anclado a la fila y no al botón: con el selector oculto (Ajustes › General › Barra
                   lateral) el botón deja de tener caja, pero "Cambiar de vault" de la paleta de comandos
                   sigue abriendo este mismo popup, que necesita un ancla con posición real. La fila vacía
                   mide 0 de alto, así que ocultar el botón no deja hueco. -->
              <Popup PlacementTarget="{Binding #VaultSwitcherRow}" Placement="BottomEdgeAlignedLeft"
                     VerticalOffset="6" IsLightDismissEnabled="True"
                     OverlayInputPassThroughElement="{Binding #VaultSwitcherTrigger}"
                     IsOpen="{Binding VaultSwitcher.IsOpen, Mode=TwoWay}">
                <Border Classes="dropdown-popover" Width="320">
                  <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Tr VaultSwitcher_RecentsTitle, Converter={StaticResource UpperCaseConverter}}"
                               Classes="eyebrow" FontSize="10.5" />

                    <ItemsControl ItemsSource="{Binding VaultSwitcher.Recents}"
                                  IsVisible="{Binding VaultSwitcher.HasOtherVaults}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentVaultItemViewModel">
                          <Grid ColumnDefinitions="*,Auto">
                            <Button Grid.Column="0" Classes="dropdown-item"
                                    Classes.active="{Binding IsActive}"
                                    IsEnabled="{Binding IsAvailable}"
                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).VaultSwitcher.OpenRecentCommand}"
                                    CommandParameter="{Binding .}"
                                    AutomationProperties.Name="{Binding DisplayName}">
                              <Grid ColumnDefinitions="Auto,*">
                                <mi:MaterialIcon Grid.Column="0" Kind="FolderOutline" Width="16" Height="16"
                                                 Margin="0,2,10,0" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="2" MinWidth="0">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" MinWidth="0" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Classes="faint"
                                               Text="{loc:Tr VaultSwitcher_ActiveBadge, Converter={StaticResource UpperCaseConverter}}"
                                               IsVisible="{Binding IsActive}" />
                                  </Grid>
                                  <TextBlock Text="{Binding Path}" Classes="faint" FontSize="10"
                                             TextTrimming="CharacterEllipsis" MaxLines="1" />
                                  <TextBlock Text="{Binding LastOpenedLabel}" Classes="faint" FontSize="10"
                                             IsVisible="{Binding IsAvailable}" />
                                  <!-- Ruta no disponible: la entrada se queda, atenuada y con el motivo
                                       concreto (unidad desconectada, permisos), porque es justo la que el
                                       usuario querrá recuperar cuando vuelva a conectar el disco. -->
                                  <TextBlock Text="{Binding UnavailableReason}" Classes="faint" FontSize="10"
                                             TextWrapping="Wrap" IsVisible="{Binding !IsAvailable}" />
                                </StackPanel>
                              </Grid>
                            </Button>
                            <Button Grid.Column="1" Classes="icon-btn icon-btn-danger" Width="28" Height="28"
                                    VerticalAlignment="Top"
                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).VaultSwitcher.RemoveRecentCommand}"
                                    CommandParameter="{Binding .}"
                                    ToolTip.Tip="{loc:Tr VaultSwitcher_RemoveFromRecents}"
                                    AutomationProperties.Name="{loc:Tr VaultSwitcher_RemoveFromRecents}">
                              <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:Tr VaultSwitcher_RemoveHint}" Classes="faint" TextWrapping="Wrap"
                               IsVisible="{Binding VaultSwitcher.HasOtherVaults}" />

                    <Button Classes="pill" HorizontalAlignment="Stretch"
                            Command="{Binding VaultSwitcher.BrowseForVaultCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                        <TextBlock Text="{loc:Tr VaultSwitcher_Browse, Converter={StaticResource UpperCaseConverter}}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>

            <!-- Nav items -->
            <ItemsControl Grid.Row="3" ItemsSource="{Binding NavItems}" Margin="0,24,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:NavItemViewModel">
                  <Button Classes="nav-item"
                          Classes.active="{Binding IsActive}"
                          Classes.collapsed="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                          CommandParameter="{Binding Page}"
                          ToolTip.Tip="{Binding Label}"
                          ToolTip.ServiceEnabled="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <!-- Badge de conteo (Fase 2 §9) — solo "Papelera" y "Calendario" lo fijan (ver
                           MainWindowViewModel.UpdateTrashBadge/UpdateCalendarBadge); el resto siempre
                           queda en 0 y el Border no se muestra. -->
                      <Panel Width="20" Height="20">
                        <mi:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center"
                                         Classes.danger="{Binding IsDanger}" />
                        <Border Classes="titlebar-badge" IsVisible="{Binding HasCount}">
                          <TextBlock Classes="titlebar-badge-text" Text="{Binding Count}" />
                        </Border>
                      </Panel>
                      <TextBlock Text="{Binding Label, Converter={StaticResource UpperCaseConverter}}"
                                 Classes.danger="{Binding IsDanger}"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Grupo fijo del sidebar: hasta 3 secciones "extra" (Ajustes › General › Secciones de la
                 barra lateral), en el orden/visibilidad que el usuario decida arrastrando, más Ajustes
                 siempre al final — mismo ItemTemplate que el ItemsControl de NavItems de arriba, solo que
                 en una lista aparte para que este grupo quede fijo en vez de desplazarse con la principal. -->
            <StackPanel Grid.Row="5" Spacing="4">
              <ItemsControl ItemsSource="{Binding BottomNavItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:NavItemViewModel">
                    <Button Classes="nav-item"
                            Classes.active="{Binding IsActive}"
                            Classes.collapsed="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                            CommandParameter="{Binding Page}"
                            ToolTip.Tip="{Binding Label}"
                            ToolTip.ServiceEnabled="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}">
                      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Panel Width="20" Height="20">
                          <mi:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center"
                                           Classes.danger="{Binding IsDanger}" />
                          <Border Classes="titlebar-badge" IsVisible="{Binding HasCount}">
                            <TextBlock Classes="titlebar-badge-text" Text="{Binding Count}" />
                          </Border>
                        </Panel>
                        <TextBlock Text="{Binding Label, Converter={StaticResource UpperCaseConverter}}"
                                   Classes.danger="{Binding IsDanger}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Ajustes -->
              <Button Classes="nav-item"
                      Classes.active="{Binding IsSettingsActive}"
                      Classes.collapsed="{Binding !IsSidebarExpanded}"
                      Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{loc:Tr Nav_SettingsTooltip}"
                      ToolTip.ServiceEnabled="{Binding !IsSidebarExpanded}">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="CogOutline" Width="20" Height="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{loc:Tr Nav_SettingsLabel, Converter={StaticResource UpperCaseConverter}}" VerticalAlignment="Center"
                             IsVisible="{Binding IsSidebarExpanded}" />
                </StackPanel>
              </Button>
            </StackPanel>

          </Grid>
        </Border>
      </Border>
    </Border>

    <!-- ===================== Content ===================== -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <!-- Reserves clearance for the floating window controls (bottom of this file) so pages whose
           own top-right corner holds a button — the notes tab bar's "cerrar todas las pestañas", for
           one — don't render underneath them. Just empty space, not a visible bar. Always on (not
           gated by UseCustomTitleBar like it used to be) because the notifications/reminders buttons
           float here regardless of title-bar mode, unlike minimize/maximize/close which the OS draws
           itself once UseCustomTitleBar is off. -->
      <Border Grid.Row="0" Height="44" />

      <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
        <!-- Una entrada cancelable por navegación, después de construir la sección. -->
        <views:SectionHost x:Name="PageHost" Page="{Binding CurrentPage}" Scope="{Binding Notes}"
                         motion:MotionReveal.AllowTranslation="{Binding PageRevealAllowsTranslation}"
                         motion:MotionReveal.Revision="{Binding PageRevealRevision}" />

        <!-- Panel lateral del asistente (.docs/project-info/asistente-ia.md): el mismo chat que la sección
             Asistente, junto a cualquier otra sección y sin navegar. Su ancho se ajusta arrastrando el borde
             izquierdo y se guarda al soltar. Su vista no se construye hasta que se abre por primera vez (ver
             ShellView.EnsureAssistantSurfaces): con la IA apagada, la shell no paga su XAML. -->
        <Grid x:Name="AssistantPanelHost" Grid.Column="1" Width="{Binding AssistantPanelWidth}" IsVisible="{Binding IsAssistantPanelVisible}">
          <Panel Width="7" HorizontalAlignment="Left" Cursor="SizeWestEast" Background="Transparent"
                 PointerPressed="AssistantPanelGrip_PointerPressed"
                 PointerMoved="AssistantPanelGrip_PointerMoved"
                 PointerReleased="AssistantPanelGrip_PointerReleased" />
        </Grid>

        <!-- Grano de película sutil sobre todo el shell (§5.1) -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource GrainBrush}" IsHitTestVisible="False" />
      </Grid>

      <!-- Diálogos del asistente: una sola copia para la sección y el panel, anclada a la ventana. También se
           construyen la primera vez que se enseña el asistente. -->
      <Panel x:Name="AssistantDialogsHost" Grid.Row="1" IsVisible="{Binding AssistantPanelEnabled}" />
    </Grid>

  </Grid>

</UserControl>
