<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d"
             x:Class="enki.Views.TagFilterView"
             x:DataType="vm:TagFilterViewModel">

  <Grid>
    <TextBlock Text="{loc:Tr TagFilter_Empty}" Classes="faint" IsVisible="{Binding IsEmpty}" />

    <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding !IsEmpty}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:TagFilterItemViewModel">
          <ToggleButton Classes="tag-chip"
                        Content="{Binding Tag}"
                        IsChecked="{Binding IsSelected, Mode=OneWay}"
                        Command="{Binding ToggleCommand}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
