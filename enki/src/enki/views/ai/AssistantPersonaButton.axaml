<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:models="clr-namespace:enki.Models"
             xmlns:controls="clr-namespace:enki.Controls"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d"
             x:Class="enki.Views.AssistantPersonaButton"
             x:DataType="vm:AssistantViewModel">

  <!-- Personalidad del chat (.docs/project-info/asistente-ia.md, «personalidad»): con quién se habla y qué
       contexto lleva. Enseña la capa general (se edita en Ajustes) y edita las dos que dependen de dónde se está:
       la de la sesión del chat, compartida por todos sus chats, y la del propio chat. Se aplica desde el turno
       siguiente; lo más concreto prevalece. -->
  <Panel>
    <Button x:Name="PersonaTrigger" Classes="date-picker-trigger" HorizontalAlignment="Left"
            VerticalAlignment="Center" Padding="10,7" MaxWidth="220"
            Command="{Binding TogglePersonaEditorCommand}"
            ToolTip.Tip="{Binding PersonaTooltip}" AutomationProperties.Name="{Binding PersonaTooltip}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <mi:MaterialIcon Grid.Column="0" Kind="CardAccountDetailsOutline" Width="13" Height="13" Margin="0,0,8,0"
                         Foreground="{DynamicResource Ink50}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding AssistantName}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <!-- Punto: hay algún contexto activo en este chat. -->
        <Ellipse Grid.Column="2" Width="6" Height="6" Margin="8,0,0,0" Fill="{DynamicResource Ink50}"
                 VerticalAlignment="Center" IsVisible="{Binding HasPersonaContext}" />
        <mi:MaterialIcon Grid.Column="3" Kind="ChevronDown" Width="12" Height="12" Margin="8,0,0,0"
                         Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
      </Grid>
    </Button>

    <Popup x:Name="PersonaPopup" PlacementTarget="{Binding #PersonaTrigger}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
           IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #PersonaTrigger}"
           controls:PopoverKeyboard.CloseOnEscape="True"
           controls:SharedPopover.IsOpen="{Binding IsPersonaEditorOpen, Mode=TwoWay}">
      <Border Classes="dropdown-popover" Width="380" MaxHeight="640">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <TextBlock Text="{loc:Tr Assistant_Persona_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
            <TextBlock Text="{loc:Tr Assistant_Persona_Intro}" Classes="muted" FontSize="12" TextWrapping="Wrap" />

            <!-- Capa general: solo lectura aquí, para no tener dos editores del mismo texto. -->
            <Grid Classes="icon-text-row" ColumnDefinitions="Auto,*">
              <mi:MaterialIcon Grid.Column="0" Kind="AccountCircleOutline" Width="14" Height="14" Margin="0,0,10,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Ink50}" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{Binding AssistantName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding PersonaGeneralPreview}" Classes="faint" FontSize="11.5" TextWrapping="Wrap" />
                <Button Classes="ghost" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding OpenPersonaSettingsCommand}">
                  <TextBlock Text="{loc:Tr Assistant_Persona_EditGeneral, Converter={StaticResource UpperCaseConverter}}" />
                </Button>
              </StackPanel>
            </Grid>

            <!-- Capa de la sesión: solo en chats de sesión. -->
            <StackPanel Spacing="6" IsVisible="{Binding IsSessionChat}">
              <Rectangle Classes="section-rule" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding PersonaSessionTitle, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding PersonaSessionCounter}" Classes="faint" Margin="8,0,0,0" />
              </Grid>
              <TextBox x:Name="PersonaSessionContextBox" Classes="search" Text="{Binding PersonaSessionContextDraft}"
                       MaxLength="{x:Static models:AiPersona.MaxScopedContextLength}"
                       AcceptsReturn="True" TextWrapping="Wrap" Height="96" VerticalContentAlignment="Top"
                       IsEnabled="{Binding CanEditSessionContext}"
                       PlaceholderText="{loc:Tr Assistant_Persona_Session_Placeholder}"
                       AutomationProperties.Name="{Binding PersonaSessionTitle}" />
              <TextBlock Text="{loc:Tr Assistant_Persona_Session_Help}" Classes="faint" FontSize="11" TextWrapping="Wrap"
                         IsVisible="{Binding CanEditSessionContext}" />
              <TextBlock Text="{loc:Tr Assistant_Persona_Session_Unavailable}" Classes="faint" FontSize="11" TextWrapping="Wrap"
                         IsVisible="{Binding !CanEditSessionContext}" />
            </StackPanel>

            <!-- Capa del chat. -->
            <StackPanel Spacing="6">
              <Rectangle Classes="section-rule" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{loc:Tr Assistant_Persona_Chat_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
                <TextBlock Grid.Column="1" Text="{Binding PersonaChatCounter}" Classes="faint" Margin="8,0,0,0" />
              </Grid>
              <TextBox x:Name="PersonaChatContextBox" Classes="search" Text="{Binding PersonaChatContextDraft}"
                       MaxLength="{x:Static models:AiPersona.MaxScopedContextLength}"
                       AcceptsReturn="True" TextWrapping="Wrap" Height="96" VerticalContentAlignment="Top"
                       IsEnabled="{Binding CanEditChatContext}"
                       PlaceholderText="{loc:Tr Assistant_Persona_Chat_Placeholder}"
                       AutomationProperties.Name="{loc:Tr Assistant_Persona_Chat_Title}" />
              <TextBlock Text="{loc:Tr Assistant_Persona_Chat_Help}" Classes="faint" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Classes="icon-text-row" ColumnDefinitions="Auto,*" IsVisible="{Binding HasPersonaError}">
              <mi:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="13" Height="13" Margin="0,0,8,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding PersonaError}" Foreground="{DynamicResource DangerBrush}"
                         FontSize="11.5" TextWrapping="Wrap" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Classes="ghost" Command="{Binding DiscardPersonaChangesCommand}">
                <TextBlock Text="{loc:Tr Assistant_Persona_Cancel, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
              <Button Classes="pill-primary" Command="{Binding SavePersonaCommand}">
                <TextBlock Text="{loc:Tr Assistant_Persona_Save, Converter={StaticResource UpperCaseConverter}}" />
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Popup>
  </Panel>
</UserControl>
