<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:views="clr-namespace:enki.Views"
             xmlns:models="clr-namespace:enki.Models"
             xmlns:controls="clr-namespace:enki.Controls"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="220"
             x:Class="enki.Views.AssistantComposerView"
             x:Name="Root"
             x:DataType="vm:AssistantViewModel">

  <!-- Compositor del asistente, compartido por la sección y el panel lateral (que lo marca "compact"): avisos
       del chat, adjuntos pendientes, cuadro de texto, acciones, alcance y aviso del proveedor. Solo se monta
       una superficie a la vez delante del usuario, así que nunca hay dos compositores editando el mismo
       borrador a la vista. En la sección, mientras el chat está vacío, AssistantView lo coloca en el centro de
       la bienvenida y lo marca "hero": sin márgenes propios y con algo más de alto para escribir. -->

  <UserControl.Styles>
    <Style Selector="Border#ComposerFrame">
      <Setter Property="Padding" Value="32,8,32,20" />
    </Style>
    <Style Selector="views|AssistantComposerView.compact Border#ComposerFrame">
      <Setter Property="Padding" Value="12,8,12,12" />
    </Style>
    <Style Selector="views|AssistantComposerView.hero Border#ComposerFrame">
      <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Un único marco: el cuadro de texto y la barra comparten fondo, sin línea entre ambos. El borde sube
         de tinta al pasar el cursor y al recibir el foco (§7.3). -->
    <Style Selector="Border#ComposerSurface">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ink15}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionInteractionDuration}" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="views|AssistantComposerView.hero Border#ComposerSurface">
      <Setter Property="BorderBrush" Value="{DynamicResource Ink20}" />
    </Style>
    <Style Selector="Border#ComposerSurface:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Ink30}" />
    </Style>
    <Style Selector="Border#ComposerSurface:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Ink50}" />
    </Style>

    <Style Selector="TextBox#ComposerBox">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="MaxHeight" Value="240" />
      <Setter Property="Padding" Value="16,14,16,6" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="views|AssistantComposerView.hero TextBox#ComposerBox">
      <Setter Property="MinHeight" Value="80" />
      <Setter Property="Padding" Value="18,16,18,6" />
    </Style>
    <Style Selector="views|AssistantComposerView.compact TextBox#ComposerBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MaxHeight" Value="180" />
      <Setter Property="Padding" Value="12,11,12,4" />
    </Style>
    <!-- Los estados de Fluent (:pointerover, :focus, :disabled) pintan su propio fondo y borde sobre la parte
         de plantilla y le ganan a un estilo sin pseudoclase: sin repetirlos aquí, al enfocar aparecía un
         segundo recuadro negro dentro del marco. -->
    <Style Selector="TextBox#ComposerBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox#ComposerBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox#ComposerBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox#ComposerBox:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox#ComposerBox:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Atajos de teclado: a la vista solo mientras se escribe, y no en el ancho estrecho del panel (allí
         siguen en el popover de información). -->
    <Style Selector="TextBlock#ComposerHint">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="views|AssistantComposerView:not(.compact) Border#ComposerSurface:focus-within TextBlock#ComposerHint">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Adjuntar la nota abierta: chip con el mismo hairline que los adjuntos ya añadidos. -->
    <Style Selector="Button.composer-chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ink15}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.composer-chip /template/ ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionInteractionDuration}" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.composer-chip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.composer-chip mi|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.composer-chip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ink40}" />
    </Style>
    <Style Selector="Button.composer-chip:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.composer-chip:pointerover mi|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Enviar y detener: cuadrados de icono. Enviar parte de Button.pill-primary (sólido, invierte al pasar el
         cursor); deshabilitado no es un bloque gris al 35 % sino un hueco apenas marcado, para que se note al
         instante cuándo ya se puede enviar. Detener parte de Button.pill (contorno). -->
    <Style Selector="Button.composer-send">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="Button.composer-send:disabled">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.composer-send:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Ink05}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Ink10}" />
    </Style>
    <Style Selector="Button.composer-send:disabled mi|MaterialIcon">
      <Setter Property="Foreground" Value="{DynamicResource Ink30}" />
    </Style>
    <!-- Adjunto que no se puede enviar: además del icono y el motivo, el borde lo distingue sin depender solo
         del color del texto. -->
    <Style Selector="Border.attachment-chip">
      <Setter Property="BorderBrush" Value="{DynamicResource Ink10}" />
    </Style>
    <Style Selector="Border.attachment-chip.problem">
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="ComposerFrame">
    <!-- Los popovers van fuera de la pila: aunque midan cero, cada hijo visible de un StackPanel suma su
         Spacing, y añadían un hueco invisible bajo el marco. -->
    <Panel>
      <StackPanel MaxWidth="860" Spacing="10">

        <!-- Conversación de antes de separar el historial por vault: se lee, pero se continúa tras asociarla. -->
        <Border Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}" BorderThickness="1" Padding="12,10"
                IsVisible="{Binding IsUnassignedChat}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <mi:MaterialIcon Grid.Column="0" Kind="LinkVariant" Width="14" Height="14" Margin="0,1,10,0" VerticalAlignment="Top"
                             Foreground="{DynamicResource Ink50}" />
            <TextBlock Grid.Column="1" Text="{loc:Tr Assistant_Unassigned_Banner}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="pill pill-compact" Margin="12,0,0,0" VerticalAlignment="Center"
                    Command="{Binding AssignActiveChatToVaultCommand}">
              <TextBlock Text="{loc:Tr Assistant_Unassigned_Assign, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </Border>

        <!-- El espacio del chat no está disponible (sesión borrada o bloqueada): se dice antes de escribir. -->
        <Border Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}" BorderThickness="1" Padding="12,9"
                IsVisible="{Binding HasScopeWarning}">
          <Grid ColumnDefinitions="Auto,*">
            <mi:MaterialIcon Grid.Column="0" Kind="LockOutline" Width="14" Height="14" Margin="0,1,10,0" VerticalAlignment="Top"
                             Foreground="{DynamicResource Ink50}" />
            <TextBlock Grid.Column="1" Text="{Binding ScopeWarning}" FontSize="12" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <!-- Borrador restaurado con adjuntos que ya no existen o quedaron fuera del ámbito. -->
        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasDraftNotice}">
          <mi:MaterialIcon Grid.Column="0" Kind="InformationOutline" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Ink50}" />
          <TextBlock Grid.Column="1" Text="{Binding DraftNotice}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="icon-btn" Width="22" Height="22" Command="{Binding DismissDraftNoticeCommand}"
                  ToolTip.Tip="{loc:Tr Common_Close}" AutomationProperties.Name="{loc:Tr Common_Close}">
            <mi:MaterialIcon Kind="Close" Width="11" Height="11" />
          </Button>
        </Grid>

        <!-- Un único marco agrupa el borrador, sus adjuntos y las acciones. El foco se señala en todo
             el compositor; la barra reserva siempre espacio para enviar o detener. Pulsar en cualquier hueco
             del marco lleva el foco al cuadro de texto. -->
        <Border x:Name="ComposerSurface" CornerRadius="0" Cursor="IBeam" PointerPressed="ComposerSurface_PointerPressed">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding PendingAttachments}" IsVisible="{Binding HasPendingAttachments}" Margin="14,12,14,0"
                          Cursor="Arrow">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:AiAttachmentChipViewModel">
                  <Border Classes="attachment-chip" Classes.problem="{Binding HasProblem}" Background="{DynamicResource Ink05}"
                          BorderThickness="1" Padding="10,2,2,2" Margin="0,0,6,6" ToolTip.Tip="{Binding WorkspaceLabel}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <mi:MaterialIcon Kind="{Binding Icon}" Width="12" Height="12" Foreground="{DynamicResource Ink50}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Title}" FontSize="11.5" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasProblem}" VerticalAlignment="Center">
                        <mi:MaterialIcon Kind="AlertCircleOutline" Width="11" Height="11" Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="{Binding Problem}" FontSize="10.5" Foreground="{DynamicResource DangerBrush}" MaxWidth="220"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Problem}" />
                      </StackPanel>
                      <Button Classes="icon-btn" Width="22" Height="22"
                              Command="{Binding #Root.((vm:AssistantViewModel)DataContext).RemoveAttachmentCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="{loc:Tr Assistant_Composer_RemoveAttachment}" AutomationProperties.Name="{loc:Tr Assistant_Composer_RemoveAttachment}">
                        <mi:MaterialIcon Kind="Close" Width="11" Height="11" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox x:Name="ComposerBox" Text="{Binding DraftText}" AcceptsReturn="True" TextWrapping="Wrap"
                     Background="Transparent" BorderThickness="0" FontSize="14" FontWeight="Normal"
                     VerticalContentAlignment="Top" IsEnabled="{Binding !IsUnassignedChat}"
                     PlaceholderForeground="{DynamicResource Ink40}"
                     PlaceholderText="{loc:Tr Assistant_Composer_Placeholder}"
                     AutomationProperties.Name="{loc:Tr Assistant_Composer_Placeholder}" />

            <Grid x:Name="ComposerToolbar" ColumnDefinitions="*,Auto,Auto,Auto" Margin="8,2,8,8" Cursor="Arrow">
              <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ItemSpacing="2" LineSpacing="4" Margin="0,0,8,0">
                <Button x:Name="AttachNoteTrigger" Classes="icon-btn" Width="34" Height="34"
                        Command="{Binding ToggleNotePickerCommand}" IsEnabled="{Binding CanAttachMore}"
                        ToolTip.Tip="{loc:Tr Assistant_Composer_AttachNote}" AutomationProperties.Name="{loc:Tr Assistant_Composer_AttachNote}">
                  <mi:MaterialIcon Kind="Paperclip" Width="16" Height="16" />
                </Button>
                <Button x:Name="SkillTrigger" Classes="icon-btn" Width="34" Height="34"
                        Command="{Binding ToggleSkillPickerCommand}" IsVisible="{Binding CanPickSkill}"
                        ToolTip.Tip="{loc:Tr Assistant_Composer_PickSkill}" AutomationProperties.Name="{loc:Tr Assistant_Composer_PickSkill}">
                  <mi:MaterialIcon Kind="Brain" Width="16" Height="16" />
                </Button>
                <Button Classes="icon-btn" Width="34" Height="34"
                        Command="{Binding ClearSkillCommand}" IsVisible="{Binding HasActiveSkill}"
                        ToolTip.Tip="{loc:Tr Assistant_Composer_ClearSkill}" AutomationProperties.Name="{loc:Tr Assistant_Composer_ClearSkill}">
                  <mi:MaterialIcon Kind="CloseCircleOutline" Width="16" Height="16" />
                </Button>
                <Button Classes="composer-chip"
                        Command="{Binding AttachActiveNoteCommand}" IsVisible="{Binding CanAttachActiveNote}"
                        ToolTip.Tip="{Binding ActiveNoteLabel}" AutomationProperties.Name="{Binding ActiveNoteLabel}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <mi:MaterialIcon Kind="NotePlusOutline" Width="13" Height="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActiveNoteLabel}" FontSize="11.5" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </WrapPanel>
              <TextBlock Grid.Column="1" x:Name="ComposerHint" Text="{loc:Tr Assistant_Composer_Hint}" Classes="faint"
                         MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
              <Button Grid.Column="2" x:Name="ComposerHelpTrigger" Classes="icon-btn" Width="34" Height="34"
                      Margin="0,0,6,0" VerticalAlignment="Bottom" Click="ComposerHelp_Click"
                      ToolTip.Tip="{loc:Tr Assistant_Composer_Help}" AutomationProperties.Name="{loc:Tr Assistant_Composer_Help}">
                <mi:MaterialIcon Kind="InformationOutline" Width="16" Height="16" />
              </Button>
              <Button Grid.Column="3" x:Name="SendButton" Classes="pill-primary composer-send"
                      Command="{Binding SendCommand}" IsVisible="{Binding !IsSending}"
                      ToolTip.Tip="{loc:Tr Assistant_Composer_Send}" AutomationProperties.Name="{loc:Tr Assistant_Composer_Send}">
                <mi:MaterialIcon Kind="ArrowUp" Width="17" Height="17" />
              </Button>
              <Button Grid.Column="3" x:Name="StopButton" Classes="pill composer-send"
                      Command="{Binding StopCommand}" IsVisible="{Binding IsSending}"
                      ToolTip.Tip="{loc:Tr Assistant_Composer_Stop}" AutomationProperties.Name="{loc:Tr Assistant_Composer_Stop}">
                <mi:MaterialIcon Kind="Stop" Width="16" Height="16" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- La ayuda se superpone al hilo y no añade filas bajo el compositor. -->
      <Popup x:Name="ComposerHelpPopup" PlacementTarget="{Binding #ComposerHelpTrigger}"
             Placement="TopEdgeAlignedRight" VerticalOffset="-6" IsLightDismissEnabled="True"
             OverlayInputPassThroughElement="{Binding #ComposerHelpTrigger}"
             controls:PopoverKeyboard.CloseOnEscape="True">
        <Border Classes="dropdown-popover" Width="300" Focusable="True">
          <StackPanel Spacing="12">
            <TextBlock Text="{loc:Tr Assistant_Composer_Help}" FontSize="12" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="Auto,*">
              <mi:MaterialIcon Kind="{Binding ScopeIcon}" Width="13" Height="13" Margin="0,2,8,0"
                               VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding ScopeSummary}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Text="{loc:Tr Assistant_Composer_Disclaimer}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Tr Assistant_Composer_Hint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Popup>

      <!-- Selector de adjuntos: notas o archivos de texto del ámbito, mismo popover que "vincular nota" de
           Kanban. Los archivos que no son texto se ven, deshabilitados y con el motivo. -->
      <Popup PlacementTarget="{Binding #AttachNoteTrigger}" Placement="TopEdgeAlignedLeft" VerticalOffset="-6"
             IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #AttachNoteTrigger}"
             controls:PopoverKeyboard.CloseOnEscape="True"
             IsOpen="{Binding IsNotePickerOpen, Mode=TwoWay}">
        <Border Classes="dropdown-popover" Width="360">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal">
              <RadioButton Classes="segment" GroupName="AssistantAttachKind"
                           Content="{loc:Tr Assistant_Picker_Notes, Converter={StaticResource UpperCaseConverter}}"
                           IsChecked="{Binding !IsPickingFiles, Mode=OneWay}" Command="{Binding ShowPickerNotesCommand}" />
              <RadioButton Classes="segment" GroupName="AssistantAttachKind"
                           Content="{loc:Tr Assistant_Picker_Files, Converter={StaticResource UpperCaseConverter}}"
                           IsChecked="{Binding IsPickingFiles, Mode=OneWay}" Command="{Binding ShowPickerFilesCommand}" />
            </StackPanel>
            <TextBox Classes="search" Text="{Binding NotePickerSearchText}"
                     PlaceholderText="{loc:Tr Kanban_NotePicker_SearchPlaceholder}"
                     AutomationProperties.Name="{loc:Tr Kanban_NotePicker_SearchPlaceholder}" />
            <ScrollViewer MaxHeight="280">
              <ItemsControl ItemsSource="{Binding NotePickerResults}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:AiAttachmentPickerItemViewModel">
                    <Button Classes="dropdown-item" IsEnabled="{Binding IsEnabled}"
                            Command="{Binding #Root.((vm:AssistantViewModel)DataContext).PickNoteCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                      <Grid ColumnDefinitions="Auto,*">
                        <mi:MaterialIcon Grid.Column="0" Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,10,0"
                                         Foreground="{DynamicResource Ink50}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" Classes="faint" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{loc:Tr Kanban_NotePicker_NoResults}" Classes="muted" FontSize="12.5"
                       IsVisible="{Binding !NotePickerResults.Count}" />
            <TextBlock Text="{loc:Tr Assistant_Picker_FilesHint}" Classes="faint" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding IsPickingFiles}" />
          </StackPanel>
        </Border>
      </Popup>

      <!-- Selector de skill de partida. -->
      <Popup PlacementTarget="{Binding #SkillTrigger}" Placement="TopEdgeAlignedLeft" VerticalOffset="-6"
             IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #SkillTrigger}"
             controls:PopoverKeyboard.CloseOnEscape="True"
             IsOpen="{Binding IsSkillPickerOpen, Mode=TwoWay}">
        <Border Classes="dropdown-popover" Width="340">
          <StackPanel Spacing="10">
            <TextBlock Text="{loc:Tr Assistant_Composer_PickSkill, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" />
            <TextBlock Text="{loc:Tr Assistant_Composer_SkillFixedHint}" Classes="faint" FontSize="11" TextWrapping="Wrap" />
            <ScrollViewer MaxHeight="300">
              <ItemsControl ItemsSource="{Binding SkillOptions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="models:SkillFile">
                    <Button Classes="dropdown-item"
                            Command="{Binding #Root.((vm:AssistantViewModel)DataContext).PickSkillCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" Classes="faint" TextTrimming="CharacterEllipsis" MaxLines="1" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{loc:Tr Assistant_Composer_NoSkills}" Classes="muted" FontSize="12.5" TextWrapping="Wrap"
                       IsVisible="{Binding !SkillOptions.Count}" />
          </StackPanel>
        </Border>
      </Popup>
    </Panel>
  </Border>
</UserControl>
