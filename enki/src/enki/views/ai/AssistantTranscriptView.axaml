<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:views="clr-namespace:enki.Views"
             xmlns:controls="clr-namespace:enki.Controls"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="640"
             x:Class="enki.Views.AssistantTranscriptView"
             x:Name="Root"
             x:DataType="vm:AssistantViewModel">

  <!-- Lo que se ve entre la cabecera y el compositor del asistente, compartido por la sección y el panel
       lateral: comprobación del proveedor, puesta en marcha (instalar, iniciar sesión, clave de API,
       actualizar), la conversación o la bienvenida de un chat vacío, y el error del último turno. El panel la
       marca con la clase "compact", donde los márgenes y el titular se estrechan; la sección, con
       "external-welcome", porque monta su propia bienvenida con el compositor centrado. -->

  <UserControl.Styles>
    <!-- Márgenes por estilo y no en el XAML de cada control: un valor local le gana a cualquier estilo, y la
         variante "compact" de abajo no llegaría a aplicarse. -->
    <Style Selector="ItemsControl#MessageList">
      <Setter Property="Margin" Value="32,24,32,16" />
    </Style>
    <Style Selector="StackPanel#SetupPanel">
      <Setter Property="Margin" Value="32,48" />
    </Style>
    <Style Selector="Border#ErrorBox">
      <Setter Property="Margin" Value="32,0,32,10" />
    </Style>
    <Style Selector="views|AssistantTranscriptView.compact ItemsControl#MessageList">
      <Setter Property="Margin" Value="16,16,16,12" />
    </Style>
    <Style Selector="views|AssistantTranscriptView.external-welcome Panel#WelcomeHost">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="views|AssistantTranscriptView.compact StackPanel#SetupPanel">
      <Setter Property="Margin" Value="18,28" />
    </Style>
    <Style Selector="TextBlock#ChatUsage">
      <Setter Property="Margin" Value="32,0,32,8" />
    </Style>
    <Style Selector="views|AssistantTranscriptView.compact TextBlock#ChatUsage">
      <Setter Property="Margin" Value="16,0,16,6" />
    </Style>
    <Style Selector="views|AssistantTranscriptView.compact Border#ErrorBox">
      <Setter Property="Margin" Value="16,0,16,8" />
    </Style>
    <Style Selector="views|AssistantTranscriptView.compact TextBlock.page-title">
      <Setter Property="FontSize" Value="18" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto,Auto">

    <!-- · Comprobando el proveedor por primera vez · -->
    <StackPanel Grid.Row="0" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="{Binding Cli.ShowChecking}">
      <controls:LoadingSpinner Width="22" Height="22" Foreground="{DynamicResource Ink40}" />
      <TextBlock Text="{loc:Tr Assistant_State_Checking}" Classes="muted" FontSize="12.5" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- · Puesta en marcha: instalar, iniciar sesión, guardar la clave de API o actualizar · -->
    <ScrollViewer Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding ShowSetupPanel}">
      <StackPanel x:Name="SetupPanel" MaxWidth="600" Spacing="22" HorizontalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="{loc:Tr Assistant_Setup_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" />
          <TextBlock Text="{loc:Tr Assistant_Setup_NotInstalled_Title}" Classes="page-title" TextWrapping="Wrap"
                     IsVisible="{Binding Cli.IsNotInstalled}" />
          <TextBlock Text="{loc:Tr Assistant_Setup_SignedOut_Title}" Classes="page-title" TextWrapping="Wrap"
                     IsVisible="{Binding ShowLoginSetup}" />
          <TextBlock Text="{Binding Cli.ApiKeySetupTitle}" Classes="page-title" TextWrapping="Wrap"
                     IsVisible="{Binding ShowApiKeySetup}" />
          <TextBlock Text="{loc:Tr Assistant_Setup_Unsupported_Title}" Classes="page-title" TextWrapping="Wrap"
                     IsVisible="{Binding Cli.IsUnsupported}" />
          <TextBlock Text="{loc:Tr Assistant_Setup_NotInstalled_Message}" Classes="muted" FontSize="13.5" TextWrapping="Wrap"
                     IsVisible="{Binding Cli.IsNotInstalled}" />
          <TextBlock Text="{loc:Tr Assistant_Setup_SignedOut_Message}" Classes="muted" FontSize="13.5" TextWrapping="Wrap"
                     IsVisible="{Binding ShowLoginSetup}" />
          <TextBlock Text="{Binding Cli.ApiKeySetupMessage}" Classes="muted" FontSize="13.5" TextWrapping="Wrap"
                     IsVisible="{Binding ShowApiKeySetup}" />
          <TextBlock Text="{Binding Cli.UnsupportedMessage}" Classes="muted" FontSize="13.5" TextWrapping="Wrap"
                     IsVisible="{Binding Cli.IsUnsupported}" />
        </StackPanel>

        <!-- Orden a copiar en una terminal. Enki no la ejecuta: instalar e iniciar sesión pasan siempre
             por el propio CLI y por la página del proveedor. Con una clave de API (Claude con clave propia,
             Gemini) no hay orden: se guarda en Ajustes. -->
        <Border Classes="card" Padding="0" IsVisible="{Binding ShowSetupCommand}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="$" Classes="faint" FontFamily="{DynamicResource CodeFontFamily}"
                       FontSize="13" VerticalAlignment="Center" Margin="16,0,10,0" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding Cli.LoginCommand}" IsVisible="{Binding ShowLoginSetup}"
                                 FontFamily="{DynamicResource CodeFontFamily}" FontSize="13" VerticalAlignment="Center" Margin="0,14" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding Cli.InstallCommand}" IsVisible="{Binding !Cli.IsSignedOut}"
                                 FontFamily="{DynamicResource CodeFontFamily}" FontSize="13" VerticalAlignment="Center"
                                 TextWrapping="Wrap" Margin="0,14" />
            <Button Grid.Column="2" Classes="icon-btn" Width="36" Height="36" Margin="8,0"
                    Command="{Binding CopyTextCommand}" CommandParameter="{Binding Cli.LoginCommand}"
                    IsVisible="{Binding ShowLoginSetup}"
                    ToolTip.Tip="{loc:Tr Assistant_Setup_CopyCommand}" AutomationProperties.Name="{loc:Tr Assistant_Setup_CopyCommand}">
              <mi:MaterialIcon Kind="ContentCopy" Width="15" Height="15" />
            </Button>
            <Button Grid.Column="2" Classes="icon-btn" Width="36" Height="36" Margin="8,0"
                    Command="{Binding CopyTextCommand}" CommandParameter="{Binding Cli.InstallCommand}"
                    IsVisible="{Binding !Cli.IsSignedOut}"
                    ToolTip.Tip="{loc:Tr Assistant_Setup_CopyCommand}" AutomationProperties.Name="{loc:Tr Assistant_Setup_CopyCommand}">
              <mi:MaterialIcon Kind="ContentCopy" Width="15" Height="15" />
            </Button>
          </Grid>
        </Border>

        <WrapPanel Orientation="Horizontal">
          <Button Classes="pill-primary" Margin="0,0,10,10" Command="{Binding OpenSettingsCommand}"
                  IsVisible="{Binding ShowApiKeySetup}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="KeyOutline" Width="14" Height="14" />
              <TextBlock Text="{loc:Tr Assistant_Setup_ApiKey_Open, Converter={StaticResource UpperCaseConverter}}" />
            </StackPanel>
          </Button>
          <Button Classes="pill" Margin="0,0,10,10" Command="{Binding Cli.OpenApiKeysPageCommand}"
                  IsVisible="{Binding ShowApiKeySetup}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="OpenInNew" Width="13" Height="13" />
              <TextBlock Text="{Binding Cli.ApiKeysPageLabel, Converter={StaticResource UpperCaseConverter}}" />
            </StackPanel>
          </Button>
          <Button Classes="pill-primary" Margin="0,0,10,10" Command="{Binding Cli.RefreshCommand}"
                  IsVisible="{Binding !ShowApiKeySetup}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="Refresh" Width="14" Height="14" Classes.spin="{Binding Cli.IsChecking}" />
              <TextBlock Text="{loc:Tr Assistant_Setup_CheckAgain, Converter={StaticResource UpperCaseConverter}}" />
            </StackPanel>
          </Button>
          <Button Classes="pill" Margin="0,0,10,10" Command="{Binding OpenSetupDocumentationCommand}"
                  IsVisible="{Binding !Cli.IsSignedOut}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="OpenInNew" Width="13" Height="13" />
              <TextBlock Text="{Binding Cli.SetupGuideLabel, Converter={StaticResource UpperCaseConverter}}" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" Margin="0,0,10,10" Command="{Binding OpenSettingsCommand}"
                  IsVisible="{Binding ShowSetupCommand}"
                  Content="{loc:Tr Assistant_Setup_CustomPath, Converter={StaticResource UpperCaseConverter}}" />
          <Button Classes="ghost" Margin="0,0,10,10" Command="{Binding OpenSettingsCommand}"
                  IsVisible="{Binding ShowSettingsShortcut}"
                  Content="{loc:Tr Assistant_Setup_ApiKey_Open, Converter={StaticResource UpperCaseConverter}}" />
        </WrapPanel>

        <TextBlock Text="{Binding Cli.ExecutablePathLabel}" Classes="faint" FontSize="11" TextWrapping="Wrap"
                   IsVisible="{Binding Cli.ExecutablePathLabel, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

        <Rectangle Classes="section-rule" />
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <mi:MaterialIcon Kind="ShieldLockOutline" Width="14" Height="14" Foreground="{DynamicResource Ink40}" />
            <TextBlock Text="{loc:Tr Assistant_Privacy_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" FontSize="9.5" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{loc:Tr Assistant_Privacy_Message}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding OpenTermsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="OpenInNew" Width="12" Height="12" />
              <TextBlock Text="{loc:Tr Assistant_Privacy_TermsLink, Converter={StaticResource UpperCaseConverter}}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- · Conversación o bienvenida · -->
    <Grid Grid.Row="0" IsVisible="{Binding Cli.IsReady}">
      <ScrollViewer x:Name="TranscriptScroll" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasMessages}">
        <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}" MaxWidth="860">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="22" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:AiChatMessageViewModel">
              <Panel>
                <!-- Mensaje del usuario: a la derecha, sobre un fondo sutil, con sus adjuntos. -->
                <StackPanel IsVisible="{Binding IsUser}" HorizontalAlignment="Right" MaxWidth="640" Spacing="6">
                  <Border Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}" BorderThickness="1"
                          Padding="16,11" HorizontalAlignment="Right">
                    <SelectableTextBlock Text="{Binding Text}" FontSize="13.5" LineHeight="20" TextWrapping="Wrap"
                                         SelectionBrush="{DynamicResource SelectionBackgroundBrush}" />
                  </Border>
                  <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:AiAttachmentChipViewModel">
                        <Border Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}" BorderThickness="1"
                                Padding="8,4" Margin="6,0,0,6" ToolTip.Tip="{Binding WorkspaceLabel}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="{Binding Icon}" Width="12" Height="12" Foreground="{DynamicResource Ink50}" />
                            <TextBlock Text="{Binding Title}" FontSize="11" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Classes="faint" FontSize="10" VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Respuesta: a todo el ancho, renderizada desde su Markdown. -->
                <StackPanel IsVisible="{Binding IsAssistant}" Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="Creation" Width="13" Height="13" Foreground="{DynamicResource Ink50}" />
                    <TextBlock Text="{Binding #Root.((vm:AssistantViewModel)DataContext).AssistantName, Converter={StaticResource UpperCaseConverter}, FallbackValue={x:Null}}"
                               Classes="eyebrow" FontSize="9.5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TimeLabel}" Classes="faint" FontSize="10" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsThinking}">
                    <controls:LoadingSpinner Width="14" Height="14" Foreground="{DynamicResource Ink40}" />
                    <TextBlock Text="{loc:Tr Assistant_Message_Thinking}" Classes="muted" FontSize="12.5" />
                  </StackPanel>

                  <!-- Acciones plegadas por defecto en cada respuesta. El contador sigue actualizándose
                       en vivo; solo el usuario abre el detalle. Los permisos y confirmaciones quedan fuera. -->
                  <Border IsVisible="{Binding HasActivities}" BorderBrush="{DynamicResource Ink10}" BorderThickness="1,0,0,0"
                          Padding="14,2,0,2">
                    <StackPanel Spacing="6">
                      <!-- WrapPanel: en el panel lateral estrecho, "Revertir" baja a la línea siguiente. -->
                      <WrapPanel Orientation="Horizontal">
                        <Button Name="ActivitiesToggle" Classes="section-header" Command="{Binding ToggleActivitiesCommand}" Margin="0,0,14,0"
                                ToolTip.Tip="{Binding ActivitiesToggleTooltip}" AutomationProperties.Name="{Binding ActivitiesToggleTooltip}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="{Binding IsActivitiesExpanded, Converter={StaticResource ExpandChevronConverter}}"
                                             Width="13" Height="13" Foreground="{DynamicResource Ink40}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActivitiesLabel, Converter={StaticResource UpperCaseConverter}}"
                                       Classes="eyebrow" FontSize="9" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <!-- Deshace lo que cambió esta respuesta. Pide confirmación; mientras llega otra respuesta no se ofrece. -->
                        <Button Name="RevertButton" Classes="ghost" VerticalAlignment="Center"
                                Command="{Binding #Root.((vm:AssistantViewModel)DataContext).RequestRevertMessageCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="{loc:Tr Assistant_Undo_Tooltip}" AutomationProperties.Name="{loc:Tr Assistant_Undo_Action}">
                          <Button.IsVisible>
                            <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                              <Binding Path="CanRevert" />
                              <Binding Path="#Root.((vm:AssistantViewModel)DataContext).CanRevertResponses" />
                            </MultiBinding>
                          </Button.IsVisible>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <mi:MaterialIcon Kind="UndoVariant" Width="12" Height="12" />
                            <TextBlock Text="{loc:Tr Assistant_Undo_Action, Converter={StaticResource UpperCaseConverter}}" />
                          </StackPanel>
                        </Button>
                      </WrapPanel>
                      <ItemsControl Name="ActivitiesList" ItemsSource="{Binding Activities}" IsVisible="{Binding IsActivitiesExpanded}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:AiToolActivityViewModel">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" MinHeight="24">
                              <Panel Grid.Column="0" Width="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <controls:LoadingSpinner Width="12" Height="12" Foreground="{DynamicResource Ink40}"
                                                 IsVisible="{Binding IsRunning}" />
                                <mi:MaterialIcon Kind="Check" Width="12" Height="12" Foreground="{DynamicResource SuccessBrush}"
                                                 IsVisible="{Binding IsSucceeded}" />
                                <mi:MaterialIcon Kind="AlertCircleOutline" Width="12" Height="12" Foreground="{DynamicResource DangerBrush}"
                                                 IsVisible="{Binding IsFailed}" />
                                <mi:MaterialIcon Kind="Cancel" Width="12" Height="12" Foreground="{DynamicResource Ink40}"
                                                 IsVisible="{Binding IsDenied}" />
                                <mi:MaterialIcon Kind="ProgressClock" Width="12" Height="12" Foreground="{DynamicResource Ink50}"
                                                 IsVisible="{Binding IsPending}" />
                                <mi:MaterialIcon Kind="CloseCircleOutline" Width="12" Height="12" Foreground="{DynamicResource Ink40}"
                                                 IsVisible="{Binding IsDiscarded}" />
                              </Panel>
                              <mi:MaterialIcon Grid.Column="1" Kind="{Binding Icon}" Width="12" Height="12" Margin="0,0,8,0"
                                               Foreground="{DynamicResource Ink50}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center"
                                          ClipToBounds="True">
                                <TextBlock Text="{Binding Target}" Classes="muted" FontSize="12" MaxWidth="340"
                                           TextTrimming="CharacterEllipsis" IsVisible="{Binding HasTarget}" ToolTip.Tip="{Binding TargetTooltip}" />
                                <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{DynamicResource DangerBrush}" MaxWidth="320"
                                           TextTrimming="CharacterEllipsis" IsVisible="{Binding HasError}" ToolTip.Tip="{Binding Error}" />
                                <!-- Tras "Revertir esta respuesta": deshecha, o por qué se dejó como estaba. -->
                                <TextBlock Text="{Binding RevertNote}" Classes="faint" FontSize="11" MaxWidth="320"
                                           TextTrimming="CharacterEllipsis" IsVisible="{Binding HasRevertNote}" ToolTip.Tip="{Binding RevertNote}" />
                              </StackPanel>
                              <Button Grid.Column="4" Classes="icon-btn" Width="24" Height="24" IsVisible="{Binding CanOpen}"
                                      Command="{Binding #Root.((vm:AssistantViewModel)DataContext).OpenActivityCommand}" CommandParameter="{Binding}"
                                      ToolTip.Tip="{loc:Tr Assistant_Activity_Open}" AutomationProperties.Name="{loc:Tr Assistant_Activity_Open}">
                                <mi:MaterialIcon Kind="OpenInNew" Width="12" Height="12" />
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <!-- Revisión de cambios por lotes: lo que esta respuesta preparó y aún no se ha escrito. Cada cambio
                       con su diff; se aplican los marcados o se descartan todos. Mientras llega la respuesta solo se ve. -->
                  <Border Name="ReviewCard" IsVisible="{Binding HasReview}" BorderThickness="1" Padding="16,14"
                          BorderBrush="{DynamicResource Ink30}" Background="{DynamicResource Ink05}">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <mi:MaterialIcon Grid.Column="0" Kind="FileCompare" Width="16" Height="16" Margin="0,0,10,0"
                                         Foreground="{DynamicResource Ink50}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Review.Summary, Converter={StaticResource UpperCaseConverter}, FallbackValue={x:Null}}"
                                   Classes="eyebrow" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Classes="ghost" Command="{Binding Review.ToggleAllCommand, FallbackValue={x:Null}}"
                                AutomationProperties.Name="{Binding Review.ToggleAllLabel, FallbackValue={x:Null}}">
                          <TextBlock Text="{Binding Review.ToggleAllLabel, Converter={StaticResource UpperCaseConverter}, FallbackValue={x:Null}}" />
                        </Button>
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Review.Items, FallbackValue={x:Null}}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:AiReviewChangeItemViewModel">
                            <StackPanel Spacing="6">
                              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0"
                                          AutomationProperties.Name="{Binding Title}" />
                                <mi:MaterialIcon Grid.Column="1" Kind="{Binding Icon}" Width="13" Height="13" Margin="0,0,8,0"
                                                 Foreground="{DynamicResource Ink50}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center" ClipToBounds="True">
                                  <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}">
                                    <Run Text="{Binding Action}" />
                                    <Run Text=" · " Foreground="{DynamicResource Ink40}" />
                                    <Run Text="{Binding Title}" FontWeight="Bold" />
                                  </TextBlock>
                                  <TextBlock Text="{Binding Location}" Classes="faint" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Stats}" Classes="muted" FontSize="11"
                                           FontFamily="{DynamicResource MonoFontFamily}" VerticalAlignment="Center" Margin="10,0,4,0" />
                                <Button Grid.Column="4" Classes="icon-btn" Width="26" Height="26" Command="{Binding ToggleExpandedCommand}"
                                        ToolTip.Tip="{Binding ToggleTooltip}" AutomationProperties.Name="{Binding ToggleTooltip}">
                                  <mi:MaterialIcon Kind="{Binding IsExpanded, Converter={StaticResource ExpandChevronConverter}}" Width="13" Height="13" />
                                </Button>
                              </Grid>
                              <Border Classes="card" Padding="2" MaxHeight="280" IsVisible="{Binding IsExpanded}">
                                <ScrollViewer>
                                  <views:AssistantDiffView Lines="{Binding DiffLines}" />
                                </ScrollViewer>
                              </Border>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{loc:Tr Assistant_Review_Hint}" Classes="faint" FontSize="11" TextWrapping="Wrap" />
                      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="DiscardReviewButton" Classes="ghost" Margin="0,0,12,0"
                                Command="{Binding #Root.((vm:AssistantViewModel)DataContext).DiscardReviewCommand}" CommandParameter="{Binding}"
                                IsEnabled="{Binding #Root.((vm:AssistantViewModel)DataContext).CanResolveReview}">
                          <TextBlock Text="{loc:Tr Assistant_Review_Discard, Converter={StaticResource UpperCaseConverter}}" />
                        </Button>
                        <Button Name="ApplyReviewButton" Classes="pill-primary"
                                Command="{Binding #Root.((vm:AssistantViewModel)DataContext).ApplyReviewCommand}" CommandParameter="{Binding}">
                          <Button.IsEnabled>
                            <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                              <Binding Path="Review.HasSelection" FallbackValue="False" />
                              <Binding Path="#Root.((vm:AssistantViewModel)DataContext).CanResolveReview" />
                            </MultiBinding>
                          </Button.IsEnabled>
                          <TextBlock Text="{Binding Review.ApplyLabel, Converter={StaticResource UpperCaseConverter}, FallbackValue={x:Null}}" />
                        </Button>
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <!-- Permiso de consulta: la primera vez que el asistente quiere buscar o leer por su cuenta.
                       Dice qué ámbito y qué proveedor; no cambia de pantalla ni abre Ajustes. -->
                  <Border IsVisible="{Binding HasPendingReadAccess}" BorderThickness="1" Padding="16,14"
                          BorderBrush="{DynamicResource Ink30}" Background="{DynamicResource Ink05}">
                    <StackPanel Spacing="12">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <mi:MaterialIcon Kind="FileSearchOutline" Width="16" Height="16" Foreground="{DynamicResource Ink50}" />
                        <TextBlock Text="{loc:Tr Assistant_ReadAccess_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding PendingReadAccess.Question}" FontSize="13.5" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding PendingReadAccess.Detail}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Classes="ghost" Margin="0,0,12,0" Command="{Binding PendingReadAccess.DenyCommand}">
                          <TextBlock Text="{loc:Tr Assistant_ReadAccess_Deny, Converter={StaticResource UpperCaseConverter}}" />
                        </Button>
                        <Button Classes="pill-primary" Command="{Binding PendingReadAccess.AllowCommand}">
                          <TextBlock Text="{loc:Tr Assistant_ReadAccess_Allow, Converter={StaticResource UpperCaseConverter}}" />
                        </Button>
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <!-- Confirmación de una acción sin vuelta atrás: la respuesta queda parada hasta decidir. -->
                  <Border IsVisible="{Binding HasPendingApproval}" BorderThickness="1" Padding="16,14"
                          BorderBrush="{DynamicResource DangerBrush}" Background="{DynamicResource Ink05}">
                    <StackPanel Spacing="12">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <mi:MaterialIcon Kind="AlertCircleOutline" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="{loc:Tr Assistant_Approval_Eyebrow, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow"
                                   Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding PendingApproval.Title}" FontSize="13.5" TextWrapping="Wrap" />
                      <ScrollViewer MaxHeight="160">
                        <ItemsControl ItemsSource="{Binding PendingApproval.Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding}" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <TextBlock Text="{Binding PendingApproval.Hint}" Classes="faint" FontSize="11" TextWrapping="Wrap" />
                      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Classes="ghost" Margin="0,0,12,0" Command="{Binding PendingApproval.DenyCommand}">
                          <TextBlock Text="{loc:Tr Assistant_Approval_Deny, Converter={StaticResource UpperCaseConverter}}" />
                        </Button>
                        <Button Classes="pill-primary-danger" Command="{Binding PendingApproval.AllowCommand}">
                          <TextBlock Text="{loc:Tr Assistant_Approval_Allow, Converter={StaticResource UpperCaseConverter}}" />
                        </Button>
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <controls:ChatMarkdownView Markdown="{Binding Text}" IsVisible="{Binding HasText}" />
                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsInterrupted}">
                    <mi:MaterialIcon Kind="StopCircleOutline" Width="12" Height="12" Foreground="{DynamicResource Ink40}" />
                    <TextBlock Text="{loc:Tr Assistant_Message_Interrupted}" Classes="faint" FontSize="11" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding CanAct}" Margin="-6,-4,0,0">
                    <Button Classes="icon-btn" Width="30" Height="30"
                            Command="{Binding #Root.((vm:AssistantViewModel)DataContext).CopyMessageCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="{loc:Tr Assistant_Message_Copy}" AutomationProperties.Name="{loc:Tr Assistant_Message_Copy}">
                      <Panel>
                        <mi:MaterialIcon Kind="ContentCopy" Width="14" Height="14" IsVisible="{Binding !IsCopied}" />
                        <mi:MaterialIcon Kind="Check" Width="14" Height="14" IsVisible="{Binding IsCopied}" Foreground="{DynamicResource SuccessBrush}" />
                      </Panel>
                    </Button>
                    <Button Classes="icon-btn" Width="30" Height="30"
                            Command="{Binding #Root.((vm:AssistantViewModel)DataContext).RequestAppendToNoteCommand}" CommandParameter="{Binding}"
                            IsVisible="{Binding #Root.((vm:AssistantViewModel)DataContext).CanAppendToActiveNote}"
                            ToolTip.Tip="{Binding #Root.((vm:AssistantViewModel)DataContext).AppendToActiveNoteLabel}"
                            AutomationProperties.Name="{Binding #Root.((vm:AssistantViewModel)DataContext).AppendToActiveNoteLabel}">
                      <mi:MaterialIcon Kind="TextBoxPlusOutline" Width="14" Height="14" />
                    </Button>
                    <Button Classes="icon-btn" Width="30" Height="30"
                            Command="{Binding #Root.((vm:AssistantViewModel)DataContext).SaveMessageAsNoteCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="{loc:Tr Assistant_Message_SaveAsNote}" AutomationProperties.Name="{loc:Tr Assistant_Message_SaveAsNote}">
                      <mi:MaterialIcon Kind="NotePlusOutline" Width="14" Height="14" />
                    </Button>
                  </StackPanel>
                  <!-- Tokens de esta respuesta, si el proveedor los dio y el usuario no los ha ocultado en Ajustes. -->
                  <TextBlock Name="UsageLabel" Text="{Binding UsageLabel}" Classes="faint" FontSize="10" TextWrapping="Wrap">
                    <TextBlock.IsVisible>
                      <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                        <Binding Path="HasUsage" />
                        <Binding Path="#Root.((vm:AssistantViewModel)DataContext).ShowUsage" />
                      </MultiBinding>
                    </TextBlock.IsVisible>
                  </TextBlock>
                </StackPanel>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Leyendo mensajes anteriores mientras llega la respuesta: el hilo no se mueve solo; esto lo baja. -->
      <Button x:Name="JumpToEndButton" Classes="pill pill-compact" IsVisible="False"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
              Click="JumpToEndButton_Click"
              ToolTip.Tip="{loc:Tr Assistant_Transcript_JumpToEnd}" AutomationProperties.Name="{loc:Tr Assistant_Transcript_JumpToEnd}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="ArrowDown" Width="13" Height="13" />
          <TextBlock Text="{loc:Tr Assistant_Transcript_JumpToEnd, Converter={StaticResource UpperCaseConverter}}" />
        </StackPanel>
      </Button>

      <!-- Bienvenida de un chat vacío. La sección la desactiva aquí (clase "external-welcome") y monta la suya
           propia con el compositor en medio; el panel la usa tal cual, con el compositor fijo abajo. -->
      <Panel x:Name="WelcomeHost">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding ShowWelcome}">
          <views:AssistantWelcomeView />
        </ScrollViewer>
      </Panel>
    </Grid>

    <!-- · Consumo acumulado de la conversación · -->
    <TextBlock x:Name="ChatUsage" Grid.Row="1" Text="{Binding ChatUsageLabel}" Classes="faint" FontSize="10.5"
               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="860">
      <TextBlock.IsVisible>
        <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
          <Binding Path="HasChatUsage" />
          <Binding Path="ShowTranscript" />
        </MultiBinding>
      </TextBlock.IsVisible>
    </TextBlock>

    <!-- · Error del último turno · -->
    <Border x:Name="ErrorBox" Grid.Row="2" MaxWidth="860" Padding="14,12" BorderThickness="1"
            BorderBrush="{DynamicResource DangerBrush}" Background="{DynamicResource Ink05}"
            IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="Auto,*">
        <mi:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline" Width="16" Height="16" Margin="0,1,12,0"
                         VerticalAlignment="Top" Foreground="{DynamicResource DangerBrush}" />
        <StackPanel Grid.Column="1" Spacing="8">
          <SelectableTextBlock Text="{Binding ErrorMessage}" FontSize="12.5" TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <Button Classes="pill pill-compact" Margin="0,0,10,0" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}"
                    ToolTip.Tip="{loc:Tr Assistant_Error_Continue_Tooltip}" ToolTip.IsEnabled="{Binding RetryContinues}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="Refresh" Width="13" Height="13" />
                <TextBlock Text="{Binding RetryLabel, Converter={StaticResource UpperCaseConverter}}" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" IsVisible="{Binding ErrorShowsLoginHelp}"
                    Command="{Binding CopyTextCommand}" CommandParameter="{Binding Cli.LoginCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="ContentCopy" Width="12" Height="12" />
                <TextBlock Text="{loc:Tr Assistant_Setup_CopyCommand, Converter={StaticResource UpperCaseConverter}}" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" IsVisible="{Binding ErrorShowsSettings}" Command="{Binding OpenSettingsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="KeyOutline" Width="12" Height="12" />
                <TextBlock Text="{loc:Tr Assistant_Setup_ApiKey_Open, Converter={StaticResource UpperCaseConverter}}" />
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
