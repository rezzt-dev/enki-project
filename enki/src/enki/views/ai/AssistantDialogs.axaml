<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:views="clr-namespace:enki.Views"
             xmlns:controls="clr-namespace:enki.Controls"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d"
             x:Class="enki.Views.AssistantDialogs"
             x:DataType="vm:AssistantViewModel">

  <!-- Diálogos del asistente, compartidos por la sección y el panel. ModalOverlayHost los ancla a la ventana,
       así que cubren toda la aplicación aunque los abra el panel estrecho. -->
  <Panel>
    <controls:ModalOverlayHost ConstrainContent="True" x:Name="EvaluationModal" IsOpen="{Binding IsEvaluationOpen}">
      <Border Classes="modal-card" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
          <Grid Classes="icon-text-row" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <mi:MaterialIcon Kind="ChartBoxOutline" Width="20" Height="20" Foreground="{DynamicResource Ink70}" />
            <TextBlock Grid.Column="1" Text="{loc:Tr Assistant_Evaluation_Title, Converter={StaticResource UpperCaseConverter}}"
                       Classes="section-title" TextWrapping="Wrap" />
            <Button Grid.Column="2" Classes="icon-btn modal-cancel" Command="{Binding CloseEvaluationCommand}"
                    AutomationProperties.Name="{loc:Tr Common_Close}" ToolTip.Tip="{loc:Tr Common_Close}">
              <mi:MaterialIcon Kind="Close" Width="16" Height="16" />
            </Button>
          </Grid>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" MaxHeight="420">
            <StackPanel Spacing="16">
              <TextBlock Text="{loc:Tr Assistant_Evaluation_Help}" TextWrapping="Wrap" FontSize="13" />
              <Border Classes="trash-hint">
                <TextBlock Text="{loc:Tr Assistant_Evaluation_Metrics}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
              </Border>
              <TextBlock Text="{Binding EvaluationStatus}" TextWrapping="Wrap" FontSize="12"
                         IsVisible="{Binding EvaluationStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                         AutomationProperties.LiveSetting="Polite" />
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsEvaluating}" Height="3" />
              <Border Classes="card" Padding="20" IsVisible="{Binding !HasEvaluationResults}">
                <StackPanel Spacing="10">
                  <mi:MaterialIcon Kind="ChartBoxOutline" Width="24" Height="24" Foreground="{DynamicResource Ink50}" HorizontalAlignment="Left" />
                  <TextBlock Text="{loc:Tr Assistant_Evaluation_Empty}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding EvaluationResults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border BorderBrush="{DynamicResource Ink10}" BorderThickness="0,0,0,1" Padding="0,12">
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" FontFamily="{DynamicResource MonoFontFamily}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <WrapPanel Grid.Row="2" ItemSpacing="12" LineSpacing="8">
            <Button x:Name="EvaluationRunButton" Classes="pill-primary" Command="{Binding RunEvaluationCommand}" Content="{loc:Tr Assistant_Evaluation_Run, Converter={StaticResource UpperCaseConverter}}" />
            <Button x:Name="EvaluationClearButton" Classes="ghost" Command="{Binding ClearEvaluationsCommand}" Content="{loc:Tr Assistant_Evaluation_Clear, Converter={StaticResource UpperCaseConverter}}" />
          </WrapPanel>
        </Grid>
      </Border>
    </controls:ModalOverlayHost>
    <!-- · Borrar una conversación · -->
    <controls:ModalOverlayHost IsOpen="{Binding PendingDeleteSession, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{loc:Tr Assistant_DeleteModal_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow"
                       Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Assistant_DeleteModal_Message}" FontSize="14" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PendingDeleteSession.Title}" Classes="muted" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Margin="0,0,18,0" Command="{Binding CancelDeleteSessionCommand}">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary-danger" Command="{Binding ConfirmDeleteSessionCommand}">
              <TextBlock Text="{loc:Tr Common_Delete, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>

    <!-- · Revertir una respuesta · -->
    <controls:ModalOverlayHost IsOpen="{Binding PendingRevertMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="UndoVariant" Width="18" Height="18" Foreground="{DynamicResource Ink40}" />
            <TextBlock Text="{loc:Tr Assistant_Undo_Action, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow"
                       VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Tr Assistant_Undo_Confirm_Message}" FontSize="14" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PendingRevertSummary}" Classes="muted" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Tr Assistant_Undo_Confirm_Hint}" Classes="faint" FontSize="11.5" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Margin="0,0,18,0" Command="{Binding CancelRevertMessageCommand}">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary" Command="{Binding ConfirmRevertMessageCommand}">
              <TextBlock Text="{loc:Tr Assistant_Undo_Confirm_Action, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>

    <!-- · Confirmar lo que se envía · -->
    <controls:ModalOverlayHost IsOpen="{Binding IsConfirmSendOpen}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="ShieldLockOutline" Width="18" Height="18" Foreground="{DynamicResource Ink40}" />
            <TextBlock Text="{loc:Tr Assistant_Confirm_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{loc:Tr Assistant_Confirm_Message}" FontSize="13.5" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding ConfirmSendItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:AiAttachmentChipViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <mi:MaterialIcon Grid.Column="0" Kind="{Binding Icon}" Width="13" Height="13" Margin="0,0,8,0"
                                   Foreground="{DynamicResource Ink50}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" ToolTip.Tip="{Binding WorkspaceLabel}" />
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="faint" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding ConfirmSendSummary}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="{Binding AttachmentImageNotice}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding HasAttachmentImageNotice}" />
          <CheckBox IsChecked="{Binding SkipFutureConfirmations}">
            <TextBlock Text="{loc:Tr Assistant_Confirm_DontAskAgain}" FontSize="12.5" TextWrapping="Wrap" />
          </CheckBox>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Margin="0,0,18,0" Command="{Binding CancelSendCommand}">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary" Command="{Binding ConfirmSendCommand}">
              <TextBlock Text="{loc:Tr Assistant_Composer_Send, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>

    <!-- · Añadir una respuesta a la nota activa: vista previa de lo que cambia · -->
    <controls:ModalOverlayHost IsOpen="{Binding IsAppendPreviewOpen}">
      <Border Classes="modal-card" HorizontalAlignment="Center" VerticalAlignment="Center" Width="560" MaxWidth="560">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <mi:MaterialIcon Kind="TextBoxPlusOutline" Width="18" Height="18" Foreground="{DynamicResource Ink40}" />
            <TextBlock Text="{loc:Tr Assistant_Append_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Tr Assistant_Append_Message}" FontSize="13.5" TextWrapping="Wrap" />
            <TextBlock Text="{Binding AppendPreviewTitle}" Classes="muted" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
          </StackPanel>
          <Border Classes="card" Padding="2" MaxHeight="320">
            <ScrollViewer>
              <views:AssistantDiffView Lines="{Binding AppendPreviewLines}" />
            </ScrollViewer>
          </Border>
          <TextBlock Text="{loc:Tr Assistant_Append_Hint}" Classes="faint" FontSize="11" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Classes="ghost modal-cancel" Margin="0,0,18,0" Command="{Binding CancelAppendToNoteCommand}">
              <TextBlock Text="{loc:Tr Common_Cancel, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
            <Button Grid.Column="2" Classes="pill-primary" Command="{Binding ConfirmAppendToNoteCommand}">
              <TextBlock Text="{loc:Tr Assistant_Append_Confirm, Converter={StaticResource UpperCaseConverter}}" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </controls:ModalOverlayHost>
  </Panel>
</UserControl>
