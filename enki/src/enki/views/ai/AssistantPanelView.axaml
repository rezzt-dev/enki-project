<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:views="clr-namespace:enki.Views"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="760"
             x:Class="enki.Views.AssistantPanelView"
             x:Name="Root" Background="{DynamicResource AppBackgroundBrush}"
             x:DataType="vm:AssistantViewModel">

  <!-- Panel lateral del asistente (.docs/project-info/asistente-ia.md): la misma conversación que la sección,
       junto al contenido de trabajo y sin navegar a otra parte. Los controles secundarios se reorganizan en
       filas para dejar el ancho a la conversación; el historial se despliega encima bajo demanda. "Ampliar" la
       lleva a la sección y "Cerrar" solo la oculta: la respuesta en curso sigue. -->

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewChatCommand}" />
  </UserControl.KeyBindings>

  <Border BorderBrush="{DynamicResource Ink10}" BorderThickness="1,0,0,0">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <!-- Fila 1: historial, título y acciones de la superficie. -->
      <Border Grid.Row="0" Height="48" BorderBrush="{DynamicResource Ink10}" BorderThickness="0,0,0,1" Padding="8,0,6,0">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
          <Button x:Name="PanelHistoryToggle" Grid.Column="0" Classes="icon-btn" Width="32" Height="32"
                  Command="{Binding TogglePanelHistoryCommand}"
                  ToolTip.Tip="{loc:Tr Assistant_Panel_History}" AutomationProperties.Name="{loc:Tr Assistant_Panel_History}">
            <Panel>
              <mi:MaterialIcon Kind="History" Width="16" Height="16" IsVisible="{Binding !IsPanelHistoryOpen}" />
              <mi:MaterialIcon Kind="ChevronUp" Width="16" Height="16" IsVisible="{Binding IsPanelHistoryOpen}" />
            </Panel>
          </Button>
          <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center" Spacing="1" ClipToBounds="True">
            <TextBlock Text="{Binding ChatTitle}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding ChatTitle}" />
            <TextBlock Text="{Binding ActivityLabel}" Classes="faint" FontSize="10" IsVisible="{Binding HasActivity}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2" Classes="icon-btn" Width="32" Height="32"
                  Command="{Binding NewChatCommand}" IsEnabled="{Binding CanStartNewChat}"
                  ToolTip.Tip="{loc:Tr Assistant_NewChat_Tooltip}" AutomationProperties.Name="{loc:Tr Assistant_NewChat_Tooltip}">
            <mi:MaterialIcon Kind="MessagePlusOutline" Width="16" Height="16" />
          </Button>
          <Button x:Name="ExpandPanelButton" Grid.Column="3" Classes="icon-btn" Width="32" Height="32"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExpandAssistantPanelCommand, FallbackValue={x:Null}}"
                  ToolTip.Tip="{loc:Tr Assistant_Panel_Expand}" AutomationProperties.Name="{loc:Tr Assistant_Panel_Expand}">
            <mi:MaterialIcon Kind="ArrowExpand" Width="15" Height="15" />
          </Button>
          <Button x:Name="ClosePanelButton" Grid.Column="4" Classes="icon-btn" Width="32" Height="32"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseAssistantPanelCommand, FallbackValue={x:Null}}"
                  ToolTip.Tip="{loc:Tr Assistant_Panel_Close}" AutomationProperties.Name="{loc:Tr Assistant_Panel_Close}">
            <mi:MaterialIcon Kind="Close" Width="15" Height="15" />
          </Button>
        </Grid>
      </Border>

      <!-- Fila 2: ámbito, modelo y capacidad, siempre visibles para saber hasta dónde llega el chat. -->
      <Border Grid.Row="1" BorderBrush="{DynamicResource Ink10}" BorderThickness="0,0,0,1" Padding="10,8"
              IsVisible="{Binding Cli.IsReady}">
        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
          <views:AssistantScopeButton />
          <views:AssistantModelControls />
        </WrapPanel>
      </Border>

      <Grid Grid.Row="2">
        <views:AssistantTranscriptView Classes="compact" />

        <!-- Historial desplegado sobre la conversación: no cabe al lado en el ancho del panel. -->
        <Grid IsVisible="{Binding IsPanelHistoryOpen}" Background="{DynamicResource AppBackgroundAltBrush}"
              RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,10,8,0">
            <TextBlock Text="{loc:Tr Assistant_History_Title, Converter={StaticResource UpperCaseConverter}}" Classes="eyebrow"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="icon-btn" Width="28" Height="28" Command="{Binding OpenSettingsCommand}"
                    ToolTip.Tip="{loc:Tr Assistant_OpenSettings_Tooltip}" AutomationProperties.Name="{loc:Tr Assistant_OpenSettings_Tooltip}">
              <mi:MaterialIcon Kind="CogOutline" Width="15" Height="15" />
            </Button>
          </Grid>
          <views:AssistantHistoryList Grid.Row="1" />
        </Grid>
      </Grid>

      <views:AssistantComposerView Grid.Row="3" Classes="compact" IsVisible="{Binding Cli.IsReady}" />
    </Grid>
  </Border>
</UserControl>
