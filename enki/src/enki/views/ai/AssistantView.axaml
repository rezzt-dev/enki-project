<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:views="clr-namespace:enki.Views"
             xmlns:controls="clr-namespace:enki.Controls"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             x:Class="enki.Views.AssistantView"
             x:Name="Root" Background="{DynamicResource AppBackgroundBrush}"
             x:DataType="vm:AssistantViewModel">

  <!-- Sección Asistente (.docs/project-info/asistente-ia.md): historial de conversaciones a la izquierda,
       con la misma anatomía que el panel lateral de Habilidades en modo árbol (cabecera de 58 px, buscador,
       filas folder-row y pie), y la conversación abierta a la derecha. El hilo, el compositor, el ámbito, el
       modelo y el historial son los mismos controles que usa el panel lateral (AssistantPanelView) sobre el
       mismo viewmodel; los diálogos los monta una sola vez el shell. -->

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewChatCommand}" />
  </UserControl.KeyBindings>

  <controls:SidePanelGrid ColumnDefinitions="Auto,*" IsPanelOnRight="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SidePanels.AssistantOnRight, FallbackValue=False}">

    <!-- ===================== Historial ===================== -->
    <Grid x:Name="HistoryPanel" Grid.Column="0" Width="280" IsVisible="{Binding !IsHistoryCollapsed}"
          RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundAltBrush}">
      <Border Classes="panel-seam" Grid.Row="0" Grid.RowSpan="3" Width="1"
              Background="{DynamicResource Ink10}" IsHitTestVisible="False" />

      <Border Grid.Row="0" Height="58" BorderBrush="{DynamicResource Ink10}" BorderThickness="0,0,0,1"
              Background="{DynamicResource AppBackgroundBrush}" Padding="16,0,8,0">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="{loc:Tr Assistant_History_Title, Converter={StaticResource UpperCaseConverter}}"
                     Classes="eyebrow" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="icon-btn" Command="{Binding NewChatCommand}"
                  IsEnabled="{Binding CanStartNewChat}"
                  ToolTip.Tip="{loc:Tr Assistant_NewChat_Tooltip}" AutomationProperties.Name="{loc:Tr Assistant_NewChat_Tooltip}">
            <mi:MaterialIcon Kind="MessagePlusOutline" Width="17" Height="17" />
          </Button>
          <Button x:Name="CollapseHistoryButton" Grid.Column="2" Classes="icon-btn"
                  Command="{Binding ToggleHistoryCommand}"
                  ToolTip.Tip="{loc:Tr Assistant_History_Hide_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Assistant_History_Hide_Tooltip}">
            <mi:MaterialIcon Classes="panel-chevron" Kind="ChevronDoubleLeft" Width="17" Height="17" />
          </Button>
        </Grid>
      </Border>

      <views:AssistantHistoryList Grid.Row="1" />

      <!-- Pie del historial desplegado: proveedor, estado y cuenta con los que se está hablando. -->
      <Border Grid.Row="2" BorderBrush="{DynamicResource Ink10}" BorderThickness="0,1,0,0" Padding="14,10,8,10">
        <StackPanel Spacing="8">
          <ComboBox x:Name="ProviderPicker" ItemsSource="{Binding ProviderOptions}" SelectedItem="{Binding SelectedProvider}"
                    HorizontalAlignment="Stretch" IsEnabled="{Binding !IsSending}"
                    AutomationProperties.Name="{loc:Tr Ai_Provider}" ToolTip.Tip="{loc:Tr Ai_ProviderHelp}" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,10,0" VerticalAlignment="Center"
                     Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding Cli.IsReady}" />
            <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,10,0" VerticalAlignment="Center"
                     Fill="{DynamicResource Ink30}" IsVisible="{Binding !Cli.IsReady}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="{Binding Cli.StateLabel}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Cli.AccountLabel}" Classes="faint" FontSize="10" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding Cli.HasAccount}" ToolTip.Tip="{Binding Cli.VersionLabel}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="icon-btn" Width="28" Height="28" Command="{Binding OpenSettingsCommand}"
                    ToolTip.Tip="{loc:Tr Assistant_OpenSettings_Tooltip}" AutomationProperties.Name="{loc:Tr Assistant_OpenSettings_Tooltip}">
              <mi:MaterialIcon Kind="CogOutline" Width="15" Height="15" />
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Historial plegado: conserva los accesos a nuevo chat, estado del proveedor y ajustes. -->
    <Grid x:Name="HistoryRail" Grid.Column="0" Width="52" RowDefinitions="Auto,*,Auto"
          IsVisible="{Binding IsHistoryCollapsed}" Background="{DynamicResource AppBackgroundAltBrush}">
      <Border Classes="panel-seam" Grid.RowSpan="3" Width="1"
              Background="{DynamicResource Ink10}" IsHitTestVisible="False" />
      <Border Grid.Row="0" Height="58" BorderBrush="{DynamicResource Ink10}" BorderThickness="0,0,0,1"
              Background="{DynamicResource AppBackgroundBrush}">
        <Button x:Name="ExpandHistoryButton" Classes="icon-btn" HorizontalAlignment="Center" VerticalAlignment="Center"
                Command="{Binding ToggleHistoryCommand}"
                ToolTip.Tip="{loc:Tr Assistant_History_Show_Tooltip}"
                AutomationProperties.Name="{loc:Tr Assistant_History_Show_Tooltip}">
          <mi:MaterialIcon Classes="panel-chevron" Kind="ChevronDoubleRight" Width="17" Height="17" />
        </Button>
      </Border>
      <Button Grid.Row="1" Classes="icon-btn" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
              Command="{Binding NewChatCommand}" IsEnabled="{Binding CanStartNewChat}"
              ToolTip.Tip="{loc:Tr Assistant_NewChat_Tooltip}"
              AutomationProperties.Name="{loc:Tr Assistant_NewChat_Tooltip}">
        <mi:MaterialIcon Kind="MessagePlusOutline" Width="17" Height="17" />
      </Button>
      <Border Grid.Row="2" BorderBrush="{DynamicResource Ink10}" BorderThickness="0,1,0,0" Padding="0,10">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding Cli.IsReady}"
                   ToolTip.Tip="{Binding Cli.StateLabel}" />
          <Ellipse Width="7" Height="7" Fill="{DynamicResource Ink30}" IsVisible="{Binding !Cli.IsReady}"
                   ToolTip.Tip="{Binding Cli.StateLabel}" />
          <Button Classes="icon-btn" Width="28" Height="28" Command="{Binding OpenSettingsCommand}"
                  ToolTip.Tip="{loc:Tr Assistant_OpenSettings_Tooltip}"
                  AutomationProperties.Name="{loc:Tr Assistant_OpenSettings_Tooltip}">
            <mi:MaterialIcon Kind="CogOutline" Width="15" Height="15" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===================== Conversación ===================== -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

      <!-- Cabecera: título (renombrable), skill del chat, ámbito, modelo, capacidad y paso al panel lateral. -->
      <Border Grid.Row="0" Height="58" BorderBrush="{DynamicResource Ink10}" BorderThickness="0,0,0,1" Padding="24,0,16,0">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" ClipToBounds="True">
            <TextBlock Text="{Binding ChatTitle}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="420" IsVisible="{Binding !IsRenamingTitle}"
                       ToolTip.Tip="{Binding ChatTitle}" />
            <TextBox x:Name="TitleEditor" Text="{Binding TitleDraft}" IsVisible="{Binding IsRenamingTitle}"
                     Classes="title-edit" Width="360" FontSize="14" VerticalAlignment="Center"
                     AutomationProperties.Name="{loc:Tr Assistant_Rename_Tooltip}"
                     KeyDown="TitleEditor_KeyDown" LostFocus="TitleEditor_LostFocus" />
            <Button Classes="icon-btn" Width="28" Height="28" Command="{Binding BeginRenameCommand}"
                    IsVisible="{Binding !IsDraft}"
                    ToolTip.Tip="{loc:Tr Assistant_Rename_Tooltip}" AutomationProperties.Name="{loc:Tr Assistant_Rename_Tooltip}">
              <mi:MaterialIcon Kind="PencilOutline" Width="14" Height="14" />
            </Button>
            <Border Background="{DynamicResource Ink05}" BorderBrush="{DynamicResource Ink10}" BorderThickness="1"
                    Padding="8,3" VerticalAlignment="Center" IsVisible="{Binding HasActiveSkill}"
                    ToolTip.Tip="{loc:Tr Assistant_Skill_Tooltip}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <mi:MaterialIcon Kind="Brain" Width="12" Height="12" Foreground="{DynamicResource Ink50}" />
                <TextBlock Text="{Binding ActiveSkillName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           MaxWidth="200" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </StackPanel>

          <views:AssistantScopeButton Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Cli.IsReady}" />

          <TextBlock Grid.Column="2" Text="{loc:Tr Assistant_Model_Label, Converter={StaticResource UpperCaseConverter}}"
                     Classes="eyebrow" FontSize="9.5" VerticalAlignment="Center" Margin="16,0,10,0"
                     IsVisible="{Binding Cli.IsReady}" />
          <views:AssistantModelControls Grid.Column="3" IsVisible="{Binding Cli.IsReady}" />

          <Button Grid.Column="4" Classes="icon-btn" Width="32" Height="32" Margin="8,0,0,0"
                  Command="{Binding NewChatCommand}" IsEnabled="{Binding CanStartNewChat}"
                  ToolTip.Tip="{loc:Tr Assistant_NewChat_Tooltip}" AutomationProperties.Name="{loc:Tr Assistant_NewChat_Tooltip}">
            <mi:MaterialIcon Kind="MessagePlusOutline" Width="16" Height="16" />
          </Button>
          <Button Grid.Column="5" x:Name="ShowAsPanelButton" Classes="icon-btn" Width="32" Height="32" Margin="2,0,0,0"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowAssistantAsPanelCommand, FallbackValue={x:Null}}"
                  ToolTip.Tip="{loc:Tr Assistant_Panel_ShowAsPanel}" AutomationProperties.Name="{loc:Tr Assistant_Panel_ShowAsPanel}">
            <mi:MaterialIcon Kind="DockRight" Width="16" Height="16" />
          </Button>
        </Grid>
      </Border>

      <views:AssistantTranscriptView Grid.Row="1" />

      <views:AssistantComposerView Grid.Row="2" IsVisible="{Binding Cli.IsReady}" />
    </Grid>
  </controls:SidePanelGrid>
</UserControl>
