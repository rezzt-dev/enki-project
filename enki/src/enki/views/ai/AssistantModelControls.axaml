<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:enki.ViewModels"
             xmlns:controls="clr-namespace:enki.Controls"
             xmlns:loc="clr-namespace:enki.Localization"
             mc:Ignorable="d"
             x:Class="enki.Views.AssistantModelControls"
             x:DataType="vm:AssistantViewModel">

  <!-- Modelo y capacidad del chat, en la cabecera de la sección y en la segunda fila del panel. Se bloquean
       durante una respuesta: el cambio vale para el turno siguiente, nunca para el que está en curso. -->
  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <ComboBox x:Name="ModelPicker" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModel}"
              Width="160" VerticalAlignment="Center" IsEnabled="{Binding !IsSending}"
              ToolTip.Tip="{loc:Tr Assistant_Model_Tooltip}" AutomationProperties.Name="{loc:Tr Assistant_Model_Label}">
      <ComboBox.ItemTemplate>
        <DataTemplate DataType="vm:AiModelOption">
          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <Button x:Name="EffortTrigger" Classes="date-picker-trigger" Padding="10,7"
            Command="{Binding ToggleEffortPickerCommand}"
            ToolTip.Tip="{loc:Tr Assistant_Effort_Help}" AutomationProperties.Name="{loc:Tr Assistant_Effort_Title}">
      <TextBlock Text="{Binding EffortSummary}" FontSize="12" />
    </Button>
    <Popup PlacementTarget="{Binding #EffortTrigger}" Placement="BottomEdgeAlignedRight" VerticalOffset="6"
           IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #EffortTrigger}"
           controls:PopoverKeyboard.CloseOnEscape="True"
           IsOpen="{Binding IsEffortPickerOpen, Mode=TwoWay}">
      <Border Classes="dropdown-popover" Width="260">
        <StackPanel Spacing="10">
          <TextBlock Text="{loc:Tr Assistant_Effort_Title}" Classes="eyebrow" />
          <TextBlock Text="{Binding EffortLabel}" FontSize="13" />
          <Slider x:Name="EffortSlider" Theme="{StaticResource RectangularSlider}"
                  Minimum="0" Maximum="2" SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding EffortLevel, Mode=TwoWay}" IsEnabled="{Binding CanChangeEffort}"
                  AutomationProperties.Name="{loc:Tr Assistant_Effort_Title}"
                  AutomationProperties.HelpText="{Binding EffortLabel}" />
          <Grid ColumnDefinitions="*,*,*">
            <TextBlock Text="{loc:Tr Assistant_Effort_low}" Classes="faint" />
            <TextBlock Grid.Column="1" Text="{loc:Tr Assistant_Effort_medium}" Classes="faint" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{loc:Tr Assistant_Effort_high}" Classes="faint" HorizontalAlignment="Right" />
          </Grid>
          <TextBlock Text="{loc:Tr Assistant_Effort_Help}" Classes="muted" TextWrapping="Wrap" FontSize="11" />
          <TextBlock Text="{loc:Tr Assistant_Effort_Unavailable}" IsVisible="{Binding ShowEffortUnavailable}"
                     Classes="muted" TextWrapping="Wrap" FontSize="11" />
        </StackPanel>
      </Border>
    </Popup>
  </StackPanel>
</UserControl>
